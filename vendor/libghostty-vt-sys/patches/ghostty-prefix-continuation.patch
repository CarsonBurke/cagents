+test "PageList deleting saved continuation without allocation clears it" {
+    const testing = std.testing;
+
+    var s = try init(testing.allocator, 80, 24, null);
+    defer s.deinit();
+    try s.growColdPagesForTest(3);
+    _ = s.compress(.incremental);
+    try testing.expect(s.page_compression.next_node != null);
+    const serial = s.page_serial;
+
+    // Remove complete pages through the actual erase path, including the
+    // saved node. No allocation/generation change may be required to free it.
+    const second = s.pages.first.?.next.?;
+    s.eraseHistory(.{ .history = .{ .y = @intCast(
+        @as(usize, s.pages.first.?.rows()) + second.rows() - 1,
+    ) } });
+    try testing.expectEqual(serial, s.page_serial);
+    try testing.expect(s.page_compression.next_node == null);
+    try testing.expectEqual(IncrementalCompressionResult.complete, s.compress(.drain));
+    try testing.expect(s.pages.first.?.isCompressed());
+}
+
+test "PageList clone reads preserve a live continuation and verification" {
+    const testing = std.testing;
+
+    var s = try init(testing.allocator, 80, 24, null);
+    defer s.deinit();
+    try s.growColdPagesForTest(3);
+    const first = s.pages.first.?;
+    first.page().getRowAndCell(0, 0).cell.* = .init('界');
+    _ = s.compress(.incremental);
+    try testing.expect(first.isCompressed());
+    const next = s.page_compression.next_node.?;
+    const activity = s.page_compression.activity_serial;
+
+    // Clone reads restore source memory, but cannot destroy its nodes. The
+    // clone owns new nodes and must never inherit the source's borrowed cursor.
+    var cloned = try s.clone(testing.allocator, .{ .top = .{ .screen = .{} } });
+    defer cloned.deinit();
+    try testing.expect(!first.isCompressed());
+    try testing.expectEqual(next, s.page_compression.next_node.?);
+    try testing.expectEqual(activity, s.page_compression.activity_serial);
+    try testing.expect(cloned.page_compression.next_node == null);
+    try testing.expectEqual(IncrementalCompressionResult.complete, s.compress(.drain));
+    try testing.expect(first.isCompressed());
+    try testing.expectEqual(@as(u21, '界'), first.page().getRowAndCell(0, 0).cell.content.codepoint);
+
+    // A read after completion leaves no dangling cursor; a newly scheduled
+    // incremental pass begins at the oldest page and reclaims it again.
+    try testing.expect(s.page_compression.next_node == null);
+    try testing.expectEqual(IncrementalCompressionResult.complete, s.compress(.drain));
+    try testing.expect(first.isCompressed());
+}
+
+test "PageList moved owner retains its own compression continuation" {
+    const testing = std.testing;
+
+    var original = try init(testing.allocator, 80, 24, null);
+    var owns_original = true;
+    errdefer if (owns_original) original.deinit();
+    try original.growColdPagesForTest(3);
+    _ = original.compress(.incremental);
+    const next = original.page_compression.next_node.?;
+
+    // Move ownership exactly as returning a PageList by value does. Never
+    // deinit the moved-from value: both nodes and their pools move together.
+    var moved = original;
+    owns_original = false;
+    original = undefined;
+    defer moved.deinit();
+    try testing.expectEqual(next, moved.page_compression.next_node.?);
+    try testing.expectEqual(IncrementalCompressionResult.complete, moved.compress(.drain));
+    try testing.expectEqual(@as(usize, 3), moved.memoryStats().compressed_pages);
+}
