+test "PageList incremental compression bounds all cold iterator visits" {
+    const testing = std.testing;
+
+    for ([_]usize{ 16, 64, 256 }) |count| {
+        var s = try init(testing.allocator, 80, 24, null);
+        defer s.deinit();
+        try s.growColdPagesForTest(count);
+        _ = s.compress(.full);
+        try testing.expectEqual(count, s.memoryStats().compressed_pages);
+
+        var visits: usize = 0;
+        var steps: usize = 0;
+        while (true) {
+            const result = s.compress(.incremental);
+            // This counts iterator visits, including continuation positioning,
+            // not only candidates after a history-sized positioning scan.
+            try testing.expect(s.compression_test_visits <=
+                incremental_compression_max_inspected);
+            visits += s.compression_test_visits;
+            steps += 1;
+            try testing.expect(steps <= 2 * count);
+            if (result == .complete) break;
+            try testing.expectEqual(IncrementalCompressionResult.pending, result);
+        }
+        // Both the pass and verification visit every cold page exactly once.
+        try testing.expectEqual(2 * count, visits);
+        try testing.expectEqual(count, s.memoryStats().compressed_pages);
+    }
+}
