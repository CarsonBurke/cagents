        "api",
        "graphql",
        "--hostname",
        "github.com",
        "-f",
        "query=query($owner:String!,$name:String!,$number:Int!,$cursor:String){repository(owner:$owner,name:$name){pullRequest(number:$number){reviews(first:50,after:$cursor){nodes{id author{login} body createdAt url state viewerDidAuthor} pageInfo{hasNextPage endCursor}}}}}",
        "-f",
        "owner=fixture-native",
        "-f",
        "name=tooltip-data",
        "-F",
        "number=42"
      ],
      "response": "reviews.json",
      "exit_code": 0,
      "stderr": "",
      "stdout": "exact frozen UTF-8 response-file JSON bytes plus newline",
      "cwd": [
        "$CHECKOUT"
      ],
      "required": true,
      "consumer": "native-review"
    },
    {
      "case": "daemon-authored-open",
      "argv": [
        "pr",
        "list",
        "-R",
        "github.com/fixture-native/tooltip-data",
        "--author",
        "@me",
        "--state",
        "open",
        "--search",
        "sort:updated-desc",
        "--limit",
        "50",
        "--json",
        "number,title,state,isDraft,headRefName,headRefOid,headRepository,headRepositoryOwner,baseRefName,updatedAt,url,reviewDecision,statusCheckRollup"
      ],
      "response": "authored-empty.json",
      "cwd": [
        "$CHECKOUT"
      ],
      "required": false,
      "consumer": "daemon-background",
      "exit_code": 0,
      "stderr": "",
      "stdout": "exact synthetic empty JSON array plus newline; no authenticated @me identity"
    },
    {
      "case": "daemon-authored-all",
