{
  "scope": "Synthetic read-only native fixture data; not actual authenticated GitHub tracking",
  "allowlist": [
    {
      "case": "discover-repository",
      "argv": [
        "repo",
        "view",
        "--json",
        "nameWithOwner,url"
      ],
      "response": "repo.json",
      "cwd": [
        "$REPOSITORY",
        "$WORKTREE"
      ],
      "exit_code": 0,
      "stderr": "",
      "stdout": "exact frozen UTF-8 response-file JSON bytes plus newline",
      "required": true,
      "consumer": "native-review"
    },
    {
      "case": "discover-unauthenticated",
      "argv": [
        "auth",
        "status",
        "--active",
        "--hostname",
        "github.com",
        "--json",
        "hosts"
      ],
      "response": "auth-none.json",
      "exit_code": 0,
      "stderr": "",
      "stdout": "exact frozen UTF-8 response-file JSON bytes plus newline",
      "cwd": [
        "$CHECKOUT"
      ],
      "required": true,
      "consumer": "native-review"
    },
    {
      "case": "browser-list",
      "argv": [
        "api",
        "graphql",
        "--hostname",
        "github.com",
        "-f",
        "query=query($owner:String!,$name:String!,$cursor:String){repository(owner:$owner,name:$name){pullRequests(first:50,after:$cursor,states:OPEN,orderBy:{field:CREATED_AT,direction:DESC}){nodes{id number title state isDraft headRefName headRefOid baseRefName baseRefOid author{login} updatedAt url reviewDecision commits(last:1){nodes{commit{statusCheckRollup{state}}}}} pageInfo{hasNextPage endCursor}}}}",
        "-f",
        "owner=fixture-native",
        "-f",
        "name=tooltip-data"
      ],
      "response": "list.json",
      "exit_code": 0,
      "stderr": "",
      "stdout": "exact frozen UTF-8 response-file JSON bytes plus newline",
      "cwd": [
        "$CHECKOUT"
      ],
      "required": true,
      "consumer": "native-review"
    },
    {
      "case": "review-context",
      "argv": [
        "api",
        "graphql",
        "--hostname",
        "github.com",
        "-f",
        "query=query($owner:String!,$name:String!,$number:Int!){viewer{login} repository(owner:$owner,name:$name){pullRequest(number:$number){id headRefOid baseRefOid viewerDidAuthor reviews(first:10,states:[PENDING]){nodes{id author{login} commit{oid} comments{totalCount}} pageInfo{hasNextPage endCursor}}}}}",
        "-f",
        "owner=fixture-native",
        "-f",
        "name=tooltip-data",
        "-F",
        "number=42"
      ],
      "response": "context.json",
      "exit_code": 0,
      "stderr": "",
      "stdout": "exact frozen UTF-8 response-file JSON bytes plus newline",
      "cwd": [
        "$CHECKOUT"
      ],
      "required": true,
      "consumer": "native-review"
    },
    {
      "case": "review-metadata",
      "argv": [
        "pr",
        "view",
        "42",
        "-R",
        "github.com/fixture-native/tooltip-data",
        "--json",
        "id,number,title,body,state,isDraft,headRefName,headRefOid,headRepository,headRepositoryOwner,baseRefName,baseRefOid,author,createdAt,updatedAt,url,mergeable,mergeStateStatus,reviewDecision,labels,additions,deletions,changedFiles,statusCheckRollup"
      ],
      "response": "pr.json",
      "exit_code": 0,
      "stderr": "",
      "stdout": "exact frozen UTF-8 response-file JSON bytes plus newline",
      "cwd": [
        "$CHECKOUT"
      ],
      "required": true,
      "consumer": "native-review"
    },
    {
      "case": "review-files",
      "argv": [
        "api",
        "graphql",
        "--hostname",
        "github.com",
        "-f",
        "query=query($owner:String!,$name:String!,$number:Int!,$cursor:String){viewer{login} repository(owner:$owner,name:$name){pullRequest(number:$number){id headRefOid baseRefOid files(first:100,after:$cursor){nodes{path additions deletions changeType viewerViewedState} pageInfo{hasNextPage endCursor}}}}}",
        "-f",
        "owner=fixture-native",
        "-f",
        "name=tooltip-data",
        "-F",
        "number=42"
      ],
      "response": "files.json",
      "exit_code": 0,
      "stderr": "",
      "stdout": "exact frozen UTF-8 response-file JSON bytes plus newline",
      "cwd": [
        "$CHECKOUT"
      ],
      "required": true,
      "consumer": "native-review"
    },
    {
      "case": "conversation-reviewThreads",
      "argv": [
        "api",
        "graphql",
        "--hostname",
        "github.com",
        "-f",
        "query=query($owner:String!,$name:String!,$number:Int!,$cursor:String){repository(owner:$owner,name:$name){pullRequest(number:$number){reviewThreads(first:50,after:$cursor){nodes{id path line originalLine startLine originalStartLine diffSide startDiffSide isOutdated isResolved isCollapsed viewerCanResolve viewerCanUnresolve comments(first:50){nodes{id author{login} body createdAt url viewerDidAuthor viewerCanUpdate viewerCanDelete commentState:state} pageInfo{hasNextPage endCursor}}} pageInfo{hasNextPage endCursor}}}}}",
        "-f",
        "owner=fixture-native",
        "-f",
        "name=tooltip-data",
        "-F",
        "number=42"
      ],
      "response": "threads.json",
      "exit_code": 0,
      "stderr": "",
      "stdout": "exact frozen UTF-8 response-file JSON bytes plus newline",
      "cwd": [
        "$CHECKOUT"
      ],
      "required": true,
      "consumer": "native-review"
    },
