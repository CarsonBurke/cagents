#!/usr/bin/env bash
# Executed exclusively inside the offline disposable rootfs by the public runner.
set -euo pipefail
artifact=$1
version=$2
fail() { printf 'artifact smoke: %s\n' "$*" >&2; exit 1; }
[[ -r /usr/share/zoneinfo/UTC && -r /usr/share/zoneinfo/America/Vancouver ]] || fail 'runtime timezone database is unavailable'

if [[ $artifact == *.AppImage ]]; then
    [[ $(id -u) != 0 ]] || fail 'AppImage requires an ordinary user'
    if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
        exec dbus-run-session -- /bin/bash "$0" "$@"
    fi
    export WAYLAND_DISPLAY=wayland-cagents-smoke ICED_BACKEND=tiny-skia
    weston -B headless --renderer=pixman --socket="$WAYLAND_DISPLAY" --width=1280 --height=800 \
        --idle-time=0 --no-config >/tmp/weston.log 2>&1 &
    compositor=$!
    window_pid=
    trap '[[ -z $window_pid ]] || kill "$window_pid" 2>/dev/null || :; kill "$compositor" 2>/dev/null || :; wait "$compositor" 2>/dev/null || :' EXIT
    for attempt in {1..50}; do
        [[ ! -S $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY ]] || break
        kill -0 "$compositor" 2>/dev/null || break
        sleep 0.1
    done
    if [[ ! -S $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY ]]; then
        cat /tmp/weston.log >&2
        fail 'AppImage compositor did not start'
    fi
    mkdir -p "$XDG_DATA_HOME/cagents" "$XDG_CONFIG_HOME/cagents"
    printf 'saved-user-data\n' > "$XDG_DATA_HOME/cagents/smoke-sentinel"
    printf 'saved-user-data\n' > "$XDG_CONFIG_HOME/cagents/smoke-sentinel"
    # HTTP release assets do not carry Unix mode bits.
    install -m 0755 /artifact /tmp/cagents.AppImage
    /tmp/cagents.AppImage --appimage-extract-and-run > /tmp/appimage-first
    grep -Fxq 'cagents-ui started' /tmp/appimage-first || fail 'first AppImage launch did not open a window'
    installation=$XDG_DATA_HOME/cagents-install
    binaries=$installation/versions/$version/bin
    public_command=$HOME/.local/bin/cagents
    [[ $(readlink "$installation/current") == "versions/$version" ]] || fail 'wrong AppImage version selected'
    [[ $(readlink -f "$public_command") == "$binaries/cagents" ]] || fail 'wrong AppImage command link'
    [[ -f $XDG_DATA_HOME/applications/dev.cagents.Cagents.desktop &&
        -f $XDG_DATA_HOME/icons/hicolor/scalable/apps/dev.cagents.Cagents.svg &&
        -f $XDG_CONFIG_HOME/autostart/dev.cagents.Cagents.Daemon.desktop ]] || fail 'missing AppImage desktop integration'
    "$public_command" --no-start --json daemon status > /tmp/appimage-status
    jq -e --arg version "$version" '.ok and .data.running and .data.instance == "production" and .data.daemon_version == $version' /tmp/appimage-status >/dev/null
    daemon_pid=$(jq -er '.pid | select(type == "number" and . > 1)' "$XDG_RUNTIME_DIR/cagents/cagentsd.lock")
    [[ $(readlink "/proc/$daemon_pid/exe") == "$binaries/cagentsd" ]] || fail 'wrong AppImage daemon executable'
    for process in /proc/[0-9]*/exe; do
        if [[ $(readlink -- "$process" 2>/dev/null || :) == "$binaries/cagents-ui" ]]; then
            window_pid=${process#/proc/}
            window_pid=${window_pid%/exe}
            break
        fi
    done
    [[ -n $window_pid ]] || fail 'installed window process is missing'
    window_start=$(awk '{print $22}' "/proc/$window_pid/stat")
    daemon_start=$(awk '{print $22}' "/proc/$daemon_pid/stat")
    same_process() {
        local pid=$1 executable=$2 start=$3
        [[ $(readlink "/proc/$pid/exe" 2>/dev/null || :) == "$executable" ]] &&
            [[ $(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || :) == "$start" ]]
    }
    previous=$(stat -c %i "$installation/current")
    /tmp/cagents.AppImage --appimage-extract-and-run > /tmp/appimage-second
    grep -Fxq 'cagents is already running' /tmp/appimage-second || fail 'second AppImage launch did not activate the installed window'
    [[ $(stat -c %i "$installation/current") == "$previous" ]] || fail 'second launch changed the installation'
    same_process "$window_pid" "$binaries/cagents-ui" "$window_start" &&
        same_process "$daemon_pid" "$binaries/cagentsd" "$daemon_start" ||
        fail 'second launch replaced a running process'
    if [[ $CAGENTS_SMOKE_BUNDLED_EDITOR == 1 ]]; then
        digest=$(sha256sum -- "$binaries/ceditor")
        printf '%s\n' "${digest%% *}" > /tmp/ceditor.sha256
    fi
    kill "$window_pid"
    for attempt in {1..100}; do
        same_process "$window_pid" "$binaries/cagents-ui" "$window_start" || break
        sleep 0.05
    done
    if same_process "$window_pid" "$binaries/cagents-ui" "$window_start"; then
        fail 'AppImage window did not exit before removal'
    fi
    window_pid=
    "$binaries/cagents-uninstall"
    [[ ! -e $installation/current && ! -L $installation/current &&
        ! -L $public_command && ! -L $XDG_DATA_HOME/applications/dev.cagents.Cagents.desktop ]] ||
        fail 'AppImage uninstall left program launchers'
    [[ $(cat "$XDG_DATA_HOME/cagents/smoke-sentinel") == saved-user-data &&
        $(cat "$XDG_CONFIG_HOME/cagents/smoke-sentinel") == saved-user-data ]] || fail 'AppImage uninstall changed saved user data'
    exit 0
fi

mkdir -m 700 /run/fixture
[[ $(dpkg --print-architecture) == amd64 ]] || { printf 'artifact smoke: wrong rootfs architecture\n' >&2; exit 1; }
mkdir -p /root/data/cagents /root/config/cagents /root/config/ceditor /usr/local/share
printf 'unrelated-system-file\n' > /usr/local/share/cagents-smoke-sentinel
for directory in /root/data/cagents /root/config/cagents /root/config/ceditor; do
    printf 'saved-user-data\n' > "$directory/smoke-sentinel"
done
daemon_cli=
cleanup() {
    if [[ -n $daemon_cli ]]; then
        "$daemon_cli" --json daemon stop-for-rebuild --including-subagents > /tmp/cleanup-status 2>&1 || :
    fi
}
trap cleanup EXIT
case $artifact in
    cagents-browserless*) product=cagents-browserless ;;
    cagents*) product=cagents ;;
    ceditor*) product=ceditor ;;
    *) fail 'unexpected artifact' ;;
esac
case $artifact in
    *.deb)
        [[ $(dpkg-deb -f /artifact Package) == "$product" ]] || fail 'wrong Debian package identity'
        [[ $(dpkg-deb -f /artifact Version) == "$version" ]] || fail 'wrong Debian package version'
        dpkg-deb --fsys-tarfile /artifact | tar --numeric-owner -tvf - > /tmp/members
        awk '$2 != "0/0" { exit 1 }' /tmp/members || fail 'package members must be root-owned'
        # Real install/configure executes the packaged preinst. Dependencies
        # must be satisfied in the supplied distribution rootfs.
        dpkg --install /artifact
        dpkg-query -L "$product" > /tmp/owned-files
        binaries=/usr/libexec/$product
        public_command=/usr/bin/$product ;;
    *.tar.gz)
        tar --numeric-owner -tvzf /artifact > /tmp/members
        awk '$2 != "0/0" { exit 1 }' /tmp/members || fail 'archive members must be root-owned'
        mkdir /tmp/extracted
        tar -xzf /artifact -C /tmp/extracted
        binaries=/tmp/extracted/$product-$version/bin
        public_command=$binaries/$product ;;
    *) fail 'unexpected artifact type' ;;
esac
if [[ $product == ceditor ]]; then
    private=/tmp/extracted/ceditor-$version/lib/ceditor
    [[ -L $public_command && $(readlink "$public_command") == ../lib/ceditor/current/bin/ceditor ]] || fail 'wrong editor public link'
    [[ -L $private/current && $(readlink "$private/current") == "releases/$version" ]] || fail 'wrong editor release link'
    binaries=$private/releases/$version/bin
    [[ $(readlink -f "$public_command") == "$binaries/ceditor" ]] || fail 'editor link escapes its release'
    marker=$binaries/.ceditor-companions
    [[ -f $marker && ! -L $marker && $(stat -c %a "$marker") == 644 && $(stat -c %s "$marker") == 22 ]] || fail 'invalid editor companion marker'
    cmp -- "$marker" <(printf 'ceditor companions v1\n') || fail 'wrong editor companion marker'
    executables=(ceditor cagents cagentsd)
    editor_command=$public_command
else
    executables=(cagents cagents-ui cagentsd)
    # The release build and the publisher require the dictation helper of
    # every release that has one; here it must also load and run offline.
    if [[ -e $binaries/cagents-dictate || -L $binaries/cagents-dictate ]]; then
        executables+=(cagents-dictate)
    fi
    if [[ $product == cagents && $CAGENTS_SMOKE_BUNDLED_EDITOR == 1 ]]; then
        executables+=(ceditor)
        editor_command=$binaries/ceditor
        if [[ $artifact == *.deb ]]; then
            editor_command=/usr/bin/ceditor
            [[ -L $editor_command && $(readlink -f "$editor_command") == "$binaries/ceditor" ]] \
                || fail 'editor entrypoint does not select the packaged sibling'
        fi
        [[ ! -e $binaries/.ceditor-companions && ! -L $binaries/.ceditor-companions ]] \
            || fail 'bundled editor must use the shared daemon'
    fi
fi
for executable in "${executables[@]}"; do
    [[ -f $binaries/$executable && ! -L $binaries/$executable && -x $binaries/$executable ]] || fail "missing executable: $executable"
    actual=$("$binaries/$executable" --version)
    [[ $actual == "$executable $version" ]] || fail "wrong shipped version: $actual"
    "$binaries/$executable" --help > /tmp/help
    [[ -s /tmp/help ]] || fail "empty help: $executable"
done
if [[ -n ${editor_command:-} ]]; then
    [[ $("$editor_command" --version) == "ceditor $version" ]] || fail 'editor public command version mismatch'
    [[ $("$editor_command" --settings-path) == "$XDG_CONFIG_HOME/ceditor/settings.toml" ]] \
        || fail 'editor settings path changed'
    digest=$(sha256sum -- "$binaries/ceditor")
    printf '%s\n' "${digest%% *}" > /tmp/ceditor.sha256
fi
if [[ ${executables[*]} == *cagents-dictate* ]]; then
    # Lists the speech models from the empty data directory: no download.
    "$binaries/cagents-dictate" models > /tmp/models || fail 'the dictation helper does not run'
    [[ -s /tmp/models ]] || fail 'the dictation helper lists no models'
    [[ ! -e /root/data/cagents-speech-models ]] || fail 'listing models wrote to the data directory'
fi
if [[ $product == ceditor ]]; then
    daemon_cli=$binaries/cagents
else
    [[ -x $public_command && $(readlink -f "$public_command") == "$(readlink -f "$binaries/cagents")" ]] || fail 'broken public command entrypoint'
    [[ $("$public_command" --version) == "cagents $version" ]] || fail 'public command version mismatch'
    daemon_cli=$public_command
fi
if [[ -n $daemon_cli ]]; then
    "$daemon_cli" --json daemon status > /tmp/status
    jq -e '.ok == true and .command == "daemon.status" and .data.running == false' /tmp/status >/dev/null
    "$daemon_cli" --json daemon start > /tmp/start
    jq -e '.ok == true and .command == "daemon.start" and .data.running == true' /tmp/start >/dev/null
    "$daemon_cli" --json daemon status > /tmp/status
    jq -e --arg version "$version" '.ok == true and .command == "daemon.status" and .data.running == true and .data.instance == "production" and .data.daemon_version == $version and .data.cli_version == $version and .data.socket == "/run/fixture/cagents/cagentsd.sock"' /tmp/status >/dev/null
    pid=$(jq -er '.pid | select(type == "number" and . > 1)' /run/fixture/cagents/cagentsd.lock)
    daemon_executable=$(readlink -f "$binaries/cagentsd")
    [[ $(readlink "/proc/$pid/exe") == "$daemon_executable" ]] || fail 'daemon did not use the packaged sibling'
    start=$(awk '{print $22}' "/proc/$pid/stat")
    same_daemon() {
        local executable current_start
        executable=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 1
        [[ $executable == "$daemon_executable" ]] || return 1
        current_start=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null) || return 1
        [[ $current_start == "$start" ]]
    }
    "$daemon_cli" --json terminal list > /tmp/terminals
    jq -e '.ok == true and .command == "terminal.list" and .data.terminals == []' /tmp/terminals >/dev/null
    if [[ $artifact == *.deb ]]; then
        if dpkg --remove "$product" > /tmp/live-remove 2>&1; then fail 'removal allowed a live daemon'; fi
        same_daemon || fail 'refused removal changed the daemon'
        "$daemon_cli" --json daemon status > /tmp/status
        jq -e --arg version "$version" '.ok == true and .data.running == true and .data.daemon_version == $version' /tmp/status >/dev/null
    fi
    "$daemon_cli" --json daemon stop-for-rebuild --including-subagents > /tmp/stop
    jq -e '.ok == true and .command == "daemon.stop_for_rebuild" and .data.stopped == true' /tmp/stop >/dev/null
    # Stop acknowledges SIGTERM before exit. Wait for this exact process before
    # asking its closing socket for status; keep all later IPC errors strict.
    for attempt in {1..100}; do
        if ! same_daemon; then break; fi
        sleep 0.05
    done
    if same_daemon; then fail 'daemon process did not exit'; fi
    for attempt in {1..100}; do
        "$daemon_cli" --json daemon status > /tmp/status
        if jq -e '.ok == true and .command == "daemon.status" and .data.running == false' /tmp/status >/dev/null; then break; fi
        sleep 0.05
    done
    jq -e '.ok == true and .command == "daemon.status" and .data.running == false' /tmp/status >/dev/null
    daemon_cli=
fi
case $artifact in
    *.deb)
        dpkg --remove "$product"
        while IFS= read -r path; do
            [[ -d $path ]] && continue
            [[ ! -e $path && ! -L $path ]] || fail "package-owned file remains: $path"
        done < /tmp/owned-files ;;
    *) rm -rf -- "/tmp/extracted/$product-$version" ;;
esac
[[ $(cat /usr/local/share/cagents-smoke-sentinel) == unrelated-system-file ]] || fail 'unrelated system file changed'
for directory in /root/data/cagents /root/config/cagents /root/config/ceditor; do
    [[ $(cat "$directory/smoke-sentinel") == saved-user-data ]] || fail 'saved user data changed'
done
