#!/bin/sh
# Installs a macOS release archive into a private HOME and prefix with
# install-macos.sh, checks what it installed, reinstalls it, and removes it.
#
#   packaging/macos/smoke DIST VERSION PROTOCOL
#
# The installer leaves the private login item unloaded. The separate HOME and
# XDG_RUNTIME_DIR isolate daemon and window state from the account's.
set -eu

PROGRAM=smoke
fail() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}
[ "$#" = 3 ] || fail 'usage: smoke DIST VERSION PROTOCOL'
DIST=$1 VERSION=$2 PROTOCOL=$3
ARCHIVE=$DIST/cagents-$VERSION-aarch64-apple-darwin.tar.gz

ROOT=$(mktemp -d "${TMPDIR:-/tmp}/cagents-macos-smoke.XXXXXX")
# TMPDIR and /tmp lie under /var and /tmp, links into /private. A person's
# home has no link in its path, and the daemon cannot yet serve a data
# directory reached through one, so the private home gets its real path.
ROOT=$(cd "$ROOT" && pwd -P)
trap 'exit 1' HUP INT TERM
mkdir -p "$ROOT/home" "$ROOT/runtime" "$ROOT/other-runtime"
chmod 0700 "$ROOT/runtime" "$ROOT/other-runtime"
# A path with a space, as the default under Application Support has.
PREFIX="$ROOT/home/Library/Application Support/cagents-install"
AGENT="$ROOT/home/Library/LaunchAgents/dev.cagents.Cagents.Daemon.plist"
publisher_pid=

private_runtime() {
    env HOME="$ROOT/home" XDG_RUNTIME_DIR="$ROOT/runtime" "$@"
}

# Running the launcher can register the private bundle with Launch Services,
# which is per account. Remove only the private paths.
unregister() {
    lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
    "$lsregister" -u "$PREFIX/Cagents.app" >/dev/null 2>&1 || :
    for copy in "$PREFIX"/versions/*/Cagents.app; do "$lsregister" -u "$copy" >/dev/null 2>&1 || :; done
}

cleanup() {
    if [ -n "$publisher_pid" ]; then
        touch "$ROOT/$publication-release"
        wait "$publisher_pid" 2>/dev/null || :
    fi
    # The selector may still point to the stand-in if the login test failed.
    installed_cli="$PREFIX/versions/$VERSION/bin/cagents"
    if [ -x "$installed_cli" ]; then
        private_runtime "$installed_cli" --no-start daemon stop >/dev/null 2>&1 || :
    fi
    unregister 2>/dev/null || :
    rm -rf "$ROOT"
}
trap cleanup EXIT

private_installer() {
    private_runtime env \
        CAGENTS_REPOSITORY=CarsonBurke/cagents \
        CAGENTS_ARCHIVE="$ARCHIVE" CAGENTS_CHECKSUMS="$DIST/SHA256SUMS-macos" \
        /bin/sh "$@"
}

install_release() {
    private_installer "$DIST/install-macos.sh" --prefix "$PREFIX" "$@"
}

# Pause the real publisher at the initial copy, the repair's selector rename,
# and removal of the login item.
mkdir "$ROOT/hooks"
cat > "$ROOT/hooks/pause" <<'EOF'
#!/bin/sh
set -eu
command=${0##*/}
case $command in
    ditto) real=/usr/bin/ditto ;;
    *) real=/bin/$command ;;
esac
case $SMOKE_PHASE:$command in
    first-install:ditto)
        case $2 in
            "$SMOKE_PREFIX"/.stage.*/candidate) mkdir "$2"; touch "$2/partial" ;;
            *) exec "$real" "$@" ;;
        esac
        ;;
    repair:mv) [ "$#" -eq 3 ] && [ "$1" = -fh ] && [ "$3" = "$SMOKE_PREFIX/current" ] || exec "$real" "$@" ;;
    removal:rm) [ "$#" -eq 2 ] && [ "$1" = -f ] && [ "$2" = "$SMOKE_AGENT" ] || exec "$real" "$@" ;;
    *) exec "$real" "$@" ;;
esac
printf '%s %s\n' "$PPID" "$$" > "$SMOKE_ROOT/$SMOKE_PHASE-ready"
remaining=30
until [ -f "$SMOKE_ROOT/$SMOKE_PHASE-release" ]; do
    [ "$remaining" -gt 0 ] || exit 1
    sleep 1
    remaining=$((remaining - 1))
done
[ "$SMOKE_PHASE" != first-install ] || exit 1
exec "$real" "$@"
EOF
chmod +x "$ROOT/hooks/pause"
for command in ditto mv rm; do ln -s pause "$ROOT/hooks/$command"; done
cat > "$ROOT/contender.sh" <<'EOF'
#!/bin/sh
touch "$1"
EOF

pause_publication() {
    publication=$1
    shift
    SMOKE_PHASE=$publication SMOKE_ROOT=$ROOT SMOKE_PREFIX=$PREFIX SMOKE_AGENT=$AGENT \
        PATH="$ROOT/hooks:$PATH" install_release "$@" > "$ROOT/$publication.log" 2>&1 &
    publisher_pid=$!
    remaining=30
    until [ -s "$ROOT/$publication-ready" ]; do
        if [ "$remaining" -le 0 ] || ! kill -0 "$publisher_pid" 2>/dev/null; then
            cat "$ROOT/$publication.log" >&2
            fail "$publication did not reach the publication step"
        fi
        sleep 1
        remaining=$((remaining - 1))
    done
    read -r publisher_shell publication_hook < "$ROOT/$publication-ready"
}

refuse_contender() {
    runtime=$1
    if private_runtime env XDG_RUNTIME_DIR="$runtime" "$ROOT/home/.local/bin/cagents" --no-start \
        coordinate-install --prefix "$PREFIX" --installer "$ROOT/contender.sh" \
        --publish-only -- "$ROOT/contender-ran" > "$ROOT/contender.log" 2>&1; then
        fail "a second publisher entered during $publication"
    fi
    [ ! -e "$ROOT/contender-ran" ] && grep -qiE 'temporarily unavailable|another .*install' "$ROOT/contender.log" \
        || { cat "$ROOT/contender.log" >&2; fail "the second publisher was not refused during $publication"; }
}

finish_publication() {
    touch "$ROOT/$publication-release"
    if ! wait "$publisher_pid"; then
        cat "$ROOT/$publication.log" >&2
        fail "$publication failed"
    fi
    publisher_pid=
}

# Simulate interruption while writing the initial marker, then really kill
# the publisher during the first copy. Both leave an installable prefix.
mkdir -p "$PREFIX"
touch "$PREFIX/.cagents-install-root.pending"
pause_publication first-install --no-start
[ "$(cat "$PREFIX/.cagents-install-root")" = 'cagents install root' ] \
    && [ ! -e "$PREFIX/current" ] && [ ! -e "$AGENT" ] \
    || fail 'the first publisher started copying before establishing ownership'
kill -KILL "$publisher_shell"
touch "$ROOT/$publication-release"
if wait "$publisher_pid"; then fail 'the interrupted first install reported success'; fi
publisher_pid=
remaining=30
while kill -0 "$publication_hook" 2>/dev/null; do
    [ "$remaining" -gt 0 ] || fail 'the first install copy did not exit'
    sleep 1
    remaining=$((remaining - 1))
done

# Read the installer from standard input, as the release's curl command does.
private_installer -s -- --prefix "$PREFIX" --no-start < "$DIST/install-macos.sh" > "$ROOT/install.log" 2>&1 \
    || { cat "$ROOT/install.log" >&2; fail 'streamed install failed'; }
[ "$(readlink "$PREFIX/current")" = "versions/$VERSION" ] || fail 'current does not name the release'
[ "$(cat "$PREFIX/.cagents-install-root")" = 'cagents install root' ] || fail 'the install root marker is missing'
[ "$(readlink "$ROOT/home/.local/bin/cagents")" = "$PREFIX/current/bin/cagents" ] || fail 'the cagents command link is wrong'
[ "$(readlink "$ROOT/home/Applications/Cagents.app")" = "$PREFIX/Cagents.app" ] || fail 'the Applications link is wrong'
[ "$("$ROOT/home/.local/bin/cagents" --version)" = "cagents $VERSION" ] || fail 'the linked command reports another version'
[ "$("$ROOT/home/.local/bin/cagents" daemon protocol-version)" = "$PROTOCOL" ] || fail 'the installed daemon protocol differs'
codesign --verify --strict "$PREFIX/Cagents.app" || fail 'the installed Cagents.app signature is broken'
# The launcher execs the served version's UI with its arguments, which
# answers --version without opening a window.
[ "$("$PREFIX/Cagents.app/Contents/MacOS/Cagents" --version)" = "cagents-ui $VERSION" ] \
    || fail 'the Cagents.app launcher does not reach the installed cagents-ui'
plutil -lint -s "$AGENT" || fail 'the login item is not a valid property list'
[ "$(/usr/libexec/PlistBuddy -c 'Print :RunAtLoad' "$AGENT")" = true ] || fail 'the login item does not run at load'
[ -z "$(find "$PREFIX" -xattrname com.apple.quarantine -print 2>/dev/null)" ] || fail 'installed files carry quarantine'

# Exercise the plist's actual command after an updater selects another build.
# A stand-in shows the path and arguments without launching a second daemon.
login_argument() {
    /usr/libexec/PlistBuddy -c "Print :ProgramArguments:$1" "$AGENT"
}
NEXT_BIN="$PREFIX/versions/smoke-successor/bin"
mkdir -p "$NEXT_BIN"
cat > "$NEXT_BIN/cagents" <<'EOF'
#!/bin/sh
printf '%s\n' "$0" "$@"
EOF
chmod +x "$NEXT_BIN/cagents"
ln -s versions/smoke-successor "$PREFIX/.smoke-next"
mv -fh "$PREFIX/.smoke-next" "$PREFIX/current"
login_result=$(private_runtime \
    "$(login_argument 0)" "$(login_argument 1)" "$(login_argument 2)" "$(login_argument 3)" "$(login_argument 4)") \
    || fail 'the login item could not start the selected build'
[ "$login_result" = "$(printf '%s\n' "$NEXT_BIN/cagents" daemon start)" ] \
    || fail 'the unchanged login item did not start the selected build by its real path'
ln -s "versions/$VERSION" "$PREFIX/.smoke-next"
mv -fh "$PREFIX/.smoke-next" "$PREFIX/current"
rm -r "$PREFIX/versions/smoke-successor"

# The daemon, started and stopped through the command link as a person
# would, in the private runtime directory. On macOS an executable sees the
# path it was started by, so this needs the CLI to find its companions by
# its real path, as process::current_executable does.
cli() {
    private_runtime "$ROOT/home/.local/bin/cagents" "$@"
}
cli daemon start > "$ROOT/daemon.log" 2>&1 \
    && cli --no-start daemon status --json > "$ROOT/status.json" 2>> "$ROOT/daemon.log" \
    && grep -q '"running": *true' "$ROOT/status.json" \
    || { cli --no-start daemon stop > /dev/null 2>&1 || :; cat "$ROOT/daemon.log" >&2; fail 'the daemon does not start through the command link'; }
if install_release --no-start > "$ROOT/running-repair.log" 2>&1; then
    fail 'repair replaced a version with its daemon running'
fi
grep -q 'daemon .* is running' "$ROOT/running-repair.log" \
    || { cat "$ROOT/running-repair.log" >&2; fail 'repair refused without reporting the running daemon'; }
cli --no-start daemon stop >> "$ROOT/daemon.log" 2>&1 || fail 'could not stop the daemon started through the link'

unregister

touch "$PREFIX/versions/$VERSION/.smoke-damaged-member"
pause_publication repair
refuse_contender "$ROOT/runtime"
refuse_contender "$ROOT/other-runtime"
finish_publication
[ ! -e "$PREFIX/versions/$VERSION/.smoke-damaged-member" ] || fail 'repair retained the damaged release tree'
cli --no-start daemon status --json > "$ROOT/status.json"
grep -q '"running": *true' "$ROOT/status.json" || fail 'repair did not start the daemon after publication'
cli --no-start daemon stop >> "$ROOT/daemon.log" 2>&1 || fail 'could not stop the daemon started after publication'

# Purge only isolated data, while retaining the runtime lock files.
mkdir -p "$ROOT/home/Library/Application Support/dev.cagents.cagents" "$ROOT/runtime/cagents"
touch "$ROOT/runtime/cagents/smoke-data"
pause_publication removal --purge
refuse_contender "$ROOT/runtime"
refuse_contender "$ROOT/other-runtime"
[ -f "$ROOT/runtime/cagents/smoke-data" ] || fail 'purge removed data before publication'
kill -TERM "$publisher_shell"
finish_publication
[ ! -e "$ROOT/home/Library/Application Support/dev.cagents.cagents" ] && [ ! -e "$ROOT/runtime/cagents" ] \
    || fail 'purge left private app data behind'
[ -f "$ROOT/runtime/cagents-ui.lock.update" ] || fail 'purge removed the application launch fence'
[ ! -e "$PREFIX" ] || fail 'uninstall left the prefix behind'
[ ! -L "$ROOT/home/.local/bin/cagents" ] && [ ! -L "$ROOT/home/Applications/Cagents.app" ] && [ ! -e "$AGENT" ] \
    || fail 'uninstall left a link or the login item behind'
printf 'macOS smoke: installed, repaired and removed cagents %s with exclusive publication\n' "$VERSION"
