#!/bin/bash
# Measure how often the daemon's Git watcher wakes while a project it watches
# builds, in a private fixture. See "Git watcher during builds" in
# docs/performance.md.
#
#   scripts/measure-watch-wakeups BIN_DIR [SECONDS]
#
# BIN_DIR holds a matched `cagents` and `cagentsd`. The fixture project is a
# shared clone of this checkout's commit, which the watcher covers. Once the
# Work board has read it, the project's CLI is checked through the build gate
# over and over for SECONDS (default 120), touching a source file before each
# check so the compiler reads the crate again. The daemon's threads are
# measured meanwhile from /proc. Nothing outside the fixture is touched.
set -euo pipefail

if [ "${CAGENTS_AGENT_AUTHORITY+x}" ]; then
    printf '%s\n' 'This fixture requires a genuine User shell; inherited agent authority was not modified.' >&2
    exit 77
fi
if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    sed -n '2,13p' "$0" >&2
    exit 2
fi
bin=$(realpath "$1")
seconds=${2:-120}
[ -x "$bin/cagents" ] && [ -x "$bin/cagentsd" ] || {
    printf 'No matched cagents and cagentsd in %s\n' "$bin" >&2
    exit 2
}
checkout=$(cd "$(dirname "$0")/.." && pwd)
root=$(mktemp -d "$HOME/.local/state/watch-wakeups.XXXXXX")
# Unix socket paths are short: keep the runtime beneath the real one.
runtime=$(mktemp -d "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ww.XXXXXX")
mkdir -p "$root"/{home,data,config,cache}

fixture() {
    env -u CLAUDE_CONFIG_DIR -u CAGENTS_SESSION_ID \
        HOME="$root/home" XDG_RUNTIME_DIR="$runtime" \
        XDG_DATA_HOME="$root/data" XDG_CONFIG_HOME="$root/config" \
        XDG_CACHE_HOME="$root/cache" "$@"
}
fixture_processes() {
    grep -lzx "XDG_RUNTIME_DIR=$runtime" /proc/[0-9]*/environ 2>/dev/null |
        cut -d/ -f3 | grep -vx "$$" || true
}
cleanup() {
    fixture "$bin/cagents" --no-start daemon stop >/dev/null 2>&1 || true
    local pids
    pids=$(fixture_processes)
    [ -z "$pids" ] || kill $pids 2>/dev/null || true
    sleep 1
    pids=$(fixture_processes)
    [ -z "$pids" ] || kill -9 $pids 2>/dev/null || true
    rm -rf "$runtime" "$root"
}
trap cleanup EXIT

project="$root/project"
git clone -q --shared --no-checkout "$checkout" "$project"
git -C "$project" checkout -q --detach "$(git -C "$checkout" rev-parse HEAD)"
fixture "$bin/cagents" project open "$project" >/dev/null
daemon=$(fixture_processes | while read -r pid; do
    if [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = cagentsd ]; then echo "$pid"; fi
done | head -n 1)
[ -n "$daemon" ] || { printf '%s\n' 'The fixture daemon is not running' >&2; exit 1; }
build() {
    # Outside the fixture's environment: the build is the user's own.
    (cd "$project" && scripts/cargo-gate check --locked --no-default-features --bin cagents) \
        >/dev/null 2>&1
}
printf '%s\n' 'warming the build'
build
# The board learns of the project within a model refresh, then reads it.
sleep 60
printf 'building for %s s\n' "$seconds"
/usr/bin/python3 -I - "$daemon" "$seconds" <<'EOF' &
import os, sys, time

daemon, seconds = sys.argv[1], float(sys.argv[2])
ticks = os.sysconf("SC_CLK_TCK")


def threads():
    found = {}
    for tid in os.listdir(f"/proc/{daemon}/task"):
        base = f"/proc/{daemon}/task/{tid}"
        try:
            name = open(f"{base}/comm").read().strip()
            switches = sum(
                int(line.split()[1])
                for line in open(f"{base}/status")
                if line.startswith(("voluntary_ctxt", "nonvoluntary_ctxt"))
            )
            on_cpu = int(open(f"{base}/schedstat").read().split()[0])
        except (OSError, ValueError, IndexError):
            continue
        found[tid] = (name, switches, on_cpu)
    return found


def own():
    fields = open(f"/proc/{daemon}/stat").read().rsplit(")", 1)[1].split()
    return int(fields[11]) + int(fields[12])


before, cpu = threads(), own()
time.sleep(seconds)
after, now_cpu = threads(), own()
watched = {"notify-rs inoti", "git-watch", "work-scanner", "work-scan"}
for name in sorted(watched):
    switches = on_cpu = 0
    for tid, (thread, count, used) in after.items():
        if thread != name:
            continue
        _, old_count, old_used = before.get(tid, (thread, 0, 0))
        switches += count - old_count
        on_cpu += used - old_used
    print(f"{name:16} wakeups/s {switches / seconds:9.2f}  cpu % core {100 * on_cpu / 1e9 / seconds:6.3f}")
print(f"daemon cpu % core {100 * (now_cpu - cpu) / ticks / seconds:.2f}")
EOF
measurer=$!
checks=0
while kill -0 "$measurer" 2>/dev/null; do
    touch "$project/src/main.rs"
    build
    checks=$((checks + 1))
done
wait "$measurer"
printf 'checks=%s\n' "$checks"
