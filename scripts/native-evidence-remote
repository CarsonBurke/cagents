#!/bin/bash
# scripts/native-evidence on another host, reached by plain SSH, from any
# shell, including a session cagents hosts. See "Native evidence from a
# cagents session" in docs/development.md.
#
# Nothing native runs here. This copies the sources to the host as Git
# commits, runs scripts/native-evidence there in an SSH login, which carries
# no agent authority, and brings the screenshots back. The host's own copy of
# native-evidence still refuses inherited authority, so a forwarded
# environment could not get a fixture past it.
set -euo pipefail
# Read whole before any of it runs: a build or session runs for minutes, and
# a checkout updated meanwhile must not change what the rest of this does.
{

self=$(readlink -f "$0")
tool_root=${self%/scripts/*}

# A signal sent to this wrapper alone, such as a tool timeout's TERM, would end
# only this shell. Its SSH connections, Git's and rsync's among them, would run
# on, and the host would go on building or comparing for nobody: Bash runs no
# trap until the command it waits for ends, and command substitutions hold
# most of them. So the wrapper runs under the supervisor of the gate's owned
# commands. On TERM, HUP or INT it ends this shell, then every connection the
# shell left, and reaps them before it dies by that signal; the host sees each
# connection go and ends its work. A signal the caller ignores, as nohup
# ignores HUP, stays ignored. Otherwise it passes the exit status on.
if [ "${CAGENTS_EVIDENCE_REMOTE_SUPERVISOR:-}" = "$PPID" ]; then
    unset CAGENTS_EVIDENCE_REMOTE_SUPERVISOR
else
    export CAGENTS_EVIDENCE_REMOTE_SUPERVISOR=$$
    # It reads cancellation from a file too, which this never writes.
    exec /usr/bin/python3 -I "$tool_root/scripts/cargo-gate-command.py" --wrapper native-evidence-remote \
        /dev/null "$self" "$@"
fi

usage() {
    cat <<'USAGE'
Usage: scripts/native-evidence --remote HOST --task DIR COMMAND
       scripts/native-evidence-remote --remote HOST --task DIR COMMAND

Runs native-evidence on HOST, over SSH, and keeps the screenshots in DIR here.
HOST may also come from CAGENTS_EVIDENCE_REMOTE, and DIR from
CAGENTS_EVIDENCE_TASK. DIR's name, at most 18 letters, digits, dots, hyphens
or underscores, names the task on HOST: ~/.local/state/cev/NAME there.

  pair --before SOURCE --after SOURCE --steps FILE [--integrated] [START OPTIONS]
                  The whole comparison in one command: build both sides, then
                  for each side start a session, run FILE, stop it, and bring
                  back its shots. FILE is a Bash script that runs on HOST with
                  SIDE set and `evidence` standing for native-evidence there,
                  as in `evidence drive click 'Open repository'`, `evidence
                  shot channel-prs`. A session that FILE leaves running is
                  stopped. START OPTIONS, such as --width PX, --portal gtk or
                  --codex tool-rows, --ui-scoped-fixture or --codex-executable /host/path/codex,
                  go to each side's start. Executable paths name files on HOST.
  build SIDE SOURCE [--integrated]
                  Copy SOURCE to HOST and give HOST its executables. SOURCE is
                  a checkout directory, whose uncommitted and untracked files
                  are included, or a revision such as origin/main. A main
                  commit the host's sentinel has built needs no build. A
                  checkout otherwise builds through its own gate, as
                  `mise run dev` does, reusing what that built, and the
                  executables go to HOST; a revision builds on HOST.
                  --integrated builds the UI with the embedded browser, on
                  HOST, as it does for both sides of a pair.
  shot NAME [--lossless]
                  Capture on HOST and bring back shots/SIDE-NAME.webp;
                  --lossless keeps every pixel.
  fetch           Bring back every shot and the manifest.
  where           Print the task and checkouts on HOST.
  clean           Remove the task's session, checkouts, refs and directory
                  from HOST; the shots here are kept.
  start, relaunch, open-window, stop, status, cli, env, drive, nested,
  save-seed, seed
                  As in native-evidence, run on HOST. In cli and env
                  arguments, {fixture} stands for the fixture's root there.

Each build records which local checkout and commit it came from in
DIR/sources.tsv, beside shots/manifest.tsv, whose revisions are the commits
copied to HOST.
USAGE
}

die() {
    printf 'native-evidence-remote: %s\n' "$1" >&2
    exit "${2:-1}"
}

host=${CAGENTS_EVIDENCE_REMOTE:-}
task=${CAGENTS_EVIDENCE_TASK:-}
while [ "$#" -gt 0 ]; do
    case $1 in
        --remote) host=${2:-}; shift 2 || die '--remote needs a host' 2 ;;
        --task) task=${2:-}; shift 2 || die '--task needs a directory' 2 ;;
        --help | -h) usage; exit 0 ;;
        *) break ;;
    esac
done
command=${1:-}
[ -n "$command" ] || { usage >&2; exit 2; }
shift
[ -n "$host" ] || die 'name the host with --remote or CAGENTS_EVIDENCE_REMOTE' 2
[[ $host =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ ]] || die "unsupported host name: $host" 2
[ -n "$task" ] || die 'name a task directory with --task or CAGENTS_EVIDENCE_TASK' 2
case $task in
    '~') task=$HOME ;;
    '~/'*) task=$HOME/${task#'~/'} ;;
esac
task=$(realpath -m -- "$task")
name=${task##*/}
[[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,17}$ ]] ||
    die "the task directory's name must be 1-18 letters, digits, dots, hyphens or underscores, starting with a letter or digit: $name" 2

# The repository on HOST that receives the sources. By default the same path
# as this one, which is how the build host is set up.
repository=${CAGENTS_EVIDENCE_REMOTE_REPOSITORY:-}
if [ -z "$repository" ]; then
    common=$(git -C "$tool_root" rev-parse --path-format=absolute --git-common-dir) ||
        die "cannot find the repository of $tool_root; set CAGENTS_EVIDENCE_REMOTE_REPOSITORY"
    repository=${common%/.git}
fi
[[ $repository =~ ^/[A-Za-z0-9._/-]+$ ]] || die "unsupported repository path on $host: $repository" 2
# Whose native-evidence runs on HOST: this one's, so both sides get the same
# tool and synthetic provider, as they do locally.
tool_source=${CAGENTS_EVIDENCE_REMOTE_TOOL:-$tool_root}

# Its own connection, never a channel of a user's multiplexing master: the
# host ends what a connection started when that connection's sshd goes, and a
# master's outlives this command.
ssh_command=(ssh -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=30
    -o ControlMaster=no -o ControlPath=none)
# Git's own SSH connection, the first contact in a build, gets the same
# options, so an unreachable host fails in seconds rather than prompting.
git_ssh="${ssh_command[*]}"

# Runs a Bash script on HOST in a fresh SSH login, which inherits nothing from
# this shell. The login shell there may be fish, so the script travels on
# standard input to `bash -s`, never as a command line for that shell to
# parse. One function holds it all: Bash reads it whole before running any
# of it, and its commands read nothing more from that input.
on_host() {
    local script=$1
    shift
    local quoted='' argument
    for argument in "$@"; do
        quoted+=" $(printf '%q' "$argument")"
    done
    "${ssh_command[@]}" "$host" bash -s <<SCRIPT
set -euo pipefail
remote_main() {
$script
}
$remote_lifetime
# Its own process group, which the connection's end can signal.
set -m
remote_main$quoted </dev/null &
main=\$!
set +m
end_with_connection "\$main"
status=0
wait "\$main" || status=\$?
stop_watching
exit "\$status"
SCRIPT
}

# What HOST runs started by a connection ends with it. When the client goes,
# sshd's session process exits but nothing tells what it started, which would
# build or hold the native lock for nobody; a watcher sends that work's
# process group TERM instead. A session that `start` detached on purpose
# outlives it, which is why pair stops its own on TERM. The watcher ends with
# the script, so what a connection started is gone once it closes.
remote_lifetime=$(cat <<'LIFETIME'
watcher=
# Whether a process runs: one that exited is gone, though until its parent
# reaps it, `kill -0` still finds it.
running() {
    case $(sed 's/.*) //' "/proc/$1/stat" 2>/dev/null) in
        '' | Z* | X*) return 1 ;;
    esac
}
end_with_connection() {
    local main=$1 connection=$$
    while [ "$connection" -gt 1 ]; do
        case $(cat "/proc/$connection/comm" 2>/dev/null) in
            sshd*) break ;;
        esac
        connection=$(sed 's/.*) //' "/proc/$connection/stat" 2>/dev/null | cut -d ' ' -f 2) || return 0
        [ -n "$connection" ] || return 0
    done
    [ "$connection" -gt 1 ] || return 0
    (
        # Told to stop, it ends its pause and waits for it, leaving nothing
        # for whoever adopts the orphans here.
        nap=
        trap '[ -z "$nap" ] || kill "$nap" 2>/dev/null; wait; exit 0' TERM
        while running "$connection" && kill -0 "$main" 2>/dev/null; do
            sleep 2 &
            nap=$!
            wait "$nap" || :
            nap=
        done
        kill -0 "$main" 2>/dev/null || exit 0
        kill -TERM -- "-$main" 2>/dev/null || :
    ) </dev/null >/dev/null 2>&1 &
    watcher=$!
}
stop_watching() {
    [ -n "$watcher" ] || return 0
    kill "$watcher" 2>/dev/null || :
    wait "$watcher" 2>/dev/null || :
}
LIFETIME
)

# Who a task on HOST belongs to: this machine and this task directory. The
# host knows a task only by its directory's name, so two agents whose task
# directories share a name would otherwise build, stop and clean each other's.
owner="$(uname -n):$task"

# What every script on HOST starts with: its variables, and the refusal of a
# task that isn't this one's.
remote_prelude=$(cat <<PRELUDE
repository=$(printf '%q' "$repository")
name=$(printf '%q' "$name")
owner=$(printf '%q' "$owner")
task=\$HOME/.local/state/cev/\$name
tool=\$repository/.worktrees/cev-\$name-tool
# Beside the task, which native-evidence keeps to its own files.
owner_record=\$HOME/.local/state/cev-owners/\$name
# A login profile there must not send these commands on again.
unset CAGENTS_EVIDENCE_REMOTE CAGENTS_EVIDENCE_TASK
if [ "\$owner" = "\$(uname -n):\$task" ]; then
    echo "native-evidence-remote: this task directory is the host's own, so the host would overwrite and clean it; run scripts/native-evidence here without --remote" >&2
    exit 3
fi
# Only build takes a name, so a mistyped status or fetch leaves none taken.
# The record is created exclusively: of two first builds, one gets it.
if [ "\${claim:-}" = true ] && [ ! -e "\$owner_record" ] && [ ! -e "\$task" ]; then
    mkdir -p -- "\${owner_record%/*}"
    (set -C; printf '%s\\n' "\$owner" >"\$owner_record") 2>/dev/null || :
fi
if [ -e "\$owner_record" ]; then
    if [ "\$(cat -- "\$owner_record")" != "\$owner" ]; then
        echo "native-evidence-remote: task \$name on \$(uname -n) belongs to \$(cat -- "\$owner_record"); give this task directory another name" >&2
        exit 3
    fi
elif [ -e "\$task" ]; then
    # Such as a task someone runs on the host directly, in the same place,
    # or one this route started before tasks had owners.
    claim_it=\$(printf 'mkdir -p -- %q && printf %q %q >%q' "\${owner_record%/*}" '%s\\n' "\$owner" "\$owner_record")
    echo "native-evidence-remote: \$task on \$(uname -n) is not a task this route started; give this task directory another name, or, if an earlier version of this route started it for you, claim it there with: \$claim_it" >&2
    exit 3
fi
# In cli and env arguments, {fixture} stands for the fixture's root, in a
# forwarded command and a steps file alike.
evidence() {
    local command=\$1
    shift
    case \$command in
        cli | env) set -- "\${@//\{fixture\}/\$task/fixture}" ;;
    esac
    "\$tool/scripts/native-evidence" --task "\$task" "\$command" "\$@"
}
PRELUDE
)

mkdir -p -- "$task/shots"

# A commit holding exactly what a checkout's working tree holds, tracked or
# not, without touching its index, branch or files. A clean checkout is its HEAD.
snapshot() {
    local checkout=$1 head index tree date
    head=$(git -C "$checkout" rev-parse --verify HEAD^{commit}) ||
        die "$checkout has no commit to start from"
    if [ -z "$(git -C "$checkout" --no-optional-locks status --porcelain=v1 --untracked-files=all)" ]; then
        printf '%s\n' "$head"
        return
    fi
    index=$(mktemp)
    # This runs in a command substitution, so the trap is its own; it names
    # the file itself, as the function's variable is gone by then.
    trap "rm -f -- $(printf '%q' "$index")" EXIT
    # A copy of its index, so unchanged files need no rehashing.
    cp -- "$(git -C "$checkout" rev-parse --path-format=absolute --git-path index)" "$index" 2>/dev/null || :
    GIT_INDEX_FILE=$index git -C "$checkout" add --all &&
        tree=$(GIT_INDEX_FILE=$index git -C "$checkout" write-tree) || {
        rm -f -- "$index"
        die "could not record the uncommitted state of $checkout"
    }
    rm -f -- "$index"
    # Dated as HEAD is, so the same files make the same commit, and a checkout
    # on the host already at it is left as it is.
    date="@$(git -C "$checkout" show -s --format=%ct "$head") +0000"
    GIT_AUTHOR_NAME=native-evidence GIT_AUTHOR_EMAIL=native-evidence@localhost GIT_AUTHOR_DATE=$date \
        GIT_COMMITTER_NAME=native-evidence GIT_COMMITTER_EMAIL=native-evidence@localhost GIT_COMMITTER_DATE=$date \
        git -C "$checkout" commit-tree "$tree" -p "$head" -m "native-evidence: uncommitted state of $checkout"
}

# Resolves SOURCE to the checkout that sends it and the commit it is.
resolve_source() {
    local source=$1
    if [ -d "$source" ]; then
        source_checkout=$(cd -- "$source" && pwd -P)
        source_commit=$(snapshot "$source_checkout")
        source_head=$(git -C "$source_checkout" rev-parse HEAD)
    else
        # A revision of the repository this was run from.
        source_checkout=$(git rev-parse --show-toplevel 2>/dev/null) || source_checkout=$tool_root
        source_commit=$(git -C "$source_checkout" rev-parse --verify --quiet "$source^{commit}") ||
            die "$source is neither a directory nor a revision in $source_checkout"
        source_head=$source_commit
    fi
}

# Puts COMMIT in a detached checkout on HOST, .worktrees/cev-NAME-ROLE, made
# exactly that commit: untracked files left by an earlier copy are removed.
sync_checkout() {
    local role=$1 checkout=$2 commit=$3
    git -C "$checkout" -c core.sshCommand="$git_ssh" push --quiet --force --no-verify "ssh://$host$repository" \
        "$commit:refs/native-evidence/$name/$role" ||
        die "could not copy $commit to $host:$repository"
    on_host "$remote_prelude"'
        role=$1 commit=$2
        checkout=$repository/.worktrees/cev-$name-$role
        if [ -e "$checkout/.git" ]; then
            git -C "$checkout" checkout --quiet --detach --force "$commit"
            git -C "$checkout" clean -fdq
        else
            git -C "$repository" worktree prune
            git -C "$repository" worktree add --quiet --detach "$checkout" "$commit"
        fi
        # Its Zig pin applies only once mise trusts it; the files are this commit.
        if [ -e "$checkout/mise.toml" ] && command -v mise >/dev/null 2>&1; then
            mise trust --quiet "$checkout/mise.toml" >/dev/null 2>&1 || :
        fi
        printf "%s\n" "$checkout"
    ' "$role" "$commit"
}

sync_tool() {
    tool_checkout=$(sync_checkout tool "$tool_source" "$tool_commit")
}

# What a checkout's working tree holds, as a Git tree.
tree_of() {
    git -C "$1" rev-parse "$(snapshot "$1")^{tree}"
}

# What the host's native-evidence, a copy of the tool's, builds from
# CHECKOUT: one build's arguments per line, its executable last. They depend
# on the checkout's layout, so they are asked for from within it.
build_arguments() {
    (cd -- "$1" && "$tool_source/scripts/native-evidence" __build-arguments)
}

# Whether the caller changed how Rust compiles, as a measurement does with
# RUSTFLAGS or a CARGO_PROFILE_* setting. Main's prebuilt executables were
# built without either, so such a build compiles its own.
build_environment_changed() {
    local name
    [ -z "${RUSTFLAGS-}${CARGO_ENCODED_RUSTFLAGS-}${CARGO_BUILD_RUSTFLAGS-}" ] || return 0
    for name in $(compgen -e); do
        [[ $name != CARGO_PROFILE_* ]] || return 0
    done
    return 1
}

# Builds what native-evidence runs from CHECKOUT's own gate, into its own
# target and the build host's slot for it, as `mise run dev` does: what that
# already built is reused, and Cargo rebuilds only what changed since. The
# build must be of TREE, what the host is given.
build_in_checkout() {
    local checkout=$1 tree=$2 metadata directory
    evidence_arguments=$(build_arguments "$checkout") && [ -n "$evidence_arguments" ] ||
        die "could not ask $tool_source what native-evidence builds"
    [ "$(tree_of "$checkout")" = "$tree" ] || die "$checkout changed while it was copied; build it again"
    # One slot for the three, as scripts/run-development holds it. This
    # tool's scripts/cargo-lane runs the checkout's gate, so its vendored
    # crates' warnings are counted, not shown, as the runner's are.
    # shellcheck disable=SC2016 # Expanded by the inner shell.
    (cd -- "$checkout" && scripts/cargo-gate exec --hold bash -ec '
        lane=$1 gate=$2
        while IFS= read -r arguments; do
            # Deliberately one word per argument.
            "$lane" --allow-warnings --gate "$gate" build $arguments
        done <<<"$3"
    ' build-evidence "$tool_root/scripts/cargo-lane" "$checkout/scripts/cargo-gate" "$evidence_arguments") ||
        die "could not build $checkout; see the build's messages above"
    [ "$(tree_of "$checkout")" = "$tree" ] || die "$checkout changed during its build; build it again"
    # Where the gate brought them, which Cargo's configuration may move.
    metadata=$(cd -- "$checkout" && cargo metadata --locked --format-version 1 --no-deps) ||
        die "could not find $checkout's Cargo target directory"
    directory=$(sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p' <<<"$metadata")
    [ -n "$directory" ] || die "could not find $checkout's Cargo target directory"
    built_executables=$directory/dev-runtime
}

# Sends the executables in DIRECTORY, which build_in_checkout built, to the
# task on HOST, for build's --executables; prints where they went. A side's
# earlier executables, or the other side's, are the basis for sending only
# what differs.
send_executables() {
    local side=$1 directory=$2 answer remote_task executables=() bases=() base
    answer=$(on_host "$remote_prelude"'
        # Made a task first, which only native-evidence does.
        "$tool/scripts/native-evidence" --task "$task" status >/dev/null
        printf "%s\n" "$task"
        for side in "$1" before after; do
            [ ! -d "$task/target-$side/dev-runtime" ] || printf "%s\n" "$task/target-$side/dev-runtime"
        done
    ' "$side") || die "could not prepare the task on $host"
    remote_task=$(head -n 1 <<<"$answer")
    while IFS= read -r base; do
        [[ " ${bases[*]} " == *" --copy-dest=$base "* ]] || bases+=("--copy-dest=$base")
    done < <(tail -n +2 <<<"$answer")
    local executable
    while IFS= read -r executable; do
        executables+=("$directory/${executable##* }")
    done <<<"$evidence_arguments"
    # What they were built with, which the host checks against its own.
    mkdir -p -- "$task/upload"
    printf '%s\n' "$evidence_arguments" >"$task/upload/arguments"
    executables+=("$task/upload/arguments")
    rsync --perms --compress --mkpath -e "${ssh_command[*]}" "${bases[@]}" \
        -- "${executables[@]}" "$host:$remote_task/upload-$side/" ||
        die "could not send the executables to $host"
    printf '%s\n' "$remote_task/upload-$side"
}

# Brings back the task's shots directory, manifest included.
fetch_shots() {
    on_host "$remote_prelude"'
        [ -d "$task/shots" ] || exit 0
        tar -C "$task/shots" -cf - .
    ' >"$task/.shots.tar" || {
        rm -f -- "$task/.shots.tar"
        die "could not bring back the shots from $host"
    }
    # Nothing comes back from a host with no shots yet.
    if [ -s "$task/.shots.tar" ]; then
        tar -C "$task/shots" -xf "$task/.shots.tar"
    fi
    rm -f -- "$task/.shots.tar"
}

# Forwards a native-evidence command.
forward() {
    on_host "$remote_prelude"'
        [ -x "$tool/scripts/native-evidence" ] ||
            { echo "native-evidence-remote: nothing is built for this task on this host yet; run build first" >&2; exit 1; }
        evidence "$@"
    ' "$@"
}

record_source() {
    local side=$1 sources=$task/sources.tsv
    {
        grep -v "^$side"$'\t' "$sources" 2>/dev/null || :
        printf '%s\t%s\t%s\t%s\n' "$side" "$source_checkout" "$source_head" "$source_commit"
    } >"$sources.new"
    mv -- "$sources.new" "$sources"
}

cmd_build() {
    local side=${1:-} source=${2:-} checkout build_options=()
    case $side in before | after) ;; *) die 'side must be before or after' 2 ;; esac
    [ -n "$source" ] || die 'build needs a checkout or revision' 2
    shift 2
    while [ "$#" -gt 0 ]; do
        case $1 in
            --integrated) build_options+=("$1"); shift ;;
            *) die "unknown build option: $1" 2 ;;
        esac
    done
    resolve_source "$source"
    tool_commit=$(snapshot "$tool_source")
    # Take the task's name on the host, or be refused, before anything is
    # sent there; and not while a session runs from what would be rewritten.
    local running=0 prebuilt=false answer
    answer=$(on_host "claim=true
$remote_prelude"'
        # Executables the sentinel here built of a main commit, which
        # native-evidence here takes instead of building.
        [ ! -f "$HOME/.local/state/cagents-main-sentinel/builds/$2/arguments" ] || echo prebuilt
        [ -x "$tool/scripts/native-evidence" ] || exit 0
        # Read whole: grep -q would end the pipe early, and status, killed
        # by SIGPIPE under pipefail, would read as no session.
        status=$(evidence status 2>/dev/null) || :
        running=$(sed -n "s/^session: \([a-z]*\),.*/\1/p" <<<"$status")
        [ -n "$running" ] || exit 0
        [ "$running" != "$1" ] || exit 10
        # A side that runs from the tool checkout, which the build updates.
        if [ "$(sed -n 1p "$task/target-$running/evidence-source" 2>/dev/null)" = "$(cd -- "$tool" && pwd -P)" ] &&
            [ "$(git -C "$tool" rev-parse HEAD)" != "$3" ]; then
            exit 11
        fi
    ' "$side" "$source_commit" "$tool_commit") || running=$?
    [ "$answer" != prebuilt ] || build_environment_changed || prebuilt=true
    case $running in
        0) ;;
        10) die "the $side side is running on $host; stop it before rebuilding what it was started from: scripts/native-evidence --remote $host --task $task stop" ;;
        11) die "a session on $host runs from this tool's checkout, which has changed since; stop it before building: scripts/native-evidence --remote $host --task $task stop" ;;
        255) die "could not reach $host over ssh, or it lost the connection" 255 ;;
        *) exit "$running" ;;
    esac
    sync_tool
    local options=()
    # Built here and main's prebuilt executables are browserless; the
    # integrated lane compiles on HOST.
    if [ -d "$source" ] && [ "$prebuilt" = false ] && [ "${#build_options[@]}" -eq 0 ]; then
        build_in_checkout "$source_checkout" "$(git -C "$source_checkout" rev-parse "$source_commit^{tree}")"
        options=(--executables "$(send_executables "$side" "$built_executables")")
    fi
    if [ -d "$source" ] && [ "$source_checkout" = "$(cd -- "$tool_source" && pwd -P)" ] &&
        [ "$(git -C "$source_checkout" rev-parse "$source_commit^{tree}")" = "$(git -C "$source_checkout" rev-parse "$tool_commit^{tree}")" ]; then
        # The tool's own checkout already holds this source.
        checkout=$tool_checkout
        source_commit=$tool_commit
    else
        checkout=$(sync_checkout "$side" "$source_checkout" "$source_commit")
    fi
    if [ "$source_commit" != "$source_head" ]; then
        printf 'copied %s with its uncommitted changes as %s\n' "$source_checkout" "$source_commit"
    fi
    local built=0
    forward build "$side" "$checkout" "${options[@]}" "${build_options[@]}" || built=$?
    if [ "$built" -ne 0 ]; then
        # What was sent for it is no use to the next build.
        [ "${#options[@]}" -eq 0 ] || on_host "$remote_prelude"'
            rm -rf -- "$task/upload-$1"' "$side" || :
        exit "$built"
    fi
    record_source "$side"
}

# Removes everything this task keeps on HOST: its session, if any, its
# checkouts, the refs that pinned their commits, and its task directory. The
# screenshots here stay.
cmd_clean() {
    on_host "$remote_prelude"'
        if [ -x "$tool/scripts/native-evidence" ] && ! evidence stop >/dev/null; then
            echo "native-evidence-remote: the session did not stop, so nothing was removed" >&2
            exit 1
        fi
        for role in before after tool; do
            checkout=$repository/.worktrees/cev-$name-$role
            [ ! -e "$checkout" ] || git -C "$repository" worktree remove --force "$checkout"
        done
        git -C "$repository" worktree prune
        git -C "$repository" for-each-ref --format="%(refname)" "refs/native-evidence/$name/" |
            while IFS= read -r ref; do git -C "$repository" update-ref -d "$ref"; done
        rm -rf -- "$task"
        rm -f -- "$owner_record"
    '
    printf 'removed task %s from %s; its shots here are kept in %s\n' "$name" "$host" "$task/shots"
}

cmd_pair() {
    local before='' after='' steps='' options=() build_options=()
    while [ "$#" -gt 0 ]; do
        case $1 in
            --before) before=${2:-}; shift 2 || die '--before needs a source' 2 ;;
            --after) after=${2:-}; shift 2 || die '--after needs a source' 2 ;;
            --steps) steps=${2:-}; shift 2 || die '--steps needs a file' 2 ;;
            --width | --height | --portal | --codex | --limit | --wait-lock | --instance | --startup-timeout | --daemon-trace)
                [ "$#" -ge 2 ] || die "$1 needs a value" 2
                options+=("$1" "$2")
                shift 2
                ;;
            --keep-state | --acp | --ui-trace | --workspace-trace | --projection-oracle | --ui-scoped-fixture | --wayland-debug | \
                --restore-existing-only | --launch-handshake) options+=("$1"); shift ;;
            --integrated) build_options+=("$1"); shift ;;
            --codex-executable)
                [ "$#" -ge 2 ] || die "$1 needs a value" 2
                options+=("$1" "$2")
                shift 2
                ;;
            *) die "unknown pair option: $1" 2 ;;
        esac
    done
    [ -n "$before" ] && [ -n "$after" ] && [ -n "$steps" ] ||
        die 'pair needs --before, --after and --steps' 2
    [ -f "$steps" ] || die "no steps file: $steps" 2
    cmd_build before "$before" "${build_options[@]}"
    cmd_build after "$after" "${build_options[@]}"
    local side status=0
    for side in before after; do
        printf 'running %s on %s\n' "$side" "$host"
        on_host "$remote_prelude"'
            side=$1 body=$2
            shift 2
            # A lost connection sends TERM; the session still stops.
            trap "evidence stop >/dev/null 2>&1 || :" EXIT
            trap "exit 143" TERM HUP
            evidence start "$side" "$@"
            steps=$task/steps-$side.sh
            printf "%s\n" "$body" >"$steps"
            # Its own Bash, so -e holds in it; a failed step still stops the
            # session, which releases the native lock.
            export -f evidence
            export tool task
            status=0
            SIDE=$side bash -euo pipefail "$steps" || status=$?
            trap - EXIT
            if ! stopped=$(evidence stop 2>&1); then
                printf "%s\n" "$stopped" >&2
                [ "$status" -ne 0 ] || status=1
            fi
            exit "$status"
        ' "$side" "$(cat -- "$steps")" "${options[@]}" || status=$?
        fetch_shots
        [ "$status" -eq 0 ] || die "the steps failed on the $side side (status $status); the shots taken so far are in $task/shots" "$status"
    done
    printf 'shots in %s\n' "$task/shots"
}

case $command in
    pair) cmd_pair "$@" ;;
    clean) cmd_clean ;;
    build) cmd_build "$@" ;;
    shot)
        [ "$#" -ge 1 ] || die 'shot needs a name' 2
        # The host's native-evidence checks the name and any options.
        forward shot "$@" >/dev/null
        fetch_shots
        side=$(forward status | sed -n 's/^session: \(before\|after\),.*/\1/p') || side=
        if [ -n "$side" ]; then
            printf '%s\n' "$task/shots/$side-$1.webp"
        else
            printf '%s\n' "$task/shots"
        fi
        ;;
    fetch) fetch_shots; printf '%s\n' "$task/shots" ;;
    where)
        on_host "$remote_prelude"'
            printf "host:     %s\n" "$(hostname)"
            printf "task:     %s\n" "$task"
            for role in tool before after; do
                checkout=$repository/.worktrees/cev-$name-$role
                [ -e "$checkout/.git" ] && printf "%-9s %s at %s\n" "$role:" "$checkout" "$(git -C "$checkout" rev-parse --short HEAD)"
            done
            :
        '
        ;;
    start | relaunch | open-window | stop | status | cli | env | drive | nested | save-seed | seed) forward "$command" "$@" ;;
    *) usage >&2; exit 2 ;;
esac
exit
}
