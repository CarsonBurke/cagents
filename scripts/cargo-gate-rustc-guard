#!/bin/sh
# Inside `scripts/cargo-gate exec COMMAND`, where Rust compiles on the build
# host, COMMAND's `cargo` leads back to the gate. Anything else that would
# compile Rust here meets this guard instead, in one of two roles:
#
# - RUSTC_WRAPPER, for a Cargo reached other than by that name (by path,
#   $CARGO, `rustup run` or `mise exec`). The wrapper the caller had, if any,
#   still runs.
# - `rustc` and `rustdoc` beside the gate's `cargo` on PATH, for a compiler run
#   directly. It runs the next one on PATH.
#
# Either way, it passes what only asks the compiler something, which Cargo's
# queries and `rustc -vV` do, and refuses anything else.
tool=${0##*/}

# Whether the compiler stops before compiling, as it does for its version,
# help, an explanation, or any print but those it prints while linking.
asks() {
    [ "$#" -gt 0 ] || return 0 # Without arguments, it prints its help.
    while [ "$#" -gt 0 ]; do
        case $1 in
            -V|-vV|-Vv|--version|-h|--help|--explain|--explain=*|-Chelp|-Zhelp|-Whelp)
                return 0 ;;
            -C|-Z|-W)
                [ "${2-}" != help ] || return 0 ;;
            --print)
                [ "$#" -ge 2 ] && asks_to_print "$2" && return 0 ;;
            --print=*)
                asks_to_print "${1#--print=}" && return 0 ;;
        esac
        shift
    done
    return 1
}
asks_to_print() {
    case ${1%%=*} in
        native-static-libs|link-args) return 1 ;;
    esac
}

if [ "$tool" = rustc ] || [ "$tool" = rustdoc ]; then
    if asks "$@"; then
        # The next one on PATH: not this guard under another directory.
        self=$(readlink -f -- "$0")
        rest=$PATH:
        while [ -n "$rest" ]; do
            entry=${rest%%:*}
            rest=${rest#*:}
            [ -n "$entry" ] || entry=.
            if [ -x "$entry/$tool" ] && [ ! -d "$entry/$tool" ] &&
                [ "$(readlink -f -- "$entry/$tool")" != "$self" ]; then
                exec "$entry/$tool" "$@"
            fi
        done
        printf '%s\n' "cargo-gate: no $tool on PATH besides cargo-gate's guard" >&2
        exit 127
    fi
    printf '%s\n' "cargo-gate: \`$tool\` run directly inside \`cargo-gate exec\` would compile on this host, where Rust compiles only through the gate; build with \`cargo\` by name, which builds on the build host" >&2
    exit 1
fi

# As RUSTC_WRAPPER: "$1" is the compiler, or a workspace wrapper before it.
if asks "$@"; then
    if [ -n "${CAGENTS_BUILD_EXEC_RUSTC_WRAPPER-}" ]; then
        exec "$CAGENTS_BUILD_EXEC_RUSTC_WRAPPER" "$@"
    fi
    exec "$@"
fi
printf '%s\n' "cargo-gate: Cargo inside \`cargo-gate exec\` was reached other than by the name \`cargo\` (by path, \$CARGO, rustup run or mise exec) and would compile on this host; run \`cargo\` by name, which builds on the build host, or here through the gate with CAGENTS_BUILD_REMOTE=local" >&2
exit 1
