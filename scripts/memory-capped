#!/usr/bin/python3 -I
"""Runs a command in a systemd scope with a memory limit, so a runaway dies
early instead of filling the host's memory and swap. Without a working scope
the command runs anyway, uncapped, with a note."""
import ctypes
import fcntl
import os
import shlex
import re
import signal
import stat
import subprocess
import sys
import time

PROGRAM = "memory-capped"
DEFAULT_MAX = "16G"
DEFAULT_SWAP_MAX = "4G"
USAGE = f"""usage: {PROGRAM} [--name NAME] [--slice SLICE] [--stop-leftovers] COMMAND [ARGUMENT...]

NAME is what to call COMMAND if it goes over the limit (default: its file name).
SLICE is the systemd slice its scope goes in, such as app-cagents-test.slice
(default: the user manager's).
--stop-leftovers stops whatever COMMAND left running in its scope once it
exits, such as a daemon a test started and never stopped, and names each
process on stderr and in $XDG_STATE_HOME/cagents/leftover-processes.log, so
the command that leaked it can be fixed.

Environment:
  CAGENTS_MEMORY_MAX       Memory limit for COMMAND and its children, such as
                           24G (default {DEFAULT_MAX}); 0 runs without a limit
  CAGENTS_MEMORY_SWAP_MAX  Swap they may use besides (default {DEFAULT_SWAP_MAX})

A command already under a memory limit, whether from this tool or a caller's own
scope, keeps that one. Over the limit, the whole scope is stopped and this exits
137. Interrupting this stops the scope too.
"""
UNITS = {"": 1, "K": 2**10, "M": 2**20, "G": 2**30, "T": 2**40}
PAGE = os.sysconf("SC_PAGE_SIZE")
FORWARDED = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)
PR_SET_PDEATHSIG = 1
UNIT_PREFIX = "cagents-capped-"
# Seconds a process the command left gets to end by itself.
LEFTOVER_GRACE = 1
LEFTOVER_LOG = "leftover-processes.log"
LEFTOVER_LOG_BYTES = 1024 * 1024
# A fixture or a nested session replaces these, which hides the user manager
# from systemd's tools. The command gets them back inside its scope.
MANAGER_VARIABLES = ("XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS")


def manager_environment():
    found = {key: value for key, value in os.environ.items() if key not in MANAGER_VARIABLES}
    return found | {"XDG_RUNTIME_DIR": f"/run/user/{os.getuid()}"}


def with_own_environment(command):
    """COMMAND as it would run with this process's variables, not the manager's."""
    settings = [f"{name}={os.environ[name]}" if name in os.environ else f"--unset={name}"
                for name in MANAGER_VARIABLES]
    return ["env", *sorted(settings, key=lambda setting: not setting.startswith("--")),
            "sh", "-c", 'exec "$@"', PROGRAM, *command]


def size(setting, default):
    text = os.environ.get(setting) or default
    match = re.fullmatch(r"([0-9]+)([KMGT]?)", text)
    if not match:
        print(f"{PROGRAM}: {setting} must be a size such as 16G: {text}", file=sys.stderr)
        raise SystemExit(2)
    # The kernel keeps whole pages, and the check below compares what it kept.
    return (int(match[1]) * UNITS[match[2]] + PAGE - 1) // PAGE * PAGE


def already_limited():
    """Whether this process's cgroup or one above it has a memory limit now, so
    that moving out would lift a stricter one. Being started under a limit
    wouldn't do: what starts in a scope of its own, such as a daemon and the
    sessions it runs, carries the environment but not the limit."""
    try:
        with open("/proc/self/cgroup") as file:
            group = next(line[3:].strip() for line in file if line.startswith("0::"))
    except (OSError, StopIteration):
        return False
    while group not in ("", "/"):
        try:
            with open(f"/sys/fs/cgroup{group}/memory.max") as file:
                if file.read().strip() != "max":
                    return True
        except OSError:
            pass
        group = os.path.dirname(group)
    return False


def run_as_is(command):
    # Python ignores these, and a command run directly wouldn't.
    for number in (signal.SIGPIPE, signal.SIGXFSZ):
        signal.signal(number, signal.SIG_DFL)
    try:
        os.execvp(command[0], command)
    except OSError as error:
        print(f"{PROGRAM}: {command[0]}: {error.strerror}", file=sys.stderr)
        return 127


def scope_command(unit, limit, swap, slice_=None):
    # systemd-run would otherwise expand $NAME and $$ in the command itself.
    return ["systemd-run", "--user", "--scope", "--quiet", "--expand-environment=no", *unit,
            *([f"--slice={slice_}"] if slice_ else []),
            f"--property=MemoryMax={limit}", f"--property=MemorySwapMax={swap}",
            "--property=OOMPolicy=stop", "--property=TimeoutStopSec=5", "--"]


def scope_limits_memory(limit, swap):
    """Whether a scope can be made here and its limit reaches its cgroup: no
    user manager or a manager without the memory controller can't enforce one."""
    report = 'cat "/sys/fs/cgroup$(sed -n "s/^0:://p" /proc/self/cgroup)/memory.max"'
    try:
        found = subprocess.run([*scope_command(["--collect"], limit, swap), "/bin/sh", "-c", report],
                               stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30,
                               env=manager_environment())
    except (OSError, subprocess.SubprocessError):
        return False
    return found.returncode == 0 and found.stdout.strip() == str(limit)


def follow_parent(parent):
    """A killed wrapper takes its command with it, as if it had exec'd."""
    ctypes.CDLL(None).prctl(PR_SET_PDEATHSIG, signal.SIGTERM)
    if os.getppid() != parent:
        os._exit(143)


def killed_in(group):
    """Whether the kernel has killed a process in cgroup GROUP for its memory
    limit, which it counts before the kill, or None once the group has gone."""
    try:
        with open(f"/sys/fs/cgroup{group}/memory.events") as file:
            events = dict(line.split() for line in file if line.strip())
    except (OSError, ValueError):
        return None
    return int(events.get("oom_kill", 0)) > 0


def went_over(unit, failed):
    """Whether the unit was stopped for going over its limit. A failed unit is
    left for no one to read. The process killed can be any in the scope, such
    as the tests a `cargo test` ran, whose parent then fails on its own, and
    the manager can hear of the kill after the command's parent does. So a
    command that failed asks the kernel while the scope's group remains, and
    otherwise waits, for a moment at most, until the manager has settled the
    unit: it records a kill before it finds the scope empty. Once a kill is
    known, the scope is first stopped, since what ignores SIGTERM in it can
    keep it stopping until the stop times out; either way, its failure is then
    reset."""
    deadline = time.monotonic() + (2 if failed else 0)
    over = False
    try:
        while True:
            shown = subprocess.run(["systemctl", "--user", "show", unit,
                                    "--property=Result,ActiveState,LoadState,ControlGroup"],
                                   stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30,
                                   env=manager_environment())
            state = dict(line.partition("=")[::2] for line in shown.stdout.splitlines())
            recorded = state.get("Result") == "oom-kill"
            settled = (state.get("LoadState") == "not-found"
                       or state.get("ActiveState") in ("inactive", "failed"))
            if failed and not over and state.get("ControlGroup"):
                killed = killed_in(state["ControlGroup"])
                if killed is False:
                    break  # The kernel killed nothing here: no need to wait.
                over = bool(killed)
            over = over or recorded
            if recorded or settled or time.monotonic() >= deadline:
                break
            time.sleep(0.05)
    except (OSError, subprocess.SubprocessError):
        pass
    if over:
        stop(unit)
    forget(unit)
    return over


def forget(unit):
    """Resets the unit's failure: the caller says what happened, and a failed
    unit would be left for no one to read."""
    try:
        subprocess.run(["systemctl", "--user", "reset-failed", unit], stdin=subprocess.DEVNULL,
                       capture_output=True, timeout=30, env=manager_environment())
    except (OSError, subprocess.SubprocessError):
        pass


def stop(unit):
    """Stops the unit, waiting for the stop to finish. Anything in it that
    ignores SIGTERM is killed once the stop times out, which fails the unit, so
    a caller that has said why it stopped forgets the unit afterwards, but not
    before what it says is known: the failure is what records a memory kill."""
    try:
        subprocess.run(["systemctl", "--user", "stop", unit], stdin=subprocess.DEVNULL,
                       capture_output=True, timeout=30, env=manager_environment())
    except (OSError, subprocess.SubprocessError):
        pass


def leftovers(unit):
    """The processes still in the unit's scope, each with its age in seconds
    and command line."""
    try:
        group = subprocess.run(["systemctl", "--user", "show", unit, "--property=ControlGroup", "--value"],
                               stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30,
                               env=manager_environment()).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return []
    if not group:
        return []  # The scope ended with its last process.
    found = []
    for directory, _, _ in os.walk(f"/sys/fs/cgroup{group}"):
        try:
            with open(os.path.join(directory, "cgroup.procs")) as file:
                pids = [int(line) for line in file]
        except OSError:
            continue
        for pid in pids:
            try:
                with open(f"/proc/{pid}/cmdline", "rb") as file:
                    arguments = [part.decode(errors="replace") for part in file.read().split(b"\0")[:-1]]
                with open(f"/proc/{pid}/stat") as file:
                    started = int(file.read().rsplit(")", 1)[1].split()[19])
                with open("/proc/uptime") as file:
                    uptime = float(file.read().split()[0])
            except (OSError, ValueError, IndexError):
                continue
            found.append((pid, round(uptime - started / os.sysconf("SC_CLK_TCK")), arguments))
    return found


def require_owned_log(info):
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
        raise OSError("not an owned regular log file")


def open_log(directory, name):
    flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NONBLOCK | os.O_NOFOLLOW
    return os.fdopen(os.open(name, flags, 0o600, dir_fd=directory), "ab")


def record_leftovers(unit, name, lines):
    """Keep the active log and one rotated file, with at most 1 MiB each."""
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    root = os.path.join(state, "cagents")
    try:
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        record = (f"{stamp} {unit} in {os.getcwd()}: {name}\n"
                  + "".join(f"  {line}\n" for line in lines)).encode(errors="backslashreplace")
        if len(record) > LEFTOVER_LOG_BYTES:
            omitted = b"  [additional process details omitted]\n"
            end = record.rfind(b"\n", 0, LEFTOVER_LOG_BYTES - len(omitted))
            record = record[:end + 1] + omitted
        os.makedirs(root, mode=0o700, exist_ok=True)
        directory = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            # Lock a separate inode so another new writer never acquires the
            # lock on a log that is about to become the rotated copy.
            with open_log(directory, LEFTOVER_LOG + ".lock") as lock:
                require_owned_log(os.fstat(lock.fileno()))
                fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                with open_log(directory, LEFTOVER_LOG) as log:
                    info = os.fstat(log.fileno())
                    require_owned_log(info)
                    if info.st_size > LEFTOVER_LOG_BYTES:
                        # A log from an older tool can already exceed the
                        # limit. Start a bounded generation on this write.
                        log.truncate(0)
                    elif info.st_size + len(record) > LEFTOVER_LOG_BYTES:
                        # The last generation remains readable if the new
                        # current file cannot be created after the rename.
                        previous = LEFTOVER_LOG + ".1"
                        try:
                            require_owned_log(os.stat(previous, dir_fd=directory, follow_symlinks=False))
                        except FileNotFoundError:
                            pass
                        os.replace(LEFTOVER_LOG, previous, src_dir_fd=directory, dst_dir_fd=directory)
                        with open_log(directory, LEFTOVER_LOG) as current:
                            require_owned_log(os.fstat(current.fileno()))
                            current.write(record)
                        return
                    log.write(record)
        finally:
            os.close(directory)
    except OSError:
        pass


def stop_leftovers(unit, name):
    """Stops what the command left in its scope, saying what that was. A
    process already on its way out gets a moment to finish."""
    deadline = time.monotonic() + LEFTOVER_GRACE
    while (left := leftovers(unit)) and time.monotonic() < deadline:
        time.sleep(0.1)
    if not left:
        return
    lines = [f"pid {pid}, up {age}s: {shlex.join(arguments) or '?'}" for pid, age, arguments in left]
    them = "them" if len(left) > 1 else "it"
    print(f"{PROGRAM}: {name} left {len(left)} process{'es' if len(left) > 1 else ''} running "
          f"after it exited; stopping {them}. Whatever started {them} should stop {them}:", file=sys.stderr)
    for line in lines:
        print(f"{PROGRAM}:   {line}", file=sys.stderr)
    record_leftovers(unit, name, lines)
    stop(unit)
    forget(unit)


def amount(size):
    return f"{size // 2**30} GiB" if size % 2**30 == 0 else f"{size // 2**20} MiB"


def over_limit_notice(name, limit, swap):
    """This can appear where a person expects a working app, so it says what
    happened and what to do, and doesn't read as the app crashing by itself."""
    larger = limit * 2 // 2**20
    setting = f"{larger // 2**10}G" if larger % 2**10 == 0 else f"{larger}M"
    return (f"{PROGRAM}: stopped {name} because it and the processes it started went over the "
            f"limit of {amount(limit)} of memory and {amount(swap)} of swap. This is the limit "
            "acting, not a crash. If this is normal use rather than a runaway, run it again with "
            f"a higher limit, such as CAGENTS_MEMORY_MAX={setting}.")


def end_as(status):
    """Ends as the command did, so a calling script stops on Ctrl-C too."""
    if status >= 0:
        return status
    if -status in FORWARDED:
        signal.signal(-status, signal.SIG_DFL)
        os.kill(os.getpid(), -status)
    return 128 - status


def main():
    command = sys.argv[1:]
    name = slice_ = None
    stop_left = False
    while command[:1] in (["--name"], ["--slice"], ["--stop-leftovers"]):
        if command[0] == "--stop-leftovers":
            stop_left, command = True, command[1:]
            continue
        if len(command) < 3:
            print(USAGE, end="", file=sys.stderr)
            return 2
        if command[0] == "--name":
            name = command[1]
        else:
            slice_ = command[1]
        command = command[2:]
    if not command or command[0] in ("-h", "--help"):
        print(USAGE, end="", file=sys.stdout if command else sys.stderr)
        return 0 if command else 2
    limit = size("CAGENTS_MEMORY_MAX", DEFAULT_MAX)
    swap = size("CAGENTS_MEMORY_SWAP_MAX", DEFAULT_SWAP_MAX)
    if limit == 0 or already_limited():
        return run_as_is(command)
    if not scope_limits_memory(limit, swap):
        print(f"{PROGRAM}: no systemd scope can limit memory here; running without a limit",
              file=sys.stderr)
        return run_as_is(command)
    unit = f"{UNIT_PREFIX}{os.getpid()}-{time.monotonic_ns()}.scope"
    parent = os.getpid()
    # The command runs as this child: systemd-run execs it after making the scope.
    child = subprocess.Popen([*scope_command([f"--unit={unit}"], limit, swap, slice_),
                              *with_own_environment(command)],
                             env=manager_environment(), close_fds=False,
                             preexec_fn=lambda: follow_parent(parent))
    interrupted = []

    def forward(sent, _frame):
        interrupted.append(sent)
        child.send_signal(sent)

    for number in FORWARDED:
        signal.signal(number, forward)
    status = child.wait()
    if interrupted:
        # Whatever ignored the signal, such as a compositor, goes with the scope,
        # whose failure went_over reads before it forgets the unit.
        stop(unit)
    if went_over(unit, status != 0):
        print(over_limit_notice(name or os.path.basename(command[0]), limit, swap), file=sys.stderr)
        return 137
    if stop_left and not interrupted:
        stop_leftovers(unit, name or shlex.join(command))
    return end_as(status)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(end_as(-signal.SIGINT))
