#!/bin/sh
# Dedicated actual-UI release workload; never use workstation timings as CI gates.
set -eu
umask 077
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
usage() {
    printf '%s\n' 'Usage: sh scripts/run-redraw-latency [NEW_PRIVATE_OUTPUT_DIRECTORY]' \
        '       sh scripts/run-redraw-latency --scroll' >&2
}
# The terminal scroll workload for issue #101 is deterministic and runs in
# process: it needs no compositor, no daemon and no release build, so it is
# served here instead of through the five fresh-process UI runs below. It
# reports what one viewport scroll command costs and therefore what applying
# one coalesced move per frame saves over applying every wheel notch.
if [ "${1-}" = '--scroll' ]; then
    [ "$#" -eq 1 ] || { usage; exit 2; }
    command -v cargo >/dev/null 2>&1 || { printf '%s\n' 'Required command unavailable: cargo' >&2; exit 1; }
    exec cargo test --locked --no-default-features --features host --lib -- \
        --exact --nocapture \
        terminal::worker::tests::coalescing_a_frame_of_notches_costs_one_capture_and_lands_on_the_same_screen
fi
if [ "$#" -gt 1 ]; then
    usage
    exit 2
fi
for command in cargo jq timeout mktemp; do
    command -v "$command" >/dev/null 2>&1 || { printf '%s\n' "Required command unavailable: $command" >&2; exit 1; }
done
: "${XDG_RUNTIME_DIR:?Run inside a graphical desktop session}"
if [ -z "${XAUTHORITY-}" ] && [ -f "$HOME/.Xauthority" ]; then
    XAUTHORITY=$HOME/.Xauthority
    export XAUTHORITY
fi
# Preserve the real compositor connection while isolating application locks/state.
case ${WAYLAND_DISPLAY-} in
    '')
        if [ -S "$XDG_RUNTIME_DIR/wayland-0" ]; then
            WAYLAND_DISPLAY=$XDG_RUNTIME_DIR/wayland-0
            export WAYLAND_DISPLAY
        fi
        ;;
    /*) ;;
    *) WAYLAND_DISPLAY=$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY; export WAYLAND_DISPLAY ;;
esac
revision=$(git rev-parse HEAD)
if git diff --quiet && git diff --cached --quiet; then dirty=false; else dirty=true; fi
if [ "$#" -eq 1 ]; then
    mkdir -m 700 -- "$1"
    output=$(CDPATH= cd -- "$1" && pwd)
else
    output=$(mktemp -d /tmp/cagents-redraw-latency.XXXXXXXX)
fi
# Keep the three implementation feature graphs isolated, as in run-development.
cargo build --locked --release --no-default-features --features development --bin cagents
cargo build --locked --release --no-default-features --features development,host --bin cagentsd
cargo build --locked --release --no-default-features --features development,latency-harness --bin cagents-ui
target=$(cargo metadata --locked --no-deps --format-version 1 | jq -er '.target_directory')
cli=$target/release/cagents
ui=$target/release/cagents-ui
sandbox=$(mktemp -d /tmp/cagents-latency-runtime.XXXXXXXX)
cleanup() {
    if [ -n "${active_runtime-}" ]; then
        XDG_RUNTIME_DIR=$active_runtime "$cli" daemon stop-for-rebuild >/dev/null 2>&1 || :
    fi
    rm -rf -- "$sandbox"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
export CAGENTS_LATENCY_REVISION=$revision CAGENTS_LATENCY_DIRTY=$dirty
# Tracing can contain content. Do not write UI/daemon logs into measurement output.
export RUST_LOG=off
run=1
while [ "$run" -le 5 ]; do
    base=$sandbox/$run
    mkdir -p -m 700 "$base/home" "$base/runtime" "$base/config" "$base/data" "$base/cache" "$base/state"
    export HOME=$base/home XDG_RUNTIME_DIR=$base/runtime XDG_CONFIG_HOME=$base/config
    export XDG_DATA_HOME=$base/data XDG_CACHE_HOME=$base/cache XDG_STATE_HOME=$base/state
    active_runtime=$base/runtime
    export CAGENTS_LATENCY_RUN=$run CAGENTS_LATENCY_OUTPUT=$output/run-$run.json
    if ! timeout --signal=TERM --kill-after=5s 120s "$ui" >/dev/null 2>&1; then
        printf '%s\n' "Latency UI run $run failed or timed out; no baseline accepted." >&2
        exit 1
    fi
    "$cli" daemon stop-for-rebuild >/dev/null 2>&1 || :
    active_runtime=
    jq -e --argjson run "$run" '
        .schema_version == 1 and .metric == "redraw_scheduling" and
        .manifest.run == $run and .manifest.build_mode == "release-browserless" and
        (.samples | length) == 256 and .summary.redraw_scheduled == 256 and .summary.abandoned == 0 and
        all(.samples[]; .action == "card_focus" and .outcome == "redraw_scheduled" and (.redraw_scheduling_ns | type) == "number")
    ' "$output/run-$run.json" >/dev/null
    run=$((run + 1))
done
jq -s '
    def percentile($p): .[(((length - 1) * $p / 100) | ceil)];
    ([.[].samples[].redraw_scheduling_ns] | sort) as $samples |
    {schema_version: 1, metric: "redraw_scheduling", action: "card_focus", fresh_process_runs: length,
     samples: ($samples | length), median_ns: ($samples | percentile(50)),
     p95_ns: ($samples | percentile(95)), p99_ns: ($samples | percentile(99)), worst_ns: ($samples | last),
     budgets_gating: false, provisional_p95_ns: 50000000, provisional_p99_ns: 100000000}
' "$output/run-1.json" "$output/run-2.json" "$output/run-3.json" "$output/run-4.json" "$output/run-5.json" >"$output/summary.json"
jq '.manifest | del(.run) | .fresh_process_runs = 5' "$output/run-1.json" >"$output/reference-manifest.json"
cp fixtures/redraw-scheduling.schema.json "$output/raw-sample.schema.json"
printf '%s\n' 'Five fresh-process redraw-scheduling runs completed (non-gating).'
cat "$output/summary.json"
# The private output path is intentionally not part of the exported artifacts.
