#!/bin/sh
# Run only disposable fixture processes in an unprivileged, networkless rootfs.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
command -v bwrap >/dev/null || { printf '%s\n' 'bubblewrap is required' >&2; exit 1; }
exec bwrap --unshare-user --uid 0 --gid 0 --unshare-net --unshare-pid \
    --setenv TMPDIR /tmp \
    --ro-bind /usr /host/usr --dir /usr \
    --symlink /host/usr/bin /usr/bin --symlink /host/usr/lib /usr/lib \
    --symlink /host/usr/share /usr/share --symlink /host/usr/bin /usr/sbin \
    --dir /usr/libexec --symlink usr/bin /bin --symlink usr/lib /lib \
    --symlink usr/lib /lib64 --proc /proc --dev /dev --tmpfs /tmp \
    --dir /var/lib --ro-bind "$root/packaging/cagents-package-lifecycle" /guard-template \
    -- /bin/sh -eu -c '
make_guard() {
    sed -e "s/@MODE@/$1/g" -e "s/@PROTOCOL_VERSION@/$2/g" \
        -e "s/@PACKAGE_NAME@/cagents/g" -e "s/@OTHER_PACKAGE@/cagents-browserless/g" \
        /guard-template > /tmp/guard
}
run_guard() {
    expected=$1
    shift
    result=0
    sh /tmp/guard "$@" || result=$?
    [ "$result" -eq "$expected" ] || {
        printf "expected=%s actual=%s\n" "$expected" "$result" >&2
        exit 1
    }
    for pid in $pids; do kill -0 "$pid"; done
}
pids=
trap '\''for pid in $pids; do kill "$pid" 2>/dev/null || :; done'\'' EXIT
mkdir -p /usr/libexec/cagents
cp /usr/bin/sleep /usr/libexec/cagents/cagentsd
digest=$(sha256sum /usr/libexec/cagents/cagentsd)
digest=${digest%% *}
printf "3 %s\n" "$digest" > /usr/libexec/cagents/.cagents-daemon-protocol
chmod 0644 /usr/libexec/cagents/.cagents-daemon-protocol
make_guard upgrade 3
run_guard 0 upgrade
printf "empty upgrade: accepted\n"
for count in 1 2 3; do
    /usr/libexec/cagents/cagentsd 60 &
    pid=$!
    pids="$pids $pid"
    while [ "$(readlink /proc/$pid/exe)" != /usr/libexec/cagents/cagentsd ]; do sleep 0.01; done
    run_guard 0 upgrade
    printf "compatible upgrade: %s processes preserved\n" "$count"
done
# A second compatible upgrade must recognize a previously unlinked executable.
cp /usr/bin/true /usr/libexec/cagents/cagentsd.next
mv /usr/libexec/cagents/cagentsd.next /usr/libexec/cagents/cagentsd
run_guard 0 upgrade
printf "repeated compatible upgrade: old executable proof retained\n"
make_guard upgrade 4
run_guard 1 upgrade
printf "incompatible upgrade: deferred, processes preserved\n"
make_guard remove 4
run_guard 0 upgrade
run_guard 1 remove
printf "outgoing upgrade script: no shutdown; removal: deferred\n"
rm /var/lib/cagents-package-protocols/*
# Simulate interrupted unpack: new metadata beside the old executable.
cp /usr/bin/sleep /usr/libexec/cagents/cagentsd
other_digest=$(sha256sum /usr/bin/true)
other_digest=${other_digest%% *}
printf "4 %s\n" "$other_digest" > /usr/libexec/cagents/.cagents-daemon-protocol
make_guard upgrade 4
run_guard 1 upgrade
printf "interrupted mixed-generation unpack: no false compatibility evidence\n"
rm /usr/libexec/cagents/.cagents-daemon-protocol
make_guard upgrade 3
run_guard 1 upgrade
printf "legacy unknown protocol: deferred\n"
for pid in $pids; do kill "$pid"; done
wait || :
pids=
make_guard remove 3
run_guard 0 remove
printf "removal after explicit stop: accepted\n"

# Exercise dpkg ordering, including the outgoing prerm before incoming preinst.
command -v dpkg >/dev/null
mkdir -p /var/lib/dpkg /tmp/package/DEBIAN /tmp/package/usr/libexec/cagents /home/fixture
touch /var/lib/dpkg/status
printf "keep\n" > /usr/libexec/unrelated-sentinel
printf "keep\n" > /home/fixture/user-data
build_package() {
    version=$1
    protocol=$2
    cp /usr/bin/sleep /tmp/package/usr/libexec/cagents/cagentsd
    printf "\nfixture-version-%s\n" "$version" >> /tmp/package/usr/libexec/cagents/cagentsd
    digest=$(sha256sum /tmp/package/usr/libexec/cagents/cagentsd)
    digest=${digest%% *}
    printf "%s %s\n" "$protocol" "$digest" > /tmp/package/usr/libexec/cagents/.cagents-daemon-protocol
    printf "Package: cagents\nVersion: %s\nArchitecture: amd64\nMaintainer: Fixture <fixture@example.invalid>\nDescription: isolated lifecycle fixture\n" "$version" > /tmp/package/DEBIAN/control
    make_guard upgrade "$protocol"
    cp /tmp/guard /tmp/package/DEBIAN/preinst
    make_guard remove "$protocol"
    cp /tmp/guard /tmp/package/DEBIAN/prerm
    chmod 0755 /tmp/package/DEBIAN/preinst /tmp/package/DEBIAN/prerm
    chmod 0644 /tmp/package/usr/libexec/cagents/.cagents-daemon-protocol
    dpkg-deb --root-owner-group --build /tmp/package "/tmp/cagents-$version.deb"
}
build_package 1 3
build_package 2 3
build_package 3 4
dpkg --install /tmp/cagents-1.deb
/usr/libexec/cagents/cagentsd 60 &
pid=$!
pids=$pid
while [ "$(readlink /proc/$pid/exe)" != /usr/libexec/cagents/cagentsd ]; do sleep 0.01; done
dpkg --install /tmp/cagents-2.deb
kill -0 "$pid"
if dpkg --install /tmp/cagents-3.deb; then
    printf "incompatible dpkg upgrade unexpectedly succeeded\n" >&2
    exit 1
fi
kill -0 "$pid"
if dpkg --remove cagents; then
    printf "dpkg removal unexpectedly terminated a running daemon\n" >&2
    exit 1
fi
kill -0 "$pid"
kill "$pid"
wait || :
pids=
dpkg --remove cagents
[ ! -e /usr/libexec/cagents/cagentsd ]
[ "$(cat /usr/libexec/unrelated-sentinel)" = keep ]
[ "$(cat /home/fixture/user-data)" = keep ]
printf "dpkg install/upgrade/defer/remove: process and unrelated data preserved\n"
'
