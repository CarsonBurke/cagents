#!/bin/sh
# rustfmt does not expand include! macros. Check their Rust sources explicitly
# as well as Cargo's crate roots; never rewrite files while checking them.
set -u

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit
cd "$root" || exit

cargo_status=0
cargo fmt --check || cargo_status=$?

# Keep this list in sync with Rust-source include! calls in src/, tests/ and
# crates/. Ordinary mod declarations below modules.rs are traversed by rustfmt,
# including feature-gated modules, without building any feature lane or vendor.
included_status=0
rustfmt --edition 2024 --check \
    src/modules.rs \
    src/terminal/worker/bounded_input_tests.rs \
    src/host/model/views/placement_tests.rs \
    tests/support/iced_tree.rs \
    tests/support/repository_scale.rs || included_status=$?

# Report both sets of diagnostics even when Cargo's check fails.
if [ "$cargo_status" -ne 0 ]; then
    exit "$cargo_status"
fi
exit "$included_status"
