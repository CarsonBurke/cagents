#!/usr/bin/python3
"""Check that no source reads provider credentials or calls provider services.

Provider credentials and service endpoints stay inside the explicit Claude
reset transport exception (src/account/probe/reset_transport.rs). Ordinary
account metadata and all other provider operations use the provider's own
client.

A tripwire, not a proof: a determined change can spell a needle so it does
not match. What it does catch is the ordinary way the rule gets broken, code
that names a provider's credential store, token fields or service hosts, so
that doing so takes a deliberate edit here. It reads source text only, so CI
runs it without compiling Rust.
"""

import argparse
import re
import sys
from pathlib import Path

# Everything that becomes or drives a cagents binary. Recorded fixtures are
# data a test reads, not code, and quote the services they came from.
ENTRIES = ("src", "tests", "crates", "examples", "scripts", "build.rs", "install.sh", "Cargo.toml")
CODE_EXTENSIONS = {".rs", ".sh", ".toml"}

# The one module allowed to discover credentials and call a provider.
RESET_TRANSPORT = "src/account/probe/reset_transport.rs"
ACCOUNTS = Path("src/account.rs")


def forbidden() -> list[str]:
    """Each needle is assembled at run time, so this file does not match
    itself."""
    return ["".join(parts) for parts in (
        # Credential stores and the fields inside them.
        ("claude", "AiOauth"),
        ("oauth", "Account"),
        (".credentials", ".json"),
        ("auth", ".json"),
        ("access", "Token"),
        ("refresh", "Token"),
        ("access", "_token"),
        ("refresh", "_token"),
        ("id", "_token"),
        ("OAUTH", "_TOKEN"),
        # Claude Code's entry in the system keyring.
        ("Claude Code", "-credentials"),
        # Omp's logins, kept in the same database as its usage record.
        ("auth_", "credential"),
        # Provider services, which only the providers' own clients call.
        ("anthropic", ".com"),
        ("claude.ai", "/api"),
        ("openai", ".com"),
        ("chatgpt", ".com"),
        ("backend-api", "/wham"),
    )]


def sources(root: Path) -> list[Path]:
    files = []
    for entry in ENTRIES:
        path = root / entry
        if path.is_file():
            files.append(path)
        elif path.is_dir():
            files.extend(file for file in sorted(path.rglob("*"))
                         if file.is_file() and (not file.suffix or file.suffix in CODE_EXTENSIONS))
    return files


def credential_variables(root: Path) -> list[str]:
    """The environment names `credential_overrides` removes from a managed
    account's launch. Quoting them exactly is how they are removed."""
    found = re.search(r"^pub fn credential_overrides\(provider: Provider\)[^{]*\{(.*?)^\}$",
                      (root / ACCOUNTS).read_text(), re.MULTILINE | re.DOTALL)
    if found is None:
        raise SystemExit(f"{ACCOUNTS}: credential_overrides not found")
    return re.findall(r'"([A-Z][A-Z0-9_]*)"', found.group(1))


def ends_with(file: Path, suffix: str) -> bool:
    return file.as_posix() == suffix or file.as_posix().endswith("/" + suffix)


def without_native_refresh_request(file: Path, text: str) -> str:
    """Only this complete boolean request expression is permitted. Reading
    that field or supplying credential values remains forbidden."""
    # The adapter sends the request, and its tests assert that it does.
    if ends_with(file, "src/chat/protocol/codex.rs") or ends_with(file, "src/chat/protocol/codex/tests.rs"):
        request = "".join(('json!({"refresh', 'Token":true})'))
        return text.replace(request, 'json!({"provider-refresh-option":true})')
    return text


def without_muse_sign_in_record(file: Path, text: str) -> str:
    """Muse's sign-in record may be named in exactly two ways. The probe
    fingerprints its metadata, never its contents, to learn whether a sign-in
    changed (#3539), and names it in one function. A native-evidence fixture
    writes and removes its own fake record under its fixture root, where no
    real sign-in lives. Any other mention, or these mentions in another file,
    is still a violation."""
    name = "".join(("auth", ".json"))
    if ends_with(file, "src/account/probe/inputs.rs"):
        # The whole of `muse_sign_in`'s answer, so a read wrapped around the
        # path is still a violation.
        allowed = f'Some(account.home_directory(environment)?.join("{name}"))'
    elif ends_with(file, "tests/fixtures/fixture-acp.sh") or ends_with(file, "scripts/native-evidence"):
        allowed = f'"$fixture/config/muse/{name}"'
    else:
        return text
    return text.replace(allowed, '"muse-sign-in-record"')


def permitted(file: Path, text: str, variables: list[str]) -> str:
    """The text with each named exception replaced by a neutral word."""
    # This documented Codex setting selects storage; naming it does not
    # access Omp's similarly named credential table.
    text = text.replace("cli_auth_credentials_store", "")
    # Exact quoted environment names are needed to remove inherited
    # credentials. This does not allow credential file fields, values,
    # endpoints, or arbitrary strings containing those names.
    for name in variables:
        text = text.replace(f'"{name}"', '"credential-variable-name"')
    # The Accounts install action opens this fixed documentation page in a
    # browser. It does not read credentials or call a service API.
    if ends_with(file, "crates/cagents-ui/src/app/account_ui.rs"):
        documentation = "".join(("https://developers.open", "ai.com/codex/cli/"))
        text = text.replace(f'"{documentation}"', '"install-documentation"')
    text = without_native_refresh_request(file, text)
    return without_muse_sign_in_record(file, text)


def problems(root: Path) -> list[str]:
    files = sources(root)
    if len(files) <= 50:
        return [f"found only {len(files)} sources under {root}, too few to mean anything"]
    variables = credential_variables(root)
    if not variables:
        return [f"{ACCOUNTS}: credential_overrides names no environment variables"]
    needles = forbidden()
    found = []
    for file in files:
        relative = file.relative_to(root)
        if relative.as_posix() == RESET_TRANSPORT:
            continue
        try:
            text = file.read_text()
        except (UnicodeDecodeError, OSError):
            continue
        text = permitted(relative, text, variables)
        found.extend(f"{relative} names {needle}" for needle in needles if needle in text)
    return found


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent,
                        help="repository to check (default: this checkout)")
    found = problems(parser.parse_args().root)
    for problem in found:
        print(problem, file=sys.stderr)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main())
