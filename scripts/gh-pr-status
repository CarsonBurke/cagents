#!/usr/bin/python3
"""Shared PR status without requiring an updated installed cagents CLI."""
import argparse
import contextlib
import email.utils
import fcntl
import fnmatch
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from urllib.parse import urlsplit

MAX_BYTES = 4 * 1024 * 1024
REFRESH = 120
BUILD_RETRY = 600
# Cache the status implementation, not every unrelated change to the app.
BUILD_INPUTS = ["src/github*", "src/control/gh.rs", "src/control.rs", "src/modules.rs",
                "src/secure_file.rs", "src/process*", "src/instance*",
                "Cargo.toml", "Cargo.lock", "build.rs", "rust-toolchain*", "mise.toml"]


def digest(*parts):
    result = hashlib.sha256()
    for part in parts:
        value = part if isinstance(part, bytes) else os.fsencode(part)
        result.update(len(value).to_bytes(8, "little"))
        result.update(value)
    return result.hexdigest()


def private(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
        raise OSError(f"Cache directory must be private and owned by this user: {path}")
    return path


@contextlib.contextmanager
def locked(path):
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
            raise OSError("Unsafe cache lock")
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        try:
            yield fd
        finally:
            # Release copies from unrelated forks on normal scope completion.
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


def load(path, with_time=False):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return ({}, 0) if with_time else {}
    with os.fdopen(fd, "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_BYTES:
            raise OSError("Invalid or oversized cache entry")
        data = stream.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise OSError("Oversized cache entry")
    try:
        result = json.loads(data)
        result = result if isinstance(result, dict) else {}
    except ValueError:
        result = {}
    return (result, int(info.st_mtime)) if with_time else result


def store(path, value):
    fd, name = tempfile.mkstemp(prefix=".pr-status-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(value, stream)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def git(root, *args):
    return subprocess.check_output(["git", "-C", str(root), *args], stderr=subprocess.PIPE)


def build_context(root, source_ref):
    common = Path(os.fsdecode(git(root, "rev-parse", "--path-format=absolute",
                                 "--git-common-dir").rstrip(b"\n"))).resolve()
    revision = git(root, "rev-parse", "--verify", "--end-of-options",
                   source_ref + "^{commit}").decode().strip()
    # ls-files-style path globs also include nested GitHub/process modules.
    files = git(root, "ls-tree", "-r", "-z", revision, "--", "src", "Cargo.toml",
                "Cargo.lock", "build.rs", "rust-toolchain.toml", "rust-toolchain", "mise.toml")
    relevant = [entry for entry in files.split(b"\0") if entry and any(
        fnmatch.fnmatchcase(os.fsdecode(entry.split(b"\t", 1)[1]), pattern)
        for pattern in BUILD_INPUTS)]
    key = digest("gh-pr-status-build-v1", sys.platform, os.uname().machine, *relevant)
    return common, revision, key


def build(common, revision, key):
    """A detached, single builder; it never contacts GitHub or installs the CLI."""
    root = private(common / "gh-pr-status")
    try:
        with locked(root / "build.lock") as build_flight:
            destination = private(root / key)
            binary = destination / "cagents"
            attempt = destination / "attempt.json"
            previous = load(attempt)
            if (binary.is_file() and os.access(binary, os.X_OK)) or (
                    previous.get("key") == key and previous.get("retry_at", 0) > time.time()):
                return
            store(attempt, {"key": key, "revision": revision,
                            "retry_at": int(time.time()) + BUILD_RETRY})
            primary = os.fsdecode(git(common, "worktree", "list", "--porcelain", "-z")
                                  .split(b"\0", 1)[0]).removeprefix("worktree ")
            source = Path(primary) / ".worktrees" / ("gh-pr-status-" + key)
            created = not source.exists()
            with (destination / "build.log").open("wb") as log:
                try:
                    if created:
                        subprocess.run(["git", "--git-dir", str(common), "worktree", "add",
                                        "--detach", str(source), revision], stdout=log,
                                       stderr=log, check=True)
                    elif (git(source, "rev-parse", "HEAD").decode().strip() != revision
                          or git(source, "status", "--porcelain").strip()):
                        raise OSError("Build snapshot changed; it was preserved")
                    command = [str(source / "scripts/cargo-gate"), "build", "--locked",
                               "--no-default-features", "--bin", "cagents",
                               "--message-format=json-render-diagnostics"]
                    products = set()
                    with subprocess.Popen(command, cwd=source, stdout=subprocess.PIPE,
                                          stderr=log, text=True, pass_fds=(build_flight,)) as child:
                        for line in child.stdout:
                            log.write(line.encode())
                            try:
                                message = json.loads(line)
                            except ValueError:
                                continue
                            target = message.get("target", {})
                            if (message.get("reason") == "compiler-artifact"
                                    and target.get("name") == "cagents"
                                    and "bin" in target.get("kind", [])
                                    and message.get("executable")):
                                products.add(message["executable"])
                        if child.wait():
                            raise OSError("cargo-gate build failed; see build.log")
                    if len(products) != 1:
                        raise OSError("Cargo did not report one cagents executable")
                    product = Path(products.pop())
                    if not product.is_absolute():
                        raise OSError("Cargo reported a relative executable")
                    subprocess.run([str(product), "gh", "pr-status", "--help"],
                                   stdout=log, stderr=log, check=True)
                    temporary = destination / "cagents.new"
                    shutil.copyfile(product, temporary)
                    temporary.chmod(0o700)
                    os.replace(temporary, binary)
                    store(destination / "source.json", {"revision": revision, "key": key})
                    store(attempt, {"key": key, "revision": revision, "retry_at": 0})
                except (OSError, subprocess.SubprocessError) as error:
                    log.write((str(error) + "\n").encode())
                    store(attempt, {"key": key, "revision": revision,
                                    "retry_at": int(time.time()) + BUILD_RETRY})
                finally:
                    if created and source.exists():
                        subprocess.run(["git", "--git-dir", str(common), "worktree", "remove",
                                        str(source)], stdout=log, stderr=log)
    except BlockingIOError:
        pass  # Another invocation already owns the builder.


def cached_cli(root, source_ref):
    common, revision, key = build_context(root, source_ref)
    cache = private(common / "gh-pr-status")
    binary = cache / key / "cagents"
    if binary.is_file() and os.access(binary, os.X_OK):
        return binary
    previous = load(cache / key / "attempt.json")
    if previous.get("key") != key or previous.get("retry_at", 0) <= time.time():
        # Build-only worker: callers do not wait for admission or compilation.
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "--build",
                          str(common), revision, key], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, close_fds=True)
    return None


def credentials():
    config = Path(os.environ.get("GH_CONFIG_DIR") or (
        Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "gh")).absolute()
    try:
        hosts = (config / "hosts.yml").read_bytes()
    except FileNotFoundError:
        hosts = b""
    parts = [os.fsencode(config), hosts]
    for name in ["GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN"]:
        parts.extend([name, "present", os.environ[name]] if name in os.environ else [name, "absent"])
    return digest(*parts)


def target(repository, hostname, number):
    parts = repository.split("/")
    if len(parts) == 2:
        parts[1] = parts[1].removesuffix(".git")
    if len(parts) != 2 or any(not re.fullmatch(r"[A-Za-z0-9_.-]+", p) or p in {".", ".."}
                              for p in parts):
        raise ValueError("Use --repo OWNER/REPOSITORY")
    url = urlsplit("https://" + hostname)
    host, port = url.hostname, url.port
    if (not host or url.username or url.password or url.path or url.query or url.fragment
            or not re.fullmatch(r"[A-Za-z0-9.-]+", host) or not 0 < number <= 2147483647):
        raise ValueError("Use a valid hostname and positive PR number")
    return {"repository": {"host": host.lower(), "port": None if port == 443 else port,
                           "owner": parts[0], "name": parts[1]},
            "number": number}


def authority(key):
    repo = key["repository"]
    return repo["host"] + (f':{repo["port"]}' if repo["port"] is not None else "")


def response(output):
    headers = {}
    while output.startswith(b"HTTP/"):
        match = re.search(rb"\r?\n\r?\n", output)
        if not match:
            raise ValueError("Incomplete GitHub response headers")
        headers = dict(line.decode().split(":", 1) for line in output[:match.start()].splitlines()[1:]
                       if b":" in line)
        headers = {name.lower(): value.strip() for name, value in headers.items()}
        output = output[match.end():]
    try:
        body = json.loads(output)
    except ValueError:
        body = None
    return headers, body if isinstance(body, dict) else {"message": "GitHub returned invalid JSON"}


def cooldown(headers, body, now):
    # Only transport headers and error fields, never titles/check names, pace reads.
    text = str(body.get("message", "")).lower()
    secondary = "secondary" in text or "abuse detection" in text
    retry = headers.get("retry-after")
    due = None
    if retry is not None:
        try:
            due = now + int(retry)
        except ValueError:
            due = int(email.utils.parsedate_to_datetime(retry).timestamp())
    elif secondary:
        due = now + 60
    rate_error = any(word in text for word in ["rate limit", "rate_limit", "rate-limited", "abuse detection"])
    primary = headers.get("x-ratelimit-remaining") == "0" or (
        rate_error and not secondary and retry is None and "x-ratelimit-reset" in headers
        and "x-ratelimit-remaining" not in headers)
    resource = headers.get("x-ratelimit-resource", "core")
    reset = int(headers.get("x-ratelimit-reset", now + 60)) if primary else 0
    if due is None and not primary and rate_error:
        return {"primary": {"core": now + 60}, "secondary": 0}
    return {"primary": {resource: max(reset, due or 0, now + 1)} if primary else {},
            "secondary": max(due or 0, 0)}


def snapshot(body, key):
    if body.get("number") != key["number"]:
        raise ValueError("GitHub returned a different PR")
    url = urlsplit(body["html_url"])
    repo = key["repository"]
    if (url.scheme != "https" or url.username or url.password or url.query or url.fragment
            or url.hostname != repo["host"] or (url.port or 443) != (repo["port"] or 443)
            or url.path.lower() != f'/{repo["owner"]}/{repo["name"]}/pull/{key["number"]}'.lower()):
        raise ValueError("GitHub returned a different PR target URL")
    pr = {"number": body["number"], "title": body["title"], "url": body["html_url"],
          "state": "MERGED" if body["merged"] else body["state"].upper(),
          "isDraft": body["draft"], "headRefName": body["head"]["ref"],
          "headRefOid": body["head"]["sha"], "baseRefName": body["base"]["ref"],
          "mergeable": {True: "MERGEABLE", False: "CONFLICTING", None: "UNKNOWN"}[body["mergeable"]],
          "mergeStateStatus": (body.get("mergeable_state") or "unknown").upper(),
          "reviewDecision": None, "updatedAt": body["updated_at"]}
    return {"pull_request": pr, "checks_state": None, "checks": [],
            "checks_complete": False, "primary_cost": None}


def rest(key):
    """One read, sharing the Rust CLI's cache/flight/credential/cooldown format."""
    base = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    if not base.is_absolute():
        base = Path.home() / ".local/state"
    root = private(base / "cagents/github-status")
    credential = credentials()

    def checked(value):
        if credentials() != credential:
            raise ValueError("GitHub credentials changed while reading status; result discarded")
        return value

    repo = key["repository"]
    host = authority(key)
    name = digest("pr-status-v1", credential, host, repo["owner"].lower(),
                  repo["name"].lower(), str(key["number"]))
    path = root / (name + ".json")
    retry_path = root / (name + ".rest-retry")
    at = int(time.time())
    saved = load(path)
    rest_due = load(retry_path).get("retry_at", 0)
    try:
        with locked(root / (name + ".lock")) as flight:
            saved, published = load(path, with_time=True)
            rest_due = load(retry_path).get("retry_at", 0)
            next_attempt = saved.get("next_attempt", 0)
            # Older Rust caches bind a long failed-attempt deadline to its
            # GraphQL read. That deadline must not exhaust available REST.
            graphql_pause = saved.get("error") and next_attempt > at + REFRESH
            shared_due = min(next_attempt, published + REFRESH) if graphql_pause else next_attempt
            if shared_due > at:
                return checked({**saved, "next_attempt": max(shared_due, rest_due)})
            if rest_due > at:
                return checked({**saved, "error": "GitHub REST cooldown is active", "next_attempt": rest_due})
            budget_name = digest("host-v2", credential, host)
            budget_lock = root / (budget_name + ".lock")
            budget_path = root / (budget_name + ".cooldown")
            with locked(budget_lock):
                budget = load(budget_path)
                due = max(budget.get("secondary", 0), budget.get("primary", {}).get("core", 0))
            if due > at:
                return checked({**saved, "error": "GitHub REST cooldown is active", "next_attempt": due})
            # Interrupted attempts also suppress a burst of follow-up requests.
            saved.update(error="GitHub REST read in progress", next_attempt=at + REFRESH)
            store(path, saved)
            env = dict(os.environ, GH_PROMPT_DISABLED="1", GH_PAGER="cat", NO_COLOR="1",
                       GH_SPINNER_DISABLED="1", CAGENTS_GH_NONBLOCKING="1")
            for variable in ["GH_FORCE_TTY", "GH_REPO", "GH_HOST"]:
                env.pop(variable, None)
            try:
                result = subprocess.run(["gh", "api", "--method", "GET", "--include",
                                         "--hostname", host,
                                         f'repos/{repo["owner"]}/{repo["name"]}/pulls/{key["number"]}'],
                                        env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                        timeout=30, pass_fds=(flight,))
                headers, body = response(result.stdout)
                detail = {"message": str(body.get("message", "")) + "\n"
                          + result.stderr.decode("utf-8", "replace")}
                limit = cooldown(headers, detail, int(time.time()))
                saved["next_attempt"] = max(int(time.time()) + REFRESH, limit["secondary"])
                rest_due = max([limit["secondary"], *limit["primary"].values()])
                # Persist this request's pacing even if another budget writer
                # is stopped before the host-wide merge can acquire its lock.
                # Keep resource-local pacing out of Rust's transport-agnostic
                # next_attempt, so core exhaustion cannot defer GraphQL.
                if rest_due:
                    store(retry_path, {"retry_at": rest_due})
                store(path, saved)
                if limit["primary"] or limit["secondary"]:
                    try:
                        with locked(budget_lock):
                            budget = load(budget_path)
                            primary = budget.setdefault("primary", {})
                            for resource, due in limit["primary"].items():
                                primary[resource] = max(primary.get(resource, 0), due)
                            budget["secondary"] = max(budget.get("secondary", 0), limit["secondary"])
                            store(budget_path, budget)
                    except BlockingIOError:
                        raise OSError("Host cooldown could not be saved because its lock is busy; "
                                      "this PR's retry deadline is retained") from None
                if result.returncode:
                    raise ValueError(body.get("message") or "GitHub REST request failed")
                saved.update(snapshot=snapshot(body, key), fetched_at=int(time.time()), error=None)
            except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
                saved["error"] = str(error)
            checked(saved)
            store(path, saved)
            return checked({**saved, "next_attempt": max(saved["next_attempt"], rest_due)})
    except BlockingIOError:
        return checked({**saved, "error": "Another status read is in progress; retry later",
                        "next_attempt": max(rest_due, at + REFRESH)})


def output(saved, key, as_json):
    at = int(time.time())
    fetched = saved.get("fetched_at")
    failed = bool(saved.get("error")) or not saved.get("snapshot")
    snapshot = saved.get("snapshot")
    partial = not snapshot or (not snapshot["checks_complete"] and not snapshot["checks"])
    report = {"target": key, "source": "rest-bootstrap" if partial else "cache", "snapshot": snapshot,
              "fetched_at": fetched, "age_seconds": at - fetched if fetched else None,
              "stale": failed or fetched is None or at - fetched >= REFRESH,
              "error": saved.get("error"), "retry_at": saved.get("next_attempt")
              if saved.get("next_attempt", 0) > at else None,
              "outcome": "failed" if failed else "succeeded"}
    if as_json:
        print(json.dumps({"ok": True, "command": "gh.pr_status", "data": report,
                          "limitations": ["Single REST bootstrap read; CI and review decision are unknown."]
                          if partial else []}))
    else:
        pr = (report["snapshot"] or {}).get("pull_request", {})
        print(f'{authority(key)}/{key["repository"]["owner"]}/{key["repository"]["name"]} #{key["number"]}: '
              + (report["error"] or f'{pr.get("state", "UNKNOWN")} · Head: {pr.get("headRefOid", "unknown")}'))
        print("REST bootstrap: CI and review decision unknown; shared CLI is building or unavailable."
              if partial else "Shared cached snapshot; inspect --json for CI and review state.")
    return 4 if failed else 0


def main():
    if len(sys.argv) == 5 and sys.argv[1] == "--build":
        build(Path(sys.argv[2]), sys.argv[3], sys.argv[4])
        return 0
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("number", type=int)
    parser.add_argument("-R", "--repo", required=True)
    parser.add_argument("--hostname", default="github.com")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--source-ref", default="refs/remotes/origin/main",
                        help="local source revision (default: origin/main; HEAD to qualify a candidate)")
    args = parser.parse_args()
    key = target(args.repo, args.hostname, args.number)
    try:
        binary = cached_cli(Path(__file__).resolve().parents[1], args.source_ref)
    except (OSError, subprocess.SubprocessError) as error:
        print(f"gh-pr-status: CLI bootstrap unavailable ({error}); using shared REST cache", file=sys.stderr)
        binary = None
    if binary is not None:
        # A real CLI error/cooldown is final. Never add a REST request afterward.
        command = [str(binary), "gh", "pr-status", str(args.number), "-R", args.repo,
                   "--hostname", args.hostname] + (["--json"] if args.json else [])
        identity = binary.stat()
        try:
            os.execv(binary, command)
        except OSError as error:
            print(f"gh-pr-status: cached CLI cannot start ({error}); using shared REST cache", file=sys.stderr)
            current = binary.stat() if binary.exists() else None
            if current and (current.st_dev, current.st_ino, current.st_mtime_ns, current.st_size) == (
                    identity.st_dev, identity.st_ino, identity.st_mtime_ns, identity.st_size):
                binary.unlink()
    return output(rest(key), key, args.json)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"gh-pr-status: {error}", file=sys.stderr)
        sys.exit(4)
