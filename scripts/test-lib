#!/usr/bin/python3
"""Build one lane's library tests through the gate and run exactly the selected ones.

Cargo starts the harness through this script, as its runner, wherever the gate
runs the tests: on the build host, in the slot that built them, or here after a
local build. There it lists the harness, resolves the selection to exact names
and replaces itself with the harness, so tests find the checkout that Cargo's
CARGO_MANIFEST_DIR names.
"""

import argparse
from collections import Counter
import json
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import time
import tomllib


ROOT = Path(__file__).resolve().parents[1]
# Each lane's library test harness: package, its manifest, and the features
# that select the lane's graph. `ui` is the application crate; `shared-ui` is
# the shared library compiled for the UI.
LANES = {
    "cli": ("cagents", ROOT / "Cargo.toml", ()),
    "host": ("cagents", ROOT / "Cargo.toml", ("--features", "host")),
    "shared-ui": ("cagents", ROOT / "Cargo.toml", ("--features", "ui")),
    "ui": ("cagents-ui", ROOT / "crates/cagents-ui/Cargo.toml", ()),
}
# The mise lane each is checked in: built only under cfg(test), an item only
# tests use looks used, so once the tests pass the lane's library, binaries and
# examples are checked as main's build check does. mise.toml's [vars] define
# the lanes.
CHECKED_AS = {"cli": "cli", "host": "host", "shared-ui": "ui", "ui": "ui"}
SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)
# The first argument Cargo gives this script when it runs it as the harness's
# runner, followed by the lane, the harness and the arguments after `--`.
RUNNER = "--cargo-runner"
# The first argument after `--`, which only this runner accepts. Cargo prefers
# a runner configured for the exact target to this `cfg(all())` one; libtest
# would then refuse this option rather than run the names as loose filters.
SELECTION = "--test-lib-selection"


def refuse(message):
    print(f"test-lib: {message}", file=sys.stderr)
    raise SystemExit(2)


def outside_admission():
    if os.environ.get("CAGENTS_BUILD_SLOT_HELD"):
        refuse("run outside cargo-gate exec or any enclosing build admission")
    base = Path(os.environ.get("CAGENTS_BUILD_LOCK") or "/var/tmp/cagents-cargo.lock")
    prefix = base.name + "."
    paths = [base, *(path for path in base.parent.iterdir()
                     if path.name.startswith(prefix)
                     and path.name[len(prefix):].isascii()
                     and path.name[len(prefix):].isdecimal())]
    locks = set()
    for path in paths:
        try:
            info = path.stat()
        except FileNotFoundError:
            continue
        locks.add((info.st_dev, info.st_ino))
    for path in Path("/proc/self/fd").iterdir():
        try:
            info = os.fstat(int(path.name))
        except OSError:
            continue
        if (info.st_dev, info.st_ino) not in locks:
            continue
        details = Path("/proc/self/fdinfo", path.name).read_text()
        if any(
                line.startswith("lock:") and "FLOCK" in line.split()
                for line in details.splitlines()):
            refuse("an inherited descriptor holds build admission; run outside its parent wrapper")
    # `flock --close` keeps the lock from this process but still holds it.
    ancestor = os.getppid()
    while ancestor > 1:
        try:
            if Path(f"/proc/{ancestor}/comm").read_text(errors="replace").strip() == "flock":
                for path in Path(f"/proc/{ancestor}/fd").iterdir():
                    info = path.stat()
                    if (info.st_dev, info.st_ino) in locks and any(
                            line.startswith("lock:") and "FLOCK" in line.split()
                            for line in Path(f"/proc/{ancestor}/fdinfo", path.name).read_text().splitlines()):
                        refuse("a parent flock holds build admission; run outside it")
            status = Path(f"/proc/{ancestor}/status").read_text(errors="replace")
        except OSError:
            return
        ancestor = next(int(line.split()[1]) for line in status.splitlines() if line.startswith("PPid:"))


def identity(path):
    info = path.stat()
    if not stat.S_ISREG(info.st_mode) or not os.access(path, os.X_OK):
        refuse("Cargo test executable is not a runnable regular file")
    return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns


def selection(parser, args):
    if not args.names and not args.prefix:
        parser.error("supply an exact test name or --prefix MODULE::")
    if len(set(args.names)) != len(args.names):
        parser.error("duplicate exact names")
    for value in [*args.names, *args.prefix]:
        if not value or value.startswith("-") or any(ord(char) < 32 for char in value):
            parser.error("test names and prefixes must be nonempty literal names")
    for prefix in args.prefix:
        if not prefix.endswith("::") or prefix == "::" or any(c in prefix for c in "*?[]"):
            parser.error("--prefix requires a literal module prefix ending in ::")
    if args.test_threads is not None and args.test_threads < 1:
        parser.error("--test-threads must be positive")


def parser_for(runner):
    parser = argparse.ArgumentParser(prog="test-lib" if not runner else f"test-lib {RUNNER}",
                                     description=__doc__)
    if runner:
        # The caller's own stamp, which the gate's stamp replaced for the build.
        parser.add_argument("--build-metadata")
    parser.add_argument("lane", choices=tuple(LANES))
    if runner:
        parser.add_argument("executable")
    parser.add_argument("names", nargs="*", metavar="EXACT_NAME")
    parser.add_argument("--prefix", action="append", default=[], metavar="MODULE::",
                        help="also select ordinary tests in this literal module prefix")
    if runner:
        # Cargo passes its own `--quiet` on to the harness.
        parser.add_argument("--quiet", action="store_true")
        parser.add_argument(SELECTION, dest="selection", action="store_true")
    else:
        parser.add_argument("--profile", help="Cargo profile (default: Cargo's test profile)")
    parser.add_argument("--test-threads", type=int, metavar="N")
    return parser


def main():
    parser = parser_for(runner=False)
    args = parser.parse_intermixed_args()
    selection(parser, args)
    os.chdir(ROOT)
    outside_admission()
    package, _manifest, features = LANES[args.lane]
    # Cargo resolves the runner's relative path from its working directory,
    # this checkout's root here and its copy's root on the build host, and
    # starts it with the package's root as the working directory and
    # CARGO_MANIFEST_DIR set, wherever the tests run. Arguments after `--`
    # reach the runner after the harness's path.
    runner = ["scripts/test-lib", RUNNER]
    # As the gate's own runner does, the tests get the caller's stamp back.
    # The gate drops an inherited pair it marked as supplied.
    stamp = os.environ.get("CAGENTS_BUILD_METADATA", "")
    if (os.environ.get("CAGENTS_BUILD_METADATA_SUPPLIED") != "1"
            and re.fullmatch(r"[A-Za-z0-9.-]+", stamp)):
        runner.append("--build-metadata=" + stamp)
    runner = json.dumps([*runner, args.lane])
    command = [str(ROOT / "scripts/cargo-gate"), "test", "--locked", "--no-default-features",
               "--manifest-path", str(ROOT / "Cargo.toml"), "--package", package, "--lib",
               *features, "--config", f"target.'cfg(all())'.runner={runner}"]
    if args.profile:
        command.extend(("--profile", args.profile))
    command += ["--", SELECTION, *args.names]
    for prefix in args.prefix:
        command += ["--prefix", prefix]
    if args.test_threads is not None:
        command += ["--test-threads", str(args.test_threads)]
    status = supervise(command)
    if status:
        sys.exit(status)
    lane = tomllib.loads((ROOT / "mise.toml").read_text())["vars"][CHECKED_AS[args.lane]].split()
    sys.stdout.flush()
    os.execv(ROOT / "scripts/cargo-lane", [str(ROOT / "scripts/cargo-lane"), "check", *lane, "--lib", "--bins", "--examples"])


def terminal():
    """This process's controlling terminal, open, when this is its foreground
    job, whose Ctrl-C and Ctrl-Z reach every process in the job; else None."""
    try:
        descriptor = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except OSError:
        return None
    try:
        if os.tcgetpgrp(descriptor) == os.getpgrp():
            return descriptor
    except OSError:
        pass
    os.close(descriptor)
    return None


def die_by(number):
    """Ends this process as `number` would have, without a core dump."""
    import ctypes
    ctypes.CDLL(None).prctl(4, 0)  # PR_SET_DUMPABLE
    signal.signal(number, signal.SIG_DFL)
    os.kill(os.getpid(), number)
    return 128 + number


def hand_over(tty, owner, group):
    """Moves the terminal from the process group `owner` to `group`, only
    while `owner` has it."""
    try:
        if os.tcgetpgrp(tty) == owner:
            os.tcsetpgrp(tty, group)
    except OSError:
        pass


def supervise(command):
    """Runs the gate's command to its end and returns its status.

    Built locally, the gate becomes Cargo, which ignores an interrupt while
    its runner runs, and nothing passes a signal on to the harness beneath
    it. So the command runs in a process group of its own, and a signal sent
    to this process goes to the whole group, as a terminal's would. In a
    terminal's foreground job the group gets the terminal, as a shell's job
    would: its Ctrl-C reaches every process once, and a Ctrl-Z stops the
    group and then this process, which hands the terminal back when the job
    continues."""
    tty = terminal()
    child = None
    received = []

    def forward(number, _frame):
        received.append(number)
        if child is not None and child.returncode is None:
            try:
                os.killpg(child.pid, number)
            except ProcessLookupError:
                pass

    for number in SIGNALS:
        signal.signal(number, forward)
    # Handing the terminal between groups from the background raises SIGTTOU.
    signal.signal(signal.SIGTTOU, signal.SIG_IGN)
    parent = os.getpid()

    def start():
        import ctypes
        ctypes.CDLL(None).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
        if os.getppid() != parent:
            os._exit(143)
        if tty is not None:
            os.tcsetpgrp(tty, os.getpgrp())
        signal.signal(signal.SIGTTOU, signal.SIG_DFL)

    if received:
        return die_by(received[0])
    # The terminal's descriptor stays usable in `start`, and closes as the
    # gate starts.
    child = subprocess.Popen(command, process_group=0, preexec_fn=start)
    # A signal received while the child was starting reaches it now.
    if received:
        forward(received[0], None)
    try:
        while True:
            _pid, waited = os.waitpid(child.pid, os.WUNTRACED if tty is not None else 0)
            if not os.WIFSTOPPED(waited):
                break
            # The job was stopped from the terminal: stop with it, as the
            # caller's shell expects. Continued in the foreground, as by `fg`,
            # give the group the terminal again; in the background, as by
            # `bg`, the shell keeps it.
            hand_over(tty, child.pid, os.getpgrp())
            os.kill(os.getpid(), signal.SIGSTOP)
            hand_over(tty, os.getpgrp(), child.pid)
            try:
                os.killpg(child.pid, signal.SIGCONT)
            except ProcessLookupError:
                pass
        child.returncode = os.waitstatus_to_exitcode(waited)
    finally:
        if tty is not None:
            hand_over(tty, child.pid, os.getpgrp())
            os.close(tty)
    if received:
        # Whatever in the group outlives the command after a signal, such as
        # a harness still handling it beneath a Cargo that ended at once.
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            try:
                os.killpg(child.pid, 0)
            except ProcessLookupError:
                break
            time.sleep(0.05)
        else:
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    status = child.returncode
    # Ends as the signal that ended the command, as the gate would have.
    return status if status >= 0 else die_by(-status)


def run_harness(arguments):
    """Runs as Cargo's runner for the lane's harness: lists it, resolves the
    selection to exact names, and replaces itself with the harness."""
    parser = parser_for(runner=True)
    args = parser.parse_intermixed_args(arguments)
    selection(parser, args)
    if not args.selection:
        refuse(f"Cargo ran this runner without the selection it gives the tests ({SELECTION})")
    package, manifest, _features = LANES[args.lane]
    if os.environ.get("CARGO_PKG_NAME") != package or os.path.realpath(
            os.environ.get("CARGO_MANIFEST_DIR", "")) != os.path.realpath(manifest.parent):
        refuse(f"Cargo ran another package's tests than {package} in {manifest.parent}")
    if "\0" in args.executable or not os.path.isabs(args.executable):
        refuse("Cargo gave an invalid test executable path")
    executable = Path(args.executable)
    expected = identity(executable)
    child = None
    starting = False
    cancellation = 0

    def interrupted(number, _frame):
        nonlocal cancellation
        cancellation = cancellation or number
        if child is None and not starting:
            raise SystemExit(128 + cancellation)
        if child is not None:
            child.send_signal(number)

    for number in SIGNALS:
        signal.signal(number, interrupted)

    def listed(*extra):
        nonlocal child, starting
        if identity(executable) != expected:
            refuse("test executable changed; keep this target frozen until tests finish")
        starting = True
        try:
            child = subprocess.Popen([str(executable), "--list", "--format=terse", *extra],
                                     stdout=subprocess.PIPE, stdin=subprocess.DEVNULL,
                                     text=True, errors="replace")
        finally:
            starting = False
        # A signal received during Popen is remembered until its exact child
        # handle exists. Children inherit no temporary blocked signal mask.
        if cancellation:
            child.send_signal(cancellation)
        try:
            output, _ = child.communicate()
            status = child.returncode
        finally:
            child = None
        if cancellation:
            raise SystemExit(128 + cancellation)
        if status:
            raise SystemExit(status if status > 0 else 128 - status)
        names = []
        for line in output.splitlines():
            if line.endswith(": test"):
                names.append(line[:-6])
            elif not line.endswith(": benchmark"):
                refuse("test executable returned a malformed listing")
        if any(count != 1 for count in Counter(names).values()):
            refuse("test executable returned ambiguous duplicate names")
        return set(names)

    available = listed()
    if not available:
        refuse(f"the {args.lane} lane compiled no library tests")
    ignored = listed("--ignored")
    if not ignored <= available:
        refuse("ignored listing disagrees with the complete test listing")
    selected = set(args.names)
    missing = selected - available
    if missing:
        refuse("exact tests not found: " + ", ".join(sorted(missing)))
    if selected & ignored:
        refuse("explicit ignored tests require a separate opt-in workflow: "
               + ", ".join(sorted(selected & ignored)))
    for prefix in args.prefix:
        matches = {name for name in available if name.startswith(prefix)}
        ordinary = matches - ignored
        if not matches:
            refuse(f"prefix {prefix!r} selects no tests")
        for name in sorted(matches & ignored):
            print(f"test-lib: skipping ignored {name}", file=sys.stderr)
        selected.update(ordinary)
    if not selected:
        refuse("selection contains no ordinary tests")
    if identity(executable) != expected:
        refuse("test executable changed; keep this target frozen until tests finish")
    print(f"test-lib: running {len(selected)} exact {args.lane} tests", file=sys.stderr, flush=True)
    command = [str(executable), "--exact", *sorted(selected)]
    if args.test_threads is not None:
        command.extend(("--test-threads", str(args.test_threads)))
    if args.quiet:
        command.append("--quiet")
    # A runner of the caller's own keeps the gate from adding the one that
    # gives programs Cargo runs the caller's environment back, so this does
    # what it would: a stamp the gate supplied was for the build, and a Cargo
    # a test runs would otherwise build its own checkout with it.
    if os.environ.get("CAGENTS_BUILD_METADATA_SUPPLIED") == "1":
        os.environ.pop("CAGENTS_BUILD_METADATA_SUPPLIED")
        os.environ.pop("CAGENTS_BUILD_METADATA", None)
        if args.build_metadata is not None:
            os.environ["CAGENTS_BUILD_METADATA"] = args.build_metadata
    # Python ignores these by default; a direct harness launch should not.
    for number in SIGNALS:
        signal.signal(number, signal.SIG_DFL)
    for name in ("SIGPIPE", "SIGXFZ", "SIGXFSZ"):
        if hasattr(signal, name):
            signal.signal(getattr(signal, name), signal.SIG_DFL)
    if cancellation:
        raise SystemExit(128 + cancellation)
    # The gate runs the whole Cargo command, this runner included, under the
    # tests' memory limit and stops what they leave running.
    os.execv(executable, command)


if __name__ == "__main__":
    try:
        if sys.argv[1:2] == [RUNNER]:
            run_harness(sys.argv[2:])
        else:
            main()
    except OSError as error:
        refuse(str(error))
