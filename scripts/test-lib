#!/usr/bin/python3
"""Compile one isolated lib-test harness, then run selected tests without a slot."""

import argparse
from collections import Counter
import json
import os
from pathlib import Path
import signal
import stat
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)


def refuse(message):
    print(f"test-lib: {message}", file=sys.stderr)
    raise SystemExit(2)


def outside_admission():
    if os.environ.get("CAGENTS_BUILD_SLOT_HELD"):
        refuse("run outside cargo-gate exec or any enclosing build admission")
    base = Path(os.environ.get("CAGENTS_BUILD_LOCK") or "/var/tmp/cagents-cargo.lock")
    prefix = base.name + "."
    paths = [base, *(path for path in base.parent.iterdir()
                     if path.name.startswith(prefix)
                     and path.name[len(prefix):].isascii()
                     and path.name[len(prefix):].isdecimal())]
    locks = set()
    for path in paths:
        try:
            info = path.stat()
        except FileNotFoundError:
            continue
        locks.add((info.st_dev, info.st_ino))
    for path in Path("/proc/self/fd").iterdir():
        try:
            info = os.fstat(int(path.name))
        except OSError:
            continue
        if (info.st_dev, info.st_ino) not in locks:
            continue
        details = Path("/proc/self/fdinfo", path.name).read_text()
        if any(
                line.startswith("lock:") and "FLOCK" in line.split()
                for line in details.splitlines()):
            refuse("an inherited descriptor holds build admission; run outside its parent wrapper")
    # `flock --close` keeps the lock from this process but still holds it.
    ancestor = os.getppid()
    while ancestor > 1:
        try:
            if Path(f"/proc/{ancestor}/comm").read_text(errors="replace").strip() == "flock":
                for path in Path(f"/proc/{ancestor}/fd").iterdir():
                    info = path.stat()
                    if (info.st_dev, info.st_ino) in locks and any(
                            line.startswith("lock:") and "FLOCK" in line.split()
                            for line in Path(f"/proc/{ancestor}/fdinfo", path.name).read_text().splitlines()):
                        refuse("a parent flock holds build admission; run outside it")
            status = Path(f"/proc/{ancestor}/status").read_text(errors="replace")
        except OSError:
            return
        ancestor = next(int(line.split()[1]) for line in status.splitlines() if line.startswith("PPid:"))


def identity(path):
    info = path.stat()
    if not stat.S_ISREG(info.st_mode) or not os.access(path, os.X_OK):
        refuse("Cargo test executable is not a runnable regular file")
    return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("lane", choices=("cli", "host", "ui"))
    parser.add_argument("names", nargs="*", metavar="EXACT_NAME")
    parser.add_argument("--prefix", action="append", default=[], metavar="MODULE::",
                        help="also select ordinary tests in this literal module prefix")
    parser.add_argument("--profile", help="Cargo profile (default: Cargo's test profile)")
    parser.add_argument("--test-threads", type=int, metavar="N")
    args = parser.parse_intermixed_args()
    if not args.names and not args.prefix:
        parser.error("supply an exact test name or --prefix MODULE::")
    if len(set(args.names)) != len(args.names):
        parser.error("duplicate exact names")
    for value in [*args.names, *args.prefix]:
        if not value or value.startswith("-") or any(ord(char) < 32 for char in value):
            parser.error("test names and prefixes must be nonempty literal names")
    for prefix in args.prefix:
        if not prefix.endswith("::") or prefix == "::" or any(c in prefix for c in "*?[]"):
            parser.error("--prefix requires a literal module prefix ending in ::")
    if args.test_threads is not None and args.test_threads < 1:
        parser.error("--test-threads must be positive")
    os.chdir(ROOT)
    outside_admission()
    child = None
    starting = False
    cancellation = 0

    def interrupted(number, _frame):
        nonlocal cancellation
        cancellation = cancellation or number
        if child is None and not starting:
            raise SystemExit(128 + cancellation)
        if child is not None:
            child.send_signal(number)

    for number in SIGNALS:
        signal.signal(number, interrupted)

    def run(command, *, stdin=None, check=True):
        nonlocal child, starting
        starting = True
        try:
            child = subprocess.Popen(command, stdout=subprocess.PIPE, text=True,
                                     errors="replace", stdin=stdin)
        finally:
            starting = False
        # A signal received during Popen is remembered until its exact child
        # handle exists. Children inherit no temporary blocked signal mask.
        if cancellation:
            child.send_signal(cancellation)
        try:
            output, _ = child.communicate()
            status = child.returncode
        finally:
            child = None
        if cancellation:
            raise SystemExit(128 + cancellation)
        if status and check:
            raise SystemExit(status if status > 0 else 128 - status)
        return output, status

    command = [str(ROOT / "scripts/cargo-gate"), "test", "--locked", "--no-default-features",
               "--manifest-path", str(ROOT / "Cargo.toml"), "--package", "cagents", "--lib",
               "--no-run", "--message-format=json-render-diagnostics"]
    if args.lane != "cli":
        command.extend(("--features", args.lane))
    if args.profile:
        command.extend(("--profile", args.profile))
    # run() waits for the gate itself, not just Cargo's stdout or its child.
    output, status = run(command, check=False)
    artifacts = []
    for line in output.splitlines():
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            if not status and line.startswith("{"):
                refuse("Cargo emitted malformed JSON")
            print(line, file=sys.stderr)
            continue
        if not isinstance(message, dict):
            if status:
                print(line, file=sys.stderr)
                continue
            refuse("Cargo emitted a malformed JSON message")
        if message.get("reason") == "compiler-message":
            diagnostic = message.get("message")
            if isinstance(diagnostic, dict):
                print(diagnostic.get("rendered") or "", end="", file=sys.stderr)
        target = message.get("target")
        profile = message.get("profile")
        if (message.get("reason") == "compiler-artifact"
                and message.get("manifest_path") == str(ROOT / "Cargo.toml")
                and isinstance(target, dict) and target.get("name") == "cagents"
                and target.get("kind") == ["lib"]
                and isinstance(profile, dict) and profile.get("test") is True
                and message.get("executable") is not None):
            artifacts.append(message["executable"])
    if status:
        raise SystemExit(status if status > 0 else 128 - status)
    if len(artifacts) != 1:
        refuse(f"expected exactly one root cagents lib-test executable, found {len(artifacts)}")
    if (not isinstance(artifacts[0], str) or "\0" in artifacts[0]
            or not os.path.isabs(artifacts[0])):
        refuse("Cargo reported an invalid test executable path")
    executable = Path(artifacts[0])
    expected = identity(executable)

    def listed(*extra):
        if identity(executable) != expected:
            refuse("test executable changed; keep this target frozen until tests finish")
        output, _ = run([str(executable), "--list", "--format=terse", *extra],
                        stdin=subprocess.DEVNULL)
        names = []
        for line in output.splitlines():
            if line.endswith(": test"):
                names.append(line[:-6])
            elif not line.endswith(": benchmark"):
                refuse("test executable returned a malformed listing")
        if any(count != 1 for count in Counter(names).values()):
            refuse("test executable returned ambiguous duplicate names")
        return set(names)

    available = listed()
    ignored = listed("--ignored")
    if not ignored <= available:
        refuse("ignored listing disagrees with the complete test listing")
    selected = set(args.names)
    missing = selected - available
    if missing:
        refuse("exact tests not found: " + ", ".join(sorted(missing)))
    if selected & ignored:
        refuse("explicit ignored tests require a separate opt-in workflow: "
               + ", ".join(sorted(selected & ignored)))
    for prefix in args.prefix:
        matches = {name for name in available if name.startswith(prefix)}
        ordinary = matches - ignored
        if not matches:
            refuse(f"prefix {prefix!r} selects no tests")
        for name in sorted(matches & ignored):
            print(f"test-lib: skipping ignored {name}", file=sys.stderr)
        selected.update(ordinary)
    if not selected:
        refuse("selection contains no ordinary tests")
    if identity(executable) != expected:
        refuse("test executable changed; keep this target frozen until tests finish")
    print(f"test-lib: running {len(selected)} exact {args.lane} tests outside build admission",
          file=sys.stderr, flush=True)
    command = [str(executable), "--exact", *sorted(selected)]
    if args.test_threads is not None:
        command.extend(("--test-threads", str(args.test_threads)))
    # Python ignores these by default; a direct harness launch should not.
    for number in SIGNALS:
        signal.signal(number, signal.SIG_DFL)
    for name in ("SIGPIPE", "SIGXFZ", "SIGXFSZ"):
        if hasattr(signal, name):
            signal.signal(getattr(signal, name), signal.SIG_DFL)
    if cancellation:
        raise SystemExit(128 + cancellation)
    # A filtered mutation loop runs here too, and a mutant can allocate forever.
    limit = ROOT / "scripts/memory-capped"
    if os.access(limit, os.X_OK):
        os.execv(limit, [str(limit), executable, *command[1:]])
    os.execv(executable, command)


if __name__ == "__main__":
    try:
        main()
    except OSError as error:
        refuse(str(error))
