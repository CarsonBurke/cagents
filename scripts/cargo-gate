#!/bin/sh
# Run a Cargo command in one of a few shared build slots.
#
# Checkouts on one host share its memory, not a build directory: each worktree
# has its own. One global lock idles most of the CPU while a single slow crate
# compiles, and while tests run. This admits a few builds at once, sized by
# memory, and runs tests and programs after their build has left its slot.
set -eu

program=cargo-gate
fail() {
    printf '%s: %s\n' "$program" "$*" >&2
    exit 2
}

usage() {
    cat <<'EOF'
Usage: scripts/cargo-gate [cargo] SUBCOMMAND [ARGS...]
       scripts/cargo-gate exec COMMAND [ARGS...]

Runs `cargo SUBCOMMAND ARGS...` once a build slot is free. For `test`,
`bench` and `run`, only the build (`--no-run`, or `build`) holds the slot; the
tests or program run afterwards without it.

`exec` runs any command, such as a script of several Cargo builds, in one
slot held until it exits: a drop-in for `flock /var/tmp/cagents-cargo.lock
COMMAND`. Gated commands inside it run in that slot without waiting. Prefer
gating each Cargo command, so tests run outside the slot.

Environment:
  CAGENTS_BUILD_SLOTS    Concurrent builds; default: one per 8 GiB of RAM
                         after an 8 GiB reserve, at most one per 8 CPUs
  CAGENTS_BUILD_LOCK     First slot's lock file; the others add .1, .2, ...
                         (default /var/tmp/cagents-cargo.lock)
  CARGO_BUILD_JOBS       With several slots, set or capped to CPUs divided by
                         slots, at least 2

Slot 0 is the plain lock file, so a command still run under
`flock /var/tmp/cagents-cargo.lock` occupies exactly one slot.
EOF
}

[ "$#" -gt 0 ] || { usage >&2; exit 2; }
case $1 in
    -h|--help) usage; exit 0 ;;
    cargo) shift ;;
esac
[ "$#" -gt 0 ] || fail 'missing Cargo subcommand'
if [ "$1" = exec ]; then
    shift
    [ "$#" -gt 0 ] || fail 'missing command for exec'
    mode=exec
else
    mode=cargo
fi

# The machine's CPUs, not this process's share: nproc follows affinity and
# OMP_NUM_THREADS, and a narrow caller would otherwise think it was alone.
cpus=$(getconf _NPROCESSORS_ONLN)
memory_kib=$(sed -n 's/^MemTotal:[[:space:]]*\([0-9]*\) kB$/\1/p' /proc/meminfo)
[ -n "$memory_kib" ] || fail 'cannot read MemTotal from /proc/meminfo'
# A cagents build peaked at 6.5 GiB of anonymous memory with 12 jobs.
slot_kib=$((8 * 1024 * 1024))
if [ -n "${CAGENTS_BUILD_SLOTS:-}" ]; then
    slots=$CAGENTS_BUILD_SLOTS
    case $slots in ''|*[!0-9]*|0*) fail 'CAGENTS_BUILD_SLOTS must be a positive integer' ;; esac
else
    slots=$(((memory_kib - 8 * 1024 * 1024) / slot_kib))
    [ "$slots" -le $((cpus / 8)) ] || slots=$((cpus / 8))
    [ "$slots" -ge 1 ] || slots=1
fi
# With several slots, each build gets an equal share of the CPUs, replacing the
# repository's two-job default and capping a larger CARGO_BUILD_JOBS. A lone
# slot keeps Cargo's configured jobs. `-j` on the command still wins.
if [ "$slots" -gt 1 ]; then
    share=$((cpus / slots))
    [ "$share" -ge 2 ] || share=2
    case ${CARGO_BUILD_JOBS:-} in
        ''|*[!0-9]*|0*) CARGO_BUILD_JOBS=$share ;;
        *) [ "$CARGO_BUILD_JOBS" -le "$share" ] || CARGO_BUILD_JOBS=$share ;;
    esac
    export CARGO_BUILD_JOBS
fi

lock=${CAGENTS_BUILD_LOCK:-/var/tmp/cagents-cargo.lock}

available_kib() {
    available=$(sed -n 's/^MemAvailable:[[:space:]]*\([0-9]*\) kB$/\1/p' /proc/meminfo)
    printf '%s' "${available:-0}"
}

announce() {
    if [ "$announced" = false ]; then
        printf '%s: waiting for one of %s build slots\n' "$program" "$slots" >&2
        announced=true
    fi
}

slot_path() {
    if [ "$1" -eq 0 ]; then printf '%s' "$lock"; else printf '%s.%s' "$lock" "$1"; fi
}

# Whether every slot other than $1 is free. Only gated waiters take the
# extra slots, and they hold the queue lock while choosing one.
others_idle() {
    other=0
    while [ "$other" -lt "$slots" ]; do
        if [ "$other" -ne "$1" ]; then
            exec 7>>"$(slot_path "$other")"
            flock -n 7 || { exec 7>&-; return 1; }
            exec 7>&-
        fi
        other=$((other + 1))
    done
}

# Holds a slot on descriptor 9 until release. One waiter at a time picks a
# slot, so waiters are admitted roughly in arrival order. The highest slot is
# tried first: slot 0 is also taken by plain `flock` callers, who block on it
# and would otherwise win it ahead of a polling gate.
acquire() {
    announced=false
    waited_since=$(date +%s)
    exec 8>>"$lock.queue"
    flock -n 8 || { announce; flock 8; }
    while :; do
        index=$slots
        while [ "$index" -gt 0 ]; do
            index=$((index - 1))
            exec 9>>"$(slot_path "$index")"
            if flock -n 9; then
                # Start beside other builds only when the memory a build needs
                # is free now; a lone build always starts.
                if [ "$(available_kib)" -ge "$slot_kib" ] || others_idle "$index"; then
                    exec 8>&-
                    waited=$(($(date +%s) - waited_since))
                    if [ "$waited" -gt 0 ]; then
                        printf '%s: admitted to slot %s after %ss\n' "$program" "$index" "$waited" >&2
                    fi
                    return
                fi
                flock -u 9
            fi
            exec 9>&-
        done
        announce
        sleep 0.5
    done
}

release() {
    exec 9>&-
}

# Runs a shell function while this shell holds the slot. Descriptors 8 and 9
# stay here, so a lingering child such as a compiler cache server cannot keep
# the slot; a signal to the gate reaches the command, and the slot is released
# only once it has exited.
held() {
    (
        export CAGENTS_BUILD_SLOT_HELD=1
        "$@"
    ) 0<&0 8>&- 9>&- &
    child=$!
    trap 'kill -s TERM "$child" 2>/dev/null' INT TERM HUP
    status=0
    wait "$child" || status=$?
    while kill -0 "$child" 2>/dev/null; do
        status=0
        wait "$child" || status=$?
    done
    trap - INT TERM HUP
    return "$status"
}

run_cargo() {
    exec cargo "$@"
}

run_command() {
    exec "$@"
}

# The build half of `test`, `bench` or `run`. Arguments after `--` belong to
# the tests or program, not Cargo.
build_phase() {
    ended=false
    for argument do
        shift
        [ "$argument" != -- ] || ended=true
        [ "$ended" = true ] || set -- "$@" "$argument"
    done
    if [ "$subcommand" = run ]; then
        exec cargo build "$@"
    fi
    exec cargo "$subcommand" --no-run "$@"
}

# Whether this process inherited a slot lock that is held, as under
# `flock /var/tmp/cagents-cargo.lock scripts/run-development`. Its holder is an
# ancestor, so waiting for another slot could wait on itself.
inherits_slot() {
    held=$(readlink -f "$lock")
    for descriptor in /proc/$$/fd/*; do
        path=$(readlink "$descriptor") || continue
        case $path in
            "$held"|"$held".[0-9]|"$held".[0-9][0-9])
                exec 7>>"$path"
                if flock -n 7; then
                    exec 7>&-
                else
                    exec 7>&-
                    return 0
                fi
                ;;
        esac
    done
    return 1
}

# Already inside a slot: a gated command running Cargo again, or a caller
# that took the lock itself.
if [ -n "${CAGENTS_BUILD_SLOT_HELD:-}" ] || inherits_slot; then
    [ "$mode" = exec ] || set -- cargo "$@"
    export CAGENTS_BUILD_SLOT_HELD=1
    exec "$@"
fi

if [ "$mode" = exec ]; then
    acquire
    status=0
    held run_command "$@" || status=$?
    release
    exit "$status"
fi

subcommand=$1
shift

# Cargo cannot build doctests without running them, so a doctest command
# keeps its slot throughout. A command that only builds needs no split.
runs_separately=false
case $subcommand in
    test|bench|run) runs_separately=true ;;
esac
for argument do
    case $argument in
        --) break ;;
        --doc|--no-run) runs_separately=false ;;
    esac
done

acquire
status=0
if [ "$runs_separately" = true ]; then
    held build_phase "$@" || status=$?
    release
    [ "$status" -eq 0 ] || exit "$status"
    exec cargo "$subcommand" "$@"
fi
held run_cargo "$subcommand" "$@" || status=$?
release
exit "$status"
