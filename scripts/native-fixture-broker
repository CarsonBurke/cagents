#!/usr/bin/python3 -I
"""Run isolated native UI fixtures for agents, from a person's own terminal.

A person starts this once, in a terminal outside cagents. Agents then ask it,
through scripts/native-fixture, to drive a fixture that only ever sees its own
HOME, XDG directories, daemon and offline provider. The broker never scrubs an
authority token: it refuses to start where one is present or inherited.

Every process that runs code from a checkout runs inside the fixture's sandbox,
and nothing a sandbox writes or says is trusted. This protects the person from
sandbox code. It does not protect them from an agent shell of the same user,
which can already reach the same files and sockets. On the host side only this
broker, niri-harness and niri run.
"""

import argparse
from dataclasses import dataclass, field
import errno
import hashlib
import hmac
import json
import os
from pathlib import Path
import queue
import re
import secrets
import select
import shutil
import signal
import socket
import socketserver
import stat
import struct
import subprocess
import sys
import threading
import time

EXIT_AGENT_AUTHORITY = 77
# The same inherited identities src/control.rs treats as a hosted session.
AUTHORITY_NAMES = (
    "CAGENTS_AGENT_AUTHORITY",
    "CAGENTS_AGENT_TOKEN",
    "CAGENTS_SESSION_TOKEN",
)
GUARD_MESSAGE = (
    "native-fixture-broker must be started by a person in a terminal outside "
    "cagents; inherited agent authority was not modified."
)
SOCKET_NAME = "native-fixture-broker.sock"
FIXTURE_DIR = "native-fixture"
TARGETS_DIR = "native-fixture-targets"
PRIVATE_DIR = "native-fixture-broker"
MAX_LIVE_FIXTURES = 2
MAX_CONNECTIONS = 16
CLIENT_READ_SECONDS = 10
MAX_REQUEST_BYTES = 256 * 1024
MAX_OUTPUT_BYTES = 64 * 1024
# A tail of MAX_OUTPUT_BYTES per stream, at JSON's worst-case escaping.
MAX_RELAY_REPLY_BYTES = 1024 * 1024
MAX_DEP_INFO_BYTES = 8 * 1024 * 1024
MAX_TEXT = 8192
MAX_ARGS = 64
HOLDER_START_SECONDS = 20
HARNESS_SECONDS = 180
CLI_SECONDS = 120
LOCK_SECONDS = 200
STOP_ALL_LOCK_SECONDS = 5
VIEWPORT_APPLY_SECONDS = 3
VIEWPORT_POLL_SECONDS = 0.05
BUILD_FINISHED_MARKER = b"writing UI diagnostics to"
MAX_RUNNER_LOG_BYTES = 8 * 1024 * 1024
DEFAULT_WIDTH = 1600
MIN_WIDTH = 320
MAX_WIDTH = 3840
SYSTEM_PATH = "/usr/bin:/usr/sbin"
TERMINATION_SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
# Per process, except nproc. Aggregate memory needs a cgroup, which needs systemd.
SANDBOX_RLIMITS = (
    "--nproc=8192",
    "--core=0",
    f"--fsize={32 * 1024 ** 3}",
    f"--as={128 * 1024 ** 3}",
)

FIXTURE_NAME = re.compile(r"[a-z0-9][a-z0-9-]{0,23}")
OWNER_TOKEN = re.compile(r"[0-9a-f]{32}")
SHOT_NAME = re.compile(r"[a-z0-9][a-z0-9_-]{0,63}")
PATH_COMPONENT = re.compile(r"[A-Za-z0-9._+-]+")
KEY_CHORD = re.compile(r"[A-Za-z0-9_+-]{1,64}")
ZIG_VERSION = re.compile(r'^\s*zig\s*=\s*"(\d+\.\d+\.\d+)"\s*$', re.MULTILINE)
NESTED_DISPLAY = re.compile(r"^WAYLAND_DISPLAY=(wayland-[0-9]+)$", re.MULTILINE)
NESTED_SOCKET = re.compile(r"^NIRI_SOCKET=(/\S+)$", re.MULTILINE)
RUNNER_STATE = re.compile(r"not_started|running|exited_-?\d+")


class Refusal(Exception):
    def __init__(self, code, detail):
        super().__init__(detail)
        self.code = code
        self.detail = detail


# --------------------------------------------------------------------------
# Starting only where no agent authority exists


def ancestors_holding_authority(start_pid, proc_root="/proc"):
    """Name the ancestors whose environment holds authority, never its value.

    An unset variable passes a check of this process alone, so a broker launched
    from inside an agent's process tree is refused as well. Unreadable ancestors
    belong to another user or have exited, and hold nothing of this user's.
    """
    found = []
    pid = start_pid
    seen = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        try:
            environment = Path(proc_root, str(pid), "environ").read_bytes()
        except OSError:
            environment = b""
        names = {entry.partition(b"=")[0] for entry in environment.split(b"\0")}
        if any(name.encode() in names for name in AUTHORITY_NAMES):
            found.append(pid)
        try:
            status = Path(proc_root, str(pid), "status").read_text()
            pid = int(re.search(r"^PPid:\s*(\d+)$", status, re.MULTILINE).group(1))
        except (OSError, AttributeError, ValueError):
            break
    return found


def guard(environ=None, parent_pid=None, proc_root="/proc"):
    """Return an exit code when agent authority is present or inherited."""
    environ = os.environ if environ is None else environ
    parent_pid = os.getppid() if parent_pid is None else parent_pid
    if any(name in environ for name in AUTHORITY_NAMES):
        print(GUARD_MESSAGE, file=sys.stderr)
        return EXIT_AGENT_AUTHORITY
    holders = ancestors_holding_authority(parent_pid, proc_root)
    if holders:
        print(
            f"{GUARD_MESSAGE} An ancestor process holds it: {holders}",
            file=sys.stderr,
        )
        return EXIT_AGENT_AUTHORITY
    return None


# --------------------------------------------------------------------------
# Request validation. Nothing here touches anything but the paths it checks.


def _text(request, key, *, limit=MAX_TEXT):
    value = request.get(key)
    if not isinstance(value, str) or not value or len(value) > limit or "\0" in value:
        raise Refusal("invalid_request", f"{key} must be nonempty text within {limit} characters")
    return value


def _matching(request, key, pattern):
    value = request.get(key)
    if not isinstance(value, str) or not pattern.fullmatch(value):
        raise Refusal("invalid_request", f"{key} must match {pattern.pattern}")
    return value


def _flag(request, key):
    value = request.get(key, False)
    if not isinstance(value, bool):
        raise Refusal("invalid_request", f"{key} must be true or false")
    return value


def _number(request, key, low, high, default=None):
    value = request.get(key, default)
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not low <= value <= high:
        raise Refusal("invalid_request", f"{key} must be a number from {low} to {high}")
    return value


def _width(request):
    value = request.get("width", DEFAULT_WIDTH)
    if isinstance(value, bool) or not isinstance(value, int) or not MIN_WIDTH <= value <= MAX_WIDTH:
        raise Refusal("invalid_request", f"width must be a whole number from {MIN_WIDTH} to {MAX_WIDTH}")
    return value


def validate_checkout(value, repo):
    """Resolve a checkout path to a directory beneath the repo's .worktrees/."""
    if not isinstance(value, str) or not value or "\0" in value:
        raise Refusal("invalid_request", "checkout must be a path")
    candidate = Path(value)
    worktrees = (repo / ".worktrees").resolve()
    if not candidate.is_absolute():
        candidate = worktrees / candidate
    # Resolved so a symlink under .worktrees/ cannot lead out of it. Mounting
    # later walks these same components again without following any symlink.
    resolved = candidate.resolve()
    if worktrees not in resolved.parents:
        raise Refusal("path_escape", "checkout must be beneath this repository's .worktrees/")
    relative = resolved.relative_to(worktrees)
    if relative.parts[0] in (FIXTURE_DIR, TARGETS_DIR):
        raise Refusal("path_escape", "the broker's own directories are not checkouts")
    if not all(PATH_COMPONENT.fullmatch(part) for part in resolved.parts[1:]):
        raise Refusal("invalid_request", "checkout path contains unsupported characters")
    for required in (
        "scripts/run-development",
        "tests/fixtures/chat-composer-claude.sh",
        "mise.toml",
    ):
        if not (resolved / required).is_file():
            raise Refusal("invalid_checkout", f"checkout has no {required}")
    return resolved


def _input_fields(request):
    action = request.get("action")
    if action in ("click", "move"):
        fields = {"target": _text(request, "target")}
        if action == "click":
            button = request.get("button", "left")
            if button not in ("left", "right", "middle"):
                raise Refusal("invalid_request", "button must be left, right or middle")
            fields.update(button=button, double=_flag(request, "double"))
        return fields
    if action == "type":
        return {"text": _text(request, "text")}
    if action == "key":
        chords = request.get("chords")
        if not isinstance(chords, list) or not 1 <= len(chords) <= MAX_ARGS:
            raise Refusal("invalid_request", f"chords must list 1 to {MAX_ARGS} keys")
        for chord in chords:
            if not isinstance(chord, str) or not KEY_CHORD.fullmatch(chord):
                raise Refusal("invalid_request", f"chords must match {KEY_CHORD.pattern}")
        return {"chords": chords}
    if action == "scroll":
        axis = request.get("axis")
        if axis not in ("v", "h", "vertical", "horizontal"):
            raise Refusal("invalid_request", "axis must be v or h")
        fields = {"axis": axis, "notches": _number(request, "notches", -100, 100)}
        if "at" in request:
            fields["at"] = _text(request, "at")
        return fields
    if action == "wait":
        return {
            "text": _text(request, "text"),
            "gone": _flag(request, "gone"),
            "timeout": _number(request, "timeout", 1, 120, default=20),
        }
    if action == "observe":
        return {"no_text": _flag(request, "no_text")}
    raise Refusal("unknown_action", "unknown input action")


INPUT_KEYS = {"op", "fixture", "owner", "action", "target", "button", "double", "text",
              "chords", "axis", "notches", "at", "gone", "timeout", "no_text"}
OP_KEYS = {
    "start": {"op", "fixture", "checkout", "width"},
    "run-ui": {"op", "fixture", "owner"},
    "cli": {"op", "fixture", "owner", "args"},
    "input": INPUT_KEYS,
    "viewport": {"op", "fixture", "owner", "width"},
    "screenshot": {"op", "fixture", "owner", "name"},
    "status": {"op", "fixture", "owner"},
    "stop": {"op", "fixture", "owner", "keep"},
    # For a name left behind, whose owner token may be gone with its broker.
    "clear": {"op", "fixture"},
}
OPS_WITHOUT_OWNER = ("start", "clear")


def validate_request(request, repo):
    """Reduce a decoded request to the fields its operation allows."""
    if not isinstance(request, dict):
        raise Refusal("invalid_request", "a request is one JSON object")
    op = request.get("op")
    if not isinstance(op, str) or op not in OP_KEYS:
        raise Refusal("unknown_op", "unknown operation")
    # No environment, cwd or executable field can reach a sandboxed command.
    unexpected = set(request) - OP_KEYS[op]
    if unexpected:
        raise Refusal("invalid_request", f"unexpected fields: {sorted(unexpected)}")
    fixture = _matching(request, "fixture", FIXTURE_NAME)
    result = {"op": op, "fixture": fixture}
    if op not in OPS_WITHOUT_OWNER:
        result["owner"] = _matching(request, "owner", OWNER_TOKEN)
    if op == "start":
        result["checkout"] = validate_checkout(request.get("checkout"), repo)
        result["width"] = _width(request)
    elif op == "cli":
        args = request.get("args")
        if not isinstance(args, list) or not 1 <= len(args) <= MAX_ARGS:
            raise Refusal("invalid_request", f"args must list 1 to {MAX_ARGS} arguments")
        for argument in args:
            if not isinstance(argument, str) or "\0" in argument or len(argument) > MAX_TEXT:
                raise Refusal("invalid_request", "each argument must be text")
        result["args"] = args
    elif op == "input":
        result["action"] = request.get("action")
        result.update(_input_fields(request))
    elif op == "viewport":
        if "width" not in request:
            raise Refusal("invalid_request", "viewport needs a width")
        result["width"] = _width(request)
    elif op == "screenshot":
        result["name"] = _matching(request, "name", SHOT_NAME)
    elif op == "stop":
        result["keep"] = _flag(request, "keep")
    return result


# --------------------------------------------------------------------------
# Paths held by descriptor. A sandbox can rewrite what it can write, so a path
# checked earlier says nothing about what the same path names later.


NO_FOLLOW_DIRECTORY = os.O_PATH | os.O_NOFOLLOW | os.O_DIRECTORY | os.O_CLOEXEC


def hold_directory(base, parts, *, create=False):
    """Open base/parts..., refusing any component that is a symlink.

    base is a trusted starting point: the resolved repository or runtime directory.
    """
    descriptor = os.open(str(base), os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for part in parts:
            if create:
                try:
                    os.mkdir(part, mode=0o700, dir_fd=descriptor)
                except FileExistsError:
                    pass
            following = os.open(part, NO_FOLLOW_DIRECTORY, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = following
    except OSError as error:
        os.close(descriptor)
        if error.errno in (errno.ENOTDIR, errno.ELOOP):
            raise Refusal("path_escape", f"{'/'.join(parts)} under {base} is not a real directory") from None
        raise
    return descriptor


def hold_socket(directory, name):
    """Hold a socket in a directory the sandbox cannot write, or refuse."""
    base = os.open(str(directory), os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        held = os.open(name, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=base)
    finally:
        os.close(base)
    if not stat.S_ISSOCK(os.fstat(held).st_mode):
        os.close(held)
        raise Refusal("sandbox_failed", f"{name} is not a socket")
    return held


def _remove_entry(parent, name):
    """Remove one entry, repairing directory modes a sandbox may have revoked.

    The mode is changed through a descriptor already known to be a real
    directory, so a planted symlink is unlinked and never followed.
    """
    mode = os.stat(name, dir_fd=parent, follow_symlinks=False).st_mode
    if not stat.S_ISDIR(mode):
        os.unlink(name, dir_fd=parent)
        return
    held = os.open(name, NO_FOLLOW_DIRECTORY, dir_fd=parent)
    try:
        os.chmod(f"/proc/self/fd/{held}", 0o700)
        listing = os.open(f"/proc/self/fd/{held}", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            for entry in os.listdir(listing):
                _remove_entry(listing, entry)
        finally:
            os.close(listing)
    finally:
        os.close(held)
    os.rmdir(name, dir_fd=parent)


def remove_beneath(base, parts):
    """Remove base/parts... without following a symlink at any level.

    Returns False when it could not: a parent is not a real directory, or the
    tree resisted removal. It never raises for what a sandbox left behind.
    """
    try:
        parent = hold_directory(base, parts[:-1])
    except FileNotFoundError:
        return True
    except (Refusal, OSError):
        return False
    try:
        _remove_entry(parent, parts[-1])
    except FileNotFoundError:
        return True
    except (OSError, RecursionError):
        return False
    finally:
        os.close(parent)
    return True


def read_regular(base, parts, name, limit):
    """Read base/parts/name, which a sandbox could have replaced or redirected.

    No component may be a symlink, and a FIFO or device is refused unopened.
    """
    try:
        directory = hold_directory(base, parts)
    except (Refusal, OSError):
        return None
    try:
        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=directory)
    except OSError:
        return None
    finally:
        os.close(directory)
    with os.fdopen(descriptor, "rb") as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            return None
        return stream.read(limit)


# --------------------------------------------------------------------------
# Sandbox construction


@dataclass(frozen=True)
class Host:
    repo: Path
    home: Path
    runtime_dir: Path
    cargo_home: Path
    rustup_home: Path
    mise_data: Path
    harness: str = "niri-harness"
    niri: str = "niri"


@dataclass(frozen=True)
class Layout:
    host: Host
    name: str
    checkout: Path
    zig_dir: Path

    @property
    def root_parts(self):
        return (".worktrees", FIXTURE_DIR, self.name)

    @property
    def root(self):
        return self.host.repo.joinpath(*self.root_parts)

    @property
    def sandbox(self):
        # The only part of the fixture root a sandboxed process can write.
        return self.root / "sandbox"

    @property
    def target_parts(self):
        # One per checkout: a sandboxed build.rs can write here, so it must not
        # be repo/target, which the person's next ordinary run would execute,
        # or a directory shared with a different checkout's fixtures.
        relative = self.checkout.relative_to(self.host.repo / ".worktrees")
        digest = hashlib.sha256(str(relative).encode()).hexdigest()[:12]
        return (".worktrees", TARGETS_DIR, f"{relative.name}-{digest}")

    @property
    def target(self):
        return self.host.repo.joinpath(*self.target_parts)

    @property
    def private_parts(self):
        return (PRIVATE_DIR, self.name)

    @property
    def private(self):
        # Outside the sandbox and the agent's working tree. Not a security
        # boundary against the same user; it only stops casual or accidental edits.
        return self.host.runtime_dir.joinpath(*self.private_parts)

    @property
    def niri_root(self):
        return self.private / "niri"

    @property
    def harness_state(self):
        return self.private / "state"

    @property
    def shots(self):
        return self.root / "shots"

    @property
    def runtime_name(self):
        return f"nf-{self.name}"

    @property
    def runtime(self):
        # Mounted as XDG_RUNTIME_DIR inside; the short path keeps sockets legal.
        return self.host.runtime_dir / self.runtime_name

    @property
    def nested_wayland(self):
        return self.host.runtime_dir / "nested-wayland"

    @property
    def runner_log(self):
        return self.sandbox / "runner.log"

    @property
    def cli(self):
        return self.target / "dev-runtime" / "cagents"

    @property
    def sandbox_directories(self):
        return ("home", "data", "config", "cache", "cache/zig", "bin", "project")


def validate_target(layout):
    """Refuse a build directory outside the broker's own area."""
    area = layout.host.repo / ".worktrees" / TARGETS_DIR
    if area not in layout.target.parents:
        raise Refusal("invalid_target", f"the Cargo target must be beneath {area}")
    return layout.target


def git_common_dir(checkout, repo):
    """The repo's .git when this checkout is a linked worktree of it."""
    pointer = checkout / ".git"
    if not pointer.is_file() or pointer.is_symlink():
        return None
    common = (repo / ".git").resolve()
    if not common.is_dir():
        return None
    target = pointer.read_text(errors="replace").removeprefix("gitdir:").strip()
    return common if common in Path(target).resolve().parents else None


@dataclass
class Binds:
    """Descriptors for everything a sandbox mounts from a place that can change."""

    checkout: int
    target: int
    sandbox: int
    runtime: int
    wayland: int

    def fds(self):
        return (self.checkout, self.target, self.sandbox, self.runtime, self.wayland)

    def close(self):
        for descriptor in self.fds():
            os.close(descriptor)


def hold_binds(layout, wayland_directory, wayland_name):
    validate_target(layout)
    repo = layout.host.repo
    held = []
    try:
        for open_one in (
            lambda: hold_directory(repo, layout.checkout.relative_to(repo).parts),
            lambda: hold_directory(repo, layout.target_parts, create=True),
            lambda: hold_directory(repo, (*layout.root_parts, "sandbox")),
            lambda: hold_directory(layout.host.runtime_dir, (layout.runtime_name,)),
            lambda: hold_socket(wayland_directory, wayland_name),
        ):
            held.append(open_one())
    except BaseException:
        for descriptor in held:
            os.close(descriptor)
        raise
    return Binds(*held)


def sandbox_args(layout, binds):
    """bwrap arguments that decide what a fixture process can reach.

    Environment is deliberately absent: the holder starts from an empty one and
    each command receives sandbox_env.
    """
    host = layout.host
    args = [
        "--unshare-all",
        "--die-with-parent",
        "--cap-drop", "ALL",
        "--ro-bind", "/usr", "/usr",
        "--ro-bind", "/etc", "/etc",
    ]
    for name in ("bin", "sbin", "lib", "lib64"):
        path = Path("/") / name
        if path.is_symlink():
            args += ["--symlink", os.readlink(path), str(path)]
        elif path.is_dir():
            args += ["--ro-bind", str(path), str(path)]
    args += [
        "--proc", "/proc",
        "--dev", "/dev",
        "--dev-bind-try", "/dev/dri", "/dev/dri",
        "--ro-bind-try", "/sys", "/sys",
        "--tmpfs", "/tmp",
        "--tmpfs", "/var",
        # Cargo keeps its real paths, and its lock file lands on a tmpfs.
        # credentials.toml beside them is absent.
        "--tmpfs", str(host.cargo_home),
        "--ro-bind-try", str(host.cargo_home / "bin"), str(host.cargo_home / "bin"),
        "--ro-bind-try", str(host.cargo_home / "registry"), str(host.cargo_home / "registry"),
        "--ro-bind-try", str(host.cargo_home / "git"), str(host.cargo_home / "git"),
        "--ro-bind", str(host.rustup_home), str(host.rustup_home),
        "--ro-bind", str(layout.zig_dir), str(layout.zig_dir),
        "--ro-bind-fd", str(binds.checkout), str(layout.checkout),
    ]
    git = git_common_dir(layout.checkout, host.repo)
    if git is not None:
        args += ["--ro-bind", str(git), str(git)]
    args += [
        "--bind-fd", str(binds.target), str(layout.target),
        "--bind-fd", str(binds.sandbox), str(layout.sandbox),
        # Zig fetches into this cache; with no network it reads what exists.
        "--ro-bind-try", str(host.home / ".cache/zig/p"), str(layout.sandbox / "cache/zig/p"),
        "--bind-fd", str(binds.runtime), str(host.runtime_dir),
        "--bind-fd", str(binds.wayland), str(layout.nested_wayland),
        "--chdir", str(layout.sandbox / "project"),
        # Last, once every mount point exists: nothing can be planted at the root.
        "--remount-ro", "/",
    ]
    return args


def sandbox_env(layout):
    """The whole environment of a sandboxed process, built from nothing."""
    host = layout.host
    sandbox = layout.sandbox
    return {
        "HOME": str(sandbox / "home"),
        "USER": host.home.name,
        "LOGNAME": host.home.name,
        "LANG": "C.UTF-8",
        "TERM": "dumb",
        "TMPDIR": "/tmp",
        "XDG_RUNTIME_DIR": str(host.runtime_dir),
        "XDG_DATA_HOME": str(sandbox / "data"),
        "XDG_CONFIG_HOME": str(sandbox / "config"),
        "XDG_CACHE_HOME": str(sandbox / "cache"),
        "XDG_SESSION_TYPE": "wayland",
        "WAYLAND_DISPLAY": layout.nested_wayland.name,
        "PATH": ":".join(
            [str(sandbox / "bin"), str(host.cargo_home / "bin"), str(layout.zig_dir), SYSTEM_PATH]
        ),
        "CARGO_HOME": str(host.cargo_home),
        "RUSTUP_HOME": str(host.rustup_home),
        "RUSTUP_AUTO_INSTALL": "0",
        "CARGO_TARGET_DIR": str(layout.target),
        "CARGO_NET_OFFLINE": "true",
        "ZIG_GLOBAL_CACHE_DIR": str(sandbox / "cache/zig"),
    }


# Runs inside the sandbox on a socketpair inherited from the broker, so no path
# exists for sandbox code to redirect, and EOF ends the sandbox with the broker.
# One long-lived process gives every fixture command one PID namespace: the
# daemon can name its peers, and a daemon a CLI command autostarted outlives it.
RELAY = r"""
import json, socket, subprocess, sys, tempfile
LIMIT = %d
children = {}
def tail(stream):
    size = stream.seek(0, 2)
    stream.seek(max(0, size - LIMIT))
    return stream.read().decode("utf-8", "replace")
def run(request):
    name = request.get("poll")
    if name is not None:
        child = children.get(name)
        return {"state": "not_started" if child is None else "running" if child.poll() is None else f"exited_{child.returncode}"}
    spawn = dict(args=request["argv"], cwd=request["cwd"], env=request.get("env"), stdin=subprocess.DEVNULL, start_new_session=True)
    try:
        if "log" in request:
            with open(request["log"], "ab") as log:
                children[request["background"]] = subprocess.Popen(stdout=log, stderr=subprocess.STDOUT, **spawn)
            return {"state": "running"}
        with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
            done = subprocess.run(stdout=out, stderr=err, timeout=request["timeout"], **spawn)
            return {"exit_code": done.returncode, "stdout": tail(out), "stderr": tail(err)}
    except subprocess.TimeoutExpired:
        return {"timed_out": True}
    except OSError as error:
        return {"exit_code": 127, "stdout": "", "stderr": str(error)}
channel = socket.socket(fileno=int(sys.argv[1]))
with channel.makefile("rwb") as stream:
    stream.write(b'{"id": 0, "ready": true}\n')
    stream.flush()
    for line in stream:
        request = json.loads(line)
        reply = run(request)
        reply["id"] = request["id"]
        stream.write(json.dumps(reply).encode() + b"\n")
        stream.flush()
""" % MAX_OUTPUT_BYTES


def relay_command(descriptor):
    return ["/usr/bin/python3", "-I", "-c", RELAY, str(descriptor)]


def holder_argv(layout, binds, info_fd, relay_fd):
    return [
        "/usr/bin/prlimit", *SANDBOX_RLIMITS,
        "/usr/bin/bwrap", "--info-fd", str(info_fd),
        *sandbox_args(layout, binds),
        "--", *relay_command(relay_fd),
    ]


class RelayChannel:
    """The broker's end of the socketpair. Replies are untrusted and bounded."""

    def __init__(self, connection):
        self.connection = connection
        self.buffer = b""
        self.next_id = 0
        self.broken = False

    def close(self):
        self.broken = True
        self.connection.close()

    def read_reply(self, timeout):
        deadline = time.monotonic() + timeout
        while b"\n" not in self.buffer:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise Refusal("timeout", "the fixture sandbox did not answer in time")
            self.connection.settimeout(remaining)
            try:
                data = self.connection.recv(65536)
            except TimeoutError:
                raise Refusal("timeout", "the fixture sandbox did not answer in time") from None
            except OSError as error:
                raise Refusal("sandbox_failed", f"the fixture sandbox did not answer: {error}") from None
            if not data:
                raise Refusal("sandbox_failed", "the fixture sandbox closed the connection")
            self.buffer += data
            if len(self.buffer) > MAX_RELAY_REPLY_BYTES:
                raise Refusal("sandbox_failed", "the fixture sandbox sent too much")
        line, _, self.buffer = self.buffer.partition(b"\n")
        if len(line) > MAX_RELAY_REPLY_BYTES:
            raise Refusal("sandbox_failed", "the fixture sandbox sent too much")
        try:
            reply = json.loads(line)
        except (ValueError, UnicodeDecodeError, RecursionError):
            raise Refusal("sandbox_failed", "the fixture sandbox sent a malformed reply") from None
        if not isinstance(reply, dict):
            raise Refusal("sandbox_failed", "the fixture sandbox sent a malformed reply")
        return reply

    def await_ready(self, timeout):
        reply = self._checked(lambda: self.read_reply(timeout))
        if reply.get("id") != 0 or reply.get("ready") is not True:
            self.broken = True
            raise Refusal("sandbox_failed", "the fixture sandbox sent a malformed greeting")

    def _checked(self, read):
        try:
            return read()
        except Refusal:
            # A late reply would answer the wrong request, so the channel is done.
            self.broken = True
            raise

    def call(self, request, timeout):
        if self.broken:
            raise Refusal("sandbox_failed", "the fixture sandbox channel has failed; stop this fixture")
        self.next_id += 1
        payload = json.dumps({**request, "id": self.next_id}).encode() + b"\n"
        try:
            self.connection.settimeout(timeout)
            self.connection.sendall(payload)
        except OSError as error:
            self.broken = True
            raise Refusal("sandbox_failed", f"the fixture sandbox did not answer: {error}") from None
        reply = self._checked(lambda: self.read_reply(timeout))
        if reply.get("id") != self.next_id:
            self.broken = True
            raise Refusal("sandbox_failed", "the fixture sandbox answered a different request")
        return reply


def command_result(reply):
    """Keep only well-typed fields from what a sandbox says a command did."""
    if reply.get("timed_out") is True:
        raise Refusal("timeout", "the command did not finish in time")
    code, out, err = reply.get("exit_code"), reply.get("stdout"), reply.get("stderr")
    if isinstance(code, bool) or not isinstance(code, int) or not isinstance(out, str) or not isinstance(err, str):
        raise Refusal("sandbox_failed", "the fixture sandbox sent a malformed result")
    return {"exit_code": code, "stdout": out[-MAX_OUTPUT_BYTES:], "stderr": err[-MAX_OUTPUT_BYTES:]}


def runner_command(layout):
    return [
        str(layout.checkout / "scripts/run-development"),
        "--browserless", "--debug", "--log-file", str(layout.sandbox / "ui.log"),
    ]


def binary_belongs_to(dep_info, checkout):
    """True when Cargo's dep-info says these sources built this binary."""
    return dep_info is not None and (str(checkout) + "/").encode() in dep_info


def input_argv(request):
    """Arguments after the harness's global flags. `--` keeps text from being flags."""
    action = request["action"]
    if action == "click":
        extra = ["--button", request["button"]] + (["--double"] if request["double"] else [])
        return ["click", *extra, "--", request["target"]]
    if action == "move":
        return ["move", "--", request["target"]]
    if action == "type":
        return ["type", "--", request["text"]]
    if action == "key":
        return ["key", "--", *request["chords"]]
    if action == "scroll":
        extra = ["--at", request["at"]] if "at" in request else []
        return ["scroll", *extra, "--", request["axis"], str(request["notches"])]
    if action == "wait":
        extra = ["--gone"] if request["gone"] else []
        return ["wait", *extra, "--timeout", str(request["timeout"]), "--", request["text"]]
    if action == "observe":
        return ["observe", *(["--no-text"] if request["no_text"] else [])]
    raise Refusal("unknown_action", "unknown input action")


def harness_argv(host, name, command):
    return [host.harness, "--session", name, "--json", *command]


def bounded(data):
    return data[-MAX_OUTPUT_BYTES:].decode("utf-8", "replace")


def scale_for_width(physical_width, width):
    """The nested output scale giving this logical width, within niri's range."""
    return round(max(0.5, min(4.0, physical_width / width)), 3)


def focus_to_restore(previous, windows_before, windows_now):
    """Which host window to refocus after the nested session opens, if any.

    Only when the new nested window took focus and the earlier one still exists.
    A window that closed meanwhile, or a person's own later choice, is left alone.
    """
    if previous is None:
        return None
    present = {window.get("id") for window in windows_now}
    if previous not in present:
        return None
    focused = [window.get("id") for window in windows_now if window.get("is_focused")]
    if not focused or focused[0] == previous or focused[0] in windows_before:
        return None
    return previous


# --------------------------------------------------------------------------
# Fixture lifecycle


@dataclass(eq=False)
class Fixture:
    layout: Layout
    owner: str
    lock: threading.Lock = field(default_factory=threading.Lock)
    # Keeps a kill from using a descriptor number another thread has just closed.
    kill_lock: threading.Lock = field(default_factory=threading.Lock)
    process: subprocess.Popen = None
    holder_pid: int = None
    pidfd: int = None
    channel: RelayChannel = None
    nested_socket: str = None
    runner_started: bool = False
    width: int = DEFAULT_WIDTH
    stopped: bool = False


class Spawner:
    """Start processes from one thread that lives as long as the broker.

    A parent-death signal fires when the creating thread ends, not the process,
    so a sandbox started from a request thread would die with that request.
    """

    def __init__(self):
        self.jobs = queue.Queue()
        threading.Thread(target=self._serve, daemon=True, name="sandbox-spawner").start()

    def _serve(self):
        while True:
            job, finished = self.jobs.get()
            try:
                finished.put((True, job()))
            except BaseException as error:
                finished.put((False, error))

    def run(self, job):
        finished = queue.Queue(maxsize=1)
        self.jobs.put((job, finished))
        succeeded, value = finished.get()
        if not succeeded:
            raise value
        return value


class Fixtures:
    # Empty so nothing from this person's terminal is readable through the
    # sandbox's /proc. Contract tests set these to keep their own environment.
    holder_environment = {}
    environment_for = staticmethod(sandbox_env)

    def __init__(self, host, harness_env):
        self.host = host
        self.harness_env = harness_env
        self.lock = threading.Lock()
        self.live = {}
        self.clearing = set()
        # Separate targets mean Cargo's own lock cannot keep two cold builds apart.
        self.build_lock = threading.Lock()
        self.spawner = Spawner()

    def handle(self, request):
        op = request["op"]
        if op == "start":
            return self.start(request)
        if op == "clear":
            return self.clear(request)
        fixture = self.live.get(request["fixture"])
        if fixture is None:
            raise Refusal("unknown_fixture", "this broker does not own a fixture by that name")
        if not hmac.compare_digest(fixture.owner, request["owner"]):
            raise Refusal("wrong_owner", "another start owns this fixture; use the owner it returned")
        if op == "stop":
            # Before the lock, so a slow command cannot delay the end of the sandbox.
            self._kill_holder(fixture)
        if not fixture.lock.acquire(timeout=LOCK_SECONDS):
            raise Refusal("busy", "another request on this fixture has not finished")
        try:
            # A stop may have finished, and a new start reused the name, while
            # this request waited; it must not act on what it looked up.
            if fixture.stopped:
                raise Refusal("unknown_fixture", "that fixture has stopped")
            if op != "stop" and not self._holder_alive(fixture):
                raise Refusal("fixture_dead", "the fixture sandbox has exited; stop it and start again")
            return getattr(self, op.replace("-", "_"))(fixture, request)
        finally:
            fixture.lock.release()

    def harness(self, layout, command, timeout=HARNESS_SECONDS):
        return subprocess.run(
            command,
            env={**self.harness_env, "NIRI_HARNESS_STATE": str(layout.harness_state)},
            stdin=subprocess.DEVNULL,
            capture_output=True,
            timeout=timeout,
            start_new_session=True,
        )

    def layout_for(self, name, checkout):
        pin = ZIG_VERSION.search((checkout / "mise.toml").read_text(errors="replace"))
        if pin is None:
            raise Refusal("invalid_checkout", "mise.toml does not pin a Zig version")
        zig_dir = self.host.mise_data / "installs/zig" / pin.group(1)
        if not (zig_dir / "zig").is_file():
            zig_dir = zig_dir / "bin"
        if not (zig_dir / "zig").is_file():
            raise Refusal("missing_toolchain", f"Zig {pin.group(1)} is not installed")
        return Layout(self.host, name, checkout, zig_dir)

    def start(self, request):
        name = request["fixture"]
        with self.lock:
            if name in self.live or name in self.clearing:
                raise Refusal("fixture_exists", "a live fixture already has that name")
            if len(self.live) >= MAX_LIVE_FIXTURES:
                raise Refusal("too_many_fixtures", f"at most {MAX_LIVE_FIXTURES} fixtures can run at once")
            layout = self.layout_for(name, request["checkout"])
            if os.path.lexists(layout.root):
                raise Refusal("fixture_exists", f"run `scripts/native-fixture clear {name}` first")
            fixture = Fixture(layout, secrets.token_hex(16))
            self.live[name] = fixture
        with fixture.lock:
            try:
                viewport = self._create(fixture, request["width"])
            except BaseException:
                # Frees the name: nothing is left to clear after a failed start.
                self._kill_holder(fixture)
                try:
                    self._discard(layout, remove=True)
                finally:
                    self._release(fixture)
                    fixture.stopped = True
                    self.live.pop(name, None)
                raise
        return {
            "fixture": name,
            "owner": fixture.owner,
            "root": str(layout.root),
            "checkout": str(layout.checkout),
            "target": str(layout.target),
            "fixture_home": str(layout.sandbox / "home"),
            "shots": str(layout.shots),
            "viewport": viewport,
        }

    def _create(self, fixture, width):
        layout = fixture.layout
        repo = self.host.repo
        for parts in (
            (*layout.root_parts, "shots"),
            *((*layout.root_parts, "sandbox", *name.split("/")) for name in layout.sandbox_directories),
        ):
            os.close(hold_directory(repo, parts, create=True))
        os.close(hold_directory(self.host.runtime_dir, (layout.runtime_name,), create=True))
        for name in ("niri", "state"):
            os.close(hold_directory(self.host.runtime_dir, (*layout.private_parts, name), create=True))
        provider = hold_directory(repo, (*layout.root_parts, "sandbox", "bin"))
        try:
            os.symlink(layout.checkout / "tests/fixtures/chat-composer-claude.sh", "claude", dir_fd=provider)
        finally:
            os.close(provider)

        previous, before = self._host_focus()
        started = self.harness(
            layout,
            [
                self.host.harness, "session", "start", layout.name,
                "--root", str(layout.niri_root),
                "--no-window-wait",
                # The sandbox is this broker's own child, so nested niri runs nothing.
                "--cmd", "/usr/bin/true",
            ],
        )
        # --no-window-wait returns before niri-harness hands focus back.
        self._restore_host_focus(previous, before)
        if started.returncode:
            raise Refusal("harness_failed", bounded(started.stderr or started.stdout))
        display, fixture.nested_socket = self._nested_session(layout)
        self._spawn_holder(fixture, display)
        initialized = self._in_sandbox(fixture, ["/usr/bin/git", "init", "--quiet", "--initial-branch=main", "."])
        if initialized["exit_code"]:
            raise Refusal("sandbox_failed", initialized["stderr"])
        return self._apply_viewport(fixture, width)

    def _nested_session(self, layout):
        handshake = read_regular(self.host.runtime_dir, (*layout.private_parts, "niri"), "session.env", 4096)
        text = (handshake or b"").decode("utf-8", "replace")
        display, nested = NESTED_DISPLAY.search(text), NESTED_SOCKET.search(text)
        if not display or not nested:
            raise Refusal("harness_failed", "the nested session did not report its sockets")
        return display.group(1), nested.group(1)

    def _spawn_holder(self, fixture, display):
        layout = fixture.layout
        binds = hold_binds(layout, self.host.runtime_dir, display)
        read_info, write_info = os.pipe()
        ours, theirs = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
        fixture.channel = RelayChannel(ours)
        try:
            argv = holder_argv(layout, binds, write_info, theirs.fileno())
            fixture.process = self.spawner.run(
                lambda: subprocess.Popen(
                    argv,
                    env=self.holder_environment,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    pass_fds=(*binds.fds(), write_info, theirs.fileno()),
                    start_new_session=True,
                )
            )
            # Held from the moment it exists, so every failure below can end it.
            fixture.pidfd = os.pidfd_open(fixture.process.pid)
        finally:
            binds.close()
            os.close(write_info)
            theirs.close()
        try:
            fixture.holder_pid = self._read_holder_pid(read_info)
        finally:
            os.close(read_info)
        # The sandbox's own PID 1. Ending it ends every process in the namespace.
        inner = os.pidfd_open(fixture.holder_pid)
        with fixture.kill_lock:
            os.close(fixture.pidfd)
            fixture.pidfd = inner
        fixture.channel.await_ready(HOLDER_START_SECONDS)

    def _read_holder_pid(self, descriptor):
        deadline = time.monotonic() + HOLDER_START_SECONDS
        data = b""
        while len(data) < 4096:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not select.select([descriptor], [], [], remaining)[0]:
                raise Refusal("sandbox_failed", "the fixture sandbox did not start in time")
            chunk = os.read(descriptor, 4096)
            if not chunk:
                break
            data += chunk
        try:
            pid = json.loads(data)["child-pid"]
        except (ValueError, KeyError, TypeError):
            raise Refusal("sandbox_failed", "the fixture sandbox did not start") from None
        if not isinstance(pid, int) or isinstance(pid, bool):
            raise Refusal("sandbox_failed", "the fixture sandbox did not start")
        return pid

    def _holder_alive(self, fixture):
        if fixture.pidfd is None:
            return False
        return not select.select([fixture.pidfd], [], [], 0)[0]

    def _kill_holder(self, fixture):
        """End the sandbox. Unconditional: no sandbox-writable state is consulted."""
        with fixture.kill_lock:
            if fixture.pidfd is not None:
                try:
                    signal.pidfd_send_signal(fixture.pidfd, signal.SIGKILL)
                except OSError:
                    pass
            process = fixture.process
        if process is not None:
            process.kill()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                pass

    def _release(self, fixture):
        with fixture.kill_lock:
            if fixture.pidfd is not None:
                os.close(fixture.pidfd)
                fixture.pidfd = None
        if fixture.channel is not None:
            fixture.channel.close()

    def _host_focus(self):
        focused = self._niri_json(self.harness_env, "focused-window")
        windows = self._niri_json(self.harness_env, "windows")
        ids = {w.get("id") for w in windows} if isinstance(windows, list) else set()
        return (focused.get("id") if isinstance(focused, dict) else None), ids

    def _restore_host_focus(self, previous, before):
        windows = self._niri_json(self.harness_env, "windows")
        target = focus_to_restore(previous, before, windows if isinstance(windows, list) else [])
        if target is None:
            return
        try:
            subprocess.run(
                [self.host.niri, "msg", "action", "focus-window", "--id", str(target)],
                env=self.harness_env, capture_output=True, timeout=5, stdin=subprocess.DEVNULL,
            )
        except (OSError, subprocess.SubprocessError):
            pass

    def _niri_json(self, env, query):
        try:
            output = subprocess.run(
                [self.host.niri, "msg", "--json", query],
                env=env, capture_output=True, timeout=5, stdin=subprocess.DEVNULL,
            )
            return json.loads(output.stdout or b"null")
        except (OSError, ValueError, subprocess.SubprocessError):
            return None

    def _nested_env(self, fixture):
        return {**self.harness_env, "NIRI_SOCKET": fixture.nested_socket}

    def _nested_output(self, fixture):
        outputs = self._niri_json(self._nested_env(fixture), "outputs")
        if not isinstance(outputs, dict) or not outputs:
            return None, None
        name, output = next(iter(outputs.items()))
        logical = output.get("logical") if isinstance(output, dict) else None
        return name, logical if isinstance(logical, dict) else None

    def _apply_viewport(self, fixture, width):
        """Set the logical width by nested output scale, as niri-harness's own --width does.

        The framebuffer is laid out by the host, so its height and physical size
        are reported rather than promised. Compare these across a before/after pair.
        """
        fixture.width = width
        name, logical = self._nested_output(fixture)
        if logical is None:
            raise Refusal("viewport_failed", "the nested session reports no output")
        physical = logical["width"] * logical["scale"]
        scale = scale_for_width(physical, width)
        subprocess.run(
            [self.host.niri, "msg", "output", name, "scale", str(scale)],
            env=self._nested_env(fixture), capture_output=True, timeout=10, stdin=subprocess.DEVNULL,
        )
        # Reporting before niri applies the scale would describe the old layout.
        deadline = time.monotonic() + VIEWPORT_APPLY_SECONDS
        while True:
            _name, logical = self._nested_output(fixture)
            if logical is not None and abs(logical["scale"] - scale) < 0.001:
                break
            if time.monotonic() >= deadline:
                break
            time.sleep(VIEWPORT_POLL_SECONDS)
        return self._viewport_report(fixture, width)

    def _viewport_report(self, fixture, requested):
        _name, logical = self._nested_output(fixture)
        if logical is None:
            raise Refusal("viewport_failed", "the nested session reports no output")
        report = {
            "requested_width": requested,
            "width": logical["width"],
            "height": logical["height"],
            "scale": logical["scale"],
        }
        report["matches"] = abs(logical["width"] - requested) <= 1
        return report

    def _fit_viewport(self, fixture):
        """Fit again if the host has resized the nested window since the last fit.

        The window's final size is the host's to decide and can arrive after start.
        """
        try:
            report = self._viewport_report(fixture, fixture.width)
            if not report["matches"]:
                report = self._apply_viewport(fixture, fixture.width)
            return report
        except (Refusal, OSError, KeyError, TypeError, subprocess.SubprocessError) as error:
            return {"requested_width": fixture.width, "matches": False, "error": str(error)}

    def viewport(self, fixture, request):
        return self._apply_viewport(fixture, request["width"])

    def _in_sandbox(self, fixture, command, timeout=CLI_SECONDS):
        layout = fixture.layout
        reply = fixture.channel.call(
            {"argv": command, "cwd": str(layout.sandbox / "project"),
             "env": self.environment_for(layout), "timeout": timeout},
            timeout + 5,
        )
        return command_result(reply)

    def _runner_state(self, fixture):
        state = fixture.channel.call({"poll": "runner"}, 10).get("state")
        if not isinstance(state, str) or not RUNNER_STATE.fullmatch(state):
            raise Refusal("sandbox_failed", "the fixture sandbox sent a malformed state")
        return state

    def _is_building(self, fixture):
        """Whether this fixture's runner has not reached launching its UI yet."""
        if fixture.stopped or not fixture.runner_started:
            return False
        layout = fixture.layout
        log = read_regular(self.host.repo, (*layout.root_parts, "sandbox"), layout.runner_log.name, MAX_RUNNER_LOG_BYTES)
        if log is not None and BUILD_FINISHED_MARKER in log:
            return False
        if not fixture.lock.acquire(blocking=False):
            return True  # It is busy, and it cannot be shown to have finished.
        try:
            return self._holder_alive(fixture) and self._runner_state(fixture) == "running"
        except Refusal:
            return False
        finally:
            fixture.lock.release()

    def run_ui(self, fixture, _request):
        with self.build_lock:
            for other in list(self.live.values()):
                if other is not fixture and self._is_building(other):
                    raise Refusal(
                        "build_busy",
                        f"fixture {other.layout.name} is still building; retry run-ui when its status "
                        "says building is false, because two builds must not run at once",
                    )
            return self._start_runner(fixture)

    def _start_runner(self, fixture):
        if self._runner_state(fixture) == "running":
            raise Refusal("runner_active", "the development runner is already running")
        layout = fixture.layout
        reply = fixture.channel.call(
            {"argv": runner_command(layout), "cwd": str(layout.checkout),
             "env": self.environment_for(layout), "background": "runner", "log": str(layout.runner_log)},
            10,
        )
        if reply.get("state") != "running":
            raise Refusal("sandbox_failed", "the development runner did not start")
        fixture.runner_started = True
        return {
            "state": "building_then_launching",
            "checkout": str(layout.checkout),
            "runner_log": str(layout.runner_log),
            "ui_log": str(layout.sandbox / "ui.log"),
        }

    def _cli_built(self, fixture):
        """Built by this fixture's runner, from this fixture's checkout."""
        layout = fixture.layout
        dep_info = read_regular(self.host.repo, (*layout.target_parts, "dev-runtime"), "cagents.d", MAX_DEP_INFO_BYTES)
        return fixture.runner_started and binary_belongs_to(dep_info, layout.checkout)

    def cli(self, fixture, request):
        if not self._cli_built(fixture):
            raise Refusal("cli_not_built", "this fixture's run-ui has not built its cagents CLI yet")
        return self._in_sandbox(fixture, [str(fixture.layout.cli), *request["args"]])

    def _drive(self, fixture, command):
        try:
            result = self.harness(fixture.layout, harness_argv(self.host, fixture.layout.name, command))
        except subprocess.TimeoutExpired:
            raise Refusal("timeout", "niri-harness did not finish") from None
        return {
            "exit_code": result.returncode,
            "stdout": bounded(result.stdout),
            "stderr": bounded(result.stderr),
        }

    def input(self, fixture, request):
        self._fit_viewport(fixture)
        return self._drive(fixture, input_argv(request))

    def screenshot(self, fixture, request):
        layout = fixture.layout
        viewport = self._fit_viewport(fixture)
        result = self._drive(fixture, ["shot", "--", request["name"]])
        file_name = f"{request['name']}.png"
        image = read_regular(
            self.host.runtime_dir, (*layout.private_parts, "niri", "shots"), file_name, 64 * 1024 * 1024
        )
        if result["exit_code"] == 0 and image is not None:
            shots = hold_directory(self.host.repo, (*layout.root_parts, "shots"))
            try:
                output = os.open(
                    file_name,
                    os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC,
                    0o600,
                    dir_fd=shots,
                )
            finally:
                os.close(shots)
            with os.fdopen(output, "wb") as stream:
                stream.write(image)
            result["path"] = str(layout.shots / file_name)
        result["viewport"] = viewport
        return result

    def status(self, fixture, _request):
        layout = fixture.layout
        return {
            "fixture": layout.name,
            "root": str(layout.root),
            "checkout": str(layout.checkout),
            "target": str(layout.target),
            "runner": self._runner_state(fixture),
            "cli_built": self._cli_built(fixture),
            "building": self._building_now(fixture),
        }

    def _building_now(self, fixture):
        """_is_building, for a caller that already holds this fixture's lock."""
        if not fixture.runner_started:
            return False
        layout = fixture.layout
        log = read_regular(self.host.repo, (*layout.root_parts, "sandbox"), layout.runner_log.name, MAX_RUNNER_LOG_BYTES)
        if log is not None and BUILD_FINISHED_MARKER in log:
            return False
        return self._runner_state(fixture) == "running"

    def stop(self, fixture, request):
        layout = fixture.layout
        self._kill_holder(fixture)
        keep = bool(request.get("keep"))
        try:
            left_behind = self._discard(layout, remove=not keep)
        finally:
            # The fixture is over whatever cleanup managed; its name must not stick.
            self._release(fixture)
            fixture.stopped = True
            with self.lock:
                if self.live.get(layout.name) is fixture:
                    del self.live[layout.name]
        return {
            "fixture": layout.name,
            "kept": keep,
            "removed": not keep and str(layout.root) not in left_behind,
            "left_behind": left_behind,
        }

    def _discard(self, layout, *, remove):
        """Stop the nested session and remove broker state; name what remains."""
        try:
            self.harness(layout, [self.host.harness, "session", "stop", layout.name], timeout=30)
        except (OSError, subprocess.SubprocessError):
            pass
        left_behind = []
        if not remove_beneath(self.host.runtime_dir, layout.private_parts):
            left_behind.append(str(layout.private))
        if not remove_beneath(self.host.runtime_dir, (layout.runtime_name,)):
            left_behind.append(str(layout.runtime))
        if remove and not remove_beneath(self.host.repo, layout.root_parts):
            left_behind.append(str(layout.root))
        return left_behind

    def clear(self, request):
        """Recover a name no live fixture holds, including after a killed broker."""
        name = request["fixture"]
        with self.lock:
            if name in self.live or name in self.clearing:
                raise Refusal("fixture_exists", "that fixture is live; stop it instead")
            # Held to the end, so a start cannot create what this is removing.
            self.clearing.add(name)
        try:
            placeholder = Layout(self.host, name, self.host.repo / ".worktrees" / name, Path("/"))
            left_behind = self._discard(placeholder, remove=True)
        finally:
            with self.lock:
                self.clearing.discard(name)
        if left_behind:
            raise Refusal("not_removed", f"could not remove: {', '.join(left_behind)}")
        return {"fixture": name, "cleared": True}

    def recover_stale(self):
        """At startup every fixture on disk is stale: its broker is gone.

        Returns the names recovered and a message for each that was not.
        """
        private = self.host.runtime_dir / PRIVATE_DIR
        try:
            names = [path.name for path in private.iterdir() if FIXTURE_NAME.fullmatch(path.name)]
        except OSError:
            return [], []
        recovered, problems = [], []
        for name in names:
            placeholder = Layout(self.host, name, self.host.repo / ".worktrees" / name, Path("/"))
            try:
                left_behind = self._discard(placeholder, remove=False)
            except Exception as error:
                problems.append(f"{name}: {type(error).__name__}: {error}")
                continue
            if left_behind:
                problems.append(f"{name}: could not remove {', '.join(left_behind)}")
            else:
                recovered.append(name)
        return recovered, problems

    def stop_all(self):
        """End every sandbox first; then clean up as far as a bounded wait allows.

        Returns a message for each fixture it could not finish, and never raises.
        """
        fixtures = list(self.live.values())
        for fixture in fixtures:
            self._kill_holder(fixture)
        problems = []
        for fixture in fixtures:
            name = fixture.layout.name
            if not fixture.lock.acquire(timeout=STOP_ALL_LOCK_SECONDS):
                problems.append(f"{name}: busy; its sandbox was ended and its directories remain")
                continue
            try:
                if not fixture.stopped:
                    left_behind = self.stop(fixture, {"keep": True})["left_behind"]
                    if left_behind:
                        problems.append(f"{name}: could not remove {', '.join(left_behind)}")
            except Exception as error:
                problems.append(f"{name}: {type(error).__name__}: {error}")
            finally:
                fixture.lock.release()
        return problems


# --------------------------------------------------------------------------
# Socket protocol: one JSON line each way, one request per connection


def peer_uid(connection):
    data = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    return struct.unpack("3i", data)[1]


def answer(raw, repo, handler):
    """Turn one request line into one response object."""
    try:
        if len(raw) >= MAX_REQUEST_BYTES:
            raise Refusal("invalid_request", "the request is too large")
        try:
            decoded = json.loads(raw)
        except (ValueError, UnicodeDecodeError, RecursionError):
            raise Refusal("invalid_request", "a request is one JSON object") from None
        return {"ok": True, "result": handler(validate_request(decoded, repo))}
    except Refusal as refusal:
        return {"ok": False, "code": refusal.code, "detail": refusal.detail}
    except Exception as error:  # A failed fixture must not take down the others.
        return {"ok": False, "code": "internal_error", "detail": f"{type(error).__name__}: {error}"}


class Connection(socketserver.StreamRequestHandler):
    # Applied to the socket, so a silent client cannot hold its thread forever.
    timeout = CLIENT_READ_SECONDS

    def handle(self):
        if peer_uid(self.request) != os.getuid():
            return
        try:
            raw = self.rfile.readline(MAX_REQUEST_BYTES)
        except TimeoutError:
            return
        response = answer(raw, self.server.repo, self.server.handler)
        try:
            self.wfile.write(json.dumps(response).encode() + b"\n")
        except (OSError, TimeoutError):
            pass  # The client left; there is nobody to tell.


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True
    # Removal of a live socket is decided by prepare_socket, never by a reuse flag.
    allow_reuse_address = False
    request_queue_size = MAX_CONNECTIONS

    def __init__(self, path, repo, handler):
        self.repo = repo
        self.handler = handler
        self.slots = threading.BoundedSemaphore(MAX_CONNECTIONS)
        prepare_socket(path)
        previous = os.umask(0o177)
        try:
            super().__init__(str(path), Connection)
        finally:
            os.umask(previous)
        os.chmod(path, 0o600)

    def verify_request(self, request, client_address):
        return self.slots.acquire(blocking=False)

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self.slots.release()


def prepare_socket(path):
    """Replace only a socket nothing is listening on."""
    try:
        mode = os.lstat(path).st_mode
    except FileNotFoundError:
        return
    if not stat.S_ISSOCK(mode):
        raise Refusal("socket_path_in_use", f"{path} exists and is not a socket")
    probe = socket.socket(socket.AF_UNIX)
    try:
        probe.connect(str(path))
    except OSError:
        os.unlink(path)
    else:
        raise Refusal("broker_running", f"a broker is already listening at {path}")
    finally:
        probe.close()


# --------------------------------------------------------------------------
# Entry point


def repository_root(script):
    """The main checkout this script belongs to, also from a linked worktree."""
    checkout = script.resolve().parents[1]
    marker = checkout / ".git"
    if marker.is_file():
        target = marker.read_text(errors="replace").removeprefix("gitdir:").strip()
        return Path(target).resolve().parents[2]
    return checkout


def host_from_environment():
    environ = os.environ
    home = Path(environ["HOME"])
    return Host(
        repo=repository_root(Path(__file__)),
        home=home,
        runtime_dir=Path(environ["XDG_RUNTIME_DIR"]).resolve(),
        cargo_home=Path(environ.get("CARGO_HOME", home / ".cargo")),
        rustup_home=Path(environ.get("RUSTUP_HOME", home / ".rustup")),
        mise_data=Path(environ.get("MISE_DATA_DIR", home / ".local/share/mise")),
        harness=shutil.which("niri-harness") or "niri-harness",
        niri=shutil.which("niri") or "niri",
    )


def missing_requirements():
    missing = [name for name in ("WAYLAND_DISPLAY", "NIRI_SOCKET", "XDG_RUNTIME_DIR", "HOME")
               if not os.environ.get(name)]
    missing += [tool for tool in ("niri-harness", "niri") if shutil.which(tool) is None]
    missing += [tool for tool in ("/usr/bin/bwrap", "/usr/bin/prlimit", "/usr/bin/python3")
                if not os.access(tool, os.X_OK)]
    return missing


def install_termination():
    """Turn every polite end, including a closed terminal, into orderly cleanup."""
    def terminate(_signal, _frame):
        raise KeyboardInterrupt
    for number in TERMINATION_SIGNALS:
        signal.signal(number, terminate)


def main(argv=None):
    # First, before reading arguments, so nothing runs where authority exists.
    refused = guard()
    if refused is not None:
        return refused
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--check-guard", action="store_true",
                        help="report that this shell may start a broker, and exit")
    arguments = parser.parse_args(argv)
    if arguments.check_guard:
        print("No agent authority is present or inherited.")
        return 0
    missing = missing_requirements()
    if missing:
        print(f"native-fixture-broker needs a niri session and: {', '.join(missing)}", file=sys.stderr)
        return 2
    host = host_from_environment()
    fixtures = Fixtures(host, dict(os.environ))
    path = host.runtime_dir / SOCKET_NAME
    try:
        server = Server(path, host.repo, fixtures.handle)
    except Refusal as refusal:
        print(refusal.detail, file=sys.stderr)
        return 1
    install_termination()
    # After the socket, which proves no other broker owns these sessions.
    recovered, problems = fixtures.recover_stale()
    for name in recovered:
        print(f"recovered stale fixture session {name}; `clear` removes its directory", flush=True)
    for problem in problems:
        print(f"could not recover a stale fixture session: {problem}", file=sys.stderr, flush=True)

    digest = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    print(f"native-fixture-broker listening at {path}", flush=True)
    print(f"script {Path(__file__).resolve()} sha256 {digest}", flush=True)
    print(f"sandboxed builds write beneath {host.repo / '.worktrees' / TARGETS_DIR}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        for problem in fixtures.stop_all():
            print(f"fixture cleanup incomplete: {problem}", file=sys.stderr, flush=True)
        server.server_close()
        Path(path).unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
