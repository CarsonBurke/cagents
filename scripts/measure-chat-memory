#!/usr/bin/env python3
"""Repeatable, offline native-chat memory workload; Linux and Python stdlib only.

Run prepare, then run inside an owned native compositor. In a second terminal,
seed while that runner holds the shared build lock. Supply the runner's matched
cagents executable explicitly. sample refuses a PID outside the private fixture.
The run action owns native/build locks; do not nest it under another build lock.
It uses the runner's dev-runtime profile on both revisions, never a release baseline.

Record these stages on BOTH revisions, with the same viewport and renderer:
small (one normal chat), restore100, visit20 (scroll each), hidden20 (focus the
small chat), closed100, then repeat the same seed/visit/hide/close cycle twice.
Use a 1280x900 logical viewport at scale 1.0. Visit the next 20 panes with
Ctrl+PageDown; in each send eight wheel notches down and eight up, then focus
the small chat to hide them. Wait 10 seconds before each 10 second sample. Close
only minted actor IDs with the close action. After seeding, restart only the
private UI to measure fresh restore. Record raw
screenshots, input sequences, source SHA/dirty diff, build profile and compositor
alongside samples. Actor counts alone do not verify actual UI attachment.

The fixture uses a short disk-backed /var/tmp runtime on BOTH revisions to avoid
RAM-backed WAL pressure. This is a harness storage choice, not a product fix;
SQLite I/O timings do not represent a production tmpfs runtime. Samples are
process-local. Daemon/provider RSS and cache storage are separate measurements.
Exposed owner instrumentation counts Arc body references,
not unique heap bytes; renderer/parser allocations require additional attribution.
"""

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import time


REPOSITORY = Path(__file__).resolve().parent.parent
MARKER = ".chat-memory-fixture-v1"
STAGES = ("small", "restore100", "visit20", "hidden20", "closed100")


def write_json(path, value):
    path.write_text(json.dumps(value, indent=2) + "\n")


def fixture_environment(root):
    if not (root / MARKER).is_file():
        raise SystemExit("prepare this private fixture first")
    env = dict(os.environ)
    for key in ("CAGENTS_AGENT_AUTHORITY", "CAGENTS_ACCOUNT_HOMES", "CODEX_SESSION_ID", "CODEX_THREAD_ID",
                "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN",
                "CLAUDE_CODE_OAUTH_REFRESH_TOKEN", "CLAUDE_CODE_OAUTH_SCOPES",
                "CLAUDE_CODE_USE_ANTHROPIC_AWS", "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_MANTLE",
                "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY", "ANTHROPIC_PROFILE",
                "ANTHROPIC_FEDERATION_RULE_ID", "ANTHROPIC_ORGANIZATION_ID", "OPENAI_API_KEY",
                "CODEX_API_KEY", "CODEX_ACCESS_TOKEN", "OPENAI_FEDERATION_RULE_ID",
                "OPENAI_IDENTITY_TOKEN_FILE", "OPENAI_WORKLOAD_IDENTITY_CONTEXT", "OMP_PROFILE", "PI_PROFILE",
                "WAYLAND_SOCKET", "DISPLAY", "XAUTHORITY", "AT_SPI_BUS_ADDRESS",
                "DBUS_SESSION_BUS_ADDRESS", "DBUS_STARTER_ADDRESS", "DBUS_STARTER_BUS_TYPE"):
        env.pop(key, None)
    # A nested compositor's relative socket lives in the caller's runtime.
    display = env.get("WAYLAND_DISPLAY")
    if display and not display.startswith("/"):
        env["WAYLAND_DISPLAY"] = str(Path(env["XDG_RUNTIME_DIR"]) / display)
    original_home = Path.home()
    runtime = Path("/var/tmp") / (
        "chat-memory-" + str(os.getuid()) + "-" + hashlib.sha256(os.fsencode(root)).hexdigest()[:12]
    )
    runtime.mkdir(mode=0o700, exist_ok=True)
    if runtime.stat().st_uid != os.getuid():
        raise SystemExit("private runtime has another owner")
    runtime.chmod(0o700)
    env.setdefault("CARGO_HOME", str(original_home / ".cargo"))
    env.setdefault("RUSTUP_HOME", str(original_home / ".rustup"))
    env.update(
        HOME=str(root / "home"), XDG_RUNTIME_DIR=str(runtime),
        XDG_DATA_HOME=str(root / "data"), XDG_CONFIG_HOME=str(root / "config"),
        XDG_CACHE_HOME=str(root / "cache"), XDG_STATE_HOME=str(root / "state"),
        CODEX_HOME=str(root / "home/.codex"), CLAUDE_CONFIG_DIR=str(root / "home/.claude"),
        PI_CONFIG_DIR=str(root / "home/.pi"), PI_CODING_AGENT_DIR=str(root / "home/.omp"),
        PATH=str(root / "bin") + ":" + env["PATH"],
    )
    return env


def validate_compositor(root, env, receipt):
    """Require a pinned private compositor, rather than trusting a shell display."""
    if receipt is None:
        raise SystemExit("run requires --compositor-receipt for the owned test compositor")
    value = json.loads(receipt.read_text())
    directory = Path(value["root"]).resolve(strict=True)
    if not directory.is_relative_to(root) or directory.stat().st_uid != os.getuid():
        raise SystemExit("compositor configuration must belong to this fixture root")
    proc = Path("/proc") / str(int(value["pid"]))
    if proc.stat().st_uid != os.getuid():
        raise SystemExit("compositor has another owner")
    ticks = (proc / "stat").read_text().rsplit(")", 1)[1].split()[19]
    if ticks != str(value["start_ticks"]):
        raise SystemExit("compositor PID was reused")
    command = (proc / "cmdline").read_bytes().split(b"\0")
    if not any(part.startswith(os.fsencode(str(directory) + "/")) for part in command):
        raise SystemExit("compositor does not use its declared private configuration")
    display = Path(value["display"]).resolve(strict=True)
    if env.get("WAYLAND_DISPLAY") != str(display) or not stat.S_ISSOCK(display.stat().st_mode):
        raise SystemExit("display does not match pinned compositor receipt")
    inodes = {line.split()[6] for line in Path("/proc/net/unix").read_text().splitlines()[1:]
              if len(line.split()) >= 8 and line.split()[7] == str(display)}
    owned = set()
    for descriptor in (proc / "fd").iterdir():
        try:
            target = os.readlink(descriptor)
            if target.startswith("socket:["):
                owned.add(target[8:-1])
        except FileNotFoundError:
            continue
    if not inodes & owned:
        raise SystemExit("pinned compositor does not own the display socket")
    with (root / "compositor-validation.jsonl").open("a") as output:
        output.write(json.dumps({"pid": int(value["pid"]), "start_ticks": ticks,
            "display": str(display), "root": str(directory), "monotonic_ns": time.monotonic_ns()}) + "\n")


def cli_call(cli, env, arguments, root):
    cli = cli.resolve(strict=True)
    for sibling in ("cagents-ui", "cagentsd"):
        if not (cli.parent / sibling).is_file():
            raise SystemExit("supply a matched CLI/UI/daemon directory")
    result = subprocess.run([str(cli), "--json", *arguments], env=env,
                            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=90)
    with (root / "cli.jsonl").open("a") as output:
        output.write(json.dumps({"arguments": arguments, "exit": result.returncode,
                                 "stdout": result.stdout, "stderr": result.stderr}) + "\n")
    result.check_returncode()
    value = json.loads(result.stdout)
    return value.get("data", value)


def proc_fields(path):
    values = {}
    for line in path.read_text().splitlines():
        key, _, value = line.partition(":")
        words = value.split()
        if words and words[0].isdigit():
            values[key] = int(words[0])
    return values


def sample(root, pid, stage, seconds):
    process = Path("/proc") / str(pid)
    environment = dict(part.split(b"=", 1) for part in
                       (process / "environ").read_bytes().split(b"\0") if b"=" in part)
    if environment.get(b"XDG_DATA_HOME") != os.fsencode(root / "data"):
        raise SystemExit("refusing to sample a process outside this private fixture")
    if (process / "exe").resolve().name != "cagents-ui":
        raise SystemExit("sample requires the explicit native UI PID")
    start_identity = (process / "stat").read_text().rsplit(")", 1)[1].split()[19]
    started = time.monotonic()
    samples = []
    while time.monotonic() - started < seconds:
        stat = (process / "stat").read_text().rsplit(")", 1)[1].split()
        if stat[19] != start_identity:
            raise SystemExit("sample PID was recycled")
        status = proc_fields(process / "status")
        memory = proc_fields(process / "smaps_rollup")
        samples.append({
            "elapsed_seconds": time.monotonic() - started, "rss_kib": memory["Rss"],
            "anonymous_pss_kib": memory["Pss_Anon"], "file_pss_kib": memory["Pss_File"],
            "swap_kib": memory["Swap"], "peak_rss_kib": status["VmHWM"],
            "threads": status["Threads"], "cpu_ticks": int(stat[11]) + int(stat[12]),
        })
        time.sleep(0.25)
    ticks = os.sysconf("SC_CLK_TCK")
    duration = max(0.0001, samples[-1]["elapsed_seconds"] - samples[0]["elapsed_seconds"])
    summary = {key: max(row[key] for row in samples) for key in (
        "rss_kib", "anonymous_pss_kib", "file_pss_kib", "swap_kib", "peak_rss_kib", "threads")}
    summary["cpu_percent"] = (samples[-1]["cpu_ticks"] - samples[0]["cpu_ticks"]) / ticks / duration * 100
    runtime = Path(os.fsdecode(environment[b"XDG_RUNTIME_DIR"])) / "cagents-development"
    caches = [path for path in runtime.glob("chat-*") if path.is_dir() and not path.is_symlink()]
    sizes = []
    for cache in caches:
        for path in cache.rglob("*"):
            try:
                if path.is_file() and not path.is_symlink():
                    stat = path.stat()
                    sizes.append((stat.st_size, stat.st_blocks * 512))
            except FileNotFoundError:
                pass
    report = {"stage": stage, "pid": pid, "start_identity": start_identity,
              "runtime_storage": "disk-backed private /var/tmp; identical before/after",
              "transcript_caches": {"directories": len(caches),
                  "logical_bytes": sum(size for size, _ in sizes),
                  "allocated_bytes": sum(size for _, size in sizes)},
              "clock_ticks_per_second": ticks, "samples": samples, "summary": summary}
    path = root / (stage + ".json")
    if path.exists():
        raise SystemExit("refusing to overwrite a stage; use a new cycle suffix")
    write_json(path, report)
    print(json.dumps(summary))


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("action", choices=("prepare", "run", "seed", "close", "sample", "environment"))
    parser.add_argument("--root", type=Path, required=True, help="new disk-backed private fixture directory")
    parser.add_argument("--cli", type=Path, help="absolute matched development cagents executable")
    parser.add_argument("--count", type=int, default=100)
    parser.add_argument("--cycle", type=int, default=1)
    parser.add_argument("--pid", type=int)
    parser.add_argument("--stage", help="stage name, e.g. restore100-cycle1")
    parser.add_argument("--seconds", type=float, default=10)
    parser.add_argument("--fresh-daemon", action="store_true", help="stop ONLY this fixture's hosted jobs after builds")
    parser.add_argument("--compositor-receipt", type=Path,
                        help="run needs JSON with pid/start_ticks/absolute display/private root under --root")
    parser.add_argument("--build-lock", type=Path, default=Path.home() / ".cache/cagents-issue-build.lock")
    args = parser.parse_args()
    root = args.root.resolve()
    if (root in (Path("/"), Path.home(), REPOSITORY)
            or root.is_relative_to("/run") or root.is_relative_to("/dev/shm")):
        parser.error("choose a dedicated disk-backed fixture directory")
    if args.action == "prepare":
        root.mkdir(parents=True, exist_ok=False, mode=0o700)
        (root / MARKER).touch(mode=0o600)
        for name in ("home", "data", "config", "cache", "state", "bin", "project"):
            (root / name).mkdir(mode=0o700)
        settings = root / "config/cagents-development/settings.toml"
        settings.parent.mkdir()
        settings.write_text("schema_version = 3\nmax_hot_cards = 6\n"
                            "hibernation_delay_ms = 30000\nterminal_font_size = 14.0\n"
                            "sidebar_width = 260.0\ninspector_width = 380.0\n"
                            "check_for_updates = false\nfocus_follows_mouse = false\n"
                            "default_column_fraction = 1.0\ndefault_native_pane_fraction = 1.0\n"
                            "chat_content_fraction = 1.0\nui_scale = 1.0\n")
        settings.chmod(0o600)
        provider = REPOSITORY / "tests/fixtures/chat-memory-claude.py"
        shutil.copy2(provider, root / "bin/claude")
        for name in ("codex", "omp"):
            path = root / "bin" / name
            path.write_text("#!/bin/sh\n# Real providers are disabled in this fixture.\nexit 127\n")
            path.chmod(0o700)
        subprocess.run(["git", "init", "--quiet", str(root / "project")], check=True,
                       env=fixture_environment(root))
        write_json(root / "manifest.json", {
            "fixture": MARKER, "provider_sha256": hashlib.sha256(provider.read_bytes()).hexdigest(),
            "workload": {"parent_kib": 512, "children": 32, "child_kib": 64, "tool_rows": 30},
            "stages": STAGES, "repeated_cycles_in_same_ui_process": 3,
            "fresh_ui_process_for_each_before_after_phase": True,
            "runtime_storage": "disk-backed private /var/tmp, same before and after",
            "seeded_actors_are_not_proof_of_ui_attachment": True,
        })
        return
    env = fixture_environment(root)
    if args.action == "environment":
        # Only allowlisted non-secret paths; do not dump the inherited environment.
        print(json.dumps({key: env[key] for key in ("HOME", "XDG_RUNTIME_DIR", "XDG_DATA_HOME", "XDG_CONFIG_HOME")}, indent=2))
    elif args.action == "run":
        env["CARGO_BUILD_JOBS"] = "2"
        env.setdefault("RUST_LOG", "cagents::memory=trace,cagents=debug,cagentsd=debug,warn")
        native_lock = args.build_lock.parent / "cagents-native-ui.lock"
        args.build_lock.parent.mkdir(parents=True, exist_ok=True)
        with native_lock.open("a") as native, args.build_lock.open("a") as build:
            fcntl.flock(native, fcntl.LOCK_EX)
            fcntl.flock(build, fcntl.LOCK_EX)
            validate_compositor(root, env, args.compositor_receipt)
            # Bind the fixture bus to its private0700 runtime, rather than
            # inheriting a user bus or a compositor's session bus. dbus-run-session
            # owns the daemon lifetime and terminates it with this runner.
            bus_config = root / "session-bus.conf"
            bus_config.write_text(
                '<busconfig><type>session</type><listen>unix:path=' + env["XDG_RUNTIME_DIR"] +
                '/session-bus</listen><auth>EXTERNAL</auth><standard_session_servicedirs/>'
                '<policy context="default"><allow send_destination="*" eavesdrop="true"/>'
                '<allow eavesdrop="true"/><allow own="*"/></policy></busconfig>\n'
            )
            bus_config.chmod(0o600)
            command = ["dbus-run-session", "--config-file", str(bus_config), "--",
                       str(REPOSITORY / "scripts/run-development"), "--browserless", "--debug",
                       "--log-file", str(root / "ui.log")]
            if args.fresh_daemon:
                command.append("--fresh-daemon")
            raise SystemExit(subprocess.call(command, cwd=REPOSITORY, env=env))
    elif args.action in ("seed", "close"):
        if args.cli is None or not args.cli.is_absolute() or not 1 <= args.count <= 120:
            parser.error("seed/close need an absolute matched --cli and count1..120")
        manifest = root / ("actors-cycle" + str(args.cycle) + ".json")
        if args.action == "seed":
            cli_call(args.cli, env, ["project", "open", str(root / "project")], root)
            channel_path = root / "channel.json"
            if channel_path.exists():
                channel = json.loads(channel_path.read_text())
            else:
                channel = cli_call(args.cli, env, [
                    "channel", "spawn", "--repository", str(root / "project"),
                    "--title", "Native chat memory workload"], root)["channel"]
                write_json(channel_path, channel)
            actors = []
            for index in range(args.count):
                name = "memory-" + str(args.cycle) + "-" + str(index).zfill(3)
                actors.append(cli_call(args.cli, env, [
                    "agent", "spawn", "--provider", "claude", "--model", "haiku", "--name", name,
                    "--directory", str(root / "project"), "--channel", channel["id"],
                    "--idempotency-key", name, "--wait", "--timeout", "60",
                    "memory 512 32 " + name], root))
                write_json(manifest, actors)
                # Keep setup below the product's active-turn limit on both
                # revisions. The measured restore still owns all idle actors.
                settled = cli_call(args.cli, env, ["agent", "wait", actors[-1]["run"]["id"],
                                                  "--timeout", "60"], root)
                if settled["run"]["state"] != "Succeeded":
                    raise SystemExit("fixture actor did not settle; inspect private cli.jsonl")
                print(index + 1, flush=True)
        else:
            # Close only IDs minted by this fixture; never global inventory.
            for actor in json.loads(manifest.read_text()):
                cli_call(args.cli, env, ["agent", "close", actor["agent"]["id"]], root)
    elif args.action == "sample":
        if not args.pid or not args.stage or not 0.5 <= args.seconds <= 60:
            parser.error("sample needs --pid, --stage and seconds0.5..60")
        if not args.stage.replace("-", "").replace("_", "").isalnum():
            parser.error("stage must be a plain filename component")
        sample(root, args.pid, args.stage, args.seconds)


if __name__ == "__main__":
    main()
