#!/usr/bin/python3
"""Observe gh's HTTP traffic without adding requests or changing its arguments."""
import argparse
import collections
import datetime
import email.utils
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import statistics
import stat
import subprocess
import tempfile
import sys
import time
from urllib.parse import urlsplit

HEADERS = {"date", "age", "x-gh-cache-status", "x-from-cache", "retry-after", "x-ratelimit-limit", "x-ratelimit-remaining", "x-ratelimit-reset", "x-ratelimit-resource", "x-ratelimit-used", "x-github-request-id"}
MAX_BODY = 1024 * 1024


def state_dir():
    return Path((os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state"))) / "cagents/gh-observe"


def stamp():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds")


def append(record):
    """One bounded append per event, safe among unrelated processes; fail open."""
    try:
        root = state_dir()
        root.mkdir(parents=True, mode=0o700, exist_ok=True)
        path = root / (datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d") + ".jsonl")
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_CLOEXEC | os.O_NONBLOCK | os.O_NOFOLLOW, 0o600)
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                return False
            payload = (json.dumps(record, separators=(",", ":")) + "\n").encode()
            return os.write(fd, payload) == len(payload)
        finally:
            os.close(fd)
    except (OSError, TypeError, ValueError):
        return False


def ancestry():
    result = []
    pid = os.getppid()
    for _ in range(12):
        if pid <= 1:
            break
        try:
            root = Path("/proc") / str(pid)
            stat = (root / "stat").read_text()
            end = stat.rfind(")")
            comm = stat[stat.find("(") + 1:end]
            fields = stat[end + 2:].split()
            exe = os.readlink(root / "exe")
            result.append({"pid": pid, "comm": comm, "exe": exe, "start_ticks": fields[19]})
            pid = int(fields[1])
        except (OSError, ValueError, IndexError):
            break
    return result


def command_name(args):
    # Options can contain tokens, bodies, file paths or queries. Never log argv.
    words = []
    for arg in args:
        if arg.startswith("-") or not re.fullmatch(r"[a-z][a-z-]*", arg):
            break
        words.append(arg)
        if len(words) == 2:
            break
    return " ".join(words) or "gh"


def detailed_operation(args):
    """Only fixed JSON-shaped operations can safely use gh's text debug log."""
    name = command_name(args)
    if name == "api graphql":
        return supplied_query(args) is not None and not any(arg == "--input" or arg.startswith("--input=") for arg in args)
    return name in {
        "pr view", "pr list", "pr checks", "pr status", "pr create", "pr edit",
        "pr comment", "pr review", "pr merge", "pr close", "pr reopen", "pr ready",
        "issue view", "issue list", "issue status", "issue create", "issue edit",
        "issue comment", "issue close", "issue reopen", "issue delete",
        "repo view", "repo list", "repo create", "repo edit", "repo fork",
    }


def context(args):
    chain = ancestry()
    caller = next((p for p in chain if p["comm"] in {"claude", "codex", "node"}), None)
    if caller is None:
        caller = next((p for p in chain if Path(p["exe"].removesuffix(" (deleted)")).name in {"cagents", "cagents-ui", "ceditor"} or p["comm"] == "cagentsd"), chain[0] if chain else {})
    # Only UUID-shaped identifiers; never copy authority or arbitrary env values.
    sessions = {key: value for key, value in os.environ.items() if key in {"CAGENTS_SESSION_ID", "CAGENTS_CHANNEL_ID", "CODEX_THREAD_ID", "CLAUDE_SESSION_ID"} and re.fullmatch(r"[a-fA-F0-9-]{32,36}", value)}
    metadata = {"invocation": f"{os.getpid()}-{time.time_ns()}", "command": command_name(args), "caller": caller, "ancestors": chain, "sessions": sessions}
    # Some gh versions redact request bodies. Already supplied queries can
    # still be grouped without retaining their text or adding a network call.
    query = supplied_query(args)
    if query is not None:
        metadata.update(operation(query))
    return metadata


def supplied_query(args):
    query = None
    for index, arg in enumerate(args):
        field = arg[2:] if arg.startswith(("-fquery=", "-Fquery=")) else arg
        if arg.startswith(("--field=query=", "--raw-field=query=")):
            field = arg.split("=", 1)[1]
        if field.startswith("query=") and index and (args[index - 1] in {"-f", "-F", "--field", "--raw-field"} or field != arg):
            query = field[6:]
    return query


def operation(query):
    # Hash the field shape, removing argument values and comments.
    query = re.sub(r'"""[\s\S]*?"""|"(?:\\.|[^"\\])*"', '""', query)
    query = re.sub(r"#[^\n]*", "", query)
    query = re.sub(r"\b\d+\b", "0", query)
    name = re.search(r"(?:^|})\s*(query|mutation|subscription)(?:\s+([A-Za-z_][A-Za-z_0-9]*))?", query)
    kind = name.group(1) if name else "query"
    normalized = re.sub(r"\s+", "", query)
    return {"graphql_kind": kind, "operation": (name.group(2) if name else None) or "anonymous", "shape": hashlib.sha256(normalized.encode()).hexdigest()[:16]}


def normalize_authority(value):
    """Group API authorities without retaining URL credentials."""
    url = urlsplit(value if "://" in value else "//" + value)
    host = (url.hostname or "").lower()
    if host == "api.github.com":
        host = "github.com"
    try:
        port = url.port
    except ValueError:
        port = None
    if ":" in host:
        host = "[" + host + "]"
    defaults = {80, 443} if url.scheme == "http" else {443}
    return host + (f":{port}" if port is not None and port not in defaults else "")


def safe_endpoint(target):
    url = urlsplit(target)
    path = url.path
    # No URL query values (search terms, credentials); path only, bounded.
    if not re.fullmatch(r"/[A-Za-z0-9_./%~:@+-]*", path):
        path = "<redacted>"
    return {"host": normalize_authority(target), "path": path[:512]}


class GraphQLText:
    """Literal state for the raw query formatter; retain malformed input."""
    def __init__(self):
        self.literal = None
        self.escaped = False
        self.comment = False
        self.braces = self.parentheses = self.brackets = 0
        self.selection = False
        self.malformed = False
        self.pending = ""

    def complete(self):
        return self.selection and not self.literal and not self.comment and not self.pending and not self.malformed and self.braces == self.parentheses == self.brackets == 0

    def feed(self, text):
        text = self.pending + text
        self.pending = ""
        index = 0
        while index < len(text):
            # readline can split a long line at its memory bound. Keep enough
            # lookahead to recognize triple quotes across those chunks.
            if len(text) - index < 4 and not text.endswith("\n"):
                self.pending = text[index:]
                break
            char = text[index]
            if self.comment:
                self.comment = char != "\n"
                index += 1
            elif self.literal == "block":
                if text.startswith('\\"""', index):
                    index += 4
                elif text.startswith('"""', index):
                    self.literal = None
                    index += 3
                else:
                    index += 1
            elif self.literal == "string":
                if self.escaped:
                    self.escaped = False
                elif char == "\\":
                    self.escaped = True
                elif char == '"':
                    self.literal = None
                elif char in "\r\n":
                    self.malformed = True
                index += 1
            elif text.startswith('"""', index):
                self.literal = "block"
                index += 3
            elif char == '"':
                self.literal = "string"
                index += 1
            elif char == "#":
                self.comment = True
                index += 1
            else:
                if char == "{":
                    self.braces += 1
                    self.selection = True
                elif char == "}":
                    self.braces -= 1
                elif char == "(":
                    self.parentheses += 1
                elif char == ")":
                    self.parentheses -= 1
                elif char == "[":
                    self.brackets += 1
                elif char == "]":
                    self.brackets -= 1
                elif not (char.isascii() and (char.isalnum() or char in "_!$:=@[]|&.,+- \t\r\n")):
                    self.malformed = True
                if self.braces < 0 or self.parentheses < 0 or self.brackets < 0:
                    self.malformed = True
                index += 1


class TraceFraming:
    """Share trace/privacy boundaries between parsing and failed-parser drain."""
    def __init__(self):
        self.active = False
        self.query = None
        self.line_start = True
        self.response_headers = False
        self.content_type = None
        self.no_body = False
        self.head = False
        self.opaque = False

    def classify(self, line):
        # readline(MAX_BODY + 1) splits an oversized physical line. Its next
        # fragment is body content even when it starts like a gh diagnostic.
        # Check the original bytes: ANSI removal can shorten the first chunk.
        if self.active and len(line) > MAX_BODY:
            self.opaque = True
        line = re.sub(rb"\x1b\[[0-?]*[ -/]*[@-~]", b"", line)
        clean = line.rstrip(b"\r\n")
        if self.opaque:
            return True, True
        if self.query is not None:
            if self.line_start and self.query.complete() and clean.startswith(b"GraphQL variables:"):
                try:
                    variables = json.loads(clean[len(b"GraphQL variables:"):])
                except (ValueError, UnicodeDecodeError):
                    variables = None
                if isinstance(variables, dict):
                    self.query = None
                    return True, True
            self.query.feed(line.decode(errors="replace"))
            self.line_start = line.endswith(b"\n")
            return True, True
        if clean.startswith(b"* Request at "):
            self.active = True
            self.response_headers = False
            self.head = False
        if self.active and clean.startswith(b"> HEAD "):
            self.head = True
        if self.active and clean.startswith(b"< HTTP/"):
            self.response_headers = True
            self.content_type = None
            match = re.match(rb"< HTTP/\S+ (\d+)", clean)
            self.no_body = self.head or bool(match and int(match[1]) in {204, 205, 304})
        elif self.response_headers:
            if clean.lower().startswith(b"< content-type:"):
                self.content_type = clean.partition(b":")[2].strip().lower().partition(b";")[0]
            elif clean.lower() == b"< content-length: 0":
                self.no_body = True
            elif not clean:
                self.response_headers = False
                json_body = self.content_type is not None and self.content_type.endswith((b"/json", b"+json"))
                if not self.no_body and not json_body:
                    # Raw text can contain every textual delimiter used by
                    # httpretty. Withhold an ambiguous remainder; never echo it
                    # as a diagnostic or treat a body line as another request.
                    self.opaque = True
                    return True, True
        if self.active and clean == b"GraphQL query:":
            self.query = GraphQLText()
            self.line_start = True
            return True, True
        diagnostic = clean.startswith((b"gh: ", b"GraphQL: "))
        injected = (self.active or clean.startswith((b"[git ", b"[sh -c "))) and not diagnostic
        if clean.startswith(b"* Request took "):
            self.active = False
        return injected, False


class Traffic:
    def __init__(self, metadata, emit=append):
        self.metadata = metadata
        self.emit = emit
        self.current = None
        self.phase = None
        self.body = bytearray()
        self.body_truncated = False
        self.framing = TraceFraming()

    def body_info(self):
        if self.body_truncated:
            return
        if self.phase == "request_body" and self.body.lstrip().startswith(b"GraphQL query:\n"):
            text = self.body.decode(errors="replace").lstrip()[len("GraphQL query:\n"):]
            query, marker, _ = text.rpartition("\nGraphQL variables:")
            if marker:
                self.current.update(operation(query))
                self.current["request_body_parseable"] = True
                return
        try:
            body = json.loads(self.body)
        except (ValueError, UnicodeDecodeError):
            if self.phase == "request_body":
                self.current["request_body_parseable"] = False
                self.current["request_body_bytes"] = len(self.body)
            return
        if self.phase == "request_body":
            self.current["request_body_parseable"] = True
        if self.phase == "request_body" and isinstance(body, dict) and isinstance(body.get("query"), str):
            self.current.update(operation(body["query"]))
        if self.phase == "response_body" and isinstance(body, dict):
            limit = (body.get("data") or {}).get("rateLimit") if isinstance(body.get("data"), dict) else None
            if isinstance(limit, dict) and type(limit.get("cost")) is int:
                self.current["primary_cost"] = limit["cost"]
            errors = body.get("errors")
            if isinstance(errors, list) and errors:
                self.current["graphql_errors"] = len(errors)
                self.current["rate_limited"] = any(isinstance(e, dict) and (e.get("type") == "RATE_LIMITED" or re.search(r"rate limit|secondary rate|abuse", str(e.get("message", "")), re.I)) for e in errors)
                self.current["error_types"] = sorted({e["type"] for e in errors if isinstance(e, dict) and e.get("type") in {"RATE_LIMITED", "FORBIDDEN", "NOT_FOUND", "UNAUTHORIZED", "INTERNAL", "SERVICE_UNAVAILABLE"}})
            message = body.get("message")
            if isinstance(message, str) and re.search(r"rate limit|secondary rate|abuse", message, re.I):
                self.current["rate_limited"] = True

    def finish(self, incomplete=False):
        if self.current is None:
            return
        self.body_info()
        is_graphql = self.current.get("path") in {"/graphql", "/api/graphql"}
        if not is_graphql:
            self.current["primary_cost"] = 0 if self.current.get("status") == 304 else None
        try:
            server_time = email.utils.parsedate_to_datetime(self.current["headers"]["date"]).timestamp()
            request_time = datetime.datetime.fromisoformat(self.current["timestamp"]).timestamp()
            self.current["cached_response"] = bool(self.current.get("request_cache_ttl") and server_time < request_time - 60)
        except (KeyError, ValueError, TypeError, OverflowError):
            pass
        mutation = self.current.get("graphql_kind") == "mutation"
        read = self.current.get("method") in {"GET", "HEAD", "OPTIONS"} or (is_graphql and not mutation)
        self.current["secondary_points_estimate"] = 1 if read else 5
        self.current["incomplete"] = incomplete
        self.emit({**self.metadata, **self.current, "event": "request"})
        self.current = None
        self.phase = None
        self.body.clear()
        self.body_truncated = False

    def feed(self, line):
        """Return True for injected debug lines, False for ordinary stderr."""
        parsed = re.sub(rb"\x1b\[[0-?]*[ -/]*[@-~]", b"", line)
        clean = parsed.rstrip(b"\r\n")
        injected, raw = self.framing.classify(line)
        if not injected:
            return False
        if raw:
            self.collect_body(parsed)
            return True
        if clean.startswith(b"* Request at "):
            self.finish(incomplete=True)
            self.current = {key: self.metadata[key] for key in ("operation", "shape", "graphql_kind") if key in self.metadata}
            self.current.update({"timestamp": stamp(), "headers": {}, "primary_cost": None})
            self.phase = "request_headers"
            return True
        if self.current is None:
            # gh emits git tracing when GH_DEBUG is enabled as well.
            return clean.startswith((b"[git ", b"[sh -c "))
        if clean.startswith(b"* Request took "):
            units = {"ns": 0.000001, "us": 0.001, "µs": 0.001, "μs": 0.001, "ms": 1, "s": 1000, "m": 60000, "h": 3600000}
            duration = clean[len(b"* Request took "):].decode(errors="replace")
            pieces = re.findall(r"([0-9]+(?:\.[0-9]+)?)(ns|us|µs|μs|ms|s|m|h)", duration)
            if pieces:
                self.current["duration_ms"] = sum(float(value) * units[unit] for value, unit in pieces)
            self.finish()
            return True
        if clean.startswith(b"* Request to "):
            self.current.update(safe_endpoint(clean[len(b"* Request to "):].decode(errors="replace")))
        elif clean.startswith(b"> ") and self.phase == "request_headers":
            match = re.match(rb"> (GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS) (\S+) HTTP/", clean)
            if match:
                self.current["method"] = match.group(1).decode()
            key, sep, value = clean[2:].partition(b":")
            if sep and key.lower() == b"x-gh-cache-ttl":
                self.current["request_cache_ttl"] = value.decode(errors="replace").strip()[:64]
        elif clean.startswith(b"< HTTP/"):
            self.body_info()
            self.body.clear()
            self.body_truncated = False
            self.phase = "response_headers"
            match = re.match(rb"< HTTP/\S+ (\d+)", clean)
            if match:
                self.current["status"] = int(match.group(1))
        elif clean.startswith(b"< ") and self.phase == "response_headers":
            key, sep, value = clean[2:].partition(b":")
            name = key.decode(errors="replace").lower()
            if sep and name in HEADERS:
                self.current["headers"][name] = value.decode(errors="replace").strip()[:256]
        elif not clean and self.phase in {"request_headers", "response_headers"}:
            self.phase = self.phase.replace("headers", "body")
        elif self.phase in {"request_body", "response_body"}:
            self.collect_body(parsed)
        return True

    def collect_body(self, line):
        if self.phase not in {"request_body", "response_body"}:
            return
        if not self.body_truncated and len(self.body) + len(line) <= MAX_BODY:
            self.body.extend(line)
        else:
            self.body_truncated = True
            self.body.clear()


def repository_identity(directory):
    """Recognize the selected Git repository and its worktrees, locally only."""
    environment = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    try:
        result = subprocess.run(
            ["/usr/bin/git", "-C", str(directory), "rev-parse", "--path-format=absolute", "--git-common-dir", "--show-toplevel"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=environment,
            timeout=0.5, check=True, text=True,
        )
        common, root = result.stdout.splitlines()
        if not Path(directory).resolve().is_relative_to(Path(root).resolve()):
            return None
        return str(Path(common).resolve(strict=True))
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def exec_real(real, args):
    os.execv(real, [real, *args])


def shim(real, scope, args, http=False):
    # This path is reached only through `run`'s private, short-lived PATH.
    # Neither inherited configuration nor old limiter files can gate a call.
    try:
        eligible = os.environ.get("CAGENTS_GH_OBSERVE") != "0" and repository_identity(Path.cwd()) == scope
    except Exception:
        eligible = False
    if not eligible:
        exec_real(real, args)
    try:
        os.fstat(2)
        metadata = context(args)
        detailed = http and detailed_operation(args) and not os.isatty(2) and not os.environ.get("GH_DEBUG") and not os.environ.get("DEBUG") and not any(arg in {"--verbose", "-v"} for arg in args)
        query = supplied_query(args)
        if detailed and query is not None:
            literal = GraphQLText()
            literal.feed(query + "\n")
            # A malformed or unfinished raw dump has no trustworthy boundary.
            # Keep the original CLI diagnostics by observing this call only.
            detailed = literal.complete()
        parser = Traffic(metadata) if detailed else None
        framing = TraceFraming() if detailed else None
        recorded = append({**metadata, "event": "invocation", "timestamp": stamp(), "detailed": detailed})
    except Exception:
        recorded = False
    if not recorded:
        exec_real(real, args)
    if not detailed:
        exec_real(real, args)
    # The shell still waits for the real gh process, with unchanged argv,
    # stdin and stdout. A separate reader consumes only injected debug.
    read_fd = write_fd = None
    try:
        read_fd, write_fd = os.pipe()
        pid = os.fork()
    except OSError:
        for fd in (read_fd, write_fd):
            if fd is not None:
                os.close(fd)
        exec_real(real, args)
    if pid == 0:
        os.close(write_fd)
        for fd in (0, 1):
            if fd != read_fd:
                try:
                    os.close(fd)
                except OSError:
                    pass
        try:
            with os.fdopen(read_fd, "rb") as stream:
                while line := stream.readline(MAX_BODY + 1):
                    injected, _ = framing.classify(line)
                    if parser is not None:
                        try:
                            injected = parser.feed(line)
                        except Exception:
                            # Never close stderr on a collector failure or
                            # retry a command that may already have written.
                            parser = None
                    if not injected:
                        try:
                            os.write(2, line)
                        except OSError:
                            pass
            if parser is not None:
                try:
                    parser.finish(incomplete=True)
                except Exception:
                    pass
            append({**metadata, "event": "end", "timestamp": stamp()})
        finally:
            os._exit(0)
    os.close(read_fd)
    try:
        os.dup2(write_fd, 2)
    except OSError:
        os.close(write_fd)
        exec_real(real, args)
    os.close(write_fd)
    os.execve(real, [real, *args], dict(os.environ, GH_DEBUG="api"))


def resolve_real(explicit):
    candidates = [explicit] if explicit else [os.environ.get("CAGENTS_GH_OBSERVE_REAL")]
    if not explicit:
        # Providers can deliberately remove CAGENTS_* variables while keeping
        # PATH. Skip our own wrappers rather than resolving one recursively.
        candidates.extend(shutil.which("gh", path=entry) for entry in os.get_exec_path())
    for candidate in candidates:
        if not candidate:
            continue
        try:
            real = Path(candidate).expanduser().resolve(strict=True)
            if not real.is_file() or not os.access(real, os.X_OK):
                continue
            with real.open("rb") as stream:
                if b"# cagents gh-observe" in stream.read(512):
                    continue
            return str(real)
        except OSError:
            continue
    raise ValueError("gh itself is unavailable; supply --real /absolute/path/to/gh")


def runtime(real, scope, http=False):
    """Keep private immutable code available to opted-in background children."""
    source = Path(__file__).resolve().read_bytes()
    digest = hashlib.sha256(source + b"\0" + real.encode() + b"\0" + scope.encode() + bytes([http])).hexdigest()
    parent = Path(scope) / "cagents/gh-observe"
    if not parent.resolve().is_relative_to(Path(scope)):
        raise OSError("observation runtime is outside the repository metadata")
    parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    destination = parent / digest
    wrapper = ("#!/bin/sh\n# cagents gh-observe private wrapper\nexec /usr/bin/python3 " + shlex.quote(str(destination / "gh-observe.py")) + " --shim " + shlex.quote(real) + " " + shlex.quote(scope) + (" http" if http else " calls") + ' "$@"\n').encode()
    if not destination.exists():
        with tempfile.TemporaryDirectory(prefix=".stage-", dir=parent) as stage:
            staged = Path(stage)
            (staged / "gh-observe.py").write_bytes(source)
            (staged / "gh").write_bytes(wrapper)
            (staged / "gh").chmod(0o700)
            try:
                staged.rename(destination)
            except OSError:
                if not destination.is_dir():
                    raise
    if (destination / "gh-observe.py").read_bytes() != source or (destination / "gh").read_bytes() != wrapper:
        raise OSError("observation runtime is incomplete")
    return destination


def run(args):
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        raise SystemExit("run requires -- COMMAND [ARGS...]")
    try:
        real = resolve_real(args.real)
        scope = repository_identity(Path(args.repository).expanduser())
        directory = runtime(real, scope, getattr(args, "http", False)) if scope is not None else None
    except Exception:
        directory = None
    if directory is None:
        os.execvpe(command[0], command, os.environ)
    # Activation is only in this explicit command's environment. The private
    # files stay in Git metadata so a background child with a cached executable
    # path keeps working after its launching shell exits.
    environment = dict(os.environ, PATH=str(directory) + os.pathsep + os.environ.get("PATH", ""), CAGENTS_GH_OBSERVE_REAL=real)
    os.execvpe(command[0], command, environment)


def report(args):
    start = datetime.datetime.fromisoformat(args.since).timestamp() if args.since else 0
    end = datetime.datetime.fromisoformat(args.until).timestamp() if args.until else time.time()
    calls = collections.Counter()
    logical_calls = collections.Counter()
    commands = collections.Counter()
    invocation_calls = collections.Counter()
    invocation_only = 0
    errors = []
    timestamps = []
    detailed = collections.Counter()
    groups = {}
    requests = []
    for path in sorted(state_dir().glob("*.jsonl")):
        with path.open() as stream:
            for line in stream:
                try:
                    row = json.loads(line)
                    instant = datetime.datetime.fromisoformat(row["timestamp"]).timestamp()
                except (ValueError, KeyError):
                    continue
                if instant >= end:
                    continue
                if row.get("event") == "request":
                    requests.append((instant, row))
                elif instant >= start and row.get("event") == "invocation":
                    caller = row.get("caller", {})
                    who = f'{caller.get("comm", "unknown")}:{caller.get("pid", "?")}:{caller.get("start_ticks", "?")}'
                    commands[(who, row["command"])] += 1
                    detailed[str(row.get("detailed", False))] += 1
                    invocation_only += int(not row.get("detailed", False))
                    minute = datetime.datetime.fromtimestamp(instant, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%MZ")
                    operation = row.get("operation", row["command"])
                    if row.get("shape"):
                        operation += ":" + row["shape"]
                    invocation_calls[(minute, who, row["command"], operation)] += 1
    seen = set()
    logical_count = cached_count = duplicate_count = unattributed = network_count = 0
    for instant, row in sorted(requests, key=lambda entry: entry[0]):
        request_id = row.get("headers", {}).get("x-github-request-id")
        authority = normalize_authority(row.get("host") or "")
        identity = (authority, request_id) if request_id else None
        repeated = identity is not None and identity in seen
        if identity is not None:
            seen.add(identity)
        if instant < start:
            continue
        logical_count += 1
        cached = row.get("cached_response", False)
        duplicate_count += int(repeated)
        cached_count += int(cached)
        unattributed += int(identity is None)
        network = not cached and not repeated and not row.get("incomplete", False)
        network_count += int(network)
        timestamps.append(instant)
        caller = row.get("caller", {})
        who = f'{caller.get("comm", "unknown")}:{caller.get("pid", "?")}:{caller.get("start_ticks", "?")}'
        minute = datetime.datetime.fromtimestamp(instant, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%MZ")
        op = row.get("operation", row.get("path", "unknown"))
        if row.get("shape"):
            op += ":" + row["shape"]
        logical_calls[(minute, who, row["command"], op)] += 1
        if network:
            calls[(minute, who, row["command"], op)] += 1
        key = (who, row["command"], op)
        group = groups.setdefault(key, {"network_count": 0, "logical_count": 0, "primary_cost_known": 0, "primary_cost_sum": 0, "secondary_points_estimate": 0, "statuses": collections.Counter(), "resources": collections.Counter(), "durations": []})
        group["logical_count"] += 1
        if network:
            group["network_count"] += 1
            if type(row.get("primary_cost")) is int:
                group["primary_cost_known"] += 1
                group["primary_cost_sum"] += row["primary_cost"]
            group["secondary_points_estimate"] += row.get("secondary_points_estimate", 0)
            group["statuses"][str(row.get("status", "unknown"))] += 1
            group["resources"][row.get("headers", {}).get("x-ratelimit-resource", "unknown")] += 1
            if "duration_ms" in row:
                group["durations"].append(row["duration_ms"])
        if row.get("status", 0) >= 400 or row.get("graphql_errors") or row.get("incomplete"):
            errors.append({"network": network, "reused_response": repeated, **{key: row.get(key) for key in ("timestamp", "command", "caller", "path", "operation", "shape", "status", "headers", "graphql_errors", "error_types", "rate_limited", "incomplete")}})
    aggregates = []
    for key, group in sorted(groups.items()):
        durations = group.pop("durations")
        if durations:
            durations.sort()
            group["duration_ms"] = {"samples": len(durations), "median": statistics.median(durations), "p95": durations[min(len(durations) - 1, int(len(durations) * 0.95))], "max": max(durations)}
        aggregates.append({"caller": key[0], "command": key[1], "operation": key[2], **group})
    # Include zero-network rows for logical cache hits rather than silently
    # presenting GH_DEBUG cache exchanges as fresh GitHub traffic.
    per_minute = [{"minute": key[0], "caller": key[1], "command": key[2], "operation": key[3], "network_count": calls[key], "logical_count": count} for key, count in sorted(logical_calls.items())]
    invocations_per_minute = [{"minute": key[0], "caller": key[1], "command": key[2], "operation": key[3], "count": count} for key, count in sorted(invocation_calls.items())]
    output = {"invocations": sum(commands.values()), "invocation_only_count": invocation_only, "invocations_per_minute": invocations_per_minute, "coverage_note": "Invocation counts are gh command calls. Captured-response fields cover only HTTP-profiled calls; invocation-only calls can make unobserved requests. Zero captured responses does not mean zero network traffic.", "since": args.since, "until": args.until, "first_request": min(timestamps) if timestamps else None, "last_request": max(timestamps) if timestamps else None, "network_requests": network_count, "logical_exchanges": logical_count, "cached_by_date_and_ttl": cached_count, "reused_response_ids": duplicate_count, "exchanges_without_request_id": unattributed, "network_count_method": "Completed exchanges, excluding reused server request IDs and responses with a cache TTL and server Date older than 60 seconds; exchanges without a request ID cannot be deduplicated.", "detailed_invocations": dict(detailed), "commands": [{"caller": key[0], "command": key[1], "count": count} for key, count in sorted(commands.items())], "operations": aggregates, "calls_per_minute": per_minute, "errors": errors}
    print(json.dumps(output, indent=2))


def main():
    if len(sys.argv) >= 5 and sys.argv[1] == "--shim":
        shim(sys.argv[2], sys.argv[3], sys.argv[5:], http=sys.argv[4] == "http")
        return
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="action", required=True)
    runner = commands.add_parser("run", help="Observe gh only inside one explicit repository shell or command")
    runner.add_argument("--real", help="Absolute path to the unwrapped gh executable")
    runner.add_argument("--repository", default=".", help="Repository to observe, including its Git worktrees (default: current directory)")
    runner.add_argument("--http", action="store_true", help="Opt into HTTP headers/cost tracing for known JSON operations; raw/unknown commands remain invocation-only")
    runner.add_argument("command", nargs=argparse.REMAINDER, help="-- COMMAND [ARGS...]")
    runner.set_defaults(func=run)
    reporter = commands.add_parser("report", help="Summarize local logs; never calls GitHub")
    reporter.add_argument("--since", help="ISO timestamp, including timezone")
    reporter.add_argument("--until", help="ISO timestamp, including timezone")
    reporter.set_defaults(func=report)
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        import signal
        signal.signal(signal.SIGINT, signal.SIG_DFL)
        os.kill(os.getpid(), signal.SIGINT)
