#!/usr/bin/python3
"""Report whether this checkout can build, check and run cagents.

Each line names a prerequisite and what to do when it is missing. Required
prerequisites fail the command; optional ones only warn, because they serve a
narrower workflow (native instances, release builds). Nothing is installed or
changed: `mise run setup` installs the pinned tools, and native packages stay
the user's decision.

Rust compiles on the build host that scripts/cargo-gate reports unless
CAGENTS_BUILD_REMOTE=local or this is that host, so native build libraries are
required only where Rust compiles; a remote build host must answer over SSH.
"""

import argparse
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parent.parent
DEVELOPMENT = "docs/development.md#prerequisites"
# scripts/cargo-offload: 75 means this host builds in place.
FALL_BACK = 75
LOOPBACK_MARK = "\tloopback"
MINIMUM_GIT = (2, 36)
MINIMUM_PYTHON = (3, 11)
# What `cargo build` of every lane needs from the system, as packaged on Ubuntu.
BUILD_COMMANDS = ("cc", "c++", "clang", "cmake", "ninja", "pkg-config")
BUILD_LIBRARIES = (
    "dbus-1", "egl", "fontconfig", "freetype2", "gbm", "gl", "libudev",
    "openssl", "wayland-client", "xkbcommon",
)
TIMEOUT = 20


class Report:
    def __init__(self):
        self.failed = False

    def line(self, mark, name, detail):
        print(f"{mark:<4} {name}: {detail}", flush=True)

    def ok(self, name, detail):
        self.line("ok", name, detail)

    def fail(self, name, detail):
        self.failed = True
        self.line("FAIL", name, detail)

    def warn(self, name, detail):
        self.line("warn", name, detail)


def output(command, environment=None):
    """A command's stripped stdout, or None when it cannot run or fails."""
    try:
        result = subprocess.run(command, cwd=ROOT, env=environment, capture_output=True,
                                text=True, timeout=TIMEOUT, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def version(text):
    found = re.search(r"(\d+)\.(\d+)(?:\.(\d+))?", text or "")
    return tuple(int(part or 0) for part in found.groups()) if found else None


def check_git(report):
    found = version(output(["git", "--version"]))
    if found is None:
        report.fail("git", "not found; install Git 2.36 or newer")
    elif found[:2] < MINIMUM_GIT:
        report.fail("git", f"{'.'.join(map(str, found))} is older than 2.36; upgrade Git")
    else:
        report.ok("git", ".".join(map(str, found)))


def check_python(report):
    found = sys.version_info[:2]
    if found < MINIMUM_PYTHON:
        report.fail("python3", f"{found[0]}.{found[1]} is older than 3.11; repository tests need tomllib")
    else:
        report.ok("python3", f"{found[0]}.{found[1]}")


def check_rust(report):
    channel = tomllib.loads((ROOT / "rust-toolchain.toml").read_text())["toolchain"]["channel"]
    if shutil.which("rustup") is None:
        report.fail("rust", f"rustup not found; install rustup, then run `mise run setup` for Rust {channel}")
        return
    # Never let a doctor download a toolchain as a side effect.
    environment = os.environ | {"RUSTUP_AUTO_INSTALL": "0"}
    for tool in ("rustc", "cargo"):
        found = output([tool, "--version"], environment)
        if found is None or not re.match(rf"\S+ {re.escape(channel)}\b", found):
            report.fail("rust", f"{channel} from rust-toolchain.toml is not installed; run `mise run setup`")
            return
    # rustfmt numbers its own releases; it need only be the toolchain's component.
    if output(["rustfmt", "--version"], environment) is None:
        report.fail("rust", f"{channel} has no rustfmt; run `mise run setup`")
        return
    report.ok("rust", f"{channel} with rustfmt")


def check_zig(report):
    pinned = tomllib.loads((ROOT / "mise.toml").read_text())["tools"]["zig"]
    found = output(["zig", "version"])
    if found is None:
        report.fail("zig", f"not found; run `mise run setup` for Zig {pinned}, or install it on PATH")
    elif found != pinned:
        report.fail("zig", f"{found} does not match the mise.toml pin {pinned}; run tasks through mise "
                    f"or put Zig {pinned} first on PATH")
    else:
        report.ok("zig", found)


def check_local_build(report):
    missing = [command for command in BUILD_COMMANDS if shutil.which(command) is None]
    if missing:
        report.fail("build tools", f"missing {', '.join(missing)}; install the packages in {DEVELOPMENT}")
    else:
        report.ok("build tools", ", ".join(BUILD_COMMANDS))
    if "pkg-config" in missing:
        return
    absent = [name for name in BUILD_LIBRARIES if output(["pkg-config", "--exists", name]) is None]
    if absent:
        report.fail("build libraries", f"pkg-config cannot find {', '.join(absent)}; install the "
                    f"development packages in {DEVELOPMENT}")
    else:
        report.ok("build libraries", f"{len(BUILD_LIBRARIES)} found by pkg-config")


def check_build_host(report):
    try:
        result = subprocess.run([str(ROOT / "scripts/cargo-offload"), "--host"], cwd=ROOT,
                                capture_output=True, text=True, timeout=TIMEOUT,
                                stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as error:
        report.fail("build host", f"scripts/cargo-offload --host did not answer: {error}")
        return
    if result.returncode == FALL_BACK:
        report.ok("build host", "Rust compiles on this host")
        check_local_build(report)
        return
    host = result.stdout.strip()
    if result.returncode != 0 or not host:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        report.fail("build host", f"cannot tell where Rust compiles: {detail}")
        return
    # A loopback mark means this host builds in its own slots through a
    # stand-in for ssh; otherwise make the noninteractive connection the gate makes.
    host, loopback, _ = host.partition(LOOPBACK_MARK)
    if loopback:
        report.ok("build host", f"{host}, through its own build slots")
        return
    reached = output(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", host, "true"])
    if reached is None:
        report.fail("build host", f"{host} does not answer over SSH; builds wait for it. Fix SSH to "
                    f"{host}, or set CAGENTS_BUILD_REMOTE=local to build here")
    else:
        report.ok("build host", f"{host} answers over SSH")


def check_optional(report):
    if not os.environ.get("WAYLAND_DISPLAY"):
        report.warn("wayland", "no WAYLAND_DISPLAY; the development UI needs a Wayland session "
                    "(or `mise run dev -- --instance NAME` with niri-harness)")
    else:
        report.ok("wayland", os.environ["WAYLAND_DISPLAY"])
    for command, purpose in (("niri-harness", "headless instances (--instance)"),
                             ("bwrap", "release builds and package smoke tests")):
        if shutil.which(command) is None:
            report.warn(command, f"not found; needed only for {purpose}")
        else:
            report.ok(command, "found")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--no-build-host", action="store_true",
                        help="skip the build host and native library checks")
    args = parser.parse_args()
    report = Report()
    check_git(report)
    check_python(report)
    check_rust(report)
    check_zig(report)
    if not args.no_build_host:
        check_build_host(report)
    check_optional(report)
    if report.failed:
        print(f"Some prerequisites are missing; see {DEVELOPMENT}.", file=sys.stderr)
        return 1
    print("Ready to build and run cagents.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
