#!/bin/sh
# Keep Cargo builds from filling the file system that holds build directories.
#
# Every worktree and every agent's target directory grows as it builds, and
# Cargo never removes any of it. At most every few hours this starts
# prune-build-dirs in the background, which removes build output nothing has
# used for a week. Below twice the floor it runs it at once, and also removes
# removed workspaces' build directories without their usual grace period.
# Below the floor itself it refuses, so a build fails with an explanation
# instead of filling the disk that other builds, agents and their logs share.
# A guard that cannot tell how much room there is lets the build run.
set -eu

program=build-disk-guard
usage() {
    cat <<'EOF'
Usage: scripts/build-disk-guard BUILD_DIR

Exits 0 when the file system holding BUILD_DIR has room for builds, after
reclaiming unused build directories with prune-build-dirs when it runs low.
Exits 2, with an explanation, when it stays below the floor. Every
CAGENTS_BUILD_PRUNE_INTERVAL_HOURS it also starts the pruner in the
background, whatever the free space.

Environment:
  CAGENTS_BUILD_FREE_FLOOR_GIB  Free space below which builds are refused;
                                default: 5% of the file system, at most 64.
                                0 disables the guard.
  CAGENTS_BUILD_PRUNE           Command that reclaims build directories;
                                default: prune-build-dirs beside this guard,
                                given this repository's main checkout.
  CAGENTS_BUILD_PRUNE_IDLE_DAYS Days unwritten after which the default
                                pruner removes build output (default 7).
  CAGENTS_BUILD_PRUNE_INTERVAL_HOURS
                                Hours between background runs (default 6);
                                0 runs the pruner only when space is low.
  CAGENTS_BUILD_PRUNE_ROOTS     Directories the default pruner searches,
                                colon-separated, besides the main checkout;
                                default: ~/.cache, ~/.local/state, /var/tmp.
  CAGENTS_BUILD_PRUNE_STATE     Prefix of the pruner's schedule, lock, last
                                output (.log) and removals (.tsv); default:
                                /var/tmp/cagents-prune-build-dirs-UID.
EOF
}

case ${1:-} in
    -h|--help) usage; exit 0 ;;
    '') usage >&2; exit 2 ;;
esac
directory=$1
floor=${CAGENTS_BUILD_FREE_FLOOR_GIB:-}
case $floor in
    0) exit 0 ;;
    '') ;;
    0*|*[!0-9]*) usage >&2; exit 2 ;;
esac
interval=${CAGENTS_BUILD_PRUNE_INTERVAL_HOURS:-6}
idle=${CAGENTS_BUILD_PRUNE_IDLE_DAYS:-7}
for number in "$interval" "$idle"; do
    case $number in
        ''|0?*|*[!0-9]*) usage >&2; exit 2 ;;
    esac
done

# The build directory may not exist yet; its file system is its nearest
# existing ancestor's.
while [ ! -d "$directory" ]; do
    directory=$(dirname -- "$directory")
done

# Size and free space in GiB, rounded down.
read_space() {
    space=$(df -Pk -- "$directory" 2>/dev/null |
        awk 'NR == 2 && $2 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ {
            print int($2 / 1048576), int($4 / 1048576) }') || space=
    [ -n "$space" ] || exit 0
    size=${space% *}
    free=${space#* }
}

# When the last reclaim for low space ran, beside the build lock, and the
# pruner's own state for this user on this host: when it last ran on its
# schedule, its last runs' output and every removal.
state=${CAGENTS_BUILD_LOCK:-/var/tmp/cagents-cargo.lock}.prune
pruner_state=${CAGENTS_BUILD_PRUNE_STATE:-/var/tmp/cagents-prune-build-dirs-$(id -u)}
here=$(dirname -- "$(readlink -f -- "$0")")
prune=${CAGENTS_BUILD_PRUNE:-}
scheduled=$prune
if [ -z "$prune" ] && [ -x "$here/prune-build-dirs" ]; then
    # Worktrees' build output lives in the repository's main checkout; its
    # own build seeds new worktrees', so it stays.
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=
    main=
    [ -z "$common" ] || main=$(dirname -- "$common")
    quote() {
        printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
    }
    prune="$(quote "$here/prune-build-dirs") --apply --max-idle $idle"
    prune="$prune --lock $(quote "$pruner_state.lock") --log $(quote "$pruner_state.tsv")"
    if [ -n "$main" ]; then
        prune="$prune --root $(quote "$main") --keep-checkout $(quote "$main")"
    fi
    scheduled=$prune
    # Low on space, a removed workspace's build directory goes at once.
    prune="$prune --orphan-hours 0"
fi

# Every few hours, whatever the free space, in the background at idle
# priority: it scans every build directory, which a build should not wait for.
if [ -n "$scheduled" ] && [ "$interval" -gt 0 ]; then
    exec 7>>"$pruner_state.scheduled"
    if flock -n 7 &&
        [ -z "$(find "$pruner_state.scheduled" -mmin -$((interval * 60)) -size +0c 2>/dev/null)" ]; then
        date +%s >"$pruner_state.scheduled"
        log=$pruner_state.log
        # Keep the last run's output and the one before.
        [ ! -f "$log" ] || mv -f -- "$log" "$log.1" 2>/dev/null || :
        (
            exec 7>&- 8>&- 9>&- </dev/null >"$log" 2>&1
            command -v ionice >/dev/null 2>&1 && ionice='ionice -c3' || ionice=
            exec nice -n 19 $ionice sh -c "$scheduled"
        ) &
    fi
    exec 7>&-
fi

read_space
if [ -z "$floor" ]; then
    floor=$((size / 20))
    [ "$floor" -le 64 ] || floor=64
fi
[ "$free" -lt $((floor * 2)) ] || exit 0

if [ -z "$prune" ]; then
    printf '%s: %s GiB free on %s, and nothing to reclaim build directories with: %s is missing and CAGENTS_BUILD_PRUNE is unset\n' \
        "$program" "$free" "$directory" "$here/prune-build-dirs" >&2
fi
# One reclaim at a time across the host, and at most every ten minutes: a
# queue of builds would otherwise each scan every build directory.
if [ -n "$prune" ]; then
    exec 7>>"$state"
    if flock -n 7; then
        if [ -z "$(find "$state" -mmin -10 -size +0c 2>/dev/null)" ]; then
            printf '%s: %s GiB free on %s; reclaiming unused build directories\n' \
                "$program" "$free" "$directory" >&2
            # A failed reclaim leaves the decision to the free space below.
            sh -c "$prune" >&2 || :
            date +%s >"$state"
        fi
        exec 7>&-
    else
        # Another build is reclaiming; its result decides for this one too.
        printf '%s: %s GiB free; waiting for another build to reclaim space\n' \
            "$program" "$free" >&2
        flock -w 900 7 || :
        exec 7>&-
    fi
    read_space
fi
[ "$free" -lt "$floor" ] || exit 0

printf '%s: refusing to build: %s GiB free on %s, below the %s GiB floor.\n' \
    "$program" "$free" "$directory" "$floor" >&2
printf '%s: remove worktrees you no longer need (their build directories go with them), or set CAGENTS_BUILD_FREE_FLOOR_GIB=0 to build anyway.\n' \
    "$program" >&2
exit 2
