#!/usr/bin/env bash
# Cut a release: bump the version, build the tagged source on the build host,
# sign, rehearse through a file feed, and publish. See docs/releasing.md.
set -euo pipefail

PROGRAM=release
ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BUILD_HOST=${CAGENTS_RELEASE_BUILD_HOST:-fw16}
BUNDLES=${CAGENTS_RELEASE_BUNDLES:-"${XDG_STATE_HOME:-$HOME/.local/state}/cagents-release"}
GITHUB_REPOSITORY=${CAGENTS_RELEASE_GITHUB_REPOSITORY:-CarsonBurke/cagents}
VERSION_PATTERN='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
# Workspace members that carry the product version.
MANIFESTS=(Cargo.toml crates/cagents-ui/Cargo.toml crates/ceditor/Cargo.toml crates/cagents-dictate/Cargo.toml)

fail() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: scripts/release COMMAND [VERSION] [OPTIONS]

  cut [--wait] [--commit SHA] [--notes FILE] [--key KEY] [--build-host HOST]
                   Release a bundle HOST already built: the newest bundle of
                   main whose tests passed, or SHA's. Says how far it is
                   behind main and offers to wait for a prebuild of the tip
                   instead; --wait waits without asking. Copies the bundle to
                   $CAGENTS_RELEASE_BUNDLES/VERSION, checks every file against
                   what was built and smoke-tested, writes the notes (FILE, or
                   by default the features, fixes and speedups since the
                   previous tag), tags the commit vVERSION here, and signs
                   with KEY (default CAGENTS_RELEASE_SIGNING_KEY), or says how.
                   VERSION is the one the commit declares.
  bump VERSION     Set every product manifest and Cargo.lock to VERSION.
                   Commit it through a pull request, then tag the merged
                   commit: git tag -a vVERSION -m vVERSION COMMIT
  build VERSION [--notes FILE] [--build-host HOST]
                   Build tag vVERSION on HOST (default: CAGENTS_RELEASE_BUILD_HOST
                   or fw16) in the glibc-baseline environment, require its
                   passing test verdict from main's sentinel there (testing
                   the commit first if it has none), run the smoke checks,
                   and bring the bundle back to
                   $CAGENTS_RELEASE_BUNDLES/VERSION (default under
                   ~/.local/state/cagents-release). FILE holds the notes an
                   installed cagents shows; by default they are the features,
                   fixes and speedups since the previous tag here.
  feed VERSION --feed DIR
                   Add the signed bundle to a file feed, for rehearsing the
                   update before publishing (docs/releasing.md#rehearsing).
  publish VERSION  Verify the signed bundle and publish it on GitHub, after
                   you confirm by typing the version, pushing its tag first.
                   Then open and land the pull request that starts the next
                   patch version on main.

Sign between cut or build and feed or publish, with your own key:
  ssh-keygen -Y sign -n cagents-release -f KEY BUNDLE/release-metadata.json
EOF
}

(($# >= 1)) || { usage >&2; exit 2; }
COMMAND=$1
shift
case $COMMAND in -h|--help) usage; exit 0 ;; esac
VERSION=
TAG=
if [[ $COMMAND != cut ]]; then
    (($# >= 1)) || fail "$COMMAND needs a VERSION"
    VERSION=$1
    shift
    [[ $VERSION =~ $VERSION_PATTERN ]] || fail 'VERSION must be a stable semantic version without a leading v'
    TAG=v$VERSION
fi
NOTES=
FEED=
COMMIT=
KEY=
WAIT=false
while (($#)); do
    case $1 in
        --notes|--build-host|--feed|--commit|--key)
            (($# >= 2)) && [[ -n $2 ]] || fail "$1 requires a value"
            case $1 in
                --notes) NOTES=$2 ;; --build-host) BUILD_HOST=$2 ;; --feed) FEED=$2 ;;
                --commit) COMMIT=$2 ;; --key) KEY=$2 ;;
            esac
            shift 2
            ;;
        --wait) WAIT=true; shift ;;
        *) fail "unknown argument: $1 (see --help)" ;;
    esac
done
[[ $COMMAND == cut || ( -z $COMMIT && -z $KEY && $WAIT == false ) ]] \
    || fail '--commit, --key and --wait are for cut'

repository_git() (
    unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
    git -C "$ROOT_DIR" "$@"
)

package_version() {
    sed -n '/^\[package\]/,/^\[/{s/^version = "\([^"]*\)"$/\1/p;}' "$1"
}

bump() {
    local manifest current
    current=$(package_version "$ROOT_DIR/Cargo.toml")
    [[ $current != "$VERSION" ]] || fail "the manifests already declare $VERSION"
    [[ $(printf '%s\n%s\n' "$current" "$VERSION" | sort -V | tail -n1) == "$VERSION" ]] \
        || fail "$VERSION is not newer than $current"
    for manifest in "${MANIFESTS[@]}"; do
        [[ $(package_version "$ROOT_DIR/$manifest") == "$current" ]] \
            || fail "$manifest does not declare $current"
        # Only the [package] table's version; dependency versions stay.
        sed -i "/^\[package\]/,/^\[/{s/^version = \"$current\"$/version = \"$VERSION\"/;}" "$ROOT_DIR/$manifest"
    done
    # Updates the workspace's own entries in Cargo.lock; compiles nothing.
    (cd "$ROOT_DIR" && cargo update --workspace --offline --quiet)
    printf 'Set %s to %s. Commit it through a pull request, then tag the merged commit:\n' \
        "${MANIFESTS[*]}" "$VERSION"
    printf '  git tag -a %s -m %s COMMIT && git push origin %s\n' "$TAG" "$TAG" "$TAG"
}

build() {
    local commit relative remote_output bundle
    commit=$(repository_git rev-parse --verify "refs/tags/$TAG^{commit}") \
        || fail "tag $TAG does not exist here; create it on the merged version bump first"
    bundle=$BUNDLES/$VERSION
    [[ ! -e $bundle ]] || fail "$bundle exists; remove it to build $VERSION again"
    relative=${ROOT_DIR#"$HOME"/}
    [[ $relative != "$ROOT_DIR" ]] || fail 'the repository must be under $HOME to locate it on the build host'
    # The build runs the tag's own scripts from a checkout this command owns.
    # This checkout's tag is authoritative and replaces any other there.
    repository_git push --quiet --force "ssh://$BUILD_HOST/~/$relative" "refs/tags/$TAG:refs/tags/$TAG"
    remote_output=/var/tmp/cagents-release/$VERSION
    # Notes come from this checkout, which has every earlier tag, and are
    # checked before hours of building rather than after.
    if [[ -z $NOTES ]]; then
        local previous
        previous=$(repository_git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' "$commit^" 2>/dev/null) \
            || previous=
        NOTES=$(mktemp)
        trap 'rm -f -- "$NOTES"' EXIT
        "$ROOT_DIR/scripts/release-metadata" notes --repository "$ROOT_DIR" ${previous:+--from "$previous"} \
            --to "$commit" > "$NOTES"
    fi
    [[ -f $NOTES ]] || fail "release notes not found: $NOTES"
    [[ $(wc -c < "$NOTES") -le 65536 ]] || fail 'release notes exceed 64 KiB; pass a shorter --notes FILE'
    ssh "$BUILD_HOST" mkdir -p /var/tmp/cagents-release
    scp -q -- "$NOTES" "$BUILD_HOST:/var/tmp/cagents-release/$VERSION-notes.md"
    # The host's login shell may not be POSIX; bash reads the script instead.
    ssh "$BUILD_HOST" bash -s <<EOF
set -euo pipefail
cd ~/$(printf '%q' "$relative")
checkout=.worktrees/.release
if [[ -e \$checkout ]]; then
    git -C "\$checkout" checkout --quiet --detach $(printf '%q' "$commit")
else
    git worktree add --quiet --detach "\$checkout" $(printf '%q' "$commit")
fi
rm -rf -- $(printf '%q' "$remote_output")
# Every lane's tests gate the release through main's sentinel, which runs them
# per commit in the ordinary test profile; the release build runs none itself.
# A kept verdict answers at once; a commit main moved past before its tests
# ran is tested now, beside the build, and a failing verdict stops the build.
# Should the build fail first, the tests go on and keep their verdict, which
# the next attempt reuses.
verdict=/var/tmp/cagents-release/$VERSION-tests.json
"\$checkout/scripts/main-build-sentinel" --repository "\$PWD" \
    --require-tests $(printf '%q' "$commit") > "\$verdict" 2>&1 </dev/null &
tests=\$!
# The gate admits the build beside other agents' and holds its shares. The
# builder sizes its own Cargo jobs from the host's CPUs and available memory.
"\$checkout/scripts/cargo-gate" exec \
    "\$checkout/scripts/build-release-linux" --ref $(printf '%q' "$TAG") \
    --output $(printf '%q' "$remote_output") --notes /var/tmp/cagents-release/$VERSION-notes.md </dev/null &
build=\$!
refuse() {
    cat "\$verdict" >&2 || :
    rm -rf -- $(printf '%q' "$remote_output") "\$verdict"
    case \$1 in
        1) reason='its tests fail. A failing verdict is final: once a failure is shown to be outside the code, remove ~/.local/state/cagents-main-sentinel/verdicts/'$(printf '%q' "$commit")'.json on the build host to test it again' ;;
        3) reason='a test lane stopped outside the code, as when the build host refused it; run the release again to test it again' ;;
        *) reason='the sentinel could not give a verdict' ;;
    esac
    printf 'release: the commit has no passing test verdict from the main sentinel: %s (above).\n' "\$reason" >&2
    printf '%s\n' 'release: its test logs are under ~/.local/state/cagents-main-sentinel/logs' >&2
    exit 1
}
first=
status=0
wait -n -p first "\$tests" "\$build" || status=\$?
if [[ \$first == "\$tests" ]]; then
    if ((status)); then
        # The gate passes the signal on to the build it runs.
        kill -TERM "\$build" 2>/dev/null || :
        wait "\$build" || :
        refuse "\$status"
    fi
    wait "\$build"
else
    ((status == 0)) || { rm -f -- "\$verdict"; exit "\$status"; }
    status=0
    wait "\$tests" || status=\$?
    ((status == 0)) || refuse "\$status"
fi
rm -f -- "\$verdict"
EOF
    mkdir -p -- "$BUNDLES"
    rm -rf -- "$bundle.partial"
    scp -q -r -- "$BUILD_HOST:$remote_output" "$bundle.partial"
    "$ROOT_DIR/scripts/release-metadata" check --dir "$bundle.partial" --version "$VERSION" \
        --source-commit "$commit" >/dev/null || fail 'the copied bundle does not match its metadata'
    mv -- "$bundle.partial" "$bundle"
    # shellcheck disable=SC2029
    ssh "$BUILD_HOST" rm -rf -- "$remote_output" "/var/tmp/cagents-release/$VERSION-notes.md"
    printf 'Built %s into %s.\nRead its notes, then sign:\n' "$TAG" "$bundle"
    printf '  jq -r .notes %q\n' "$bundle/release-metadata.json"
    printf '  ssh-keygen -Y sign -n cagents-release -f KEY %q\n' "$bundle/release-metadata.json"
}

# The build host's checkout of this repository, relative to its home.
host_repository() {
    local relative=${ROOT_DIR#"$HOME"/}
    [[ $relative != "$ROOT_DIR" ]] || fail 'the repository must be under $HOME to locate it on the build host'
    printf '%s' "$relative"
}

# Runs the script on standard input on the build host, in its checkout of this
# repository. The host's login shell may not be POSIX; bash reads the script.
on_host() {
    # shellcheck disable=SC2029
    ssh "$BUILD_HOST" bash -s -- "$(host_repository)" "$@"
}

# Prints, as JSON, the build host's prebuilt bundles with each one's test
# verdict, the build running and the commit main's sentinel compiled last.
prebuilt() {
    on_host <<'HOST'
set -euo pipefail
cd ~/"$1"
scripts/prebuild-release --repository "$PWD" status --json | /usr/bin/python3 -I -c '
import json, pathlib, sys
status = json.load(sys.stdin)
verdicts = pathlib.Path.home() / ".local/state/cagents-main-sentinel/verdicts"
def verdict(sha):
    try:
        return json.loads((verdicts / f"{sha}.json").read_text()).get("passed")
    except (OSError, ValueError):
        return None
for bundle in status["bundles"]:
    bundle["passed"] = verdict(bundle["sha"])
print(json.dumps(status))
'
HOST
}

# Builds main's tip on the build host at normal priority and requires its
# passing verdict, which the sentinel gives while the bundle builds.
prebuild_tip() {
    local tip=$1
    printf 'Prebuilding %s on %s at normal priority; its tests run beside it if they have not yet.\n' \
        "$tip" "$BUILD_HOST"
    on_host "$tip" <<'HOST'
set -euo pipefail
cd ~/"$1"
tip=$2
scripts/prebuild-release --repository "$PWD" request "$tip" >/dev/null
scripts/main-build-sentinel --repository "$PWD" --require-tests "$tip" > /dev/null 2>&1 </dev/null &
tests=$!
scripts/prebuild-release --repository "$PWD" wait "$tip" </dev/null
status=0
wait "$tests" || status=$?
case $status in
    0) ;;
    1) echo "release: $tip fails its tests; see ~/.local/state/cagents-main-sentinel/logs on the build host" >&2; exit 1 ;;
    *) echo "release: the sentinel gave $tip no verdict (status $status); run the release again" >&2; exit 1 ;;
esac
HOST
}

# The newest bundle main contains whose tests passed, as "SHA BEHIND", where
# BEHIND counts the main commits after it.
newest_bundle() {
    local status=$1 sha behind best= fewest=
    while read -r sha; do
        repository_git merge-base --is-ancestor "$sha" "$MAIN" 2>/dev/null || continue
        behind=$(repository_git rev-list --count --first-parent "$sha..$MAIN")
        if [[ -z $fewest ]] || ((behind < fewest)); then
            best=$sha
            fewest=$behind
        fi
    done < <(jq -r '.bundles[] | select(.passed == true) | .sha' <<< "$status")
    [[ -n $best ]] && printf '%s %s\n' "$best" "$fewest"
}

CUT_SHA=
NOTES_FILE=
cut_cleanup() {
    [[ -z $NOTES_FILE ]] || rm -f -- "$NOTES_FILE"
    [[ -z $CUT_SHA ]] || on_host "$CUT_SHA" <<'HOST' || :
cd ~/"$1" && scripts/prebuild-release --repository "$PWD" unpin "$2"
HOST
}

cut() {
    local status selected sha behind tip answer version bundle protocol previous key building
    repository_git fetch --quiet origin main
    MAIN=$(repository_git rev-parse --verify origin/main)
    tip=$MAIN
    status=$(prebuilt) || fail "cannot read the prebuilt bundles on $BUILD_HOST"
    if [[ -n $COMMIT ]]; then
        sha=$(repository_git rev-parse --verify "$COMMIT^{commit}") || fail "unknown commit: $COMMIT"
        jq -e --arg sha "$sha" '.bundles[] | select(.sha == $sha and .passed == true)' <<< "$status" >/dev/null \
            || fail "$sha has no prebuilt bundle with passing tests on $BUILD_HOST"
        behind=$(repository_git rev-list --count --first-parent "$sha..$MAIN")
    elif selected=$(newest_bundle "$status"); then
        read -r sha behind <<< "$selected"
    else
        sha=
    fi
    if [[ $WAIT == false && -n $sha && $behind -gt 0 ]]; then
        printf 'The newest bundle with passing tests, %s, is %s commit(s) behind main (%s):\n' \
            "${sha:0:12}" "$behind" "${tip:0:12}"
        repository_git log --oneline --first-parent "$sha..$MAIN" | sed 's/^/  /'
        building=$(jq -r '.building | select(. != null) | "\(.sha) for \((now - .started_at) / 60 | floor) min"' \
            <<< "$status")
        [[ -z $building ]] || printf 'Prebuilding %s now.\n' "$building"
        if [[ -t 0 ]]; then
            read -r -p 'Release it, or wait for a prebuild of the tip? [r/w] ' answer
            case $answer in w|W) WAIT=true ;; r|R) ;; *) fail 'nothing released' ;; esac
        fi
    fi
    if [[ $WAIT == true || -z $sha ]]; then
        if [[ $WAIT == false ]]; then
            [[ -t 0 ]] || fail "$BUILD_HOST has no bundle of main with passing tests; run with --wait"
            read -r -p "$BUILD_HOST has no bundle of main with passing tests. Wait for a prebuild of the tip? [y/N] " answer
            [[ $answer == [yY] ]] || fail 'nothing released'
        fi
        prebuild_tip "$tip" || fail "no bundle of $tip"
        sha=$tip
    fi
    version=$(repository_git show "$sha:Cargo.toml" | sed -n '/^\[package\]/,/^\[/{s/^version = "\([^"]*\)"$/\1/p;}')
    [[ $version =~ $VERSION_PATTERN ]] || fail "$sha does not declare a stable version"
    VERSION=$version
    TAG=v$VERSION
    if repository_git rev-parse --quiet --verify "refs/tags/$TAG" >/dev/null; then
        [[ $(repository_git rev-parse "refs/tags/$TAG^{commit}") == "$sha" ]] \
            || fail "$TAG already exists at another commit; main needs its version bump first"
    fi
    [[ -z $(repository_git ls-remote --tags origin "refs/tags/$TAG") ]] \
        || fail "$TAG is already on origin; main needs its version bump first"
    bundle=$BUNDLES/$VERSION
    [[ ! -e $bundle ]] || fail "$bundle exists; remove it to cut $VERSION again"
    mkdir -p -- "$BUNDLES"
    rm -rf -- "$bundle.partial"
    # Pinned, eviction keeps it while it is copied.
    on_host "$sha" <<'HOST' || fail "cannot pin the bundle of $sha"
cd ~/"$1" && scripts/prebuild-release --repository "$PWD" pin "$2"
HOST
    CUT_SHA=$sha
    trap cut_cleanup EXIT
    printf 'Copying the bundle of %s (%s) from %s.\n' "$sha" "$VERSION" "$BUILD_HOST"
    scp -q -r -- "$BUILD_HOST:.local/state/cagents-prebuilt/bundles/$sha/dist" "$bundle.partial"
    # Every file matches the size and digest the prebuild recorded for this
    # commit and version: what is signed is what was built and smoke-tested.
    "$ROOT_DIR/scripts/release-metadata" check --dir "$bundle.partial" --version "$VERSION" \
        --source-commit "$sha" >/dev/null || fail 'the copied bundle does not match what was built'
    protocol=$(jq -r .protocol "$bundle.partial/release-metadata.json")
    if [[ -z $NOTES ]]; then
        previous=$(repository_git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' "$sha^" 2>/dev/null) \
            || previous=
        NOTES_FILE=$(mktemp)
        "$ROOT_DIR/scripts/release-metadata" notes --repository "$ROOT_DIR" ${previous:+--from "$previous"} \
            --to "$sha" > "$NOTES_FILE"
        NOTES=$NOTES_FILE
    fi
    [[ -f $NOTES ]] || fail "release notes not found: $NOTES"
    [[ $(wc -c < "$NOTES") -le 65536 ]] || fail 'release notes exceed 64 KiB; pass a shorter --notes FILE'
    rm -- "$bundle.partial/release-metadata.json"
    "$ROOT_DIR/scripts/release-metadata" write --dir "$bundle.partial" --version "$VERSION" \
        --source-commit "$sha" --protocol "$protocol" --notes "$NOTES" >/dev/null
    mv -- "$bundle.partial" "$bundle"
    repository_git tag -a "$TAG" -m "$TAG" "$sha" 2>/dev/null \
        || [[ $(repository_git rev-parse "refs/tags/$TAG^{commit}") == "$sha" ]] || fail "cannot tag $sha as $TAG"
    printf '\nCut %s from %s into %s. Its notes:\n\n' "$TAG" "$sha" "$bundle"
    jq -r .notes "$bundle/release-metadata.json" | sed 's/^/  /'
    key=${KEY:-${CAGENTS_RELEASE_SIGNING_KEY:-}}
    if [[ -n $key ]]; then
        printf '\nSigning with %s; touch the key if it asks.\n' "$key"
        ssh-keygen -Y sign -n cagents-release -f "$key" "$bundle/release-metadata.json"
        printf 'Rehearse it if you like (docs/releasing.md#rehearsing), then publish:\n  scripts/release publish %s\n' \
            "$VERSION"
    else
        printf '\nSign it, then publish:\n  ssh-keygen -Y sign -n cagents-release -f KEY %q\n  scripts/release publish %s\n' \
            "$bundle/release-metadata.json" "$VERSION"
    fi
}

# The pull request that starts the next patch version on main, as `release
# publish` opens and lands it after each release.
start_next_version() {
    local next worktree branch body
    next=${VERSION%.*}.$((${VERSION##*.} + 1))
    repository_git fetch --quiet origin main
    if [[ $(repository_git show origin/main:Cargo.toml | sed -n '/^\[package\]/,/^\[/{s/^version = "\([^"]*\)"$/\1/p;}') \
            != "$VERSION" ]]; then
        printf 'main no longer declares %s; it needs no version bump.\n' "$VERSION"
        return 0
    fi
    branch=release/bump-$next
    worktree=$ROOT_DIR/.worktrees/release-bump-$next
    repository_git worktree add --quiet -b "$branch" "$worktree" origin/main
    (
        cd "$worktree"
        "$worktree/scripts/release" bump "$next" >/dev/null
        git commit --quiet -am "chore(release): start $next after $TAG"
        git push --quiet -u origin "$branch"
        body=$(printf '%s\n' \
            "$TAG is published, so main now declares the next patch version, $next. Release bundles are prebuilt from main commits with the version those commits declare, so until this lands every main commit declares the already-tagged $VERSION and gets no usable bundle." \
            "" \
            "This is the change \`scripts/release bump $next\` makes: the four product manifests and the workspace's own \`Cargo.lock\` entries. \`release publish\` opens and lands this pull request after each release.")
        number=$(gh pr create -R "$GITHUB_REPOSITORY" --base main --head "$branch" \
            --title "chore(release): start $next after $TAG" --body "$body" | sed -n 's#.*/pull/\([0-9]*\)$#\1#p')
        [[ -n $number ]] || exit 1
        printf 'Opened #%s to start %s; landing it once its checks pass.\n' "$number" "$next"
        "$worktree/scripts/land-pr" "$number" -R "$GITHUB_REPOSITORY"
    ) || fail "could not start $next; open the version bump yourself: scripts/release bump $next"
    repository_git worktree remove --force "$worktree"
}

signed_bundle() {
    local bundle=$BUNDLES/$VERSION
    [[ -f $bundle/release-metadata.json.sig ]] \
        || fail "sign $bundle/release-metadata.json first (see --help)"
    printf '%s' "$bundle"
}

case $COMMAND in
    bump) bump ;;
    build) build ;;
    cut) cut ;;
    feed)
        [[ -n $FEED ]] || fail 'feed needs --feed DIR'
        "$ROOT_DIR/scripts/release-metadata" feed --dir "$(signed_bundle)" --feed "$FEED"
        ;;
    publish)
        bundle=$(signed_bundle)
        printf 'Publishing %s makes it the update every installed cagents offers.\n' "$TAG"
        read -r -p "Type $VERSION to publish: " answer
        [[ $answer == "$VERSION" ]] || fail 'not published'
        # It verifies the signature, checksums, archives and a smoke install
        # before uploading anything.
        # Publication requires the identical tag on origin.
        repository_git push --quiet origin "refs/tags/$TAG"
        "$ROOT_DIR/scripts/publish-release" --version "$VERSION" --dist "$bundle"
        start_next_version
        ;;
    *) fail "unknown command: $COMMAND (see --help)" ;;
esac
