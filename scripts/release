#!/usr/bin/env bash
# Cut a release: bump the version, build the tagged source on the build host,
# sign, rehearse through a file feed, and publish. See docs/releasing.md.
set -euo pipefail

PROGRAM=release
ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BUILD_HOST=${CAGENTS_RELEASE_BUILD_HOST:-fw16}
BUNDLES=${CAGENTS_RELEASE_BUNDLES:-"${XDG_STATE_HOME:-$HOME/.local/state}/cagents-release"}
GITHUB_REPOSITORY=${CAGENTS_RELEASE_GITHUB_REPOSITORY:-CarsonBurke/cagents}
# The rehearsal's private user on the build host; by default
# PARENT/release-VERSION, short as its sockets need, in the first of these
# parents with no .git above it. A sandbox that masks .git in its writable
# roots leaves empty .git mountpoints in /var/tmp, under which the harness
# refuses to run; /dev/shm is memory, so a failed rehearsal there keeps only
# its report and screenshots.
REHEARSAL_ROOT=${CAGENTS_RELEASE_REHEARSAL_ROOT:-}
# Separated by colons, as ssh splits its arguments at spaces.
REHEARSAL_PARENTS=${CAGENTS_RELEASE_REHEARSAL_PARENTS:-/var/tmp/cr:/dev/shm/cr}
VERSION_PATTERN='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
# Workspace members that carry the product version.
MANIFESTS=(Cargo.toml crates/cagents-ui/Cargo.toml crates/ceditor/Cargo.toml crates/cagents-dictate/Cargo.toml)

fail() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: scripts/release COMMAND [VERSION] [OPTIONS]

  cut [--wait] [--commit SHA] [--notes FILE] [--key KEY] [--build-host HOST]
                   Release a bundle HOST already built: the newest bundle of
                   main whose tests passed, or SHA's. Says how far it is
                   behind main and offers to wait for a prebuild of the tip
                   instead; --wait waits without asking. Copies the bundle to
                   $CAGENTS_RELEASE_BUNDLES/VERSION, checks every file against
                   what was built and smoke-tested, writes the notes (FILE, or
                   by default the features, fixes and speedups since the
                   previous tag), tags the commit vVERSION here, and signs
                   with KEY (default CAGENTS_RELEASE_SIGNING_KEY), or says how.
                   VERSION is the one the commit declares; an unpublished
                   earlier cut of it is replaced. Without a terminal, a
                   bundle behind main needs --wait or --commit.
  bump VERSION     Set every product manifest and Cargo.lock to VERSION.
                   Commit it through a pull request, then tag the merged
                   commit: git tag -a vVERSION -m vVERSION COMMIT
  build VERSION [--notes FILE] [--build-host HOST]
                   Build tag vVERSION on HOST (default: CAGENTS_RELEASE_BUILD_HOST
                   or fw16) in the glibc-baseline environment, require its
                   passing test verdict from main's sentinel there (testing
                   the commit first if it has none), run the smoke checks,
                   and bring the bundle back to
                   $CAGENTS_RELEASE_BUNDLES/VERSION (default under
                   ~/.local/state/cagents-release). FILE holds the notes an
                   installed cagents shows; by default they are the features,
                   fixes and speedups since the previous tag here.
  rehearse VERSION [--staged] [--build-host HOST]
                   Rehearse installed cagents updating from the newest
                   published release to the signed cut VERSION, on HOST,
                   with that commit's scripts/rehearse-update: a private user
                   with three windows, chats, agents and terminals updates
                   as a person does in the app, the published build's own
                   updater fetching the cut from a file feed. Its work must
                   survive and no reopened window may show the update as
                   failed. --staged instead runs the cut's own staged
                   `cagents daemon upgrade`, which needs no signature, and
                   requires the update to end Complete.
  feed VERSION --feed DIR
                   Add the signed bundle to a file feed, for rehearsing the
                   update before publishing (docs/releasing.md#rehearsing).
  publish VERSION  Verify the signed bundle, then push its tag and publish it
                   on GitHub, after you confirm by typing the version. Then
                   open and land the pull request that starts the next patch
                   version on main. Run again after a failure, it resumes.

Sign between cut or build and feed or publish, with your own key:
  ssh-keygen -Y sign -n cagents-release -f KEY BUNDLE/release-metadata.json
EOF
}

(($# >= 1)) || { usage >&2; exit 2; }
COMMAND=$1
shift
case $COMMAND in -h|--help) usage; exit 0 ;; esac
VERSION=
TAG=
if [[ $COMMAND != cut ]]; then
    (($# >= 1)) || fail "$COMMAND needs a VERSION"
    VERSION=$1
    shift
    [[ $VERSION =~ $VERSION_PATTERN ]] || fail 'VERSION must be a stable semantic version without a leading v'
    TAG=v$VERSION
fi
NOTES=
FEED=
COMMIT=
KEY=
WAIT=false
STAGED=false
while (($#)); do
    case $1 in
        --notes|--build-host|--feed|--commit|--key)
            (($# >= 2)) && [[ -n $2 ]] || fail "$1 requires a value"
            case $1 in
                --notes) NOTES=$2 ;; --build-host) BUILD_HOST=$2 ;; --feed) FEED=$2 ;;
                --commit) COMMIT=$2 ;; --key) KEY=$2 ;;
            esac
            shift 2
            ;;
        --wait) WAIT=true; shift ;;
        --staged) STAGED=true; shift ;;
        *) fail "unknown argument: $1 (see --help)" ;;
    esac
done
[[ $COMMAND == cut || ( -z $COMMIT && -z $KEY && $WAIT == false ) ]] \
    || fail '--commit, --key and --wait are for cut'
[[ -z $COMMIT || $WAIT == false ]] || fail "--wait releases main's tip; --commit releases another bundle"
[[ $COMMAND == rehearse || $STAGED == false ]] || fail '--staged is for rehearse'

repository_git() (
    unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
    git -C "$ROOT_DIR" "$@"
)

package_version() {
    sed -n '/^\[package\]/,/^\[/{s/^version = "\([^"]*\)"$/\1/p;}' "$1"
}

bump() {
    local manifest current
    current=$(package_version "$ROOT_DIR/Cargo.toml")
    [[ $current != "$VERSION" ]] || fail "the manifests already declare $VERSION"
    [[ $(printf '%s\n%s\n' "$current" "$VERSION" | sort -V | tail -n1) == "$VERSION" ]] \
        || fail "$VERSION is not newer than $current"
    for manifest in "${MANIFESTS[@]}"; do
        [[ $(package_version "$ROOT_DIR/$manifest") == "$current" ]] \
            || fail "$manifest does not declare $current"
        # Only the [package] table's version; dependency versions stay.
        sed -i "/^\[package\]/,/^\[/{s/^version = \"$current\"$/version = \"$VERSION\"/;}" "$ROOT_DIR/$manifest"
    done
    # Updates the workspace's own entries in Cargo.lock; compiles nothing.
    (cd "$ROOT_DIR" && cargo update --workspace --offline --quiet) || fail 'cargo could not update Cargo.lock'
    local name locked
    for manifest in "${MANIFESTS[@]}"; do
        name=$(sed -n '/^\[package\]/,/^\[/{s/^name = "\([^"]*\)"$/\1/p;}' "$ROOT_DIR/$manifest")
        locked=$(awk -v entry="name = \"$name\"" '$0 == entry { getline; gsub(/"/, "", $3); print $3; exit }' \
            "$ROOT_DIR/Cargo.lock")
        [[ $locked == "$VERSION" ]] || fail "Cargo.lock has $name at ${locked:-no version}, not $VERSION"
    done
    printf 'Set %s to %s. Commit it through a pull request, then tag the merged commit:\n' \
        "${MANIFESTS[*]}" "$VERSION"
    printf '  git tag -a %s -m %s COMMIT && git push origin %s\n' "$TAG" "$TAG" "$TAG"
}

build() {
    local commit relative remote_output bundle
    commit=$(repository_git rev-parse --verify "refs/tags/$TAG^{commit}") \
        || fail "tag $TAG does not exist here; create it on the merged version bump first"
    bundle=$BUNDLES/$VERSION
    [[ ! -e $bundle ]] || fail "$bundle exists; remove it to build $VERSION again"
    relative=${ROOT_DIR#"$HOME"/}
    [[ $relative != "$ROOT_DIR" ]] || fail 'the repository must be under $HOME to locate it on the build host'
    # The build runs the tag's own scripts from a checkout this command owns.
    # This checkout's tag is authoritative and replaces any other there.
    repository_git push --quiet --force "ssh://$BUILD_HOST/~/$relative" "refs/tags/$TAG:refs/tags/$TAG"
    remote_output=/var/tmp/cagents-release/$VERSION
    # Notes come from this checkout, which has every earlier tag, and are
    # checked before hours of building rather than after.
    if [[ -z $NOTES ]]; then
        local previous
        previous=$(repository_git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' "$commit^" 2>/dev/null) \
            || previous=
        NOTES=$(mktemp)
        trap 'rm -f -- "$NOTES"' EXIT
        "$ROOT_DIR/scripts/release-metadata" notes --repository "$ROOT_DIR" ${previous:+--from "$previous"} \
            --to "$commit" > "$NOTES"
    fi
    [[ -f $NOTES ]] || fail "release notes not found: $NOTES"
    [[ $(wc -c < "$NOTES") -le 65536 ]] || fail 'release notes exceed 64 KiB; pass a shorter --notes FILE'
    ssh "$BUILD_HOST" mkdir -p /var/tmp/cagents-release
    scp -q -- "$NOTES" "$BUILD_HOST:/var/tmp/cagents-release/$VERSION-notes.md"
    # The host's login shell may not be POSIX; bash reads the script instead.
    ssh "$BUILD_HOST" bash -s <<EOF
set -euo pipefail
cd ~/$(printf '%q' "$relative")
checkout=.worktrees/.release
if [[ -e \$checkout ]]; then
    git -C "\$checkout" checkout --quiet --detach $(printf '%q' "$commit")
else
    git worktree add --quiet --detach "\$checkout" $(printf '%q' "$commit")
fi
rm -rf -- $(printf '%q' "$remote_output")
# Every lane's tests gate the release through main's sentinel, which runs them
# per commit in the ordinary test profile; the release build runs none itself.
# A kept verdict answers at once; a commit main moved past before its tests
# ran is tested now, beside the build, and a failing verdict stops the build.
# Should the build fail first, the tests go on and keep their verdict, which
# the next attempt reuses.
verdict=/var/tmp/cagents-release/$VERSION-tests.json
"\$checkout/scripts/main-build-sentinel" --repository "\$PWD" \
    --require-tests $(printf '%q' "$commit") > "\$verdict" 2>&1 </dev/null &
tests=\$!
# The gate admits the build beside other agents' and holds its shares. The
# builder sizes its own Cargo jobs from the host's CPUs and available memory.
"\$checkout/scripts/cargo-gate" exec \
    "\$checkout/scripts/build-release-linux" --ref $(printf '%q' "$TAG") \
    --output $(printf '%q' "$remote_output") --notes /var/tmp/cagents-release/$VERSION-notes.md </dev/null &
build=\$!
refuse() {
    cat "\$verdict" >&2 || :
    rm -rf -- $(printf '%q' "$remote_output") "\$verdict"
    case \$1 in
        1) reason='its tests fail. A failing verdict is final: once a failure is shown to be outside the code, remove ~/.local/state/cagents-main-sentinel/verdicts/'$(printf '%q' "$commit")'.json on the build host to test it again' ;;
        3) reason='a test lane stopped outside the code, as when the build host refused it; run the release again to test it again' ;;
        *) reason='the sentinel could not give a verdict' ;;
    esac
    printf 'release: the commit has no passing test verdict from the main sentinel: %s (above).\n' "\$reason" >&2
    printf '%s\n' 'release: its test logs are under ~/.local/state/cagents-main-sentinel/logs' >&2
    exit 1
}
first=
status=0
wait -n -p first "\$tests" "\$build" || status=\$?
if [[ \$first == "\$tests" ]]; then
    if ((status)); then
        # The gate passes the signal on to the build it runs.
        kill -TERM "\$build" 2>/dev/null || :
        wait "\$build" || :
        refuse "\$status"
    fi
    wait "\$build"
else
    ((status == 0)) || { rm -f -- "\$verdict"; exit "\$status"; }
    status=0
    wait "\$tests" || status=\$?
    ((status == 0)) || refuse "\$status"
fi
rm -f -- "\$verdict"
EOF
    mkdir -p -- "$BUNDLES"
    rm -rf -- "$bundle.partial"
    scp -q -r -- "$BUILD_HOST:$remote_output" "$bundle.partial"
    "$ROOT_DIR/scripts/release-metadata" check --dir "$bundle.partial" --version "$VERSION" \
        --source-commit "$commit" >/dev/null || fail 'the copied bundle does not match its metadata'
    mv -- "$bundle.partial" "$bundle"
    # shellcheck disable=SC2029
    ssh "$BUILD_HOST" rm -rf -- "$remote_output" "/var/tmp/cagents-release/$VERSION-notes.md"
    printf 'Built %s into %s.\nRead its notes, then sign:\n' "$TAG" "$bundle"
    printf '  jq -r .notes %q\n' "$bundle/release-metadata.json"
    printf '  ssh-keygen -Y sign -n cagents-release -f KEY %q\n' "$bundle/release-metadata.json"
}

# The build host's checkout of this repository, relative to its home.
host_repository() {
    local relative=${ROOT_DIR#"$HOME"/}
    [[ $relative != "$ROOT_DIR" ]] || fail 'the repository must be under $HOME to locate it on the build host'
    printf '%s' "$relative"
}

# Runs the script on standard input on the build host, in its checkout of this
# repository. The host's login shell may not be POSIX; bash reads the script.
on_host() {
    # shellcheck disable=SC2029
    ssh "$BUILD_HOST" bash -s -- "$(host_repository)" "$@"
}

# Prints, as JSON, the build host's prebuilt bundles with each one's test
# verdict, the build running and the commit main's sentinel compiled last.
prebuilt() {
    on_host <<'HOST'
set -euo pipefail
cd ~/"$1"
scripts/prebuild-release --repository "$PWD" status --json | /usr/bin/python3 -I -c '
import json, pathlib, sys
status = json.load(sys.stdin)
verdicts = pathlib.Path.home() / ".local/state/cagents-main-sentinel/verdicts"
def verdict(sha):
    try:
        return json.loads((verdicts / f"{sha}.json").read_text()).get("passed")
    except (OSError, ValueError):
        return None
# An unreadable bundle.json reads as null; such a bundle is no candidate.
status["bundles"] = [bundle for bundle in status["bundles"] if bundle]
for bundle in status["bundles"]:
    bundle["passed"] = verdict(bundle["sha"])
print(json.dumps(status))
'
HOST
}

# Builds main's tip on the build host at normal priority and requires its
# passing verdict, which the sentinel gives while the bundle builds.
prebuild_tip() {
    local tip=$1
    printf 'Prebuilding %s on %s at normal priority; its tests run beside it if they have not yet.\n' \
        "$tip" "$BUILD_HOST"
    on_host "$tip" <<'HOST'
set -euo pipefail
cd ~/"$1"
tip=$2
scripts/prebuild-release --repository "$PWD" request "$tip" >/dev/null
scripts/main-build-sentinel --repository "$PWD" --require-tests "$tip" > /dev/null 2>&1 </dev/null &
tests=$!
scripts/prebuild-release --repository "$PWD" wait "$tip" </dev/null
status=0
wait "$tests" || status=$?
case $status in
    0) ;;
    1) echo "release: $tip fails its tests; see ~/.local/state/cagents-main-sentinel/logs on the build host" >&2; exit 1 ;;
    *) echo "release: the sentinel gave $tip no verdict (status $status); run the release again" >&2; exit 1 ;;
esac
HOST
}

# The versions tagged on origin, as a JSON array.
released_versions() {
    repository_git ls-remote --tags --refs origin 'v*' | sed -n 's#.*refs/tags/v##p' | jq -R . | jq -sc .
}

# The newest bundle main contains whose tests passed and whose version is not
# released yet, as "SHA BEHIND", where BEHIND counts the main commits after it.
newest_bundle() {
    local status=$1 released=$2 sha behind best= fewest=
    while read -r sha; do
        repository_git merge-base --is-ancestor "$sha" "$MAIN" 2>/dev/null || continue
        behind=$(repository_git rev-list --count --first-parent "$sha..$MAIN")
        if [[ -z $fewest ]] || ((behind < fewest)); then
            best=$sha
            fewest=$behind
        fi
    done < <(jq -r --argjson released "$released" \
        '.bundles[] | select(.passed == true and (.version as $v | $released | index($v) | not)) | .sha' \
        <<< "$status")
    [[ -n $best ]] && printf '%s %s\n' "$best" "$fewest"
}

# A pinned bundle is kept from eviction while it is chosen and copied.
CUT_SHA=
pin_bundle() {
    on_host "$1" <<'HOST' || fail "cannot keep the bundle of $1 on $BUILD_HOST; it may have been evicted, so run the release again"
cd ~/"$1" && scripts/prebuild-release --repository "$PWD" pin "$2"
HOST
    CUT_SHA=$1
}
unpin_bundle() {
    [[ -z $CUT_SHA ]] || on_host "$CUT_SHA" <<'HOST' || :
cd ~/"$1" && scripts/prebuild-release --repository "$PWD" unpin "$2"
HOST
    CUT_SHA=
}

NOTES_FILE=
cut_cleanup() {
    [[ -z $NOTES_FILE ]] || rm -f -- "$NOTES_FILE"
    unpin_bundle
}

cut() {
    local status released selected sha behind tip answer version bundle protocol previous key building
    trap cut_cleanup EXIT
    repository_git fetch --quiet origin main
    MAIN=$(repository_git rev-parse --verify origin/main)
    tip=$MAIN
    status=$(prebuilt) || fail "cannot read the prebuilt bundles on $BUILD_HOST"
    released=$(released_versions) || fail 'cannot read the tags on origin'
    if [[ -n $COMMIT ]]; then
        sha=$(repository_git rev-parse --verify "$COMMIT^{commit}") || fail "unknown commit: $COMMIT"
        repository_git merge-base --is-ancestor "$sha" "$MAIN" || fail "$sha is not on main"
        jq -e --arg sha "$sha" '.bundles[] | select(.sha == $sha and .passed == true)' <<< "$status" >/dev/null \
            || fail "$sha has no prebuilt bundle with passing tests on $BUILD_HOST"
        behind=$(repository_git rev-list --count --first-parent "$sha..$MAIN")
    elif selected=$(newest_bundle "$status" "$released"); then
        read -r sha behind <<< "$selected"
    else
        sha=
    fi
    [[ -z $sha ]] || pin_bundle "$sha"
    if [[ $WAIT == false && -n $sha && $behind -gt 0 ]]; then
        printf 'The newest bundle with passing tests, %s, is %s commit(s) behind main (%s):\n' \
            "${sha:0:12}" "$behind" "${tip:0:12}"
        repository_git log --oneline --first-parent "$sha..$MAIN" | sed 's/^/  /'
        building=$(jq -r '.building | select(. != null) | "\(.sha) for \((now - .started_at) / 60 | floor) min"' \
            <<< "$status")
        [[ -z $building ]] || printf 'Prebuilding %s now.\n' "$building"
        if [[ -t 0 ]]; then
            read -r -p 'Release it, or wait for a prebuild of the tip? [r/w] ' answer
            case $answer in w|W) WAIT=true ;; r|R) ;; *) fail 'nothing released' ;; esac
        elif [[ -z $COMMIT ]]; then
            fail "run with --wait to release main's tip, or --commit $sha to release this bundle"
        fi
    fi
    if [[ $WAIT == true || -z $sha ]]; then
        if [[ $WAIT == false ]]; then
            [[ -t 0 ]] || fail "$BUILD_HOST has no bundle of main with passing tests; run with --wait"
            read -r -p "$BUILD_HOST has no bundle of main with passing tests. Wait for a prebuild of the tip? [y/N] " answer
            [[ $answer == [yY] ]] || fail 'nothing released'
        fi
        unpin_bundle
        prebuild_tip "$tip" || fail "no bundle of $tip"
        sha=$tip
        pin_bundle "$sha"
    fi
    version=$(repository_git show "$sha:Cargo.toml" | sed -n '/^\[package\]/,/^\[/{s/^version = "\([^"]*\)"$/\1/p;}')
    [[ $version =~ $VERSION_PATTERN ]] || fail "$sha does not declare a stable version"
    VERSION=$version
    TAG=v$VERSION
    if jq -e --arg v "$VERSION" 'index($v)' <<< "$released" >/dev/null; then
        # publish pushes the tag just before it publishes; a failure between
        # the two leaves the tag on origin with nothing published.
        [[ $(gh release view "$TAG" -R "$GITHUB_REPOSITORY" --json isDraft --jq .isDraft 2>/dev/null) == false ]] \
            || fail "$TAG is on origin but not published; finish it with scripts/release publish $VERSION"
        fail "$TAG is already released; main needs its version bump first"
    fi
    bundle=$BUNDLES/$VERSION
    # Not on origin, so an earlier cut of this version was never published:
    # this one replaces it once it is copied and checked.
    if [[ -e $bundle/release-metadata.json.sig ]]; then
        printf 'An unpublished cut of %s is signed already, from %s.\n' "$TAG" \
            "$(jq -r .source_commit "$bundle/release-metadata.json" 2>/dev/null || echo 'an unknown commit')"
        [[ -t 0 ]] || fail "remove $bundle to replace it"
        read -r -p "Replace it with the bundle of ${sha:0:12}? [y/N] " answer
        [[ $answer == [yY] ]] || fail 'nothing released'
    fi
    mkdir -p -- "$BUNDLES"
    rm -rf -- "$bundle.partial"
    printf 'Copying the bundle of %s (%s) from %s.\n' "$sha" "$VERSION" "$BUILD_HOST"
    scp -q -r -- "$BUILD_HOST:.local/state/cagents-prebuilt/bundles/$sha/dist" "$bundle.partial"
    # Every file matches the size and digest the prebuild recorded for this
    # commit and version: what is signed is what was built and smoke-tested.
    "$ROOT_DIR/scripts/release-metadata" check --dir "$bundle.partial" --version "$VERSION" \
        --source-commit "$sha" >/dev/null || fail 'the copied bundle does not match what was built'
    protocol=$(jq -r .protocol "$bundle.partial/release-metadata.json")
    if [[ -z $NOTES ]]; then
        previous=$(repository_git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' "$sha^" 2>/dev/null) \
            || previous=
        NOTES_FILE=$(mktemp)
        "$ROOT_DIR/scripts/release-metadata" notes --repository "$ROOT_DIR" ${previous:+--from "$previous"} \
            --to "$sha" > "$NOTES_FILE"
        NOTES=$NOTES_FILE
    fi
    [[ -f $NOTES ]] || fail "release notes not found: $NOTES"
    [[ $(wc -c < "$NOTES") -le 65536 ]] || fail 'release notes exceed 64 KiB; pass a shorter --notes FILE'
    rm -- "$bundle.partial/release-metadata.json"
    "$ROOT_DIR/scripts/release-metadata" write --dir "$bundle.partial" --version "$VERSION" \
        --source-commit "$sha" --protocol "$protocol" --notes "$NOTES" >/dev/null
    if [[ -e $bundle ]]; then
        printf 'Replacing the unpublished cut of %s.\n' "$TAG"
        rm -rf -- "$bundle"
    fi
    if [[ $(repository_git rev-parse --quiet --verify "refs/tags/$TAG^{commit}") != "$sha" ]]; then
        repository_git tag -d "$TAG" >/dev/null 2>&1 || :
    fi
    mv -- "$bundle.partial" "$bundle"
    repository_git tag -a "$TAG" -m "$TAG" "$sha" 2>/dev/null \
        || [[ $(repository_git rev-parse "refs/tags/$TAG^{commit}") == "$sha" ]] || fail "cannot tag $sha as $TAG"
    printf '\nCut %s from %s into %s. Its notes:\n\n' "$TAG" "$sha" "$bundle"
    jq -r .notes "$bundle/release-metadata.json" | sed 's/^/  /'
    key=${KEY:-${CAGENTS_RELEASE_SIGNING_KEY:-}}
    if [[ -n $key ]]; then
        printf '\nSigning with %s; touch the key if it asks.\n' "$key"
        ssh-keygen -Y sign -n cagents-release -f "$key" "$bundle/release-metadata.json" \
            || fail "$TAG is cut but not signed; sign it, then publish: ssh-keygen -Y sign -n cagents-release -f $(printf %q "$key") $(printf %q "$bundle/release-metadata.json")"
        printf 'Rehearse the update, then publish:\n  scripts/release rehearse %s\n  scripts/release publish %s\n' \
            "$VERSION" "$VERSION"
    else
        printf '\nSign it, rehearse the update, then publish:\n  ssh-keygen -Y sign -n cagents-release -f KEY %q\n  scripts/release rehearse %s\n  scripts/release publish %s\n' \
            "$bundle/release-metadata.json" "$VERSION" "$VERSION"
    fi
}

# The pull request that starts the next patch version on main, as `release
# publish` opens and lands it after each release. Running it again resumes:
# it lands the pull request already open, or opens it afresh.
# Rebuilds BRANCH in WORKTREE as main plus the bump to NEXT, and pushes it,
# which also updates its open pull request. The bump is mechanical, so
# regenerating it is always right.
bump_branch() {
    local next=$1 branch=$2 worktree=$3
    [[ ! -d $worktree ]] || repository_git worktree remove --force "$worktree"
    repository_git worktree prune
    repository_git fetch --quiet origin main
    repository_git worktree add --quiet -B "$branch" "$worktree" origin/main \
        || fail "cannot create $worktree"
    # bump runs cargo, which mise provides only in a trusted checkout.
    if command -v mise >/dev/null && [[ -f $worktree/mise.toml ]]; then
        mise trust --quiet "$worktree" || fail "cannot trust $worktree for mise"
    fi
    "$worktree/scripts/release" bump "$next" >/dev/null || fail "the version bump to $next failed in $worktree"
    repository_git -C "$worktree" commit --quiet -am "chore(release): start $next after $TAG" \
        || fail "cannot commit the version bump in $worktree"
    repository_git -C "$worktree" push --quiet --force -u origin "$branch" || fail "cannot push $branch"
}

start_next_version() {
    local next branch worktree number body status=0
    next=${VERSION%.*}.$((${VERSION##*.} + 1))
    repository_git fetch --quiet origin main
    if [[ $(repository_git show origin/main:Cargo.toml | sed -n '/^\[package\]/,/^\[/{s/^version = "\([^"]*\)"$/\1/p;}') \
            != "$VERSION" ]]; then
        printf 'main no longer declares %s; it needs no version bump.\n' "$VERSION"
        return 0
    fi
    branch=release/bump-$next
    worktree=$ROOT_DIR/.worktrees/release-bump-$next
    number=$(gh pr list -R "$GITHUB_REPOSITORY" --head "$branch" --state open --json number --jq '.[0].number // empty') \
        || fail "cannot look for an open pull request from $branch"
    if [[ -n $number ]]; then
        printf 'Landing #%s, which starts %s.\n' "$number" "$next"
    else
        # Anything left of an earlier attempt that opened nothing is rebuilt.
        bump_branch "$next" "$branch" "$worktree"
        body=$(printf '%s\n' \
            "$TAG is published, so main now declares the next patch version, $next. Release bundles are prebuilt from main commits with the version those commits declare, so until this lands every main commit declares the already-tagged $VERSION and gets no usable bundle." \
            "" \
            "This is the change \`scripts/release bump $next\` makes: the four product manifests and the workspace's own \`Cargo.lock\` entries. \`release publish\` opens and lands this pull request after each release.")
        number=$(gh pr create -R "$GITHUB_REPOSITORY" --base main --head "$branch" \
            --title "chore(release): start $next after $TAG" --body "$body" | sed -n 's#.*/pull/\([0-9]*\)$#\1#p') \
            || fail "cannot open the pull request from $branch"
        [[ -n $number ]] || fail "cannot open the pull request from $branch"
        printf 'Opened #%s to start %s; landing it once its checks pass.\n' "$number" "$next"
    fi
    "$ROOT_DIR/scripts/land-pr" "$number" -R "$GITHUB_REPOSITORY" || status=$?
    if ((status == 3)); then
        # land-pr's status for a conflict with main.
        printf '#%s conflicts with main; making the bump again on main.\n' "$number"
        bump_branch "$next" "$branch" "$worktree"
        status=0
        "$ROOT_DIR/scripts/land-pr" "$number" -R "$GITHUB_REPOSITORY" || status=$?
    fi
    ((status == 0)) \
        || fail "#$number, which starts $next, did not land; run scripts/release publish $VERSION again once it can"
    [[ ! -d $worktree ]] || repository_git worktree remove --force "$worktree"
}

# The version is updated from what is published now to the bytes cut, copied
# to the build host. By default the published build updates itself as a
# person does, from a file feed of the signed cut; --staged runs the cut's
# own staged upgrade instead.
rehearse() {
    local bundle=$BUNDLES/$VERSION sha previous root started mode=in-app files
    [[ -f $bundle/release-metadata.json ]] || fail "cut $VERSION first: scripts/release cut"
    if [[ $STAGED == true ]]; then
        mode=staged
        files=("$bundle/cagents-$VERSION-x86_64-unknown-linux-gnu.tar.gz" "$bundle/SHA256SUMS" "$bundle/install.sh")
    else
        # The published build trusts only the release keys.
        bundle=$(signed_bundle)
        files=("$bundle"/*)
    fi
    sha=$(jq -er .source_commit "$bundle/release-metadata.json") || fail "$bundle names no source commit"
    previous=$(gh release view -R "$GITHUB_REPOSITORY" --json tagName --jq .tagName) \
        || fail 'cannot read the newest published release'
    previous=${previous#v}
    [[ $previous =~ $VERSION_PATTERN && $previous != "$VERSION" \
        && $(printf '%s\n%s\n' "$previous" "$VERSION" | sort -V | tail -n1) == "$VERSION" ]] \
        || fail "the newest published release is $previous, not older than $VERSION; there is nothing to rehearse"
    # ssh would drop an empty argument.
    root=${REHEARSAL_ROOT:--}
    printf 'Rehearsing the %s update from %s to %s on %s; it takes a few minutes.\n' \
        "$mode" "$previous" "$VERSION" "$BUILD_HOST"
    started=$SECONDS
    on_host "$VERSION" <<'HOST' || fail "cannot prepare $BUILD_HOST for the rehearsal"
rm -rf -- ~/.cache/cagents-release-rehearsal/cut-"$2" && mkdir -p -- ~/.cache/cagents-release-rehearsal/cut-"$2"
HOST
    scp -q -- "${files[@]}" "$BUILD_HOST:.cache/cagents-release-rehearsal/cut-$VERSION/" \
        || fail "cannot copy the cut to $BUILD_HOST"
    on_host "$sha" "$VERSION" "$previous" "$GITHUB_REPOSITORY" "$root" "$mode" "$REHEARSAL_PARENTS" <<'HOST' \
        || fail "the rehearsal of $VERSION did not pass"
# Parsed whole before it runs, so nothing it starts reads the rest of it.
main() {
set -euo pipefail
cd ~/"$1"
local repository=$PWD sha=$2 version=$3 previous=$4 github=$5 root=$6 mode=$7 cache=~/.cache/cagents-release-rehearsal
local new=$cache/cut-$3 old=$cache/$4 harness=$PWD/.worktrees/.rehearse-release status=0 update
local feed=$cache/feed-$3 path=() parents parent ancestor kept=
if [[ $root == - ]]; then
    root=
    IFS=: read -ra parents <<<"$8"
    for parent in "${parents[@]}"; do
        ancestor=$parent
        while [[ ! -e $ancestor/.git && ! -L $ancestor/.git && $ancestor != / ]]; do ancestor=$(dirname -- "$ancestor"); done
        [[ -e $ancestor/.git || -L $ancestor/.git ]] || { root=$parent/release-$version; break; }
    done
    [[ -n $root ]] || { echo "release: each of ${parents[*]} has a .git above it; set CAGENTS_RELEASE_REHEARSAL_ROOT" >&2; exit 1; }
fi
exec 9>>"$cache/lock"
flock -n 9 || { echo "release: another rehearsal is running on $HOSTNAME" >&2; exit 1; }
(cd "$new" && sha256sum --check --strict --ignore-missing --quiet SHA256SUMS)
if [[ ! -f $old/SHA256SUMS ]]; then
    rm -rf -- "$old.partial"
    mkdir -p -- "$old.partial"
    gh release download "v$previous" -R "$github" -D "$old.partial" \
        -p "cagents-$previous-x86_64-unknown-linux-gnu.tar.gz" -p SHA256SUMS -p install.sh
    rm -rf -- "$old"
    mv -- "$old.partial" "$old"
fi
(cd "$old" && sha256sum --check --strict --ignore-missing --quiet SHA256SUMS) \
    || { rm -rf -- "$old"; echo "release: the download of $previous was damaged; run the rehearsal again" >&2; exit 1; }
# The harness of the commit released, which knows what that build does; made
# afresh, so that nothing else in the directory can redirect Git.
git -C "$repository" worktree remove --force "$harness" 2>/dev/null || rm -rf -- "$harness"
git -C "$repository" worktree prune
git -C "$repository" cat-file -e "$sha^{commit}" 2>/dev/null || git -C "$repository" fetch -q --no-tags origin main
git -C "$repository" worktree add -q --detach "$harness" "$sha"
local rehearse=$harness/scripts/rehearse-update
if [[ $mode == in-app ]]; then
    # The feed offers only the cut, whose signature the published build checks.
    rm -rf -- "$feed"
    "$harness/scripts/release-metadata" feed --dir "$new" --feed "$feed" >/dev/null
    # A third window holding nothing reads the update's status as soon as it
    # reopens, while the published build's worker is still verifying the cut.
    path=(--feed "$feed" --empty-window)
fi
if [[ -e $root ]]; then
    echo "Replacing the earlier rehearsal in $root."
    # Without its marker, init never finished, so nothing there runs.
    "$rehearse" --root "$root" cleanup >/dev/null || [[ -e $root/.rehearse-update ]] || rm -rf -- "$root"
    [[ ! -e $root ]] || { echo "release: cannot remove the earlier rehearsal in $root" >&2; exit 1; }
fi
"$rehearse" --root "$root" run --old-dir "$old" --old-version "$previous" --old-installer "$old/install.sh" \
    --new-dir "$new" --new-version "$version" --new-installer "$new/install.sh" --answer yes \
    --ended-provider "${path[@]}" >/dev/null 9>&- || status=$?
local report=$root/report.txt
[[ ! -f $report ]] || sed -n '/^Total duration:/p;/^Outcome:/p;/^Regressions/,/^Steps/{/^Steps/d;p;}' "$report"
# The update worker's own record: the cut's on the staged path, the
# published build's in the app. A failed or refused job is what reopened
# windows report as "Update failed" or "Update not installed".
update=$(/usr/bin/python3 -I -c '
import json, sys
try:
    job = json.load(open(sys.argv[1]))
    print(job.get("phase"), *(["refused"] if job.get("refusal") else []))
except (OSError, ValueError):
    print("absent")' "$root/home/.local/share/cagents-install/.update/status.json")
echo "Update status: $update"
# Either way a reopened window reports anything but Complete as a failed
# or refused update, which is what the rehearsal must catch (#3877).
if ((status == 0)) && grep -qx 'Outcome: PASS' "$report" && [[ $update == Complete ]]; then
    "$rehearse" --root "$root" cleanup >/dev/null \
        || echo "release: the rehearsal passed, but $root could not be removed" >&2
    git -C "$repository" worktree remove --force "$harness" || :
    rm -rf -- "$feed"
elif [[ $root == /dev/shm/* ]]; then
    # Memory: keep the report and screenshots, and free the rest.
    kept=$cache/failed-$version
    rm -rf -- "$kept" && mkdir -p -- "$kept"
    cp -a -- "$report" "$kept/" 2>/dev/null || :
    [[ ! -d $root/shots ]] || cp -a -- "$root/shots" "$kept/"
    "$rehearse" --root "$root" cleanup >/dev/null || :
    echo "release: its report and screenshots are in $kept on $HOSTNAME" >&2
    exit 1
else
    echo "release: its report, records and screenshots are in $root on $HOSTNAME" >&2
    exit 1
fi
}
main "$@" </dev/null
HOST
    printf 'Rehearsed %s to %s in %d min %d s.\n' "$previous" "$VERSION" $(((SECONDS - started) / 60)) \
        $(((SECONDS - started) % 60))
}

signed_bundle() {
    local bundle=$BUNDLES/$VERSION
    [[ -f $bundle/release-metadata.json.sig ]] \
        || fail "sign $bundle/release-metadata.json first (see --help)"
    printf '%s' "$bundle"
}

case $COMMAND in
    bump) bump ;;
    build) build ;;
    cut) cut ;;
    rehearse) rehearse ;;
    feed)
        [[ -n $FEED ]] || fail 'feed needs --feed DIR'
        "$ROOT_DIR/scripts/release-metadata" feed --dir "$(signed_bundle)" --feed "$FEED"
        ;;
    publish)
        bundle=$(signed_bundle)
        # Run again after a failure, it resumes past what is done.
        if [[ $(gh release view "$TAG" -R "$GITHUB_REPOSITORY" --json isDraft --jq .isDraft 2>/dev/null) == false ]]; then
            printf '%s is published already.\n' "$TAG"
        else
            printf 'Publishing %s makes it the update every installed cagents offers.\n' "$TAG"
            read -r -p "Type $VERSION to publish: " answer
            [[ $answer == "$VERSION" ]] || fail 'not published'
            # It verifies the signature, checksums, archives and a smoke
            # install, and only then pushes the tag and uploads.
            "$ROOT_DIR/scripts/publish-release" --version "$VERSION" --dist "$bundle" --push-tag \
                || fail "$TAG is not published; once the cause is fixed, run scripts/release publish $VERSION again"
        fi
        start_next_version
        ;;
    *) fail "unknown command: $COMMAND (see --help)" ;;
esac
