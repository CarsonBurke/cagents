#!/usr/bin/env bash
# Cut a release: bump the version, build the tagged source on the build host,
# sign, rehearse through a file feed, and publish. See docs/releasing.md.
set -euo pipefail

PROGRAM=release
ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BUILD_HOST=${CAGENTS_RELEASE_BUILD_HOST:-fw16}
BUNDLES=${CAGENTS_RELEASE_BUNDLES:-"${XDG_STATE_HOME:-$HOME/.local/state}/cagents-release"}
VERSION_PATTERN='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
# Workspace members that carry the product version.
MANIFESTS=(Cargo.toml crates/cagents-ui/Cargo.toml crates/ceditor/Cargo.toml crates/cagents-dictate/Cargo.toml)

fail() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: scripts/release COMMAND VERSION [OPTIONS]

  bump VERSION     Set every product manifest and Cargo.lock to VERSION.
                   Commit it through a pull request, then tag the merged
                   commit: git tag -a vVERSION -m vVERSION COMMIT
  build VERSION [--notes FILE] [--build-host HOST]
                   Build tag vVERSION on HOST (default: CAGENTS_RELEASE_BUILD_HOST
                   or fw16) in the glibc-baseline environment, run its tests
                   and smoke checks, and bring the bundle back to
                   $CAGENTS_RELEASE_BUNDLES/VERSION (default under
                   ~/.local/state/cagents-release). FILE holds the notes an
                   installed cagents shows; by default they are the features,
                   fixes and speedups since the previous tag here.
  feed VERSION --feed DIR
                   Add the signed bundle to a file feed, for rehearsing the
                   update before publishing (docs/releasing.md#rehearsing).
  publish VERSION  Verify the signed bundle and publish it on GitHub, after
                   you confirm by typing the version.

Sign between build and feed or publish, with your own key:
  ssh-keygen -Y sign -n cagents-release -f KEY BUNDLE/release-metadata.json
EOF
}

(($# >= 1)) || { usage >&2; exit 2; }
COMMAND=$1
shift
case $COMMAND in -h|--help) usage; exit 0 ;; esac
(($# >= 1)) || fail "$COMMAND needs a VERSION"
VERSION=$1
shift
[[ $VERSION =~ $VERSION_PATTERN ]] || fail 'VERSION must be a stable semantic version without a leading v'
TAG=v$VERSION
NOTES=
FEED=
while (($#)); do
    case $1 in
        --notes|--build-host|--feed)
            (($# >= 2)) && [[ -n $2 ]] || fail "$1 requires a value"
            case $1 in --notes) NOTES=$2 ;; --build-host) BUILD_HOST=$2 ;; --feed) FEED=$2 ;; esac
            shift 2
            ;;
        *) fail "unknown argument: $1 (see --help)" ;;
    esac
done

repository_git() (
    unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
    git -C "$ROOT_DIR" "$@"
)

package_version() {
    sed -n '/^\[package\]/,/^\[/{s/^version = "\([^"]*\)"$/\1/p;}' "$1"
}

bump() {
    local manifest current
    current=$(package_version "$ROOT_DIR/Cargo.toml")
    [[ $current != "$VERSION" ]] || fail "the manifests already declare $VERSION"
    [[ $(printf '%s\n%s\n' "$current" "$VERSION" | sort -V | tail -n1) == "$VERSION" ]] \
        || fail "$VERSION is not newer than $current"
    for manifest in "${MANIFESTS[@]}"; do
        [[ $(package_version "$ROOT_DIR/$manifest") == "$current" ]] \
            || fail "$manifest does not declare $current"
        # Only the [package] table's version; dependency versions stay.
        sed -i "/^\[package\]/,/^\[/{s/^version = \"$current\"$/version = \"$VERSION\"/;}" "$ROOT_DIR/$manifest"
    done
    # Updates the workspace's own entries in Cargo.lock; compiles nothing.
    (cd "$ROOT_DIR" && cargo update --workspace --offline --quiet)
    printf 'Set %s to %s. Commit it through a pull request, then tag the merged commit:\n' \
        "${MANIFESTS[*]}" "$VERSION"
    printf '  git tag -a %s -m %s COMMIT && git push origin %s\n' "$TAG" "$TAG" "$TAG"
}

build() {
    local commit relative remote_output bundle
    commit=$(repository_git rev-parse --verify "refs/tags/$TAG^{commit}") \
        || fail "tag $TAG does not exist here; create it on the merged version bump first"
    bundle=$BUNDLES/$VERSION
    [[ ! -e $bundle ]] || fail "$bundle exists; remove it to build $VERSION again"
    relative=${ROOT_DIR#"$HOME"/}
    [[ $relative != "$ROOT_DIR" ]] || fail 'the repository must be under $HOME to locate it on the build host'
    # The build runs the tag's own scripts from a checkout this command owns.
    # This checkout's tag is authoritative and replaces any other there.
    repository_git push --quiet --force "ssh://$BUILD_HOST/~/$relative" "refs/tags/$TAG:refs/tags/$TAG"
    remote_output=/var/tmp/cagents-release/$VERSION
    # Notes come from this checkout, which has every earlier tag, and are
    # checked before hours of building rather than after.
    if [[ -z $NOTES ]]; then
        local previous
        previous=$(repository_git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' "$commit^" 2>/dev/null) \
            || previous=
        NOTES=$(mktemp)
        trap 'rm -f -- "$NOTES"' EXIT
        "$ROOT_DIR/scripts/release-metadata" notes --repository "$ROOT_DIR" ${previous:+--from "$previous"} \
            --to "$commit" > "$NOTES"
    fi
    [[ -f $NOTES ]] || fail "release notes not found: $NOTES"
    [[ $(wc -c < "$NOTES") -le 65536 ]] || fail 'release notes exceed 64 KiB; pass a shorter --notes FILE'
    ssh "$BUILD_HOST" mkdir -p /var/tmp/cagents-release
    scp -q -- "$NOTES" "$BUILD_HOST:/var/tmp/cagents-release/$VERSION-notes.md"
    # The host's login shell may not be POSIX; bash reads the script instead.
    ssh "$BUILD_HOST" bash -s <<EOF
set -euo pipefail
cd ~/$(printf '%q' "$relative")
checkout=.worktrees/.release
if [[ -e \$checkout ]]; then
    git -C "\$checkout" checkout --quiet --detach $(printf '%q' "$commit")
else
    git worktree add --quiet --detach "\$checkout" $(printf '%q' "$commit")
fi
rm -rf -- $(printf '%q' "$remote_output")
# The gate admits the build beside other agents' and holds its shares.
CARGO_BUILD_JOBS=\${CARGO_BUILD_JOBS:-8} "\$checkout/scripts/cargo-gate" exec \
    "\$checkout/scripts/build-release-linux" --ref $(printf '%q' "$TAG") \
    --output $(printf '%q' "$remote_output") --notes /var/tmp/cagents-release/$VERSION-notes.md </dev/null
EOF
    mkdir -p -- "$BUNDLES"
    rm -rf -- "$bundle.partial"
    scp -q -r -- "$BUILD_HOST:$remote_output" "$bundle.partial"
    "$ROOT_DIR/scripts/release-metadata" check --dir "$bundle.partial" --version "$VERSION" \
        --source-commit "$commit" >/dev/null || fail 'the copied bundle does not match its metadata'
    mv -- "$bundle.partial" "$bundle"
    # shellcheck disable=SC2029
    ssh "$BUILD_HOST" rm -rf -- "$remote_output" "/var/tmp/cagents-release/$VERSION-notes.md"
    printf 'Built %s into %s.\nRead its notes, then sign:\n' "$TAG" "$bundle"
    printf '  jq -r .notes %q\n' "$bundle/release-metadata.json"
    printf '  ssh-keygen -Y sign -n cagents-release -f KEY %q\n' "$bundle/release-metadata.json"
}

signed_bundle() {
    local bundle=$BUNDLES/$VERSION
    [[ -f $bundle/release-metadata.json.sig ]] \
        || fail "sign $bundle/release-metadata.json first (see --help)"
    printf '%s' "$bundle"
}

case $COMMAND in
    bump) bump ;;
    build) build ;;
    feed)
        [[ -n $FEED ]] || fail 'feed needs --feed DIR'
        "$ROOT_DIR/scripts/release-metadata" feed --dir "$(signed_bundle)" --feed "$FEED"
        ;;
    publish)
        bundle=$(signed_bundle)
        printf 'Publishing %s makes it the update every installed cagents offers.\n' "$TAG"
        read -r -p "Type $VERSION to publish: " answer
        [[ $answer == "$VERSION" ]] || fail 'not published'
        # It verifies the signature, checksums, archives and a smoke install
        # before uploading anything.
        "$ROOT_DIR/scripts/publish-release" --version "$VERSION" --dist "$bundle"
        ;;
    *) fail "unknown command: $COMMAND (see --help)" ;;
esac
