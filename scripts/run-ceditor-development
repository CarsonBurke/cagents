#!/bin/sh
set -eu
caller_cwd=$PWD
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
alerts=0
case "${1:-}" in
    --help)
        printf '%s\n' 'Usage: scripts/run-ceditor-development [--review-alerts] [--] [FILE_OR_DIRECTORY...]' '' 'Builds only ceditor with dev-runtime and an isolated development identity.' 'Use --review-alerts to build matched CLI/daemon companions in separate lanes.' 'Without that flag, ordinary editing requires no terminal host, Zig, or Servo.' 'Pass -- --help for ceditor CLI help; -- --settings-path prints its settings path.'
        exit 0
        ;;
    --review-alerts) alerts=1; shift; [ "${1:-}" != -- ] || shift ;;
    --) shift ;;
esac
if [ "$alerts" = 1 ]; then
    cargo build --locked --profile dev-runtime --no-default-features --features development --bin cagents
    cargo build --locked --profile dev-runtime --no-default-features --features development,host --bin cagentsd
fi
cargo build --locked --profile dev-runtime --package ceditor --features development
# Cargo metadata honors target-dir from Cargo config as well as the environment.
# Companions are started lazily only when a review alert is observed.
target=$(cargo metadata --no-deps --format-version 1 | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p')
[ -n "$target" ] || { printf '%s\n' 'Cargo did not report its target directory' >&2; exit 1; }
if [ -n "${CARGO_BUILD_TARGET:-}" ]; then
    target=$target/$CARGO_BUILD_TARGET
fi
# Wayland task switchers resolve icons through the application ID's desktop entry.
# Keep development separate without maintaining a second copy of the artwork.
data_home=${XDG_DATA_HOME:-"${HOME:?HOME must be set}/.local/share"}
desktop_id=io.github.cagents.ceditor.Development
install -d "$data_home/applications"
install -Dm644 "$root/packaging/io.github.cagents.ceditor.svg" \
    "$data_home/icons/hicolor/scalable/apps/$desktop_id.svg"
desktop_exec=$(printf '%s' "$target/dev-runtime/ceditor" | sed \
    -e 's/\\/\\\\/g' \
    -e 's/"/\\"/g' \
    -e 's/`/\\`/g' \
    -e 's/\$/\\$/g' \
    -e 's/%/%%/g')
{
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in
            Name=*) printf '%s\n' 'Name=ceditor Development' ;;
            Exec=*) printf 'Exec="%s" %%F\n' "$desktop_exec" ;;
            Icon=*) printf 'Icon=%s\n' "$desktop_id" ;;
            StartupWMClass=*) printf 'StartupWMClass=%s\n' "$desktop_id" ;;
            MimeType=*) ;;
            *) printf '%s\n' "$line" ;;
        esac
    done < "$root/packaging/io.github.cagents.ceditor.desktop"
    printf '%s\n' 'NoDisplay=true'
} > "$data_home/applications/$desktop_id.desktop"
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache --force --ignore-theme-index "$data_home/icons/hicolor" >/dev/null 2>&1 || :
fi
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$data_home/applications" >/dev/null 2>&1 || :
fi
cd "$caller_cwd"
exec "$target/dev-runtime/ceditor" "$@"
