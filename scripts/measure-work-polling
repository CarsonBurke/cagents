#!/bin/bash
# Measure how much Git the daemon's Work board runs for a large project that
# the watcher cannot cover, in a private fixture. See "Work board polling" in
# docs/performance.md.
#
#   scripts/measure-work-polling BIN_DIR [WORKTREES] [SECONDS] [ACTIVE]
#
# BIN_DIR holds a matched `cagents` and `cagentsd`. The fixture project has
# WORKTREES (default 250) worktrees of 40 tracked directories each, more than
# the watcher's directory budget, and ACTIVE (default 3) of them have a fresh
# edit. The fixture project also has a few edits outside the active window.
# After the first scans settle, it counts the `git status` reads the
# daemon starts and the CPU its exited children used over SECONDS (default
# 120). Nothing outside the fixture is touched.
set -euo pipefail

if [ "${CAGENTS_AGENT_AUTHORITY+x}" ]; then
    printf '%s\n' 'This fixture requires a genuine User shell; inherited agent authority was not modified.' >&2
    exit 77
fi
if [ $# -lt 1 ] || [ $# -gt 4 ]; then
    sed -n '2,13p' "$0" >&2
    exit 2
fi
bin=$(realpath "$1")
worktrees=${2:-250}
seconds=${3:-120}
active=${4:-3}
[ -x "$bin/cagents" ] && [ -x "$bin/cagentsd" ] || {
    printf 'No matched cagents and cagentsd in %s\n' "$bin" >&2
    exit 2
}
checkout=$(cd "$(dirname "$0")/.." && pwd)
root=$(mktemp -d "$HOME/.local/state/work-polling.XXXXXX")
# Unix socket paths are short: keep the runtime beneath the real one.
runtime=$(mktemp -d "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wp.XXXXXX")
mkdir -p "$root"/{home,data,config,cache}

fixture() {
    env -u CLAUDE_CONFIG_DIR -u CAGENTS_SESSION_ID \
        HOME="$root/home" XDG_RUNTIME_DIR="$runtime" \
        XDG_DATA_HOME="$root/data" XDG_CONFIG_HOME="$root/config" \
        XDG_CACHE_HOME="$root/cache" "$@"
}
fixture_processes() {
    grep -lzx "XDG_RUNTIME_DIR=$runtime" /proc/[0-9]*/environ 2>/dev/null |
        cut -d/ -f3 | grep -vx "$$" || true
}
cleanup() {
    fixture "$bin/cagents" --no-start daemon stop >/dev/null 2>&1 || true
    local pids
    pids=$(fixture_processes)
    [ -z "$pids" ] || kill $pids 2>/dev/null || true
    sleep 1
    pids=$(fixture_processes)
    [ -z "$pids" ] || kill -9 $pids 2>/dev/null || true
    rm -rf "$runtime" "$root"
}
trap cleanup EXIT

project="$root/project"
git init -q --initial-branch=main "$project"
for directory in $(seq -w 1 40); do
    mkdir -p "$project/src/d$directory"
    printf '%s\n' "$directory" > "$project/src/d$directory/file.txt"
done
git -C "$project" add -A
git -C "$project" -c user.name=fixture -c user.email=fixture@example.test \
    commit -q -m fixture
for index in $(seq 1 "$worktrees"); do
    git -C "$project" worktree add -q -b "w$index" "$project/.worktrees/w$index"
done
# Old edits: dirty, but outside the active window.
for index in $(seq $((active + 1)) $((active + 10))); do
    [ "$index" -le "$worktrees" ] || break
    printf 'old\n' >> "$project/.worktrees/w$index/src/d01/file.txt"
    touch -d '2 days ago' "$project/.worktrees/w$index/src/d01/file.txt"
done
# Fresh edits: the project, and these worktrees, are active.
for index in $(seq 1 "$active"); do
    printf 'edit\n' >> "$project/.worktrees/w$index/src/d01/file.txt"
done
fixture "$bin/cagents" project open "$project" >/dev/null
# The board learns of the project within a model refresh, then reads every
# worktree once.
printf 'worktrees=%s active=%s; waiting 90 s for the first scans\n' "$worktrees" "$active"
sleep 90
daemon=$(fixture_processes | while read -r pid; do
    if [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = cagentsd ]; then echo "$pid"; fi
done | head -n 1)
[ -n "$daemon" ] || { printf '%s\n' 'The fixture daemon is not running' >&2; exit 1; }
python3 -I - "$daemon" "$seconds" <<'EOF'
import glob, os, sys, time

daemon, seconds = sys.argv[1], float(sys.argv[2])
ticks = os.sysconf("SC_CLK_TCK")

def times():
    fields = open(f"/proc/{daemon}/stat").read().rsplit(")", 1)[1].split()
    own = int(fields[11]) + int(fields[12])
    children = int(fields[13]) + int(fields[14])
    return own, children

seen, statuses = set(), 0
own, children = times()
end = time.monotonic() + seconds
while time.monotonic() < end:
    for task in glob.glob(f"/proc/{daemon}/task/*/children"):
        try:
            pids = open(task).read().split()
        except OSError:
            continue
        for pid in pids:
            if pid in seen:
                continue
            try:
                arguments = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
            except OSError:
                continue
            # Caught between fork and exec: look again next pass.
            if not arguments or arguments[0] != b"git":
                continue
            seen.add(pid)
            statuses += b"status" in arguments
    time.sleep(0.002)
now_own, now_children = times()
print(f"seconds={seconds:g} git={len(seen)} status={statuses}")
print(f"git status per second {statuses / seconds:.2f}")
print(f"git processes per second {len(seen) / seconds:.2f}")
print(f"exited children cpu % core {100 * (now_children - children) / ticks / seconds:.2f}")
print(f"daemon cpu % core {100 * (now_own - own) / ticks / seconds:.2f}")
EOF
