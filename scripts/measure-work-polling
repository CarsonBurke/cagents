#!/bin/bash
# Measure how much Git the daemon's Work board runs for a large project that
# the watcher cannot cover, in a private fixture. See "Work board polling" in
# docs/performance.md.
#
#   scripts/measure-work-polling BIN_DIR [WORKTREES] [SECONDS] [ACTIVE] [DIRECTORIES]
#
# BIN_DIR holds a matched `cagents` and `cagentsd`. The fixture project has
# WORKTREES (default 250) worktrees of DIRECTORIES (default 40) tracked
# directories each, more than the watcher's directory budget. ACTIVE (default
# 3) of them have a fresh edit and ten more an edit outside the active window.
# It reports the first load: how long the board took to read every worktree,
# plan and register its watches and settle, and which Git commands it ran. Then it counts the
# Git commands and `git status` reads the daemon starts and the CPU it and its
# exited children used over SECONDS (default 300). Git's own trace2 records
# every command, so even the shortest are counted. Nothing outside the fixture
# is touched.
set -euo pipefail

if [ "${CAGENTS_AGENT_AUTHORITY+x}" ]; then
    printf '%s\n' 'This fixture requires a genuine User shell; inherited agent authority was not modified.' >&2
    exit 77
fi
if [ $# -lt 1 ] || [ $# -gt 5 ]; then
    sed -n '2,17p' "$0" >&2
    exit 2
fi
bin=$(realpath "$1")
worktrees=${2:-250}
seconds=${3:-300}
active=${4:-3}
tracked=${5:-40}
[ -x "$bin/cagents" ] && [ -x "$bin/cagentsd" ] || {
    printf 'No matched cagents and cagentsd in %s\n' "$bin" >&2
    exit 2
}
checkout=$(cd "$(dirname "$0")/.." && pwd)
budget=$(sed -n 's/^const MAX_DIRECTORIES: usize = \([0-9]*\);$/\1/p' "$checkout/src/git_watch.rs")
[ -n "$budget" ] || { printf '%s\n' 'The watcher budget was not found in src/git_watch.rs' >&2; exit 2; }
root=$(mktemp -d "$HOME/.local/state/work-polling.XXXXXX")
# Unix socket paths are short: keep the runtime beneath the real one.
runtime=$(mktemp -d "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wp.XXXXXX")
mkdir -p "$root"/{home,data,config,cache,trace}

fixture() {
    env -u CLAUDE_CONFIG_DIR -u CAGENTS_SESSION_ID \
        HOME="$root/home" XDG_RUNTIME_DIR="$runtime" \
        XDG_DATA_HOME="$root/data" XDG_CONFIG_HOME="$root/config" \
        XDG_CACHE_HOME="$root/cache" GIT_TRACE2="$root/trace" "$@"
}
fixture_processes() {
    grep -lzx "XDG_RUNTIME_DIR=$runtime" /proc/[0-9]*/environ 2>/dev/null |
        cut -d/ -f3 | grep -vx "$$" || true
}
cleanup() {
    fixture "$bin/cagents" --no-start daemon stop >/dev/null 2>&1 || true
    local pids
    pids=$(fixture_processes)
    [ -z "$pids" ] || kill $pids 2>/dev/null || true
    sleep 1
    pids=$(fixture_processes)
    [ -z "$pids" ] || kill -9 $pids 2>/dev/null || true
    rm -rf "$runtime" "$root"
}
trap cleanup EXIT

project="$root/project"
git init -q --initial-branch=main "$project"
# Otherwise the primary checkout reports the worktrees as untracked, fresh
# edits and so counts as active.
printf '/.worktrees/\n' >> "$project/.git/info/exclude"
# The first tracked directory, whose file the fixture edits.
first=$(seq -w 1 "$tracked" | head -n 1)
for directory in $(seq -w 1 "$tracked"); do
    mkdir -p "$project/src/d$directory"
    printf '%s\n' "$directory" > "$project/src/d$directory/file.txt"
done
git -C "$project" add -A
git -C "$project" -c user.name=fixture -c user.email=fixture@example.test \
    commit -q -m fixture
for index in $(seq 1 "$worktrees"); do
    git -C "$project" worktree add -q -b "w$index" "$project/.worktrees/w$index"
done
# The watcher needs one watch per tracked directory, root included, in every
# checkout. Within its budget the project is watched, not polled.
per_checkout=$(git -C "$project" ls-files | awk -F/ '{p=""; for (i = 1; i < NF; i++) {p = p $i "/"; print p}}' | sort -u | wc -l)
directories=$(( (worktrees + 1) * (per_checkout + 1) ))
if [ "$directories" -le "$budget" ]; then
    printf '%s directories fit the watcher budget of %s; use more worktrees\n' \
        "$directories" "$budget" >&2
    exit 2
fi
# Old edits: dirty, but outside the active window.
for index in $(seq $((active + 1)) $((active + 10))); do
    [ "$index" -le "$worktrees" ] || break
    printf 'old\n' >> "$project/.worktrees/w$index/src/d$first/file.txt"
    touch -d '2 days ago' "$project/.worktrees/w$index/src/d$first/file.txt"
done
# Fresh edits: the project, and these worktrees, are active.
for index in $(seq 1 "$active"); do
    printf 'edit\n' >> "$project/.worktrees/w$index/src/d$first/file.txt"
done
fixture "$bin/cagents" project open "$project" >/dev/null
daemon=$(fixture_processes | while read -r pid; do
    if [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = cagentsd ]; then echo "$pid"; fi
done | head -n 1)
[ -n "$daemon" ] || { printf '%s\n' 'The fixture daemon is not running' >&2; exit 1; }
printf 'worktrees=%s active=%s directories=%s budget=%s\n' \
    "$worktrees" "$active" "$directories" "$budget"
/usr/bin/python3 -I - "$daemon" "$seconds" "$((worktrees + 1))" "$root/trace" <<'EOF'
import collections, glob, os, sys, time

daemon, seconds, checkouts, trace = sys.argv[1], float(sys.argv[2]), int(sys.argv[3]), sys.argv[4]
ticks = os.sysconf("SC_CLK_TCK")
# Watch planning's own commands: a worktree's Git paths and its index.
PLAN = {"rev-parse", "ls-files"}
# Trace session file: (subcommand, wall-clock start, elapsed seconds).
known = {}


def times():
    fields = open(f"/proc/{daemon}/stat").read().rsplit(")", 1)[1].split()
    return int(fields[11]) + int(fields[12]), int(fields[13]) + int(fields[14])


def watches():
    """Native inotify watches the daemon holds."""
    count = 0
    for fd in glob.glob(f"/proc/{daemon}/fdinfo/*"):
        try:
            with open(fd) as info:
                count += sum(line.startswith("inotify wd:") for line in info)
        except OSError:
            pass
    return count


def collect():
    """Reads the trace sessions of every Git command that has exited."""
    for name in os.listdir(trace):
        if name in known:
            continue
        path = os.path.join(trace, name)
        command = elapsed = None
        try:
            with open(path) as session:
                for line in session:
                    fields = line.split()
                    if len(fields) < 4:
                        continue
                    if fields[2] == "cmd_name":
                        command = fields[3]
                    elif fields[2] == "exit":
                        elapsed = float(fields[3].split(":", 1)[1])
            ended = os.stat(path).st_mtime
        except (OSError, ValueError):
            continue
        if command is not None and elapsed is not None:
            known[name] = (command, ended - elapsed, elapsed)


def report(label, names, duration):
    by_command = collections.Counter(known[name][0] for name in names)
    wall = sum(known[name][2] for name in names)
    print(f"{label}: {len(names)} git ({len(names) / duration:.2f}/s), "
          f"summed git wall time {wall:.1f} s")
    print("  " + ", ".join(f"{command} {count}" for command, count in by_command.most_common()))


# The board learns of the project within a model refresh, then reads every
# checkout, plans and registers its watches, and reads again what they now
# cover. The load ends once every checkout has a status, the watches are in
# place and the daemon has started no Git command for 10 s.
started = time.time()
own, children = times()
read_every = registered = None
while True:
    time.sleep(1)
    if time.time() - started > 1800:
        sys.exit("the board did not finish its first read in 1800 s")
    collect()
    statuses = sum(entry[0] == "status" for entry in known.values())
    if read_every is None and statuses >= checkouts:
        read_every = time.time() - started
    if registered is None and watches():
        registered = time.time() - started
    latest = max((entry[1] + entry[2] for entry in known.values()), default=started)
    if read_every is not None and registered is not None and time.time() - latest > 10:
        break
planned = max((entry[1] for entry in known.values() if entry[0] in PLAN), default=started)
load = set(known)
now_own, now_children = times()
print(f"every checkout read after {read_every:.0f} s")
print(f"last planning command started after {planned - started:.0f} s")
print(f"watches registered after {registered:.0f} s")
report("load", load, time.time() - started)
print(f"load cpu s: daemon {(now_own - own) / ticks:.1f}, exited children {(now_children - children) / ticks:.1f}")
print(f"native watches {watches()}")

own, children = times()
time.sleep(seconds)
now_own, now_children = times()
collect()
steady = [name for name in known if name not in load]
statuses = sum(known[name][0] == "status" for name in steady)
print(f"seconds={seconds:g} git={len(steady)} status={statuses}")
report("steady", steady, seconds)
print(f"git status per second {statuses / seconds:.2f}")
print(f"git processes per second {len(steady) / seconds:.2f}")
print(f"exited children cpu % core {100 * (now_children - children) / ticks / seconds:.2f}")
print(f"daemon cpu % core {100 * (now_own - own) / ticks / seconds:.2f}")
print(f"native watches {watches()}")
EOF
