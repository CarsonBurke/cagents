#!/usr/bin/python3
"""Check main's newest commit through the fw16 gate whenever it moves, find
the first-parent commit at which each failing lane first fails when it fails
after passing, build the newest checked commit that compiles for native
evidence to start from, then run every lane's tests on it and record their
verdict, which a release of that commit requires.

With --require-tests SHA it records that commit's verdict, testing it first
if it has none, and exits 0 only when its tests pass."""
import argparse
import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import resource
import shutil
import socket
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parent))
import cargo_warnings

TITLE = "Main Rust build sentinel: compilation failure"
# Each lane's selection after `clippy --locked --no-default-features --all-targets`.
# `app` is the application package and the widgets and views it composes,
# absent from commits before each was split out; `browser` is that graph with
# the integrated browser. Its protocol-fixture feature adds only the Wayland
# registry test server, so one check covers every integrated-browser target.
# `editor` lints the kit as it ships: the application's tests enable the kit's
# test-support feature, which `app` and `browser` therefore lint it with.
LANES = {
    "cli": [],
    "host": ["--features", "host"],
    "ui": ["--features", "ui"],
    "app": ["-p", "cagents-ui", "-p", "cagents-ui-kit"],
    "browser": ["-p", "cagents-ui", "-p", "cagents-ui-kit", "--features", "cagents-ui/browser-protocol-fixture"],
    "dictate": ["-p", "cagents-dictate", "--features", "engine"],
    "editor": ["-p", "ceditor"],
}
APPLICATION_LANES = {"app", "browser"}
# Not a compile: the commit's own scripts/check-lane-isolation resolves every
# lane's dependency graph and fails when one pulls in another lane's, such as
# Ghostty into the UI. It counts as a lane, bisected like the others, but a
# commit that fails only it still compiled, so it is built and tested.
ISOLATION = "isolation"
ISOLATION_SCRIPT = "scripts/check-lane-isolation"
CHECKS = [*LANES, ISOLATION]
# Lanes whose package an older commit may not have, and the manifest that
# says it does.
LANE_MANIFESTS = {lane: "crates/cagents-ui/Cargo.toml" for lane in APPLICATION_LANES}
LANE_MANIFESTS["dictate"] = "crates/cagents-dictate/Cargo.toml"
LANE_MANIFESTS["editor"] = "crates/ceditor/Cargo.toml"
# Each test lane's selection after `test --locked --all-targets --no-fail-fast`,
# in the ordinary test profile. Together they run every test a release used to
# run itself: the shared library without features and with `host` and `ui`,
# the application without and with the integrated browser (the shared library
# then has its `full` identity and browser paths), the editor and the
# dictation helper. A missing package skips its lane, and a missing kit is
# left out of its lane, as for the checks.
TEST_LANES = {
    "cli": ["--no-default-features"],
    "host": ["--no-default-features", "--features", "host"],
    "ui": ["--no-default-features", "-p", "cagents", "-p", "cagents-ui", "-p", "cagents-ui-kit",
           "--features", "cagents/ui"],
    "browser": ["--no-default-features", "-p", "cagents", "-p", "cagents-ui", "-p", "cagents-ui-kit",
                "--features", "cagents-ui/browser-protocol-fixture"],
    "editor": ["-p", "ceditor"],
    "dictate": ["--no-default-features", "-p", "cagents-dictate", "--features", "engine"],
}
TEST_LANE_MANIFESTS = {"ui": "crates/cagents-ui/Cargo.toml", "browser": "crates/cagents-ui/Cargo.toml",
                       "editor": "crates/ceditor/Cargo.toml",
                       "dictate": "crates/cagents-dictate/Cargo.toml"}
TEST_TITLE = "Main test sentinel: test failure"
# Lanes whose UI fixtures still interfere with each other at higher
# parallelism (#2058); the others take a test thread per CPU.
TEST_THREADS = {"ui": "2", "browser": "2"}
# Cargo exits 101 when a test fails or the code does not compile. Any other
# status, such as the disk guard's refusal or a kill, says nothing about the
# commit, so it leaves no verdict and the lane is tested again.
CODE_FAILURE = 101
# A caller's test variables would change what the lanes test.
TEST_ENVIRONMENT_IGNORED = re.compile(r"CAGENTS_TEST_|RUST_TEST_|RUSTFLAGS$|RUSTDOCFLAGS$|CARGO_PROFILE_"
                                      r"|CARGO_BUILD_RUSTFLAGS$|CARGO_ENCODED_RUSTFLAGS$|CARGO_INCREMENTAL$")
# Room in the issue for each failing lane's failures, below GitHub's limit.
EXCERPT_CHARACTERS = 12000
# How many main commits keep their native-evidence executables, about 0.6 GiB each.
BUILDS_KEPT = 6
# Bundles releases of what compiled; see scripts/prebuild-release.
PREBUILD_SERVICE = "cagents-prebuild.service"
# native-evidence's task for these builds: its path must be short, for sockets.
EVIDENCE_TASK = Path.home() / ".local/state/cev-main-sentinel"


def run(*command, **kwargs):
    return subprocess.run(command, check=True, text=True, **kwargs)


def save(path, state):
    temporary = path.with_suffix(".new")
    temporary.write_text(json.dumps(state, indent=2) + "\n")
    temporary.replace(path)


def git(repository, *args):
    return run("git", "-C", str(repository), *args, stdout=subprocess.PIPE).stdout.strip()


def workspace_packages(checkout):
    """Names of the checked commit's workspace members, whose warnings fail
    a lane. None when the manifests cannot be read: Cargo then fails the
    lanes itself, and that failure is what is reported."""
    try:
        return cargo_warnings.workspace_packages(checkout)
    except cargo_warnings.WorkspaceUnreadable as error:
        print(f"main-build-sentinel: workspace members unreadable, warnings not counted: {error}", flush=True)
        return None


def present(arguments, packages):
    """A lane's arguments without the packages a commit from before they were
    split out does not have; all of them when its members are unknown."""
    if packages is None:
        return list(arguments)
    kept = []
    pairs = iter(arguments)
    for argument in pairs:
        if argument == "-p":
            package = next(pairs)
            if package in packages:
                kept += [argument, package]
        else:
            kept.append(argument)
    return kept


def check_lane(command, checkout, environment, log_path, warnings_path, packages):
    """Runs one lane's check, writing its diagnostics to the log as Cargo
    renders them, and the workspace's own warnings, once each, to their own
    file; returns the exit status and how many such warnings there were."""
    log_path.write_text("")
    warnings = cargo_warnings.Warnings(packages)
    with (log_path.open("a") as log,
          subprocess.Popen([*command, "--message-format=json"], cwd=checkout, env=environment,
                           stdout=subprocess.PIPE, stderr=log, text=True, errors="replace") as process):
        for line in process.stdout:
            _, text = warnings.read(line)
            if text is not None:
                log.write(text)
            log.flush()
        status = process.wait()
    warnings_path.write_text(warnings.rendered())
    return status, len(warnings.own)


def check_isolation(checkout, environment, log_path):
    """Runs the commit's lane-isolation check, which never fetches, after
    fetching this host's dependencies, which a commit checked only in this
    lane while bisecting may not have had built here; returns its status."""
    with log_path.open("w") as log:
        fetched = subprocess.run(["cargo", "fetch", "--locked", "--target", "host-tuple"], cwd=checkout,
                                 env=environment, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
        if fetched.returncode:
            return fetched.returncode
        log.flush()
        return subprocess.run([str(checkout / ISOLATION_SCRIPT)], cwd=checkout, env=environment,
                              stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT).returncode


def github(directory, state, *args):
    result = subprocess.run(["gh", *args, "--repo", state["github_repository"]], text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode:
        # Do not retry into a shared rate limit. Ask for its actual reset once.
        if "rate limit" in result.stderr.lower():
            limits = run("gh", "api", "rate_limit", stdout=subprocess.PIPE)
            resources = json.loads(limits.stdout)["resources"]
            resets = [entry["reset"] for entry in resources.values()
                      if entry.get("remaining") == 0]
            state["retry_after"] = max([time.time() + 120, *resets])
            save(directory / "state.json", state)
        raise RuntimeError(result.stderr.strip())
    return result.stdout.strip()


def failed_lanes(result):
    warnings = result.get("warnings", {})
    return [lane for lane, status in result["lanes"].items() if status or warnings.get(lane)]


def checkout_commit(repository, sha):
    """Checks out `sha` in the sentinel's worktree and returns its path."""
    checkout = repository / ".worktrees" / "main-build-sentinel"
    if checkout.exists():
        if git(checkout, "status", "--porcelain"):
            raise RuntimeError(f"sentinel checkout is dirty: {checkout}")
        git(checkout, "checkout", "--detach", sha)
    else:
        git(repository, "worktree", "add", "--detach", str(checkout), sha)
    return checkout


def check_commit(repository, directory, sha, lanes):
    """Checks out `sha` in the sentinel's worktree and checks each of `lanes`
    the commit has; returns their exit statuses and warning counts."""
    checkout = checkout_commit(repository, sha)
    (directory / "logs").mkdir(exist_ok=True)
    statuses = {}
    warnings = {}
    packages = workspace_packages(checkout)
    # No priority bypass, held lease, or local compilation override.
    environment = dict(os.environ, CAGENTS_BUILD_REMOTE="fw16")
    for lane in lanes:
        log = directory / "logs" / f"{sha}-{lane}.log"
        warnings_log = directory / "logs" / f"{sha}-{lane}-warnings.log"
        if lane == ISOLATION:
            # A commit from before the check has nothing to run.
            if not (checkout / ISOLATION_SCRIPT).exists():
                continue
            print(f"main-build-sentinel: {sha} {lane}", flush=True)
            statuses[lane], warnings[lane] = check_isolation(checkout, environment, log), 0
            warnings_log.write_text("")
            continue
        if lane in LANE_MANIFESTS and not (checkout / LANE_MANIFESTS[lane]).exists():
            continue
        command = [str(checkout / "scripts/cargo-gate"), "clippy", "--locked",
                   "--no-default-features", "--all-targets", *present(LANES[lane], packages)]
        print(f"main-build-sentinel: {sha} {lane}", flush=True)
        statuses[lane], warnings[lane] = check_lane(command, checkout, environment, log, warnings_log, packages)
    return statuses, warnings


def bisect(repository, directory, state):
    """For each lane the tip fails, narrows the first-parent commits between
    the last passing one and the tip down to the earliest at which that lane
    fails, checking only that lane, and names those commits on the issue."""
    search = state["bisect"]
    path = directory / "state.json"
    commits = search["commits"]
    # For each lane, commits[good] passes it and commits[bad] fails it; -1 is
    # the last passing commit. A commit's other lanes are not checked.
    for lane, bounds in search["lanes"].items():
        while bounds["bad"] - bounds["good"] > 1:
            middle = (bounds["good"] + bounds["bad"]) // 2
            statuses, warnings = check_commit(repository, directory, commits[middle], [lane])
            fails = failed_lanes({"lanes": statuses, "warnings": warnings})
            bounds["bad" if fails else "good"] = middle
            save(path, state)
    if state.get("issue"):
        found = {}
        for lane, bounds in search["lanes"].items():
            found.setdefault(commits[bounds["bad"]], []).append(lane)
        lines = [f"- `{sha}` ({git(repository, 'show', '-s', '--format=%s', sha)}): "
                 f"{', '.join(lanes)}" for sha, lanes in found.items()]
        # Persisted first, so a failed call retries the comment, not the checks.
        state["retry_after"] = time.time() + 120
        save(path, state)
        github(directory, state, "issue", "comment", str(state["issue"]), "--body",
               f"Bisected the {len(commits)} first-parent commits after `{search['after']}`, the "
               "last that passed. The earliest commit at which each failing lane fails:\n\n"
               + "\n".join(lines) + "\n\nA lane that broke, was fixed and broke again in this "
               "range, or failed for a reason outside the code, can point earlier than the break "
               "the tip shows; its log under `logs/` on fw16 says which.")
        state.pop("retry_after", None)
    state.pop("bisect")
    save(path, state)


def report(repository, directory, state):
    """Persist each successful report step; a failed API call never loses a result."""
    pending = state["pending"]

    def gh(*args):
        return github(directory, state, *args)

    warnings = pending.get("warnings", {})
    failed = failed_lanes(pending)
    if not failed:
        if state.get("failing"):
            gh("issue", "comment", str(state["issue"]), "--body",
               f"Recovered at `{pending['sha']}`: all-targets checks passed on fw16 in every lane, "
               "without warnings from the workspace's crates.")
        state["failing"] = False
        return
    if not state.get("issue"):
        matches = json.loads(gh("issue", "list", "--state", "all", "--search",
                                f'"{TITLE}" in:title', "--json", "number,title"))
        matches = [item for item in matches if item["title"] == TITLE]
        if matches:
            state["issue"] = matches[0]["number"]
            save(directory / "state.json", state)
    sha = pending["sha"]
    details = git(repository, "show", "-s", "--format=%H%n%P%n%s", sha)
    body = (f"Main fails its Rust build check at `{sha}` on fw16: a lane does not compile, "
            "the workspace's own crates print compiler or Clippy warnings, or a lane resolves "
            "another lane's dependency graph. Vendored dependencies' warnings do not count.\n\n"
            f"Last passing commit: `{state.get('last_good', 'none recorded')}`.\n\n"
            f"Commit, parents and subject:\n```text\n{details}\n```\n\n"
            "Checks use `scripts/cargo-gate clippy --locked --no-default-features --all-targets` "
            "in separate CLI, host, shared UI (`--features ui`), application "
            "(`-p cagents-ui`), integrated browser and dictation helper "
            "(`-p cagents-dictate --features engine`) lanes, as well as `-p ceditor`. The "
            "isolation lane is `scripts/check-lane-isolation`, which compiles nothing.\n\n")
    for lane, status in pending["lanes"].items():
        count = warnings.get(lane, 0)
        body += f"- {lane}: exit {status}" + (f", {count} warning{'s' * (count != 1)}" if count else "") + "\n"
    for lane in failed:
        log = directory / "logs" / f"{sha}-{lane}.log"
        # A lane that compiled failed on its warnings, which the vendored
        # dependencies' could crowd out of the log's tail.
        shown = log if pending["lanes"][lane] else directory / "logs" / f"{sha}-{lane}-warnings.log"
        tail = shown.read_text(errors="replace")[-5000:].replace("```", "'''")
        body += f"\n{lane} diagnostics (tail; complete log on fw16 at `{log}`):\n```text\n{tail}\n```\n"
    body_file = directory / "issue.md"
    body_file.write_text(body)
    if not state.get("issue"):
        url = gh("issue", "create", "--title", TITLE, "--body-file", str(body_file))
        state["issue"] = int(url.rsplit("/", 1)[1])
        save(directory / "state.json", state)
    else:
        gh("issue", "edit", str(state["issue"]), "--body-file", str(body_file))
        # Reopen is idempotent, including when the issue is already open.
        gh("issue", "reopen", str(state["issue"]))
    state["failing"] = True


def keep_main_build(repository, directory, state):
    """Builds the executables native evidence runs for the newest checked
    commit, if it compiled, into builds/SHA, as scripts/native-evidence would
    build them for its "before" side, which takes them from there."""
    sha = state.get("checked")
    # Warnings fail the check, not the build evidence starts from.
    if not sha or state.get("compiled") != sha or state.get("built") == sha:
        return
    builds = directory / "builds"
    builds.mkdir(exist_ok=True)
    (builds / ".lock").touch()
    checkout = repository / ".worktrees" / "main-build-sentinel"
    tool = checkout / "scripts/native-evidence"
    if not (builds / sha).is_dir() and tool.exists() and git(checkout, "rev-parse", "HEAD") == sha:
        # The commit's own tool, which says what its builds compile; one
        # older than that builds nothing here.
        listed = subprocess.run([str(tool), "__build-arguments"], cwd=checkout, text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if listed.returncode == 0 and listed.stdout.strip():
            print(f"main-build-sentinel: {sha} native-evidence build", flush=True)
            with (directory / "logs" / f"{sha}-evidence.log").open("w") as log:
                built = subprocess.run([str(tool), "--task", str(EVIDENCE_TASK), "build", "before", str(checkout)],
                                       cwd=checkout, stdout=log, stderr=subprocess.STDOUT).returncode
            staging = builds / f".{sha}.new"
            try:
                if built == 0:
                    shutil.rmtree(staging, ignore_errors=True)
                    staging.mkdir()
                    for line in listed.stdout.splitlines():
                        executable = line.rsplit(" ", 1)[-1]
                        (EVIDENCE_TASK / "target-before/dev-runtime" / executable).replace(staging / executable)
                    (staging / "arguments").write_text(listed.stdout)
                    staging.replace(builds / sha)
            except OSError as error:
                # Evidence then builds this commit itself; the checks are unaffected.
                print(f"main-build-sentinel: could not keep {sha}'s build: {error}", flush=True)
                shutil.rmtree(staging, ignore_errors=True)
    state["built"] = sha
    save(directory / "state.json", state)
    with (builds / ".lock").open("a") as lock:
        # native-evidence holds this shared while it copies from a build.
        fcntl.flock(lock, fcntl.LOCK_EX)
        kept = sorted((entry for entry in builds.iterdir() if entry.is_dir() and not entry.name.startswith(".")),
                      key=lambda entry: entry.stat().st_mtime, reverse=True)
        # And what a run stopped before it was done left behind.
        for old in [*kept[BUILDS_KEPT:], *builds.glob(".*.new")]:
            shutil.rmtree(old, ignore_errors=True)


def verdict_path(directory, sha):
    return directory / "verdicts" / f"{sha}.json"


def read_verdict(directory, sha):
    path = verdict_path(directory, sha)
    return json.loads(path.read_text()) if path.exists() else None


def test_command(lane, packages=None):
    return ["scripts/cargo-gate", "test", "--locked", "--all-targets", "--no-fail-fast",
            *present(TEST_LANES[lane], packages)]


def test_environment(lane):
    environment = {name: value for name, value in os.environ.items()
                   if not TEST_ENVIRONMENT_IGNORED.match(name)}
    # No priority bypass, held lease, or local compilation override.
    environment["CAGENTS_BUILD_REMOTE"] = "fw16"
    if lane in TEST_THREADS:
        environment["RUST_TEST_THREADS"] = TEST_THREADS[lane]
    return environment


def test_commit(repository, directory, sha):
    """Runs each test lane the commit has, in the sentinel's worktree, and
    returns the verdict: passed only when every lane's tests ran and passed.
    It is recorded unless a lane failed for a reason outside the code."""
    checkout = checkout_commit(repository, sha)
    (directory / "logs").mkdir(exist_ok=True)
    lanes = {}
    packages = workspace_packages(checkout)
    for lane in TEST_LANES:
        if lane in TEST_LANE_MANIFESTS and not (checkout / TEST_LANE_MANIFESTS[lane]).exists():
            continue
        print(f"main-build-sentinel: {sha} test {lane}", flush=True)
        started = time.monotonic()
        command = test_command(lane, packages)
        with (directory / "logs" / f"{sha}-test-{lane}.log").open("w") as log:
            status = subprocess.run([str(checkout / command[0]), *command[1:]], cwd=checkout,
                                    env=test_environment(lane), stdout=log,
                                    stderr=subprocess.STDOUT).returncode
        lanes[lane] = {"status": status, "seconds": round(time.monotonic() - started)}
    # A test that leaves files in the checkout must not stop later checks.
    changed = git(checkout, "status", "--porcelain", "--untracked-files=all")
    if changed:
        print(f"main-build-sentinel: {sha} tests changed the checkout; restoring it:\n{changed}", flush=True)
        git(checkout, "reset", "--quiet", "--hard")
        git(checkout, "clean", "--quiet", "-fd")
    verdict = {"sha": sha, "passed": all(entry["status"] == 0 for entry in lanes.values()),
               "lanes": lanes, "finished": time.time()}
    outside = [lane for lane, entry in lanes.items() if entry["status"] not in (0, CODE_FAILURE)]
    if outside:
        verdict["outside_code"] = outside
        print(f"main-build-sentinel: {sha} {', '.join(outside)} stopped outside the code; "
              "no verdict is kept", flush=True)
        return verdict
    verdict_path(directory, sha).parent.mkdir(exist_ok=True)
    save(verdict_path(directory, sha), verdict)
    return verdict


FAILURE_LINE = re.compile(r"^(test .* \.\.\. FAILED|error(\[E\d+\])?: |---- .* ----$|failures:$"
                          r"|test result: FAILED)")


def failure_excerpt(text, limit=EXCERPT_CHARACTERS):
    """The parts of a lane's output that say what failed: the failing tests,
    each one's captured output, compile errors and Cargo's closing summary;
    the passing tests between them are left out."""
    lines = text.splitlines()
    kept = []
    # A failing test's captured output runs to the next failure; an error,
    # such as a compiler's, to its first blank line.
    block = None
    for index, line in enumerate(lines):
        if FAILURE_LINE.match(line):
            block = "test" if line.startswith("---- ") else "error" if line.startswith("error") else None
        elif line.startswith("     Running ") or block == "error" and not line.strip():
            block = None
            continue
        elif not block:
            continue
        kept.append(line)
    excerpt = "\n".join(kept) or text
    if len(excerpt) > limit:
        half = limit // 2
        excerpt = excerpt[:half] + "\n[...]\n" + excerpt[-half:]
    return excerpt


def report_tests(directory, state, verdict):
    """Keeps one issue on main's failing tests, as `report` does for checks."""
    def gh(*args):
        return github(directory, state, *args)

    sha = verdict["sha"]
    if verdict["passed"]:
        if state.get("tests_failing"):
            gh("issue", "comment", str(state["test_issue"]), "--body",
               f"Recovered at `{sha}`: every test lane passed on fw16.")
        state["tests_failing"] = False
        return
    if not state.get("test_issue"):
        matches = json.loads(gh("issue", "list", "--state", "all", "--search",
                                f'"{TEST_TITLE}" in:title', "--json", "number,title"))
        matches = [item for item in matches if item["title"] == TEST_TITLE]
        if matches:
            state["test_issue"] = matches[0]["number"]
            save(directory / "state.json", state)
    body = (f"Main's tests fail at `{sha}` on fw16. No release can be cut from a commit "
            "whose tests have not passed.\n\n"
            f"Last passing commit: `{state.get('tests_last_good', 'none recorded')}`.\n\n"
            "Each lane runs in the ordinary test profile.\n\n")
    for lane, entry in verdict["lanes"].items():
        body += f"- {lane}: exit {entry['status']} in {entry['seconds']} s\n"
    for lane, entry in verdict["lanes"].items():
        if entry["status"]:
            log = directory / "logs" / f"{sha}-test-{lane}.log"
            excerpt = failure_excerpt(log.read_text(errors="replace")).replace("```", "'''")
            threads = f"RUST_TEST_THREADS={TEST_THREADS[lane]} " if lane in TEST_THREADS else ""
            body += (f"\n{lane}, as `{threads}{' '.join(test_command(lane))}` "
                     f"(complete log on fw16 at `{log}`):\n```text\n{excerpt}\n```\n")
    body_file = directory / "test-issue.md"
    body_file.write_text(body)
    if not state.get("test_issue"):
        url = gh("issue", "create", "--title", TEST_TITLE, "--body-file", str(body_file))
        state["test_issue"] = int(url.rsplit("/", 1)[1])
        save(directory / "state.json", state)
    else:
        gh("issue", "edit", str(state["test_issue"]), "--body-file", str(body_file))
        gh("issue", "reopen", str(state["test_issue"]))
    state["tests_failing"] = True


def test_main(repository, directory, state):
    """Tests the newest checked commit once, if it compiled. A verdict to
    report survives a failed notification and is retried without testing."""
    path = directory / "state.json"
    sha = state.get("checked")
    if not state.get("tests_pending"):
        if not sha or state.get("compiled") != sha:
            return
        # A verdict removed by hand has the commit tested again.
        if state.get("tested") == sha and read_verdict(directory, sha) is not None:
            return
        if time.time() < state.get("tests_retry_after", 0):
            return
        verdict = read_verdict(directory, sha) or test_commit(repository, directory, sha)
        if verdict.get("outside_code"):
            # Not the code's verdict; tested again after a pause.
            state["tests_retry_after"] = time.time() + 1800
            save(path, state)
            return
        state.pop("tests_retry_after", None)
        state["tests_pending"] = sha
        save(path, state)
    verdict = read_verdict(directory, state["tests_pending"])
    if verdict is None:
        # Removed by hand to have it tested again.
        state.pop("tests_pending")
        save(path, state)
        return
    state["retry_after"] = time.time() + 120
    save(path, state)
    report_tests(directory, state, verdict)
    state.pop("retry_after", None)
    if verdict["passed"]:
        state["tests_last_good"] = verdict["sha"]
    state["tested"] = state.pop("tests_pending")
    save(path, state)


def require_tests(repository, directory, revision):
    """Blocks until no tick runs, then returns the commit's verdict, testing
    it first if it has none, and fetching main first if it is not known here."""
    commit = f"{revision}^{{commit}}"
    # A verdict, once written, never changes: one already kept needs no lock,
    # and so does not wait for a tick testing another commit.
    known = subprocess.run(["git", "-C", str(repository), "rev-parse", "--quiet", "--verify", commit],
                           text=True, stdout=subprocess.PIPE)
    if not known.returncode:
        verdict = read_verdict(directory, known.stdout.strip())
        if verdict is not None:
            return verdict
    worktrees = repository / ".worktrees"
    worktrees.mkdir(exist_ok=True)
    directory.mkdir(parents=True, exist_ok=True)
    with ((worktrees / ".main-build-sentinel.lock").open("a") as checkout_lock,
          (directory / "lock").open("a") as lock):
        fcntl.flock(checkout_lock, fcntl.LOCK_EX)
        fcntl.flock(lock, fcntl.LOCK_EX)
        if subprocess.run(["git", "-C", str(repository), "rev-parse", "--quiet", "--verify", commit],
                          stdout=subprocess.DEVNULL).returncode:
            git(repository, "fetch", "--no-tags", "origin", "main")
        sha = git(repository, "rev-parse", "--verify", commit)
        verdict = read_verdict(directory, sha)
        if verdict is None:
            verdict = test_commit(repository, directory, sha)
            # Back where the watcher left its checkout, which it builds from.
            path = directory / "state.json"
            checked = json.loads(path.read_text()).get("checked") if path.exists() else None
            if checked:
                checkout_commit(repository, checked)
        return verdict


def start_prebuild():
    """Starts the release prebuild service, where it is installed, without
    waiting for it. It bundles the newest commit that compiled while that
    commit's tests run, only on CPU time and memory nothing else needs."""
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        subprocess.run(["systemctl", "--user", "start", "--no-block", PREBUILD_SERVICE], timeout=30,
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def tick(repository, directory, github_repository):
    # The checkout is shared even when callers select different state directories.
    worktrees = repository / ".worktrees"
    worktrees.mkdir(exist_ok=True)
    with (worktrees / ".main-build-sentinel.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        tick_locked(repository, directory, github_repository)
    # And on every tick, for a prebuild that waited for memory and gave up.
    start_prebuild()


def tick_locked(repository, directory, github_repository):
    directory.mkdir(parents=True, exist_ok=True)
    with (directory / "lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        path = directory / "state.json"
        state = json.loads(path.read_text()) if path.exists() else {}
        if state.get("github_repository", github_repository) != github_repository:
            raise RuntimeError("state belongs to another GitHub repository")
        state["github_repository"] = github_repository
        if time.time() < state.get("retry_after", 0):
            return
        # The timestamp also bounds restart/manual invocations and failed Git fetches.
        busy = state.get("pending") or state.get("bisect") or state.get("tests_pending")
        if time.time() - state.get("last_fetch", 0) < 120 and not busy:
            return
        if not busy:
            state["last_fetch"] = time.time()
            save(path, state)
            git(repository, "fetch", "--no-tags", "origin", "main")
            tip = git(repository, "rev-parse", "origin/main")
            previous = state.get("checked")
            if previous:
                # A force push needs a fresh baseline; never traverse unrelated history.
                ancestor = subprocess.run(["git", "-C", str(repository), "merge-base",
                                           "--is-ancestor", previous, tip]).returncode
                commits = (git(repository, "rev-list", "--first-parent", "--reverse",
                               f"{previous}..{tip}").splitlines() if ancestor == 0 else [tip])
            else:
                commits = [tip]
            # Only the tip is checked: a commit after it would have to fix
            # what one before it broke for main to pass with a break hidden.
            # The rest are kept to bisect if the tip fails.
            state["queue"] = commits[-1:]
            state["between"] = commits[:-1]
            save(path, state)
        while state.get("pending") or state.get("queue"):
            if not state.get("pending"):
                # A queue of every commit, as an earlier sentinel saved it.
                if len(state["queue"]) > 1:
                    state["between"] = [*state.get("between", []), *state["queue"][:-1]]
                    state["queue"] = state["queue"][-1:]
                    save(path, state)
                sha = state["queue"][0]
                statuses, warnings = check_commit(repository, directory, sha, CHECKS)
                state["pending"] = {"sha": sha, "lanes": statuses, "warnings": warnings}
                save(path, state)
            state["retry_after"] = time.time() + 120
            save(path, state)
            report(repository, directory, state)
            state.pop("retry_after", None)
            pending = state.pop("pending")
            failed = failed_lanes(pending)
            between = state.pop("between", [])
            # Only a break since a passing commit has a first failing commit.
            if failed and between and state.get("checked") and state.get("checked") == state.get("last_good"):
                state["bisect"] = {"after": state["checked"], "commits": [*between, pending["sha"]],
                                   "lanes": {lane: {"good": -1, "bad": len(between)} for lane in failed}}
            state["checked"] = pending["sha"]
            if not any(status for lane, status in pending["lanes"].items() if lane != ISOLATION):
                state["compiled"] = pending["sha"]
            # A passing commit passes every check, isolation too.
            if not failed:
                state["last_good"] = pending["sha"]
            state["queue"].pop(0)
            save(path, state)
        # Before bisecting moves the checkout off the commit it builds.
        keep_main_build(repository, directory, state)
        # After bisecting, which names the commit that broke a check sooner.
        if state.get("bisect"):
            bisect(repository, directory, state)
        # Before the tests, which take long enough to bundle the commit beside.
        start_prebuild()
        test_main(repository, directory, state)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", type=Path, required=True)
    parser.add_argument("--state", type=Path, default=Path.home() / ".local/state/cagents-main-sentinel")
    parser.add_argument("--github-repository", default="CarsonBurke/cagents")
    parser.add_argument("--require-tests", metavar="SHA",
                        help="print SHA's test verdict, testing it first if it has none; exit 0 "
                             "if its tests passed, 1 if they failed, 3 if a lane stopped outside "
                             "the code, as when the build host refused it, 4 on any other error")
    args = parser.parse_args()
    if socket.gethostname().split(".")[0] != "fw16":
        parser.error("run this watcher on fw16; builds still go through scripts/cargo-gate")
    # Some UI test runs need more files than a service's default limit of 1024.
    _, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    resource.setrlimit(resource.RLIMIT_NOFILE, (hard, hard))
    if args.require_tests:
        try:
            verdict = require_tests(args.repository.resolve(), args.state.resolve(), args.require_tests)
        except Exception as error:
            # Not a verdict: the caller must not read it as failing tests.
            print(f"main-build-sentinel: no verdict for {args.require_tests}: {error!r}", file=sys.stderr)
            sys.exit(4)
        print(json.dumps(verdict, indent=2))
        sys.exit(0 if verdict["passed"] else 3 if verdict.get("outside_code") else 1)
    tick(args.repository.resolve(), args.state.resolve(), args.github_repository)


if __name__ == "__main__":
    main()
