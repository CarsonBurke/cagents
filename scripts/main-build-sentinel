#!/usr/bin/python3
"""Check main's newest commit through the fw16 gate whenever it moves, find
the first-parent commit at which each failing lane first fails when it fails
after passing, then build the newest checked commit that compiles for native
evidence to start from."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parent))
import cargo_warnings

TITLE = "Main Rust build sentinel: compilation failure"
# Each lane's selection after `clippy --locked --no-default-features --all-targets`.
# `app` is the application package, absent from commits before it was split out;
# `browser` is that package's integrated-browser graph. Its protocol-fixture
# feature adds only the Wayland registry test server, so one check covers every
# integrated-browser target.
LANES = {
    "cli": [],
    "host": ["--features", "host"],
    "ui": ["--features", "ui"],
    "app": ["-p", "cagents-ui"],
    "browser": ["-p", "cagents-ui", "--features", "browser-protocol-fixture"],
    "dictate": ["-p", "cagents-dictate", "--features", "engine"],
}
APPLICATION_LANES = {"app", "browser"}
# Lanes whose package an older commit may not have, and the manifest that
# says it does.
LANE_MANIFESTS = {lane: "crates/cagents-ui/Cargo.toml" for lane in APPLICATION_LANES}
LANE_MANIFESTS["dictate"] = "crates/cagents-dictate/Cargo.toml"
# How many main commits keep their native-evidence executables, about 0.6 GiB each.
BUILDS_KEPT = 6
# native-evidence's task for these builds: its path must be short, for sockets.
EVIDENCE_TASK = Path.home() / ".local/state/cev-main-sentinel"


def run(*command, **kwargs):
    return subprocess.run(command, check=True, text=True, **kwargs)


def save(path, state):
    temporary = path.with_suffix(".new")
    temporary.write_text(json.dumps(state, indent=2) + "\n")
    temporary.replace(path)


def git(repository, *args):
    return run("git", "-C", str(repository), *args, stdout=subprocess.PIPE).stdout.strip()


def workspace_packages(checkout):
    """Names of the checked commit's workspace members, whose warnings fail
    a lane. None when the manifests cannot be read: Cargo then fails the
    lanes itself, and that failure is what is reported."""
    try:
        return cargo_warnings.workspace_packages(checkout)
    except cargo_warnings.WorkspaceUnreadable as error:
        print(f"main-build-sentinel: workspace members unreadable, warnings not counted: {error}", flush=True)
        return None


def check_lane(command, checkout, environment, log_path, warnings_path, packages):
    """Runs one lane's check, writing its diagnostics to the log as Cargo
    renders them, and the workspace's own warnings, once each, to their own
    file; returns the exit status and how many such warnings there were."""
    log_path.write_text("")
    warnings = cargo_warnings.Warnings(packages)
    with (log_path.open("a") as log,
          subprocess.Popen([*command, "--message-format=json"], cwd=checkout, env=environment,
                           stdout=subprocess.PIPE, stderr=log, text=True, errors="replace") as process):
        for line in process.stdout:
            _, text = warnings.read(line)
            if text is not None:
                log.write(text)
            log.flush()
        status = process.wait()
    warnings_path.write_text(warnings.rendered())
    return status, len(warnings.own)


def github(directory, state, *args):
    result = subprocess.run(["gh", *args, "--repo", state["github_repository"]], text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode:
        # Do not retry into a shared rate limit. Ask for its actual reset once.
        if "rate limit" in result.stderr.lower():
            limits = run("gh", "api", "rate_limit", stdout=subprocess.PIPE)
            resources = json.loads(limits.stdout)["resources"]
            resets = [entry["reset"] for entry in resources.values()
                      if entry.get("remaining") == 0]
            state["retry_after"] = max([time.time() + 120, *resets])
            save(directory / "state.json", state)
        raise RuntimeError(result.stderr.strip())
    return result.stdout.strip()


def failed_lanes(result):
    warnings = result.get("warnings", {})
    return [lane for lane, status in result["lanes"].items() if status or warnings.get(lane)]


def check_commit(repository, directory, sha, lanes):
    """Checks out `sha` in the sentinel's worktree and checks each of `lanes`
    the commit has; returns their exit statuses and warning counts."""
    checkout = repository / ".worktrees" / "main-build-sentinel"
    if checkout.exists():
        if git(checkout, "status", "--porcelain"):
            raise RuntimeError(f"sentinel checkout is dirty: {checkout}")
        git(checkout, "checkout", "--detach", sha)
    else:
        git(repository, "worktree", "add", "--detach", str(checkout), sha)
    (directory / "logs").mkdir(exist_ok=True)
    statuses = {}
    warnings = {}
    packages = workspace_packages(checkout)
    for lane in lanes:
        if lane in LANE_MANIFESTS and not (checkout / LANE_MANIFESTS[lane]).exists():
            continue
        command = [str(checkout / "scripts/cargo-gate"), "clippy", "--locked",
                   "--no-default-features", "--all-targets", *LANES[lane]]
        print(f"main-build-sentinel: {sha} {lane}", flush=True)
        # No priority bypass, held lease, or local compilation override.
        environment = dict(os.environ, CAGENTS_BUILD_REMOTE="fw16")
        statuses[lane], warnings[lane] = check_lane(
            command, checkout, environment, directory / "logs" / f"{sha}-{lane}.log",
            directory / "logs" / f"{sha}-{lane}-warnings.log", packages)
    return statuses, warnings


def bisect(repository, directory, state):
    """For each lane the tip fails, narrows the first-parent commits between
    the last passing one and the tip down to the earliest at which that lane
    fails, checking only that lane, and names those commits on the issue."""
    search = state["bisect"]
    path = directory / "state.json"
    commits = search["commits"]
    # For each lane, commits[good] passes it and commits[bad] fails it; -1 is
    # the last passing commit. A commit's other lanes are not checked.
    for lane, bounds in search["lanes"].items():
        while bounds["bad"] - bounds["good"] > 1:
            middle = (bounds["good"] + bounds["bad"]) // 2
            statuses, warnings = check_commit(repository, directory, commits[middle], [lane])
            fails = failed_lanes({"lanes": statuses, "warnings": warnings})
            bounds["bad" if fails else "good"] = middle
            save(path, state)
    if state.get("issue"):
        found = {}
        for lane, bounds in search["lanes"].items():
            found.setdefault(commits[bounds["bad"]], []).append(lane)
        lines = [f"- `{sha}` ({git(repository, 'show', '-s', '--format=%s', sha)}): "
                 f"{', '.join(lanes)}" for sha, lanes in found.items()]
        # Persisted first, so a failed call retries the comment, not the checks.
        state["retry_after"] = time.time() + 120
        save(path, state)
        github(directory, state, "issue", "comment", str(state["issue"]), "--body",
               f"Bisected the {len(commits)} first-parent commits after `{search['after']}`, the "
               "last that passed. The earliest commit at which each failing lane fails:\n\n"
               + "\n".join(lines) + "\n\nA lane that broke, was fixed and broke again in this "
               "range, or failed for a reason outside the code, can point earlier than the break "
               "the tip shows; its log under `logs/` on fw16 says which.")
        state.pop("retry_after", None)
    state.pop("bisect")
    save(path, state)


def report(repository, directory, state):
    """Persist each successful report step; a failed API call never loses a result."""
    pending = state["pending"]

    def gh(*args):
        return github(directory, state, *args)

    warnings = pending.get("warnings", {})
    failed = failed_lanes(pending)
    if not failed:
        if state.get("failing"):
            gh("issue", "comment", str(state["issue"]), "--body",
               f"Recovered at `{pending['sha']}`: all-targets checks passed on fw16 in every lane, "
               "without warnings from the workspace's crates.")
        state["failing"] = False
        return
    if not state.get("issue"):
        matches = json.loads(gh("issue", "list", "--state", "all", "--search",
                                f'"{TITLE}" in:title', "--json", "number,title"))
        matches = [item for item in matches if item["title"] == TITLE]
        if matches:
            state["issue"] = matches[0]["number"]
            save(directory / "state.json", state)
    sha = pending["sha"]
    details = git(repository, "show", "-s", "--format=%H%n%P%n%s", sha)
    body = (f"Main fails its Rust build check at `{sha}` on fw16: a lane does not compile, "
            "or the workspace's own crates print compiler or Clippy warnings. Vendored "
            "dependencies' warnings "
            "do not count.\n\n"
            f"Last passing commit: `{state.get('last_good', 'none recorded')}`.\n\n"
            f"Commit, parents and subject:\n```text\n{details}\n```\n\n"
            "Checks use `scripts/cargo-gate clippy --locked --no-default-features --all-targets` "
            "in separate CLI, host, shared UI (`--features ui`), application "
            "(`-p cagents-ui`), integrated browser and dictation helper "
            "(`-p cagents-dictate --features engine`) lanes.\n\n")
    for lane, status in pending["lanes"].items():
        count = warnings.get(lane, 0)
        body += f"- {lane}: exit {status}" + (f", {count} warning{'s' * (count != 1)}" if count else "") + "\n"
    for lane in failed:
        log = directory / "logs" / f"{sha}-{lane}.log"
        # A lane that compiled failed on its warnings, which the vendored
        # dependencies' could crowd out of the log's tail.
        shown = log if pending["lanes"][lane] else directory / "logs" / f"{sha}-{lane}-warnings.log"
        tail = shown.read_text(errors="replace")[-5000:].replace("```", "'''")
        body += f"\n{lane} diagnostics (tail; complete log on fw16 at `{log}`):\n```text\n{tail}\n```\n"
    body_file = directory / "issue.md"
    body_file.write_text(body)
    if not state.get("issue"):
        url = gh("issue", "create", "--title", TITLE, "--body-file", str(body_file))
        state["issue"] = int(url.rsplit("/", 1)[1])
        save(directory / "state.json", state)
    else:
        gh("issue", "edit", str(state["issue"]), "--body-file", str(body_file))
        # Reopen is idempotent, including when the issue is already open.
        gh("issue", "reopen", str(state["issue"]))
    state["failing"] = True


def keep_main_build(repository, directory, state):
    """Builds the executables native evidence runs for the newest checked
    commit, if it compiled, into builds/SHA, as scripts/native-evidence would
    build them for its "before" side, which takes them from there."""
    sha = state.get("checked")
    # Warnings fail the check, not the build evidence starts from.
    if not sha or state.get("compiled") != sha or state.get("built") == sha:
        return
    builds = directory / "builds"
    builds.mkdir(exist_ok=True)
    (builds / ".lock").touch()
    checkout = repository / ".worktrees" / "main-build-sentinel"
    tool = checkout / "scripts/native-evidence"
    if not (builds / sha).is_dir() and tool.exists() and git(checkout, "rev-parse", "HEAD") == sha:
        # The commit's own tool, which says what its builds compile; one
        # older than that builds nothing here.
        listed = subprocess.run([str(tool), "__build-arguments"], cwd=checkout, text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if listed.returncode == 0 and listed.stdout.strip():
            print(f"main-build-sentinel: {sha} native-evidence build", flush=True)
            with (directory / "logs" / f"{sha}-evidence.log").open("w") as log:
                built = subprocess.run([str(tool), "--task", str(EVIDENCE_TASK), "build", "before", str(checkout)],
                                       cwd=checkout, stdout=log, stderr=subprocess.STDOUT).returncode
            staging = builds / f".{sha}.new"
            try:
                if built == 0:
                    shutil.rmtree(staging, ignore_errors=True)
                    staging.mkdir()
                    for line in listed.stdout.splitlines():
                        executable = line.rsplit(" ", 1)[-1]
                        (EVIDENCE_TASK / "target-before/dev-runtime" / executable).replace(staging / executable)
                    (staging / "arguments").write_text(listed.stdout)
                    staging.replace(builds / sha)
            except OSError as error:
                # Evidence then builds this commit itself; the checks are unaffected.
                print(f"main-build-sentinel: could not keep {sha}'s build: {error}", flush=True)
                shutil.rmtree(staging, ignore_errors=True)
    state["built"] = sha
    save(directory / "state.json", state)
    with (builds / ".lock").open("a") as lock:
        # native-evidence holds this shared while it copies from a build.
        fcntl.flock(lock, fcntl.LOCK_EX)
        kept = sorted((entry for entry in builds.iterdir() if entry.is_dir() and not entry.name.startswith(".")),
                      key=lambda entry: entry.stat().st_mtime, reverse=True)
        # And what a run stopped before it was done left behind.
        for old in [*kept[BUILDS_KEPT:], *builds.glob(".*.new")]:
            shutil.rmtree(old, ignore_errors=True)


def tick(repository, directory, github_repository):
    # The checkout is shared even when callers select different state directories.
    worktrees = repository / ".worktrees"
    worktrees.mkdir(exist_ok=True)
    with (worktrees / ".main-build-sentinel.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        tick_locked(repository, directory, github_repository)


def tick_locked(repository, directory, github_repository):
    directory.mkdir(parents=True, exist_ok=True)
    with (directory / "lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        path = directory / "state.json"
        state = json.loads(path.read_text()) if path.exists() else {}
        if state.get("github_repository", github_repository) != github_repository:
            raise RuntimeError("state belongs to another GitHub repository")
        state["github_repository"] = github_repository
        if time.time() < state.get("retry_after", 0):
            return
        # The timestamp also bounds restart/manual invocations and failed Git fetches.
        busy = state.get("pending") or state.get("bisect")
        if time.time() - state.get("last_fetch", 0) < 120 and not busy:
            return
        if not busy:
            state["last_fetch"] = time.time()
            save(path, state)
            git(repository, "fetch", "--no-tags", "origin", "main")
            tip = git(repository, "rev-parse", "origin/main")
            previous = state.get("checked")
            if previous:
                # A force push needs a fresh baseline; never traverse unrelated history.
                ancestor = subprocess.run(["git", "-C", str(repository), "merge-base",
                                           "--is-ancestor", previous, tip]).returncode
                commits = (git(repository, "rev-list", "--first-parent", "--reverse",
                               f"{previous}..{tip}").splitlines() if ancestor == 0 else [tip])
            else:
                commits = [tip]
            # Only the tip is checked: a commit after it would have to fix
            # what one before it broke for main to pass with a break hidden.
            # The rest are kept to bisect if the tip fails.
            state["queue"] = commits[-1:]
            state["between"] = commits[:-1]
            save(path, state)
        while state.get("pending") or state.get("queue"):
            if not state.get("pending"):
                # A queue of every commit, as an earlier sentinel saved it.
                if len(state["queue"]) > 1:
                    state["between"] = [*state.get("between", []), *state["queue"][:-1]]
                    state["queue"] = state["queue"][-1:]
                    save(path, state)
                sha = state["queue"][0]
                statuses, warnings = check_commit(repository, directory, sha, LANES)
                state["pending"] = {"sha": sha, "lanes": statuses, "warnings": warnings}
                save(path, state)
            state["retry_after"] = time.time() + 120
            save(path, state)
            report(repository, directory, state)
            state.pop("retry_after", None)
            pending = state.pop("pending")
            failed = failed_lanes(pending)
            between = state.pop("between", [])
            # Only a break since a passing commit has a first failing commit.
            if failed and between and state.get("checked") and state.get("checked") == state.get("last_good"):
                state["bisect"] = {"after": state["checked"], "commits": [*between, pending["sha"]],
                                   "lanes": {lane: {"good": -1, "bad": len(between)} for lane in failed}}
            state["checked"] = pending["sha"]
            if not any(pending["lanes"].values()):
                state["compiled"] = pending["sha"]
                if not any(pending.get("warnings", {}).values()):
                    state["last_good"] = pending["sha"]
            state["queue"].pop(0)
            save(path, state)
        # Before bisecting moves the checkout off the commit it builds.
        keep_main_build(repository, directory, state)
        if state.get("bisect"):
            bisect(repository, directory, state)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repository", type=Path, required=True)
    parser.add_argument("--state", type=Path, default=Path.home() / ".local/state/cagents-main-sentinel")
    parser.add_argument("--github-repository", default="CarsonBurke/cagents")
    args = parser.parse_args()
    if socket.gethostname().split(".")[0] != "fw16":
        parser.error("run this watcher on fw16; builds still go through scripts/cargo-gate")
    tick(args.repository.resolve(), args.state.resolve(), args.github_repository)


if __name__ == "__main__":
    main()
