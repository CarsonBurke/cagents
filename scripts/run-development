#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"


browserless=false
debug=false
fresh_daemon=false
log_file=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --browserless) browserless=true ;;
        --debug) debug=true ;;
        --fresh-daemon) fresh_daemon=true ;;
        --log-file)
            if [ "$#" -lt 2 ]; then
                printf '%s\n' "--log-file requires a path" >&2
                exit 2
            fi
            shift
            log_file=$1
            ;;
        --help)
            cat <<'USAGE'
Usage: scripts/run-development [OPTIONS] [-- UI_ARGUMENTS...]

Options:
  --browserless    Build without Servo and open saved browser URLs externally
  --debug          Enable cagents debug logs and Rust backtraces
  --fresh-daemon   Stop the existing development daemon before launching
  --log-file PATH  Write UI tracing output to PATH
  --help           Show this help
USAGE
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            printf '%s\n' "unknown option: $1" >&2
            exit 2
            ;;
    esac
    shift
done

if [ "$debug" = true ]; then
    export RUST_BACKTRACE=${RUST_BACKTRACE:-1}
    export RUST_LOG=${RUST_LOG:-cagents=debug,cagentsd=debug,warn}
fi

stop_development_daemon() {
    runtime=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR must be set}/cagents-development
    socket=$runtime/cagentsd.sock
    lock=$runtime/cagentsd.lock
    if [ ! -e "$socket" ]; then
        return
    fi
    if [ ! -f "$lock" ] || [ -L "$lock" ]; then
        printf '%s\n' "development daemon lock is not a regular file: $lock" >&2
        exit 1
    fi
    if [ "$(stat -c %u "$lock")" != "$(id -u)" ]; then
        printf '%s\n' "development daemon lock is not owned by the current user: $lock" >&2
        exit 1
    fi

    metadata=$(cat "$lock")
    pid=$(printf '%s\n' "$metadata" | sed -n 's/^{"pid":\([0-9][0-9]*\),"proof":.*/\1/p')
    if [ -z "$pid" ] || [ "$pid" -le 1 ] || [ ! -d "/proc/$pid" ]; then
        printf '%s\n' "development daemon lock has invalid process metadata: $lock" >&2
        exit 1
    fi
    if [ "$(stat -c %u "/proc/$pid")" != "$(id -u)" ]; then
        printf '%s\n' "development daemon process is not owned by the current user: $pid" >&2
        exit 1
    fi

    owns_lock=false
    for descriptor in "/proc/$pid/fd/"*; do
        if [ "$descriptor" -ef "$lock" ]; then
            owns_lock=true
            break
        fi
    done
    if [ "$owns_lock" != true ]; then
        printf '%s\n' "development daemon process does not own its lock: $pid" >&2
        exit 1
    fi

    kill -TERM "$pid"
    remaining=100
    while [ -e "$socket" ]; do
        if [ "$remaining" -eq 0 ]; then
            printf '%s\n' "development daemon did not stop within 5 seconds" >&2
            exit 1
        fi
        remaining=$((remaining - 1))
        sleep 0.05
    done
}

if [ "$fresh_daemon" = true ]; then
    stop_development_daemon
fi

if [ "$browserless" = true ]; then
    cargo build --locked --profile dev-runtime --no-default-features --features development --bins
else
    cargo build --locked --profile dev-runtime --features development --bins
fi

run_ui() {
    if [ "$browserless" = true ]; then
        exec cargo run --quiet --locked --profile dev-runtime --no-default-features \
            --features development --bin cagents-ui -- "$@"
    fi
    exec cargo run --quiet --locked --profile dev-runtime --features development \
        --bin cagents-ui -- "$@"
}

if [ -n "$log_file" ]; then
    printf '%s\n' "writing UI diagnostics to $log_file"
    run_ui "$@" >"$log_file" 2>&1
fi
run_ui "$@"
