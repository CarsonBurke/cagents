#!/usr/bin/python3
"""Plan, verify and run the repository's script contract suites.

CI checks out a single revision, a pull request's merge result or a main
commit, and every job runs this script from that revision. The suite list and
the files it tests therefore always come from the same commit; there is no
older-head applicability case to tolerate.

  verify            refuse missing, symlinked or unlisted suites and bad shell
                    syntax; every problem is reported at once
  plan              print the CI matrix, one entry per job shard
  protocol-base     print the commit the protocol contract compares with
  run [--verbose] [JOB [SHARD]]
                    run one job's suites; SHARD (I/N) runs every Nth test of a
                    sharded job's single suite, so the shards cover it exactly.
                    Without JOB, run every job unsharded, one after another,
                    then the source job's suites. Each suite that passes gets
                    one line, and one that fails or is interrupted its whole
                    output; --verbose,
                    the default on GitHub Actions, prints every test and the
                    digest of every file a suite tests, as CI's log records
"""

import argparse
import hashlib
import json
import os
import re
import signal
import stat
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


@dataclass(frozen=True)
class Suite:
    name: str
    fixture: str
    sources: tuple[str, ...] = ()
    # (shell, path) pairs whose syntax is checked before anything executes.
    syntax: tuple[tuple[str, str], ...] = ()
    isolated: bool = True
    env: tuple[tuple[str, str], ...] = ()


@dataclass(frozen=True)
class Job:
    name: str
    suites: tuple[Suite, ...]
    shards: int = 1


# What the update rehearsal's suites load from scripts/, and the fixtures its
# private user runs in place of providers and GitHub.
REHEARSAL_SCRIPTS = ("scripts/rehearse-update", "scripts/native_slots.py",
