#!/usr/bin/python3
"""Run a lane's Cargo command through scripts/cargo-gate, holding the
workspace's crates to the rule main's build check applies: no warnings.

Usage: scripts/cargo-lane [--allow-warnings] SUBCOMMAND [CARGO ARGS...] [-- HARNESS ARGS...]

Cargo's messages are read as JSON, which the gate relays from the build host
unchanged, so nothing about what compiles where, or what is fresh, differs
from running the gate directly. Diagnostics print as Cargo renders them,
except that a warning from a vendored crate, outside the `[workspace]`
members, is counted and not shown, and a workspace crate's warning shows once
however many targets report it. Errors show from every crate. Cargo replays
a fresh unit's warnings, so a check that compiles nothing still reports them.

The command exits with Cargo's status; when Cargo succeeded but a workspace
crate warned, it ends with one line naming where, and exits 1. With
--allow-warnings, as the development runner and native-evidence build, it
names them the same way but keeps Cargo's status: those builds must still
run. A --message-format other than `human` or `short`, such as JSON, is
passed through untouched, with nothing filtered.

The workspace is the one Cargo uses from the current directory, so a
checkout other than this script's is judged by its own members.

Environment:
  CAGENTS_VENDORED_WARNINGS=1  Show the vendored crates' warnings too
"""
import os
from pathlib import Path
import signal
import subprocess
import sys

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import cargo_warnings

PROGRAM = "cargo-lane"
# How many warnings the closing line locates; each was shown in full above.
LOCATIONS_SHOWN = 10
# The signals the gate cancels its build on, as it did when the lane tasks
# ran it directly: mise sends TERM to a lane when a sibling lane fails.
FORWARDED = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)
# The human formats this reads as JSON in their place.
HUMAN = {"human", "short"}


def split_format(arguments):
    """The --message-format values the caller gave, None for one missing its
    value, and the arguments without them. Only Cargo's options count: those
    before a `--` that starts the harness's or program's arguments."""
    formats, rest = [], []
    words = iter(arguments)
    for word in words:
        if word == "--":
            rest += [word, *words]
            break
        if word == "--message-format":
            formats.append(next(words, None))
        elif word.startswith("--message-format="):
            formats.append(word.partition("=")[2])
        else:
            rest.append(word)
    return formats, rest


def plural(count, noun):
    return f"{count} {noun}{'s' * (count != 1)}"


def run(command, warnings, show_vendored):
    """Runs the gate, relaying its output; returns its exit status."""
    started = []

    def forward(number, _frame):
        # The gate cancels its build and exits; its output is still read.
        # One that has not started yet is not started.
        if not started:
            raise SystemExit(128 + number)
        if started[0].poll() is None:
            started[0].send_signal(number)

    for number in FORWARDED:
        signal.signal(number, forward)
    process = subprocess.Popen(command, stdout=subprocess.PIPE)
    started.append(process)
    # Cargo's standard error, with its progress and its own errors, passes
    # straight through; its standard output carries the messages, and any
    # line that is not one, such as a test's, goes out byte for byte.
    with process:
        for line in process.stdout:
            kind, text = warnings.read(line)
            if kind == cargo_warnings.OUTPUT:
                sys.stdout.buffer.write(text)
                sys.stdout.buffer.flush()
            elif kind in (cargo_warnings.DIAGNOSTIC, cargo_warnings.OWN) or (
                    kind == cargo_warnings.VENDORED and show_vendored):
                sys.stderr.write(text)
                sys.stderr.flush()
        status = process.wait()
    return 128 - status if status < 0 else status


def main(arguments):
    if arguments[:1] in (["-h"], ["--help"]):
        print(__doc__, end="")
        return 0
    allow_warnings = arguments[:1] == ["--allow-warnings"]
    if allow_warnings:
        arguments = arguments[1:]
    if not arguments or arguments[0].startswith("-"):
        print(__doc__, end="", file=sys.stderr)
        return 2
    gate = [str(HERE / "cargo-gate"), arguments[0]]
    formats, rest = split_format(arguments[1:])
    parts = [part.strip() for value in formats for part in (value or "").split(",")]
    if None in formats or not set(parts) <= HUMAN:
        # JSON the caller reads, or a format Cargo is to refuse.
        os.execv(gate[0], [*gate, *arguments[1:]])
    chosen = ["json"]
    if "short" in parts:
        chosen.append("json-diagnostic-short")
    if sys.stderr.isatty():
        chosen.append("json-diagnostic-rendered-ansi")
    # Cargo's own options follow the subcommand, ahead of any `--`.
    command = [*gate, "--message-format=" + ",".join(chosen), *rest]

    try:
        packages = cargo_warnings.workspace_packages(
            cargo_warnings.workspace_root(Path.cwd()) or HERE.parent)
    except cargo_warnings.WorkspaceUnreadable as error:
        print(f"{PROGRAM}: the workspace's members are unreadable, so every warning shows "
              f"and none fails the command: {error}", file=sys.stderr)
        packages = None
    warnings = cargo_warnings.Warnings(packages)
    show_vendored = os.environ.get("CAGENTS_VENDORED_WARNINGS") == "1"
    status = run(command, warnings, show_vendored)
    if warnings.vendored and not show_vendored:
        print(f"{PROGRAM}: {plural(len(warnings.vendored), 'warning')} from vendored crates not shown "
              "(CAGENTS_VENDORED_WARNINGS=1 shows them)", file=sys.stderr)
    if warnings.own:
        places = warnings.locations()
        where = ", ".join(places[:LOCATIONS_SHOWN]) + (
            f", and {len(places) - LOCATIONS_SHOWN} more" if len(places) > LOCATIONS_SHOWN else "")
        print(f"{PROGRAM}: {plural(len(warnings.own), 'warning')} from the workspace's crates"
              f"{f' ({where})' if where else ''}; main's build check fails on them", file=sys.stderr)
        if status == 0 and not allow_warnings:
            status = 1
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
