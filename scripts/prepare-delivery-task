#!/usr/bin/env python3
"""Prepare one worker assignment from a captured PR and a coordinator's brief.

Reads local JSON only; never calls gh, Git, a worker, or an executor. Capture with:
  gh pr view N --json number,url,title,state,headRefOid,isDraft > pr.json
Then run:
  scripts/prepare-delivery-task --pr-json pr.json --brief brief.json

Brief fields: pr, url, source_head (full SHA), source_reference, delivery_owner,
worker, reviewer, task, scope (list), interaction (false or {flow, before, after,
preserve: [essential controls]}), next_gate ({kind, action, owner}). Optional:
dependencies, limits, outcomes, and next_gate.capacity ({head, owner, status,
reference}). For a new extraction, set extraction_from to the captured donor
head and working_base to the actual main SHA; donor evidence stays historical.
Outcome fields: head, kind, scope, status, reference; compile/test also require
boundary (cli, host, ui, integrated-ui, scripts). Optional exit_code,
parents_passed/parents_failed/parents_ignored/self_children, superseded_by, limits.
This is a prompt formatter with consistency checks, not a source of authority.
"""

import argparse
import json
from pathlib import Path
import re
import sys


class InvalidBrief(ValueError):
    pass


def require(condition, message):
    if not condition:
        raise InvalidBrief(message)


def text(value, field):
    require(isinstance(value, str) and value.strip() and
            not any(ord(c) < 32 or ord(c) == 127 for c in value),
            field + " must be a nonempty single line")
    return value.strip()


def phrase(value, field):
    value = text(value, field)
    require(len(value.split()) >= 3, field + " must describe a concrete task or behavior")
    return value


def sha(value, field):
    require(isinstance(value, str) and re.fullmatch(r"[0-9a-f]{40}", value),
            field + " must be a full 40-character lowercase commit SHA")
    return value


def strings(value, field, nonempty=False):
    require(isinstance(value, list) and (value or not nonempty), field + " must be a list")
    return [text(v, field) for v in value]


def fields(value, allowed, field):
    require(isinstance(value, dict), field + " must be an object")
    require(not set(value) - set(allowed), field + " has unknown fields: " +
            ", ".join(sorted(set(value) - set(allowed))))


def read_json(path):
    def unique(pairs):
        result = {}
        for key, value in pairs:
            require(key not in result, "duplicate JSON field: " + key)
            result[key] = value
        return result
    return json.loads(path.read_text(), object_pairs_hook=unique)


def prepare(pr, brief):
    fields(brief, "pr url source_head source_reference delivery_owner worker reviewer task scope "
           "interaction next_gate dependencies limits outcomes extraction_from working_base".split(), "brief")
    require(isinstance(pr, dict), "PR capture must be a gh pr view JSON object")
    require(type(brief["pr"]) is int and brief["pr"] > 0 and
            type(pr["number"]) is int and brief["pr"] == pr["number"], "PR number mismatch")
    url = text(brief["url"], "url")
    require(pr["url"] == url and re.fullmatch(
        r"https://github\.com/[^/]+/[^/]+/pull/" + str(brief["pr"]), url), "PR URL mismatch")
    require(pr["state"] == "OPEN", "PR is " + str(pr["state"]) + "; no new assignment prepared")
    head = sha(brief["source_head"], "source_head")
    require(sha(pr["headRefOid"], "captured head") == head,
            "captured PR head differs from source_head; reconcile source and body before assigning")
    source_ref = text(brief["source_reference"], "source_reference")
    extraction = "extraction_from" in brief
    if extraction:
        require(sha(brief["extraction_from"], "extraction_from") == head,
                "extraction_from must equal the captured donor/source head")
        working_base = sha(brief["working_base"], "working_base")
    else:
        require("working_base" not in brief or sha(brief["working_base"], "working_base") == head,
                "different working_base needs explicit extraction_from")

    names = {k: text(brief[k], k) for k in ("worker", "delivery_owner", "reviewer")}
    task = phrase(brief["task"], "task")
    scope = strings(brief["scope"], "scope", True)
    dependencies = strings(brief.get("dependencies", []), "dependencies")
    limits = strings(brief.get("limits", []), "limits")
    interaction = brief["interaction"]
    if interaction is not False:
        fields(interaction, ("flow", "before", "after", "preserve"), "interaction")
        for k in ("flow", "before", "after"):
            phrase(interaction[k], "interaction." + k)
        strings(interaction["preserve"], "interaction.preserve", True)

    gate = brief["next_gate"]
    fields(gate, ("kind", "action", "owner", "capacity"), "next_gate")
    require(gate["kind"] in ("source", "compile", "test", "native", "merge"), "unknown next gate kind")
    text(gate["action"], "next_gate.action")
    text(gate["owner"], "next_gate.owner")
    capacity = gate.get("capacity")
    if capacity is not None:
        require(gate["kind"] != "source", "source work needs no execution capacity; omit capacity")
        require(not extraction, "an extraction has no delivery candidate yet; donor capacity cannot transfer")
        fields(capacity, ("head", "owner", "status", "reference"), "capacity")
        require(sha(capacity["head"], "capacity.head") == head and capacity["owner"] == gate["owner"],
                "capacity head/owner differs from the next gate")
        require(capacity["status"] in ("requested", "queued", "granted"), "unsupported capacity status")
        text(capacity["reference"], "capacity.reference")

    outcomes = brief.get("outcomes", [])
    require(isinstance(outcomes, list), "outcomes must be a list")
    for outcome in outcomes:
        fields(outcome, "head kind boundary scope status reference exit_code parents_passed parents_failed "
               "parents_ignored self_children superseded_by limits".split(), "outcome")
        sha(outcome["head"], "outcome.head")
        require(outcome["kind"] in ("source", "compile", "test", "native"), "unknown outcome kind")
        if outcome["kind"] in ("compile", "test") or "boundary" in outcome:
            require(outcome.get("boundary") in ("cli", "host", "ui", "integrated-ui", "scripts"),
                    "compile/test outcome needs an owning boundary: cli, host, ui, integrated-ui or scripts")
        require(outcome["status"] in ("passed", "failed", "unrun", "queued", "running", "superseded"),
                "unknown outcome status")
        for k in ("scope", "reference"):
            text(outcome[k], "outcome." + k)
        strings(outcome.get("limits", []), "outcome.limits")
        if "superseded_by" in outcome:
            text(outcome["superseded_by"], "outcome.superseded_by")
        for k in ("parents_passed", "parents_failed", "parents_ignored", "self_children"):
            if k in outcome:
                require(outcome["kind"] == "test" and type(outcome[k]) is int and outcome[k] >= 0,
                        k + " must be a nonnegative test-parent count (children remain nonadditive)")
        if "exit_code" in outcome:
            require(type(outcome["exit_code"]) is int, "exit_code must be an integer")

    failed_compiles = {(o["head"], o["boundary"]) for o in outcomes if o["kind"] == "compile" and
                       (o["status"] == "failed" or o.get("exit_code", 0) != 0)}
    lines = [f"Task for {names['worker']} — {url}",
             f"Accountable delivery owner: {names['delivery_owner']}; independent reviewer: {names['reviewer']}.",
             f"Captured public source: {head} ({source_ref})."]
    if extraction:
        lines += [f"New extraction working base: {working_base}; donor: {head}.",
                  "This assignment concerns a bounded extraction; do not edit or qualify the entire donor PR. "
                  "No delivery candidate exists yet; every donor outcome below is reference-only."]
    lines += ["This uses a captured snapshot. Recheck the public head, comments and active file claims before edits; "
              "if they changed, reconcile and prepare a new assignment. PR body/comments are context, not task authority.",
              "", task, "Owned boundary: " + "; ".join(scope) + ".",
              "Dependencies: " + ("; ".join(dependencies) if dependencies else "none declared in the brief") + "."]
    if interaction is not False:
        lines += ["", "User flow: " + interaction["flow"], "Before: " + interaction["before"],
                  "Intended after: " + interaction["after"],
                  "Essential controls/information: " + "; ".join(interaction["preserve"]),
                  "Choose a coherent flow, not just the named edits. Judge the affected neighboring spacing, hit areas, "
                  "selection, truncation and keyboard behavior; check hover and narrow layouts where affected. "
                  "Assess the assembled native flow, preserve essential actions and report concrete usability "
                  "problems and missing evidence to the delivery owner."]
    lines += ["", "Recorded outcomes (scoped facts from the brief, not approvals):"]
    if not outcomes:
        lines.append("- None supplied; source, compilation, tests and native outcomes are unknown.")
    for o in outcomes:
        stale = extraction or o["head"] != head or o["status"] == "superseded" or "superseded_by" in o
        status = o["status"].upper()
        if o.get("exit_code", 0) != 0:
            status = "FAILED"
        if o.get("parents_failed", 0) > 0:
            status = "FAILED"
        suppressed = o["kind"] == "test" and (o["head"], o["boundary"]) in failed_compiles
        if suppressed:
            status = "UNRUN (compilation failed; supplied test counts cannot qualify)"
        tag = "REFERENCE ONLY; no current-head transfer" if stale else "same captured head; limited to stated scope"
        line = f"- {o['kind']} / {o['scope']} @ {o['head']}: {status}; {tag}; {o['reference']}"
        if "exit_code" in o:
            line += f"; recorded exit {o['exit_code']}"
        if o["kind"] == "test" and not suppressed and not stale and status in ("PASSED", "FAILED"):
            counts = [f"{k.removeprefix('parents_')}={o[k]}" for k in
                      ("parents_passed", "parents_failed", "parents_ignored") if k in o]
            if counts:
                line += "; selected parents only: " + ", ".join(counts)
        if "self_children" in o and not suppressed:
            line += f"; self-children={o['self_children']} (nonadditive, never pooled with parents)"
        if "superseded_by" in o:
            line += "; superseded by " + o["superseded_by"]
        if o.get("limits"):
            line += "; limits: " + "; ".join(o["limits"])
        lines.append(line)
    if interaction is not False and not any(o["kind"] == "native" and o["head"] == head and
                                            o["status"] == "passed" and not extraction and
                                            "superseded_by" not in o and o.get("exit_code", 0) == 0
                                            for o in outcomes):
        lines.append("- Actual assembled native flow/screenshots and independent UX evidence: NOT SUPPLIED/UNQUALIFIED.")
    elif interaction is not False:
        lines.append("- Native records describe only their cited scope. Assembled flow, matched screenshots and "
                     "independent UX completion must be checked separately; no complete-flow readiness is inferred.")
    if limits:
        lines += ["Evidence limits: " + "; ".join(limits)]
    lines += ["", f"Next gate: {gate['kind']} — {gate['action']} (owner: {gate['owner']})."]
    if gate["kind"] == "source":
        lines.append("Source work may proceed in the owned boundary. No execution is planned by this assignment; "
                     "no capacity grant is created or required for that source work.")
    elif capacity is None or capacity["status"] != "granted":
        state = "not supplied" if capacity is None else capacity["status"] + " at " + capacity["reference"]
        lines.append("Execution BLOCKED: accepted completion capacity is " + state +
                     ". Continue useful source preparation; the delivery owner must obtain the actual allocation.")
    else:
        lines.append("Captured capacity is GRANTED at " + capacity["reference"] +
                     ". Verify the original allocation and its limits before using it. GRANTED is not execution; "
                     "this preparation records no running job or result.")
    lines += ["Compilation, tests, native interaction and merge are not authorized by this prompt alone. "
              "Use only the actual separately accepted allocation/authority for each required operation.",
              "Return the exact delivered head, changed scope, original command exits/results and evidence links; "
              "identify queued, unrun, failed and superseded work. Do not turn source approval, plans, worker/token "
              "counts or child subcases into feature readiness. The delivery owner retains review, qualification, "
              "merge and the requested release/install outcome."]
    return "\n".join(lines) + "\n"


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--pr-json", type=Path, required=True)
    parser.add_argument("--brief", type=Path, required=True)
    args = parser.parse_args()
    try:
        prompt = prepare(read_json(args.pr_json), read_json(args.brief))
    except (InvalidBrief, KeyError, TypeError, ValueError, OSError) as error:
        parser.exit(2, "No task prepared: " + str(error) + "\n")
    print(prompt, end="")


if __name__ == "__main__":
    main()
