#!/usr/bin/python3 -I
"""Runs builds on the build host.

Each build waits for its share of the memory set aside for builds, or for an
extra share while the host's memory allows, then runs
in a systemd scope in background-cagents.slice. That slice sits in the user
manager's background.slice, whose CPU weight is below interactive work and
tests, and its memory is capped as a whole, so the kernel throttles builds
before they push everything else into swap. Every build draws from one pool of
GNU make jobserver tokens, which bounds how many compiler jobs run on the host
at once: a lone build uses every CPU, and several share them, without waiting
for each other to start. Tests run after their build has
given its share back, in app-cagents-test.slice under memory-capped.

Without a systemd user manager, or with CAGENTS_BUILD_SCOPE=0, builds still
wait for their shares but run in place, each with its own Cargo jobs. A build
that another build-host started runs in place too, in that build's scope and
with its jobserver, unless something between closed that jobserver's
descriptors, when it joins the jobserver for itself.

A build that would wait for its shares first asks Cargo whether there is
anything to compile, in a probe: the build, one job at a time, in the build
slice, under a compiler wrapper that ends it at its first compile. At most
four probes run at once, each ended as well if what it runs, such as a build
script rerunning without a compile, outgrows 1 GiB. A probe that finds
everything fresh, or fails, is the build: its output is shown and no shares
are taken. Otherwise the build waits for its shares as any other.
"""
import array
import contextlib
import fcntl
import os
import re
import select
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import termios
import threading
import time

PROGRAM = "cargo-gate"
USAGE = """usage: build-host cargo [OPTIONS] -- CARGO SUBCOMMAND [ARGUMENT...]
       build-host build [OPTIONS] -- COMMAND [ARGUMENT...]
       build-host count

`cargo` runs a Cargo command: its build holds the shares, and for `test`,
`bench` and `run` the tests or program then run without them, tests in
app-cagents-test.slice under memory-capped. `build` holds the shares for all of
COMMAND, such as a script of builds. `count` prints how many shares the host
has, the extra ones it takes while memory allows included.

Options:
  --shares N         Memory shares the build needs (default 1); 0 within
                     the shares of a build that started it
  --deadline NS      Give up waiting for shares at this CLOCK_MONOTONIC
                     time, in nanoseconds, exiting 124
  --wait-seconds S   The same, S seconds from now
  --runner CONFIG    For `cargo`, Cargo's --config setting of the runner that
                     the tests or program of `run`, `test` or `bench` start
                     under
  --remove PATH      Remove the directory PATH when this ends, such as the
                     `cargo` shim of the gate's `exec`

Environment:
  CAGENTS_BUILD_LOCK   First share's lock file; the others add .1, .2, ...
                       (default /var/tmp/cagents-cargo.lock)
  CAGENTS_BUILD_SLOTS  Shares on this host (default: three quarters of its
                       memory, in shares of 4 GiB, and at least 2)
  CAGENTS_BUILD_EXTRA_SHARES
                       Shares beyond those, taken only while MemAvailable,
                       less 8 GiB, and the build slice's room hold the
                       build's shares and the extra shares others hold, and
                       memory pressure is low (default 2, or 0 when
                       CAGENTS_BUILD_SLOTS is set)
  CAGENTS_BUILD_PROC   Where meminfo and pressure/memory are read, for tests
                       (default /proc)
  CAGENTS_BUILD_SCOPE=0
                       Run builds in place, without a scope or the jobserver
  CAGENTS_BUILD_JOBSERVER
                       The jobserver's directory, for tests
                       (default /run/user/UID/cagents-jobserver)
  CAGENTS_BUILD_IDLE=1 Run the build in the background of every other: its
                       scope has CPU time only when nothing else wants it,
                       the lowest IO weight, and Cargo jobs of its own
                       rather than the shared jobserver's
"""
HERE = os.path.dirname(os.path.realpath(__file__))
SHARE = 4 * 2**30
# Shares beyond the host's count of them, taken only while there is memory
# for the build: builds' peaks rarely coincide, and with every share held,
# builds' anonymous memory on fw16 came to about a third of their shares' on
# average and at most 57%. A build takes extra shares only
# when they complete what it needs, and only if both the host's MemAvailable,
# less a floor, and what the build slice's MemoryHigh leaves above its builds'
# anonymous memory hold the build's share memory and that of the extra shares
# others hold, which may not be in use yet; memory PSI's "some" avg10 must be
# at most EXTRA_PRESSURE percent too. Otherwise the build waits in line as for
# any share. MemoryHigh, which the extra shares overcommit, throttles builds
# whose peaks coincide after all.
EXTRA_SHARES = 2
EXTRA_FLOOR = 8 * 2**30
EXTRA_PRESSURE = 1.0
# Builds go in systemd's background.slice, whose CPUWeight of 30 is below the
# 100 of app.slice, where agent sessions, the desktop's applications and tests
# run.
BUILD_SLICE = "background-cagents.slice"
TEST_SLICE = "app-cagents-test.slice"
# Builds' outputs fill the page cache, which counts toward the build slice's
# MemoryHigh. Reclaim at that cap takes anonymous memory as well as cache: on
# fw16, with 12.5 to 17 GiB still available, builds at about 25 GiB of
# anonymous memory and 7 GiB of cache pushed swap up by as much as 10 GiB,
# past zram onto disk. So while builds
# run in scopes, one build-host at a time asks the kernel, once a second, to
# drop cache alone (memory.reclaim with swappiness=0, Linux 6.13 on) whenever
# the slice comes within RECLAIM_HEADROOM of its cap, down to RECLAIM_SLACK
# further below it: only cache the kernel counts inactive, and only when that
# is enough, so builds near the cap on their own keep the cache they use.
RECLAIM_HEADROOM = 2 * 2**30
RECLAIM_SLACK = 2**30
RECLAIM_TICK = 1.0
# How often build-host restocks its build's tokens from the pool, and how
# often it counts the builds sharing it.
TOKEN_TICK = 0.02
SWEEP_SECONDS = 0.25
# Where a build's jobserver descriptors start.
HIGH_DESCRIPTOR = 200
# Cargo's short names for what this splits.
ALIASES = {"t": "test", "r": "run"}
# Marks a command run by a build that holds shares, for the gates it starts.
HELD_MARK = "CAGENTS_BUILD_SLOT_HELD"
SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)
# The memory a probe may use, and so how many run at once: no more than one
# share between them. Cargo alone needs about 180 MiB to find this workspace
# fresh.
PROBE_MEMORY = 2**30
PROBE_TICK = 0.1
# How long a probe may hold its slot, its output held back, before the build
# queues instead: Cargo finds this workspace fresh in a few seconds.
PROBE_SECONDS = 60
# What only builds, and so can be probed. `doc` runs rustdoc, which no
# compiler wrapper sees.
PROBED = ("build", "b", "check", "c", "clippy")
# The compiler wrapper that ends a probe at its first compile.
PROBE_WRAPPER = os.path.join(HERE, "cargo-gate-rustc-guard")
RETRY_WRAPPER = os.path.join(HERE, "cargo-incremental-retry.py")


def say(message):
    print(f"{PROGRAM}: {message}", file=sys.stderr, flush=True)


def memory_total():
    with open("/proc/meminfo") as file:
        for line in file:
            if line.startswith("MemTotal:"):
                return int(line.split()[1]) * 1024
    raise OSError("cannot read MemTotal from /proc/meminfo")


def budget():
    """The memory set aside for builds: three quarters of the host's."""
    return memory_total() * 3 // 4


def share_count():
    configured = os.environ.get("CAGENTS_BUILD_SLOTS")
    if configured:
        if not configured.isdecimal() or int(configured) <= 0:
            say("CAGENTS_BUILD_SLOTS must be a positive integer")
            raise SystemExit(2)
        return int(configured)
    return max(2, budget() // SHARE)


def extra_share_count():
    """Shares beyond share_count() taken only while memory allows: none where
    the share count is configured, as for a lock that is a mutex."""
    configured = os.environ.get("CAGENTS_BUILD_EXTRA_SHARES")
    if configured:
        if not configured.isdecimal():
            say("CAGENTS_BUILD_EXTRA_SHARES must be a whole number")
            raise SystemExit(2)
        return int(configured)
    return 0 if os.environ.get("CAGENTS_BUILD_SLOTS") else EXTRA_SHARES


def build_slice_memory():
    """The memory.stat of the build slice that builds here run in, or None
    where they run in place."""
    if os.environ.get("CAGENTS_BUILD_SCOPE") == "0":
        return None
    uid = os.getuid()
    return (f"/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service/"
            f"background.slice/{BUILD_SLICE}/memory.stat")


def slice_directory():
    """The build slice's cgroup directory, or None where builds run in place."""
    memory = build_slice_memory()
    return memory and os.path.dirname(memory)


def cache_to_drop(current, inactive, high):
    """How much of the build slice's `inactive` page cache, of its `current`
    memory, to reclaim under a MemoryHigh of `high` bytes (None for none):
    none while the slice is not near its cap, nor when dropping all of that
    cache would not take it to the target, where only builds' own memory
    could."""
    target = high - RECLAIM_HEADROOM - RECLAIM_SLACK if high is not None else None
    if target is None or current <= high - RECLAIM_HEADROOM or current - inactive > target:
        return 0
    return current - target


class CacheTrimmer:
    """Keeps the build slice's page cache from making the kernel swap builds
    out at its cap, while this build runs: one build-host at a time, the
    one holding `lock`, drops cache that would take the slice near its cap."""

    def __init__(self, directory, lock):
        self.directory, self.lock = directory, lock
        self.stopped = threading.Event()
        self.leading = None
        self.thread = threading.Thread(target=self.watch, daemon=True)
        # Signals go to the main thread, as for the jobserver's.
        masked = signal.pthread_sigmask(signal.SIG_BLOCK, SIGNALS)
        try:
            self.thread.start()
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, masked)

    def lead(self):
        """Whether this build-host is the one that trims, taking that on if
        no other is."""
        if self.leading is None:
            try:
                file = open(self.lock, "a")
            except OSError:
                return False
            try:
                fcntl.flock(file, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                file.close()
                return False
            self.leading = file
        return True

    def read(self, name):
        with open(os.path.join(self.directory, name)) as file:
            return file.read().strip()

    def trim(self):
        """Drops what cache_to_drop says; False once this kernel or slice
        cannot drop cache alone, or does not say what it holds."""
        try:
            high = self.read("memory.high")
            # Cache the kernel can drop and that builds have not used of late;
            # tmpfs, which only swap could free, is not in it.
            cache = next(int(line.split()[1]) for line in self.read("memory.stat").splitlines()
                         if line.startswith("inactive_file "))
            amount = cache_to_drop(int(self.read("memory.current")), cache,
                                   None if high == "max" else int(high))
        except FileNotFoundError:
            return True  # The slice comes and goes with its builds.
        except (OSError, ValueError, StopIteration, IndexError):
            return False
        if amount:
            try:
                with open(os.path.join(self.directory, "memory.reclaim"), "w") as file:
                    file.write(f"{amount} swappiness=0")
            except BlockingIOError:
                pass  # Less cache was left to drop than asked for.
            except FileNotFoundError:
                return True
            except OSError:
                return False  # EINVAL: a kernel whose reclaim takes no swappiness.
        return True

    def watch(self):
        while not self.stopped.wait(RECLAIM_TICK):
            if self.lead() and not self.trim():
                return

    def close(self):
        self.stopped.set()
        # A reclaim under way finishes on its own.
        self.thread.join(RECLAIM_TICK)
        if self.leading:
            self.leading.close()


def memory_allows(reserved, slice_memory):
    """Whether the host has `reserved` bytes available above EXTRA_FLOOR, the
    build slice's cap leaves them above its anonymous memory (where
    `slice_memory` names its memory.stat), and the host is not stalling on
    memory; not when any of these cannot be read. A slice that does not exist
    yet, under a user manager that does, holds nothing."""
    proc = os.environ.get("CAGENTS_BUILD_PROC") or "/proc"
    try:
        with open(os.path.join(proc, "meminfo")) as file:
            available = next(int(line.split()[1]) * 1024 for line in file
                             if line.startswith("MemAvailable:"))
        with open(os.path.join(proc, "pressure/memory")) as file:
            some = next(line.split() for line in file if line.startswith("some "))
        pressure = float(next(field for field in some if field.startswith("avg10="))[6:])
        anonymous = 0
        if slice_memory is not None:
            try:
                with open(slice_memory) as file:
                    anonymous = next(int(line.split()[1]) for line in file if line.startswith("anon "))
            except FileNotFoundError:
                # Not started yet, under a user manager whose cgroup is where
                # it is looked for; elsewhere the slice is not known.
                manager = os.path.dirname(os.path.dirname(os.path.dirname(slice_memory)))
                if not os.path.isdir(manager):
                    return False
    except (OSError, StopIteration, ValueError, IndexError):
        return False
    return (available >= reserved + EXTRA_FLOOR and anonymous + reserved <= budget()
            and pressure <= EXTRA_PRESSURE)


def share_paths(lock, count):
    return [lock] + [f"{lock}.{index}" for index in range(1, count)]


class Expired(Exception):
    pass


class Busy(Exception):
    """The shares were not free at once."""


def flock_until(file, deadline):
    """Takes the lock on `file`, blocking in the kernel's queue of waiters,
    which keeps their order, until the CLOCK_MONOTONIC `deadline`."""
    if deadline is None:
        fcntl.flock(file, fcntl.LOCK_EX)
        return
    def expire(_number, _frame):
        raise Expired
    previous = signal.signal(signal.SIGALRM, expire)
    try:
        left = (deadline - time.monotonic_ns()) / 1e9
        if left <= 0:
            raise Expired
        signal.setitimer(signal.ITIMER_REAL, left)
        fcntl.flock(file, fcntl.LOCK_EX)
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


def lock_path():
    return os.environ.get("CAGENTS_BUILD_LOCK") or "/var/tmp/cagents-cargo.lock"


@contextlib.contextmanager
def shares(needed, deadline, queue_up=True):
    """Holds `needed` of the host's shares until the block ends. Waiters line
    up on a queue lock, and the one at its head takes shares as they free, so
    a build needing two is not passed over by builds needing one. A command
    run under `flock /var/tmp/cagents-cargo.lock` holds the first. Once the
    host's shares are taken, it may take extra ones while memory allows.
    Unless it may `queue_up`, this takes them only if they are free at once,
    and raises Busy otherwise."""
    lock = lock_path()
    total = share_count()
    needed = max(1, min(needed, total))
    paths = share_paths(lock, total + extra_share_count())
    extras = paths[total:]
    slice_memory = build_slice_memory() if extras else None
    held = []
    with open(f"{lock}.queue", "a") as queue:
        announced = False
        short = [False]
        def wait(take):
            nonlocal announced
            told = False
            while not take():
                if deadline is not None and time.monotonic_ns() >= deadline:
                    raise Expired
                if not announced:
                    announced = True
                    say(f"waiting for {needed} of the {total} build memory shares on "
                        f"{os.uname().nodename}; the others are in use")
                if short[0] and not told:
                    told = True
                    say("an extra share is free, but not the memory for it")
                time.sleep(0.25)
        try:
            fcntl.flock(queue, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if not queue_up:
                raise Busy
            say(f"waiting for {needed} of the {total} build memory shares on "
                f"{os.uname().nodename}; the others are in use")
            announced = True
            flock_until(queue, deadline)
        def free(candidates):
            """Locks each of `candidates` this does not hold that is free,
            and returns those and how many others hold."""
            taken, busy = [], 0
            for path in candidates:
                if any(name == path for name, _ in held):
                    continue
                share = open(path, "a")
                try:
                    fcntl.flock(share, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    share.close()
                    busy += 1
                    continue
                taken.append((path, share))
            return taken, busy
        def take():
            for path in paths[:total]:
                if len(held) == needed:
                    break
                taken, _ = free([path])
                held.extend(taken)
            # Extra shares only to complete the build, so that the memory
            # they are taken on is the memory it starts with.
            if len(held) < needed and extras:
                taken, busy = free(extras)
                short[0] = False
                if len(held) + len(taken) >= needed:
                    if memory_allows((needed + busy) * SHARE, slice_memory):
                        extra = needed - len(held)
                        held.extend(taken[:extra])
                        taken = taken[extra:]
                        say(f"admitted on {extra} extra build memory "
                            f"share{'s' if extra > 1 else ''}, as memory allows")
                    else:
                        short[0] = True
                for _, share in taken:
                    share.close()
            return len(held) == needed
        try:
            if not queue_up and not take():
                raise Busy
            wait(take)
        except BaseException:
            for _, share in held:
                share.close()
            raise
    try:
        yield
    finally:
        for _, share in held:
            share.close()


def systemctl(*arguments):
    return subprocess.run(["systemctl", "--user", *arguments], stdin=subprocess.DEVNULL,
                          capture_output=True, text=True, timeout=30, env=manager_environment())


def manager_environment_only():
    return {"XDG_RUNTIME_DIR": f"/run/user/{os.getuid()}"}


def manager_environment():
    """This environment, finding the user manager: a fixture or nested session
    that moved XDG_RUNTIME_DIR would hide it."""
    return {key: value for key, value in os.environ.items()
            if key not in MANAGER_VARIABLES} | manager_environment_only()


def prepare_slice(name=BUILD_SLICE):
    """Whether builds can run in scopes of the slice `name` here, capping its
    memory first, and for the idle slice making it idle, where they differ."""
    if os.environ.get("CAGENTS_BUILD_SCOPE") == "0":
        return False
    # The idle slice throttles itself at half the builds' memory, before it
    # could squeeze the build slice beside it.
    cap = budget() // (2 if name == IDLE_SLICE else 1) // 4096 * 4096
    wanted = [f"MemoryHigh={cap}", *(IDLE_SLICE_SETTINGS if name == IDLE_SLICE else ())]
    try:
        shown = systemctl("show", name, *(f"--property={setting.split('=')[0]}" for setting in wanted))
        if shown.returncode != 0:
            return False
        if sorted(shown.stdout.split()) != sorted(wanted):
            return systemctl("set-property", "--runtime", name, *wanted).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False
    return True


def jobserver_directory():
    return os.environ.get("CAGENTS_BUILD_JOBSERVER") or f"/run/user/{os.getuid()}/cagents-jobserver"


def pending(descriptor):
    """How many tokens wait in the pipe `descriptor`."""
    count = array.array("i", [0])
    fcntl.ioctl(descriptor, termios.FIONREAD, count)
    return count[0]


def drain(descriptor):
    while True:
        try:
            if not os.read(descriptor, 4096):
                return
        except BlockingIOError:
            return


class Jobserver:
    """A build's place in the host's jobserver.

    The host's tokens wait in a pool, a named pipe holding one for each CPU.
    A build does not use the pool itself. Its Cargo and compilers take tokens
    from a pipe this keeps stocked from the pool, and give them back into
    another, whose tokens this passes straight on to the pool. So every
    token a build takes comes through here: while other builds want tokens,
    none gets more than its fair share of the CPUs, and once the build ends,
    however it ends, every token taken for it goes back, including any its
    processes held when they were killed.

    Only build-host processes hold the pool open, each with a shared lock on
    its users file and an exclusive one on its record in `builds`, which
    says how many tokens it took. A build-host killed outright cannot give
    them back, so another gives back what its record says once its lock is
    free. A pipe's contents go with the last process holding it open, so a
    build that finds no other using the pool fills it afresh."""

    def __init__(self, directory, tokens):
        self.tokens = tokens
        self.taken = 0
        self.users = self.pool = self.record = None
        self.own = []
        try:
            self.mutex = os.path.join(directory, "join")
            self.records = os.path.join(directory, "builds")
            os.makedirs(self.records, mode=0o700, exist_ok=True)
            with self.serialized():
                self.users = os.open(os.path.join(directory, "users"), os.O_RDONLY | os.O_CREAT, 0o600)
                path = os.path.join(directory, "pool")
                with contextlib.suppress(FileExistsError):
                    os.mkfifo(path, 0o600)
                self.pool = os.open(path, os.O_RDWR | os.O_NONBLOCK)
                if not stat.S_ISFIFO(os.fstat(self.pool).st_mode):
                    raise OSError(f"{path} is not a named pipe")
                try:
                    fcntl.flock(self.users, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    pass
                else:
                    # No build-host is running: what the pool and records
                    # held went with them.
                    drain(self.pool)
                    for name in os.listdir(self.records):
                        os.unlink(os.path.join(self.records, name))
                    os.write(self.pool, b"+" * tokens)
                fcntl.flock(self.users, fcntl.LOCK_SH)
                self.record_path = os.path.join(self.records, f"{os.getpid()}-{time.monotonic_ns()}")
                self.record = os.open(self.record_path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600)
                fcntl.flock(self.record, fcntl.LOCK_EX)
            # Two pipes of the build's own. This end of each never blocks;
            # the build's, which jobserver clients expect to, do.
            with tempfile.TemporaryDirectory(dir=directory) as private:
                ends = {}
                for name in ("give", "back"):
                    fifo = os.path.join(private, name)
                    os.mkfifo(fifo, 0o600)
                    ends[name] = (os.open(fifo, os.O_RDWR | os.O_NONBLOCK), os.open(fifo, os.O_RDWR))
                    self.own += ends[name]
            (self.give, reader), (self.back, writer) = ends["give"], ends["back"]
            # Numbered high, clear of the low descriptors that scripts
            # redirect, as with `exec 9>lock`.
            reader, writer = (fcntl.fcntl(end, fcntl.F_DUPFD, HIGH_DESCRIPTOR) for end in (reader, writer))
            self.own += [reader, writer]
            for descriptor in (reader, writer):
                os.set_inheritable(descriptor, True)
            self.auth = f"{reader},{writer}"
        except BaseException:
            self.close_descriptors()
            raise
        self.hungry = False
        self.reserve = 1
        self.stopping = threading.Event()
        self.stocker = threading.Thread(target=self.stock, daemon=True)
        # Signals go to the main thread, which a signal while giving tokens
        # back would otherwise not reach in time.
        masked = signal.pthread_sigmask(signal.SIG_BLOCK, SIGNALS)
        try:
            self.stocker.start()
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, masked)

    @contextlib.contextmanager
    def serialized(self):
        """One build-host at a time joins or reads the records."""
        with open(self.mutex, "a") as mutex:
            fcntl.flock(mutex, fcntl.LOCK_EX)
            yield

    def note(self):
        """Records how many tokens the build has, and whether it wants more."""
        os.pwrite(self.record, f"{self.taken:<20}{int(self.hungry)}".encode(), 0)

    def move(self, source, target, count):
        """Moves up to `count` tokens between pipes, returning how many."""
        if count <= 0:
            return 0
        try:
            tokens = os.read(source, count)
        except BlockingIOError:
            return 0
        os.write(target, tokens)
        return len(tokens)

    def sweep(self):
        """Gives back what build-hosts killed outright took, and counts the
        other builds that want more tokens than they have."""
        hungry = 0
        with self.serialized():
            for name in os.listdir(self.records):
                path = os.path.join(self.records, name)
                try:
                    record = os.open(path, os.O_RDWR)
                except FileNotFoundError:
                    continue
                try:
                    try:
                        fcntl.flock(record, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    except BlockingIOError:
                        hungry += path != self.record_path and os.pread(record, 21, 0)[20:] == b"1"
                        continue
                    owed = os.pread(record, 20, 0).strip()
                    if owed.isdigit() and int(owed):
                        os.write(self.pool, b"+" * int(owed))
                    os.unlink(path)
                finally:
                    os.close(record)
        return hungry

    def stock(self):
        """Passes returned tokens to the pool as they come, and keeps up to
        `reserve` in the build's pipe: twice as many after the build took them
        all, and half as many after it left some. A build that took them all
        wants more, and while others do too, each gets an equal share of the
        tokens; one alone may have every token the others leave."""
        poller = select.poll()
        poller.register(self.back, select.POLLIN)
        swept = 0.0
        others = 0
        while not self.stopping.is_set():
            poller.poll(TOKEN_TICK * 1000)
            now = time.monotonic()
            before = self.taken, self.hungry
            self.taken -= self.move(self.back, self.pool, self.tokens)
            if now - swept >= SWEEP_SECONDS:
                others, swept = self.sweep(), now
            level = pending(self.give)
            self.hungry = level == 0
            share = -(-self.tokens // (others + 1))
            self.reserve = min(2 * self.reserve, self.tokens) if level == 0 else max(1, self.reserve // 2)
            wanted = max(0, min(self.reserve, share - (self.taken - level)))
            if level > wanted:
                self.taken -= self.move(self.give, self.pool, level - wanted)
            else:
                self.taken += self.move(self.pool, self.give, wanted - level)
            if (self.taken, self.hungry) != before:
                self.note()

    def close(self):
        """Gives back every token taken for the build, which has ended."""
        masked = signal.pthread_sigmask(signal.SIG_BLOCK, SIGNALS)
        try:
            self.stopping.set()
            self.stocker.join()
            # A build joining or sweeping meanwhile would find the pool
            # emptied by its last holder, or repay this build again.
            with self.serialized():
                if self.taken > 0:
                    os.write(self.pool, b"+" * self.taken)
                self.taken = 0
                self.close_descriptors()
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, masked)

    def close_descriptors(self):
        if self.record is not None:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(self.record_path)
        for descriptor in (*self.own, self.record, self.users, self.pool):
            if descriptor is not None:
                os.close(descriptor)
        self.users = self.pool = self.record = None
        self.own = []


def build_environment(environment, auth):
    """What a build runs with: the jobserver, given as its read and write
    descriptors, when it has one, and otherwise Cargo jobs of its own. A
    caller's own CARGO_BUILD_JOBS stays."""
    environment = dict(environment)
    cpus = os.cpu_count() or 1
    if auth:
        flags = f"-j --jobserver-auth={auth}"
        environment["MAKEFLAGS"] = environment["CARGO_MAKEFLAGS"] = flags
        environment.pop("MFLAGS", None)
        # The jobserver bounds the jobs; this only overrides the
        # repository's default for hosts that have none.
        environment.setdefault("CARGO_BUILD_JOBS", str(cpus))
    else:
        environment.setdefault("CARGO_BUILD_JOBS", str(max(2, min(8, cpus // 2))))
    environment[HELD_MARK] = str(os.getpid())
    return environment


def follow_parent(parent):
    """A killed build-host takes its command with it."""
    import ctypes
    ctypes.CDLL(None).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    if os.getppid() != parent:
        os._exit(143)


MANAGER_VARIABLES = ("XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS")
# A background build, such as a release prebuilt beside main's checks, that
# nothing else waits behind. It runs in its own slice at the top of the user
# manager, which the kernel schedules only on CPU time that no sibling, such
# as app.slice's tests and sessions or the build slice, wants: an idle group
# yields only to its siblings, so it must not sit inside the build slice.
# Starved, it would sit on jobserver tokens other builds need, so it takes
# none and runs its own Cargo jobs instead.
IDLE_SETTING = "CAGENTS_BUILD_IDLE"
# A dash would nest it in another slice.
IDLE_SLICE = "cagentsidle.slice"
IDLE_SLICE_SETTINGS = ("CPUWeight=idle", "IOWeight=1")


def idle():
    return os.environ.get(IDLE_SETTING) == "1"


class Interrupted(Exception):
    def __init__(self, number):
        super().__init__(number)
        self.number = number


def run(command, environment, scoped, group=True, capture=False, idle=False):
    """Runs `command` to its end, in a scope of the build slice when
    `scoped`, and returns its status, with its standard output when
    `capture`. A signal to this process interrupts it: first as a Ctrl-C
    would, then, if it is still running five seconds later, by stopping its
    whole scope. Unscoped, the command's own process group stands in for the
    scope, unless `group` is false, as for a command within another build,
    whose scope or group ends it. An `idle` scope runs in the idle slice,
    behind everything else."""
    unit = f"cagents-build-{os.getpid()}-{time.monotonic_ns()}.scope"
    if scoped:
        # The command runs as this child: systemd-run execs it after making
        # the scope, which the manager's environment finds, with the build's.
        settings = [f"{name}={environment[name]}" if name in environment else f"--unset={name}"
                    for name in MANAGER_VARIABLES]
        command = ["systemd-run", "--user", "--scope", "--quiet", "--collect",
                   f"--slice={IDLE_SLICE if idle else BUILD_SLICE}", f"--unit={unit}",
                   "--property=TimeoutStopSec=5", "--",
                   "env", *sorted(settings, key=lambda setting: not setting.startswith("--")),
                   *command]
        environment = {key: value for key, value in environment.items()
                       if key not in MANAGER_VARIABLES} | manager_environment_only()
    parent = os.getpid()
    try:
        group = group and not scoped
        child = subprocess.Popen(command, env=environment, close_fds=False,
                                 stdout=subprocess.PIPE if capture else None,
                                 process_group=0 if group else None,
                                 preexec_fn=lambda: follow_parent(parent))
    except OSError as error:
        say(f"build-host: {command[0]}: {error.strerror}")
        status = 127 if isinstance(error, FileNotFoundError) else 126
        return (status, b"") if capture else status
    output = []
    if capture:
        reader = threading.Thread(target=lambda: output.append(child.stdout.read()), daemon=True)
        reader.start()
    interrupted = []

    def signal_command(number):
        with contextlib.suppress(ProcessLookupError):
            if group:
                os.killpg(child.pid, number)
            else:
                child.send_signal(number)

    def forward(number, _frame):
        if not interrupted:
            signal_command(signal.SIGINT)
            interrupted.append((number, time.monotonic()))

    previous = {number: signal.signal(number, forward) for number in SIGNALS}
    try:
        stopped = False
        while True:
            try:
                status = child.wait(timeout=0.2)
                break
            except subprocess.TimeoutExpired:
                pass
            if interrupted and not stopped and time.monotonic() - interrupted[0][1] >= 5:
                stopped = True
                if scoped:
                    systemctl("stop", unit)
                else:
                    signal_command(signal.SIGKILL)
    finally:
        for number, handler in previous.items():
            signal.signal(number, handler)
    if interrupted:
        # What the command left behind, such as a background job, which
        # ignores Ctrl-C, ends with it.
        if scoped:
            systemctl("stop", unit)
        else:
            signal_command(signal.SIGKILL)
        raise Interrupted(interrupted[0][0])
    if capture:
        reader.join()
        return status, output[0] if output else b""
    return status


class Stale(Exception):
    """The probe would have compiled, or outgrew its slot."""


@contextlib.contextmanager
def probe_slot():
    """Holds one of the host's probe slots, or yields None if none is free."""
    lock = lock_path()
    for index in range(max(1, SHARE // PROBE_MEMORY)):
        with open(f"{lock}.probe.{index}", "a") as slot:
            try:
                fcntl.flock(slot, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                continue
            yield slot
            return
    yield None


def tree_memory(root):
    """The memory of `root` and its descendants, other than what they share
    with other processes, such as their programs' code."""
    page = os.sysconf("SC_PAGE_SIZE")
    total, pending = 0, [root]
    while pending:
        pid = pending.pop()
        try:
            with open(f"/proc/{pid}/statm") as file:
                fields = file.read().split()
            total += (int(fields[1]) - int(fields[2])) * page
            for task in os.listdir(f"/proc/{pid}/task"):
                with open(f"/proc/{pid}/task/{task}/children") as file:
                    pending += [int(child) for child in file.read().split()]
        except (OSError, ValueError, IndexError):
            continue
    return total


class Probe:
    """Runs a build's commands to find whether they compile anything, one
    Cargo job at a time, keeping their output until the build is known not
    to need its shares. Each runs in a process group of its own, and where
    builds run in scopes, in a scope of the build slice, whose cap covers it
    with the builds. It ends as soon as it would compile, outgrows
    PROBE_MEMORY, runs PROBE_SECONDS or reaches the admission deadline."""

    def __init__(self, directory, deadline):
        self.directory = directory
        # One limit for all of the probe's commands, such as the host test
        # helper and the build after it.
        self.until = time.monotonic_ns() + PROBE_SECONDS * 10**9
        if deadline is not None:
            self.until = min(self.until, deadline)
        self.compiled = os.path.join(directory, "compiles")
        self.output = []
        self.scoped = prepare_slice()

    def environment(self, environment):
        environment = dict(environment)
        for name in ("MAKEFLAGS", "CARGO_MAKEFLAGS", "MFLAGS"):
            environment.pop(name, None)
        environment["CARGO_BUILD_JOBS"] = "1"
        # The caller's own wrapper still answers the compiler's queries;
        # a guard there, as under `cargo-gate exec`, stands for the one the
        # caller had before it.
        wrapper = environment.get("RUSTC_WRAPPER", "")
        if wrapper and os.path.basename(wrapper) == os.path.basename(PROBE_WRAPPER):
            wrapper = environment.get("CAGENTS_BUILD_EXEC_RUSTC_WRAPPER", "")
        # A gate the probe starts keeps the guard, rather than restoring an
        # exec's wrapper in its place.
        for name in ("CAGENTS_BUILD_EXEC_SHIMS", "CAGENTS_BUILD_EXEC_RUSTC_WRAPPER"):
            environment.pop(name, None)
        environment["CAGENTS_BUILD_PROBE_RUSTC_WRAPPER"] = wrapper
        environment["RUSTC_WRAPPER"] = PROBE_WRAPPER
        environment["CAGENTS_BUILD_PROBE_DIRECTORY"] = self.directory
        if "CARGO_TERM_COLOR" not in environment and sys.stderr.isatty():
            environment["CARGO_TERM_COLOR"] = "always"
        return environment

    def run(self, command, environment, capture=False):
        environment = self.environment(environment)
        unit = f"cagents-probe-{os.getpid()}-{time.monotonic_ns()}.scope"
        if self.scoped:
            # Throttled a little past where the check below ends it, so
            # nothing outgrows its slot by much between checks.
            settings = [f"{name}={environment[name]}" if name in environment else f"--unset={name}"
                        for name in MANAGER_VARIABLES]
            command = ["systemd-run", "--user", "--scope", "--quiet", "--collect",
                       f"--slice={BUILD_SLICE}", f"--unit={unit}",
                       f"--property=MemoryHigh={PROBE_MEMORY * 3 // 2}", "--",
                       "env", *sorted(settings, key=lambda setting: not setting.startswith("--")),
                       *command]
            environment = {key: value for key, value in environment.items()
                           if key not in MANAGER_VARIABLES} | manager_environment_only()
        parent = os.getpid()
        try:
            child = subprocess.Popen(command, env=environment,
                                     stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                     stderr=subprocess.PIPE, process_group=0,
                                     preexec_fn=lambda: follow_parent(parent))
        except OSError:
            # The build with its shares reports it, as it would have.
            raise Stale
        streams = {}
        readers = [threading.Thread(target=lambda name=name, stream=stream:
                                    streams.__setitem__(name, stream.read()), daemon=True)
                   for name, stream in (("stdout", child.stdout), ("stderr", child.stderr))]
        for reader in readers:
            reader.start()
        try:
            while True:
                try:
                    status = child.wait(timeout=PROBE_TICK)
                    break
                except subprocess.TimeoutExpired:
                    pass
                if (os.path.exists(self.compiled) or time.monotonic_ns() >= self.until
                        or tree_memory(child.pid) > PROBE_MEMORY):
                    raise Stale
        finally:
            # What it started, still running or left behind, ends with it.
            with contextlib.suppress(ProcessLookupError):
                os.killpg(child.pid, signal.SIGKILL)
            # The scope also holds what left the group, as with setsid.
            if self.scoped:
                with contextlib.suppress(OSError, subprocess.SubprocessError):
                    systemctl("kill", "--signal=SIGKILL", unit)
            child.wait()
            for reader in readers:
                reader.join()
            child.stdout.close()
            child.stderr.close()
        # The guard ends the probe's process group at a compile. Killed by
        # something else, such as the kernel out of memory, a probe says
        # nothing of the build either.
        if os.path.exists(self.compiled) or status < 0:
            raise Stale
        stdout, stderr = streams.get("stdout", b""), streams.get("stderr", b"")
        if capture:
            self.output.append((b"", stderr))
            return status, stdout
        self.output.append((stdout, stderr))
        return status

    def show(self):
        """Shows what the probe's commands wrote, which was the build's."""
        try:
            for stdout, stderr in self.output:
                sys.stdout.buffer.write(stdout)
                sys.stdout.flush()
                sys.stderr.buffer.write(stderr)
                sys.stderr.flush()
        except BrokenPipeError:
            # A reader that stopped reading, such as `head`, wants no more.
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
            os.dup2(devnull, sys.stderr.fileno())


def status_of(status):
    return status if status >= 0 else 128 - status


def within_build():
    """Whether a build-host that is still running started this."""
    holder = os.environ.get(HELD_MARK, "")
    if not holder.isdecimal():
        return False
    try:
        with open(f"/proc/{holder}/cmdline", "rb") as file:
            arguments = file.read().split(b"\0")[:4]
    except OSError:
        return False
    return any(os.path.basename(argument) == b"build-host" for argument in arguments)


def lost_jobserver():
    """Whether this inherited a jobserver whose descriptors a process
    between, such as Python's subprocess by default, did not pass on."""
    found = re.search(r"--jobserver-auth=(\d+),(\d+)", os.environ.get("MAKEFLAGS", ""))
    if not found or os.environ.get("CAGENTS_BUILD_SCOPE") == "0":
        return False
    try:
        return not all(stat.S_ISFIFO(os.fstat(int(end)).st_mode) for end in found.groups())
    except OSError:
        return True


class Build:
    """One build's slot in the host: its shares, scope and jobserver."""

    def __init__(self, shares, deadline, runner=None):
        self.shares, self.deadline, self.runner = shares, deadline, runner
        self.probe = None
        self.retry_links = False

    def complete(self, steps, probed=False):
        """Runs `steps`, which build with `run`, and returns what they return.
        A build that can be `probed` and whose shares are not free at once is
        probed first, and waits for them only if it compiles."""
        if probed and self.shares and os.environ.get("CAGENTS_BUILD_PROBE") != "0" \
                and os.access(PROBE_WRAPPER, os.X_OK):
            try:
                with self.admitted(queue_up=False):
                    return steps()
            except Busy:
                pass
            with probe_slot() as slot:
                if slot is not None:
                    with tempfile.TemporaryDirectory(prefix="cagents-probe-") as directory:
                        self.probe = Probe(directory, self.deadline)
                        try:
                            result = steps()
                        except Stale:
                            pass
                        else:
                            self.probe.show()
                            return result
                        finally:
                            self.probe = None
        with self.admitted():
            return steps()

    @contextlib.contextmanager
    def admitted(self, queue_up=True):
        started = time.monotonic()
        try:
            # None for a command within the shares of a build that started it.
            with shares(self.shares, self.deadline, queue_up) if self.shares else contextlib.nullcontext():
                waited = time.monotonic() - started
                if waited >= 2:
                    say(f"admitted after {waited:.0f}s")
                # A build that another build-host started, such as Cargo
                # under `cargo-gate exec`, runs in its scope, with its
                # jobserver, which its environment names.
                self.nested = within_build()
                self.scoped = not self.nested and (prepare_slice(IDLE_SLICE) if idle() else prepare_slice())
                self.jobserver = None
                if (self.scoped or self.nested and lost_jobserver()) and not idle():
                    try:
                        self.jobserver = Jobserver(jobserver_directory(), os.cpu_count() or 1)
                    except OSError as error:
                        say(f"building without the shared jobserver: {error}")
                trimmer = None
                try:
                    directory = slice_directory() if self.scoped and not idle() else None
                    if directory:
                        trimmer = CacheTrimmer(directory, jobserver_directory() + ".reclaim")
                    yield self
                finally:
                    if trimmer:
                        trimmer.close()
                    if self.jobserver:
                        self.jobserver.close()
        except Expired:
            say("build admission timed out")
            raise SystemExit(124)

    def run(self, command, capture=False):
        environment = os.environ
        if self.retry_links:
            environment = dict(environment, RUSTC_WRAPPER=RETRY_WRAPPER)
        if self.probe:
            return self.probe.run(command, build_environment(environment, None), capture)
        auth = self.jobserver.auth if self.jobserver else None
        return run(command, build_environment(environment, auth), self.scoped,
                   group=not self.nested, capture=capture, idle=idle())


def separate(arguments):
    """For `test`, `bench` or `run` that runs something after building it:
    the subcommand's index. Cargo cannot build doctests without running
    them, so `--doc` builds and runs in one, as does anything `--no-run`."""
    index = 1 if arguments[:1] and arguments[0].startswith("+") else 0
    if len(arguments) <= index or arguments[index] not in ("test", "bench", "run"):
        return None
    for argument in arguments[index + 1:]:
        if argument == "--":
            break
        if argument in ("--doc", "--no-run"):
            return None
    return index


def build_phase(cargo, arguments, index):
    """The build half of `test`, `bench` or `run`. Arguments after `--`
    belong to the tests or program, not Cargo."""
    rest = arguments[index + 1:]
    rest = rest[:rest.index("--")] if "--" in rest else rest
    if arguments[index] == "run":
        return [cargo, *arguments[:index], "build", *rest]
    return [cargo, *arguments[:index], arguments[index], "--no-run", *rest]


def under_test_limit(command):
    """COMMAND under the memory limit tests run with, in app-cagents-test.slice."""
    capped = os.path.join(HERE, "memory-capped")
    if not os.access(capped, os.X_OK):
        return command
    return [sys.executable, "-I", capped, "--slice", TEST_SLICE, "--stop-leftovers", *command]


def runs_tests(arguments, index):
    """Whether the Cargo command runs tests or benchmarks, as `--doc` does
    while it builds them."""
    rest = arguments[index + 1:]
    rest = rest[:rest.index("--")] if "--" in rest else rest
    return arguments[index:index + 1] in (["test"], ["bench"]) and "--no-run" not in rest


def probed(arguments, index, tests):
    """Whether the Cargo command only builds, with the compiler alone, and so
    can be probed: what `separate` splits, or a build, check, clippy or
    `--no-run` that no `--doc` makes rustdoc's."""
    if index is not None:
        return True
    first = 1 if arguments[:1] and arguments[0].startswith("+") else 0
    rest = arguments[first + 1:]
    rest = rest[:rest.index("--")] if "--" in rest else rest
    return (not tests and "--doc" not in rest
            and arguments[first:first + 1] in [[name] for name in (*PROBED, "test", "bench")])


def retry_links(arguments):
    """Use the retry wrapper only in a leased slot and only as a default."""
    if (not os.environ.get("CAGENTS_BUILD_OFFLOAD_BUILD_DIR")
            or not os.environ.get("CAGENTS_BUILD_OFFLOAD_WORKSPACE_DIRS")
            or not os.access(RETRY_WRAPPER, os.X_OK)
            or "RUSTC_WRAPPER" in os.environ or "CARGO_BUILD_RUSTC_WRAPPER" in os.environ):
        return False
    from pathlib import Path
    try:
        import tomllib
    except ImportError:
        return False

    def specifies_wrapper(config):
        # An include might supply a wrapper as well: leave that configuration
        # to Cargo, along with files we cannot read or interpret.
        return ("include" in config or "rustc-wrapper" in config.get("build", {})
                or {"RUSTC_WRAPPER", "CARGO_BUILD_RUSTC_WRAPPER"}.intersection(config.get("env", {})))

    here = Path.cwd()
    cargo_home = Path(os.environ.get("CARGO_HOME") or Path.home() / ".cargo")
    folders = [cargo_home, *(parent / ".cargo" for parent in (here, *here.parents))]
    configs = [folder / name for folder in folders for name in ("config", "config.toml")]
    try:
        options = iter(arguments)
        for option in options:
            if option == "--":
                break
            if option == "--config":
                value = next(options, "")
            elif option.startswith("--config="):
                value = option.partition("=")[2]
            else:
                continue
            if "=" not in value:
                configs.append(Path(value))
            elif specifies_wrapper(tomllib.loads(value)):
                return False
        return not any(specifies_wrapper(tomllib.loads(path.read_text(encoding="utf-8")))
                       for path in configs if path.is_file())
    except (OSError, ValueError, TypeError):
        return False


def cargo_command(build, cargo, arguments):
    index = 1 if arguments[:1] and arguments[0].startswith("+") else 0
    if arguments[index:index + 1] and arguments[index] in ALIASES:
        arguments = [*arguments[:index], ALIASES[arguments[index]], *arguments[index + 1:]]
    tests = runs_tests(arguments, index)
    if build.runner and arguments[index:index + 1] in (["run"], ["test"], ["bench"]):
        arguments = [*arguments[:index + 1], "--config", build.runner, *arguments[index + 1:]]
    build.retry_links = retry_links(arguments)
    index = separate(arguments)

    def steps():
        """The build, which returns its status, or None when what it built
        is to run."""
        if index is not None and arguments[index] == "test":
            # Library tests cannot use Cargo's integration-only CARGO_BIN_EXE_*
            # variables, so the matched daemon builds here, with the shares.
            helper = os.path.join(HERE, "cargo-host-test-helper.py")
            if os.path.isfile(helper) and not os.environ.get("CAGENTS_TEST_RETAINED_ACTOR_HELPER"):
                status, output = build.run([sys.executable, "-I", "-B", helper, cargo, *arguments],
                                           capture=True)
                if status:
                    return status_of(status)
                # A probe that ran it found the daemon built, so the build
                # with shares that follows a stale probe need not run it again.
                if output.strip():
                    os.environ["CAGENTS_TEST_RETAINED_ACTOR_HELPER"] = output.strip().decode()
        if index is None:
            # Doctests build and run in one, within the shares.
            command = [cargo, *arguments]
            return status_of(build.run(under_test_limit(command) if tests else command))
        status = build.run(build_phase(cargo, arguments, index))
        return status_of(status) if status else None

    status = build.complete(steps, probed(arguments, index, tests))
    if status is not None:
        return status
    # The shares are back: what remains runs the tests or program.
    command = [cargo, *arguments]
    if tests:
        command = under_test_limit(command)
    os.execvp(command[0], command)


def options(arguments):
    shares, deadline, runner, remove = 1, None, None, []
    while arguments and arguments[0] != "--":
        option, value = arguments[0], arguments[1] if len(arguments) > 1 else ""
        if option == "--runner":
            runner = value
        elif option == "--remove":
            remove.append(value)
        elif option not in ("--shares", "--deadline", "--wait-seconds"):
            print(USAGE, end="", file=sys.stderr)
            raise SystemExit(2)
        elif not value.isdecimal():
            say(f"build-host: {option} needs a whole number")
            raise SystemExit(2)
        elif option == "--shares":
            shares = int(value)
        elif option == "--deadline":
            deadline = int(value)
        else:
            deadline = time.monotonic_ns() + int(value) * 10**9
        arguments = arguments[2:]
    if not arguments[1:]:
        print(USAGE, end="", file=sys.stderr)
        raise SystemExit(2)
    return Build(shares, deadline, runner), remove, arguments[1:]


def main(arguments):
    if arguments == ["count"]:
        print(share_count() + extra_share_count())
        return 0
    if arguments[:1] not in (["cargo"], ["build"]):
        print(USAGE, end="", file=sys.stderr)
        return 2
    build, remove, command = options(arguments[1:])

    def stop(number, _frame):
        raise Interrupted(number)

    # Until a command runs, which takes signals over, a signal ends the wait.
    for number in SIGNALS:
        signal.signal(number, stop)
    try:
        if arguments[0] == "cargo":
            return cargo_command(build, command[0], command[1:])
        with build.admitted():
            return status_of(build.run(command))
    except Interrupted as interruption:
        for path in remove:
            shutil.rmtree(path, ignore_errors=True)
        # Ends as the signal it was sent, as the command would have, without
        # the core dump SIGQUIT's default action would write.
        import ctypes
        ctypes.CDLL(None).prctl(4, 0)  # PR_SET_DUMPABLE
        signal.signal(interruption.number, signal.SIG_DFL)
        os.kill(os.getpid(), interruption.number)
        return 128 + interruption.number
    finally:
        for path in remove:
            shutil.rmtree(path, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
