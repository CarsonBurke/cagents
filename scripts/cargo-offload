#!/usr/bin/python3
"""Run a gated Cargo command on the build host instead of this one.

scripts/cargo-gate runs this before anything else. Rust compiles only on the
host in CAGENTS_BUILD_REMOTE, unless that is `local` or names this host. A
command that compiles leases a build slot there, copies the
checkout's sources into it, and runs Cargo there with its output streamed
back and its exit status kept. What a caller here expects from it comes back:
executables, documentation, timing reports, artifact directories, what the
command wrote in the sources (Cargo's fixes, a test's recording), and Cargo's
messages with their paths turned into this host's.
`run` builds there and runs the program here.

Each slot's checkout path never changes, so every worktree built in a slot
reuses what the previous one compiled there, and the slot a worktree used
last is preferred. Before each build, its lease bounds the slot's build
output: it keeps the incremental compilation state of the crates the slot
compiled most recently, within CAGENTS_BUILD_REMOTE_INCREMENTAL_GIB, and
every few hours drops compiled units no build has looked at for days. Below
twice the host's floor it keeps a quarter as much, in every slot no lease
holds as well. `--trim-slots FLOOR_GIB [--wait]` does the same to this
host's own idle slots for scripts/build-disk-guard. With
CAGENTS_BUILD_REMOTE_LOOPBACK=1, the build host's own
commands build in its slots too, as another host's would, through a local
stand-in for ssh. While the host is unreachable, does not answer or is low
on disk, the command waits for it, saying so once a minute, within the gate's
admission budget; it never builds here instead. Cargo commands that do not
compile run here directly. A command that compiles but cannot run there
faithfully is refused with the reason.
"""

import base64
import contextlib
import fcntl
import hashlib
import ipaddress
import json
import os
import pwd
import queue
import re
import resource
from pathlib import Path
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time

# The gate builds here: CAGENTS_BUILD_REMOTE is `local` or names this host.
FALL_BACK = 75
# A command the build host cannot run faithfully, which building here would hide.
REFUSED = 78
# The build host could not lease a slot for a reason waiting does not fix.
UNAVAILABLE = 69
# The admission budget ran out, as for a slot here.
EXPIRED = 124
program = "cargo-gate"
OPT_OUT = "set CAGENTS_BUILD_REMOTE=local to build here instead"

# Subcommands, and their aliases, that compile.
REMOTE = {
    "build": "build", "b": "build", "check": "check", "c": "check", "clippy": "clippy",
    "test": "test", "t": "test", "bench": "bench", "doc": "doc", "d": "doc",
    "rustc": "rustc", "rustdoc": "rustdoc", "run": "run", "r": "run", "fix": "fix",
}
# Subcommands that read or change only this checkout, the lock file or
# Cargo's caches, and compile nothing: they run here as they are.
HERE = {
    "metadata", "tree", "fmt", "locate-project", "pkgid", "fetch", "generate-lockfile",
    "update", "vendor", "clean", "search", "version", "help", "verify-project",
    "read-manifest", "config", "info", "add", "remove", "new", "init", "owner", "yank",
    "login", "logout", "report", "-V", "--version", "-vV", "--list", "-h", "--help",
}
# Options that take a value in the next argument when not given with `=`.
VALUED = {
    "-p", "--package", "--bin", "--example", "--test", "--bench", "-F", "--features",
    "-j", "--jobs", "--profile", "--target", "--target-dir", "--manifest-path",
    "--message-format", "--color", "--config", "-Z", "--lockfile-path", "--artifact-dir",
    "--out-dir", "--exclude", "--crate-type", "--explain", "--edition",
}
# Options whose value is a path, which the build host has at the same place
# in its copy of the checkout. `--config` and `--target` take a path only
# sometimes.
PATHS = {"--manifest-path", "--lockfile-path", "--target-dir", "--artifact-dir", "--out-dir"}
# Settings naming a path that only this repository's scripts read, never a
# build or its tests; they stay here. A development instance's daemon gives
# CAGENTS_DEVELOPMENT_HOSTED_BY, runtime directories on this host, to the
# terminals and agents it hosts. scripts/native-evidence reads its own, such
# as the CAGENTS_EVIDENCE_TASK its users export, whose builds come here.
SCRIPT_SETTINGS = {"CAGENTS_ZIG", "CAGENTS_DEVELOPMENT_HOSTED_BY"}
SCRIPT_PREFIXES = ("CAGENTS_EVIDENCE_",)
RUN_MARKER = "cargo-offload-run "
# What `--hold` gives the command it runs: the build host, the slot it holds
# there and the checkout it holds it for, and a lock it keeps while it does.
HELD = "CAGENTS_BUILD_OFFLOAD_HELD"
# The most incremental compilation state, in GiB, each slot on the build host
# keeps unless CAGENTS_BUILD_REMOTE_INCREMENTAL_GIB says otherwise; see
# INCREMENTAL_BUDGET in the agent.
INCREMENTAL_GIB = 20
# Set to 1, the build host's own commands build in its slots rather than
# here: what they make comes back, and the slots keep the build output.
LOOPBACK = "CAGENTS_BUILD_REMOTE_LOOPBACK"
# How `--host` reports a build host that is this one, reached by loopback.
LOOPBACK_MARK = "\tloopback"
# The shell a loopback runs commands in, instead of the user's login shell.
LOOPBACK_SHELL = "CAGENTS_BUILD_REMOTE_LOOPBACK_SHELL"
# Set beside CAGENTS_BUILD_METADATA, whose value it then owns: an empty one is
# no metadata, and build.rs leaves the checkout alone. Its own value never
# changes between commits, so watching it costs build.rs no reruns.
SUPPLIED = "CAGENTS_BUILD_METADATA_SUPPLIED"
DIRECTORIES_MARKER = "cargo-offload-directories "


class Refusal(Exception):
    """The command compiles, but the build host cannot run it faithfully."""


class Plan:
    """A Cargo command line, read for what has to travel to the build host
    and what has to come back."""

    def __init__(self, arguments):
        self.toolchain = None
        if arguments and arguments[0].startswith("+"):
            self.toolchain, arguments = arguments[0], arguments[1:]
        self.name = arguments[0]
        self.subcommand = REMOTE[self.name]
        # (option, value, attached) for each option before `--`; a bare
        # argument is (None, argument, False).
        self.options = []
        self.program = []
        self.trailing = []
        words = arguments[1:]
        index = 0
        while index < len(words):
            word = words[index]
            index += 1
            if word == "--":
                if self.subcommand == "run":
                    self.program = words[index:]
                else:
                    self.trailing = words[index - 1:]
                break
            if word.startswith("--") and "=" in word:
                option, value = word.split("=", 1)
                self.options.append((option, value, True))
            elif word in VALUED and index < len(words):
                self.options.append((word, words[index], False))
                index += 1
            elif len(word) > 2 and word[0] == "-" and word[1] != "-" and word[:2] in VALUED:
                self.options.append((word[:2], word[2:], True))
            elif not word.startswith("-") and self.subcommand == "run":
                # `cargo run` passes its first bare argument and everything
                # after it to the program.
                self.program = words[index - 1:]
                break
            else:
                self.options.append((None, word, False) if not word.startswith("-")
                                    else (word, None, False))

    def values(self, option):
        return [value for name, value, _ in self.options if name == option]

    def flag(self, option):
        return any(name == option for name, _, _ in self.options)

    @property
    def message_format(self):
        formats = self.values("--message-format")
        return ",".join(formats) if formats else None

    @property
    def caller_wants_json(self):
        return any(part.strip().startswith("json") for part in (self.message_format or "").split(","))

    @property
    def no_run(self):
        return self.flag("--no-run")

    @property
    def fixes(self):
        return self.subcommand == "fix" or self.flag("--fix")

    @property
    def timings(self):
        return self.flag("--timings")

    @property
    def executables(self):
        """Whether the executables the command makes are its result here."""
        return self.subcommand in ("build", "rustc", "run") or (
            self.subcommand in ("test", "bench") and self.no_run)

    @property
    def captures(self):
        """Whether Cargo's standard output is read here: for the executables
        it reports, or to turn the build host's paths in its messages into
        this host's."""
        return (self.executables or self.caller_wants_json or self.flag("--open")
                or self.flag("--unit-graph") or self.flag("--build-plan"))

    @property
    def runs_tests(self):
        return self.subcommand in ("test", "bench") and not self.no_run

    def arguments(self, translate, extra):
        """The command line for the build host: paths translated, the
        message format this side reads, and `extra` options."""
        words = [self.toolchain] if self.toolchain else []
        words.append(self.name)
        formats = []
        for option, value, attached in self.options:
            if option == "--message-format":
                formats.append(value)
                continue
            if option == "--open":
                continue  # This host opens the documentation, not the build host.
            if value is not None and option is not None:
                value = translate(option, value)
            if option is None:
                words.append(value)
            elif value is None:
                words.append(option)
            elif attached:
                words.append(f"{option}={value}" if option.startswith("--") else option + value)
            else:
                words += [option, value]
        if self.captures and not self.caller_wants_json:
            # Cargo's diagnostics stay as the caller asked; its messages carry
            # the executables.
            short = "short" in ",".join(formats)
            formats = ["json-render-diagnostics"] + (["json-diagnostic-short"] if short else [])
        if formats:
            words.append("--message-format=" + ",".join(formats))
        words += extra
        if self.subcommand == "run":
            return words
        return words + self.trailing


def parse(arguments):
    """The Plan for a command that compiles, or None for one that runs here.
    Raises Refusal for one that compiles and cannot run on the build host."""
    words = arguments[1:] if arguments[:1] and arguments[0].startswith("+") else arguments
    if not words or words[0] in HERE:
        return None
    if words[0].startswith("-"):
        raise Refusal(f"`cargo {' '.join(arguments)}`: options before the subcommand are not "
                      f"passed to the build host; put them after it, or {OPT_OUT}")
    if words[0] not in REMOTE:
        raise Refusal(f"`cargo {words[0]}` may compile, and only the build host compiles; "
                      f"it has no offloaded form, so {OPT_OUT}")
    plan = Plan(arguments)
    if plan.subcommand == "doc" and plan.flag("--open") and plan.caller_wants_json:
        raise Refusal(f"`cargo doc --open` with JSON messages is not supported; {OPT_OUT}")
    return plan


def artifacts(messages, roots):
    """The executables Cargo reported, by which of the directories `roots`
    holds them (the innermost), as paths relative to it: programs, examples
    and test harnesses, not build scripts. Cargo reports test harnesses in its
    build directory, which its configuration may keep apart from the target
    directory."""
    roots = sorted(dict.fromkeys(root.rstrip("/") for root in roots), key=len, reverse=True)
    found = {root: [] for root in roots}
    for message in messages:
        if isinstance(message, str):
            try:
                message = json.loads(message)
            except ValueError:
                continue
        if not isinstance(message, dict) or message.get("reason") != "compiler-artifact":
            continue
        executable = message.get("executable")
        kinds = (message.get("target") or {}).get("kind") or []
        if "custom-build" in kinds:
            continue
        if not isinstance(executable, str):
            continue
        root = next((root for root in roots if executable.startswith(root + "/")), None)
        if root is None:
            continue
        relative = executable[len(root) + 1:]
        if relative not in found[root] and ".." not in relative.split("/"):
            found[root].append(relative)
    return {root: made for root, made in found.items() if made}


def rewrite(value, mappings):
    """`value` with every string that names a path under one of the build
    host's directories naming the same path under this host's."""
    if isinstance(value, str):
        # Package IDs name a path package by its URL.
        for scheme in ("path+file://", "file://"):
            if value.startswith(scheme + "/"):
                path, mark, rest = value[len(scheme):].partition("#")
                return scheme + rewrite(path, mappings) + mark + rest
        for remote, local in mappings:
            if value == remote or value.startswith(remote + "/"):
                return local + value[len(remote):]
        # Search paths a build script gives, such as `native=/path`.
        kind, mark, path = value.partition("=")
        if mark and path.startswith("/") and kind.isidentifier():
            changed = rewrite(path, mappings)
            if changed != path:
                return kind + mark + changed
        return value
    if isinstance(value, list):
        return [rewrite(item, mappings) for item in value]
    if isinstance(value, dict):
        return {key: rewrite(item, mappings) for key, item in value.items()}
    return value


def forwarded_environment(environment):
    """The caller's settings that change what Cargo, rustc or the tests do,
    without paths on this host or this host's build-slot settings."""
    kept = {}
    for name, value in environment.items():
        if name.startswith(("RUST_", "CARGO_TERM_", "CARGO_PROFILE_")) or name in (
            "RUSTFLAGS", "RUSTDOCFLAGS", "CARGO_INCREMENTAL", "CARGO_ENCODED_RUSTFLAGS",
            "CARGO_ENCODED_RUSTDOCFLAGS", "NEXTEST_PROFILE",
        ):
            kept[name] = value
        elif name.startswith("CAGENTS_") and not name.startswith("CAGENTS_BUILD_") \
                and not value.startswith(("/", "~")) and not secret(name):
            kept[name] = value
    return kept


def secret(name):
    """Whether a setting looks like a credential, which stays on this host."""
    return any(word in name.upper() for word in ("TOKEN", "KEY", "SECRET", "PASS", "AUTH", "CREDENTIAL", "COOKIE"))


def path_settings(environment):
    """Settings naming a file on this host that the build or its tests read,
    such as the retained-actor helper the HOST tests execute."""
    return [name for name, value in sorted(environment.items())
            if name.startswith("CAGENTS_") and not name.startswith("CAGENTS_BUILD_")
            and name not in SCRIPT_SETTINGS and not name.startswith(SCRIPT_PREFIXES)
            and value.startswith(("/", "~"))
            and not secret(name)]


def inside(path, root):
    return os.path.commonpath([path, root]) == root


def build_metadata(root, version, environment):
    """The version stamp build.rs would give this checkout, which the build
    host's copy, having no Git history, cannot work out itself. A value the
    caller sets is kept, unless a gate set it: then it is the stamp of
    whatever that gate built, which a process it started has inherited."""
    given = environment.get("CAGENTS_BUILD_METADATA", "").strip()
    if given and environment.get(SUPPLIED) != "1":
        return given

    def git(*arguments):
        result = subprocess.run(
            ["git", "-C", root, *arguments], capture_output=True, text=True,
            env=dict(environment, GIT_OPTIONAL_LOCKS="0"),
        )
        return result.stdout.strip() if result.returncode == 0 else None

    sha = git("rev-parse", "--short", "HEAD")
    if not sha:
        return None
    dirty = bool(git("status", "--porcelain", "--untracked-files=no"))
    tags = (git("tag", "--points-at", "HEAD") or "").splitlines()
    if f"v{version}" in tags and not dirty:
        return None
    return f"local.{sha}.dirty" if dirty else f"local.{sha}"


def checkout_stamp(arguments, environment):
    """The stamp for a build here of the workspace these Cargo arguments name,
    or None outside a Cargo workspace in a Git checkout, where build.rs
    decides."""
    manifest = []
    for index, argument in enumerate(arguments):
        if argument == "--":
            break
        if argument == "--manifest-path" and index + 1 < len(arguments):
            manifest = ["--manifest-path", arguments[index + 1]]
        elif argument.startswith("--manifest-path="):
            manifest = [argument]
    try:
        metadata = subprocess.run(
            [real_cargo(environment), "metadata", "--format-version", "1", "--no-deps",
             *manifest], capture_output=True, text=True, env=environment)
        if metadata.returncode:
            return None
        workspace = json.loads(metadata.stdout)
        root = os.path.realpath(workspace["workspace_root"])
        package = next((package for package in workspace["packages"]
                        if os.path.dirname(os.path.realpath(package["manifest_path"])) == root),
                       None)
        top = subprocess.run(["git", "-C", root, "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True,
                             env=dict(environment, GIT_OPTIONAL_LOCKS="0"))
    except (OSError, ValueError, KeyError, TypeError):
        return None
    if package is None or top.returncode:
        return None
    return build_metadata(os.path.realpath(top.stdout.strip()), package["version"],
                          environment) or ""


def uncommitted(top, workspace, environment):
    """The workspace's files with changes that are not staged, and those with
    staged changes, as `cargo fix` judges a checkout before changing it."""
    result = subprocess.run(
        ["git", "-C", top, "status", "--porcelain=v1", "-z", "--untracked-files=all", "--",
         workspace],
        capture_output=True, env=dict(environment, GIT_OPTIONAL_LOCKS="0"), check=True)
    dirty, staged = [], []
    entries = iter(result.stdout.split(b"\0"))
    for entry in entries:
        if not entry:
            continue
        state, name = entry[:2].decode(), os.fsdecode(entry[3:])
        if state[0] in "RC":
            next(entries, None)  # The rename's source.
        if state == "??" or state[1] != " ":
            dirty.append(name)
        if state[0] not in " ?":
            staged.append(name)
    return dirty, staged


def profile_config(path):
    """This user's Cargo profile settings as TOML for the build host, which
    builds the same profiles. Build settings such as jobs and build-dir
    describe this host and stay here."""
    try:
        import tomllib
        with open(path, "rb") as file:
            profiles = tomllib.load(file).get("profile", {})
    except (OSError, ValueError, ImportError):
        return ""

    def key(name):
        return name if name.replace("-", "").replace("_", "").isalnum() else json.dumps(name)

    def value(item):
        if isinstance(item, bool):
            return "true" if item else "false"
        if isinstance(item, (int, float)):
            return str(item)
        if isinstance(item, str):
            return json.dumps(item)
        if isinstance(item, list):
            return "[" + ", ".join(value(element) for element in item) + "]"
        raise ValueError(item)

    lines = []

    def table(names, entries):
        scalars = {name: item for name, item in entries.items() if not isinstance(item, dict)}
        if scalars:
            lines.append("[" + ".".join(key(name) for name in names) + "]")
            for name, item in scalars.items():
                lines.append(f"{key(name)} = {value(item)}")
        for name, item in entries.items():
            if isinstance(item, dict):
                table(names + [name], item)

    try:
        table(["profile"], profiles)
    except ValueError:
        return ""
    return "\n".join(lines) + "\n" if lines else ""


def local_addresses():
    """This host's network addresses."""
    try:
        listing = subprocess.run(["ip", "-j", "address", "show"], capture_output=True,
                                 text=True, timeout=5).stdout
        return {entry["local"] for interface in json.loads(listing)
                for entry in interface.get("addr_info", []) if "local" in entry}
    except (OSError, ValueError, subprocess.TimeoutExpired, KeyError, TypeError):
        return set()


def is_this_host(host):
    """Whether `host`, as ssh reaches it, is this machine: the build host's own
    builds run here."""
    names = {socket.gethostname(), os.uname().nodename}
    short = {name.split(".")[0] for name in names}
    if host in names or host.split(".")[0] in short:
        return True
    try:
        configuration = subprocess.run(["ssh", "-G", host], capture_output=True, text=True,
                                       timeout=5, stdin=subprocess.DEVNULL).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False
    resolved = next((line.split(None, 1)[1] for line in configuration.splitlines()
                     if line.startswith("hostname ")), host).strip()
    if resolved in names or resolved.split(".")[0] in short:
        return True
    try:
        addresses = {str(ipaddress.ip_address(resolved))}
    except ValueError:
        # A name: a resolver that does not know it can take seconds to say
        # so, which every build would wait for.
        found = []
        lookup = threading.Thread(target=resolve, args=(resolved, found), daemon=True)
        lookup.start()
        lookup.join(1)
        addresses = set(found)
    return bool(addresses & (local_addresses() | {"127.0.0.1", "::1"}))


# ssh's options that take a value, as `-o NAME=VALUE` does.
SSH_VALUED = set("BbcDEeFIiJLlmOoPpQRSWw")


def loopback_shell(arguments):
    """Stands in for `ssh [OPTIONS] HOST COMMAND...` to this host. It runs
    COMMAND as sshd would: in the user's login shell, from the home
    directory, with only the basics a session starts from (the shell's own
    configuration adds the rest), so nothing of the caller's build, such as
    its CARGO_TARGET_DIR, reaches the slot. sshd's SSH_CONNECTION, ~/.ssh/rc
    and ~/.ssh/environment have no counterpart. A control command (`-O`) has
    no shared connection to act on.

    The command reads its input through this process, as through an ssh
    connection: when this ends, even by SIGKILL, the command sees its input
    close and ends what it started, as the build host's agent does when its
    caller's connection drops. A shell that does not `exec` its command
    would otherwise leave that running."""
    while arguments and arguments[0].startswith("-") and len(arguments[0]) > 1:
        option = arguments.pop(0)
        if option[1] == "O":
            return 0
        if option[1] in SSH_VALUED and len(option) == 2 and arguments:
            arguments.pop(0)
    if len(arguments) < 2:
        say("loopback: missing host or command")
        return 2
    account = pwd.getpwuid(os.getuid())
    shell = os.environ.get(LOOPBACK_SHELL) or account.pw_shell or "/bin/sh"
    environment = {"HOME": account.pw_dir, "USER": account.pw_name,
                   "LOGNAME": account.pw_name, "SHELL": shell,
                   "PATH": "/usr/local/bin:/usr/bin:/bin"}
    for name in ("LANG", "LC_ALL", "LC_CTYPE"):
        if name in os.environ:
            environment[name] = os.environ[name]
    runtime = f"/run/user/{os.getuid()}"
    if os.path.isdir(runtime):
        environment["XDG_RUNTIME_DIR"] = runtime
    home = account.pw_dir if os.path.isdir(account.pw_dir) else "/"
    # ssh passes the command to the shell as one string, its words joined.
    command = subprocess.Popen([shell, "-c", " ".join(arguments[1:])], env=environment,
                               cwd=home, stdin=subprocess.PIPE)

    def relay():
        try:
            while data := os.read(0, 65536):
                command.stdin.write(data)
                command.stdin.flush()
        except OSError:
            pass  # The command stopped reading; its status says why.
        finally:
            with contextlib.suppress(OSError):
                command.stdin.close()
    threading.Thread(target=relay, daemon=True).start()
    status = command.wait()
    sys.stdout.flush()
    os._exit(status if status >= 0 else 128 - status)


def resolve(name, found):
    try:
        found.extend(info[4][0] for info in socket.getaddrinfo(name, None))
    except (OSError, UnicodeError):
        pass


def real_cargo(environment):
    """This host's Cargo: the first on PATH, from which the gate has taken an
    `exec` command's `cargo` shim, unless CAGENTS_BUILD_CARGO names one."""
    return environment.get("CAGENTS_BUILD_CARGO") or "cargo"


# Runs on the build host as `python3 -c REMOTE_AGENT COMMAND ...`. Every
# command ends with what it started when its standard input closes: the
# connection to this host dropped or the gate here was cancelled.
REMOTE_AGENT = r'''
import collections, fcntl, glob, hashlib, json, os, re, resource, shutil, signal, stat, subprocess, sys, threading, time
command, base = sys.argv[1], os.path.expanduser(sys.argv[2])
DIRECTORIES_MARKER = "cargo-offload-directories "

def until_closed(then):
    def watch():
        try:
            while sys.stdin.buffer.read(65536):
                pass
        except OSError:
            pass
        then()
    threading.Thread(target=watch, daemon=True).start()

def say(*words):
    print(*words, flush=True)

def temporary_directory(slot):
    """A short private directory for the slot's temporary files, or one in
    the slot when the short one is unsafe. Tests bind Unix sockets several
    levels under it, within 108 bytes, so the HOST fixtures want a base of at
    most 28 bytes (docs/development.md). As in that document's recipe, it is
    in the user's runtime directory: agent sandboxes leave `.git`
    placeholders in /tmp, /var/tmp and ~/.cache, under which recovery
    placement refuses by design, and fixtures refuse roots inside the home
    directory. A host test lane leaves about 12 MB there, which the next
    command in the slot removes."""
    # The variable is for tests standing in for the build host; ssh does not
    # pass it on.
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    private = os.environ.get("CAGENTS_OFFLOAD_TEMPORARY_ROOT") or os.path.join(runtime, "cof")
    try:
        os.mkdir(private, 0o700)
    except FileExistsError:
        pass
    except OSError:
        return os.path.join(slot, "tmp")
    status = os.lstat(private)
    if not stat.S_ISDIR(status.st_mode) or status.st_uid != os.getuid() or status.st_mode & 0o077:
        return os.path.join(slot, "tmp")
    index = os.path.basename(slot).removeprefix("slot-")
    path = os.path.join(private, os.path.basename(os.path.dirname(slot)) + "-" + index)
    if len(path) > 28:
        # A long repository name: a short digest of the slot keeps the base
        # within the fixtures' budget.
        digest = hashlib.sha256(os.fsencode(slot)).hexdigest()[:6]
        path = os.path.join(private, f"{digest}-{index}")
    return path


def clear(root):
    """Removes a directory tree, including directories a test left without
    owner permissions, changing permissions only inside the tree."""
    def inside(path):
        return os.path.commonpath([root, path]) == root
    def retry(function, failed, _error):
        unlocked = False
        for directory in (os.path.dirname(failed), failed):
            if inside(directory) and os.path.isdir(directory) and not os.path.islink(directory):
                try:
                    os.chmod(directory, 0o700)
                    unlocked = True
                except OSError:
                    pass
        if not unlocked:
            return
        try:
            if os.path.isdir(failed) and not os.path.islink(failed):
                if failed != root:
                    remove(failed)
            else:
                function(failed)
        except OSError:
            pass
    def remove(path):
        if sys.version_info >= (3, 12):
            shutil.rmtree(path, onexc=retry)
        else:
            shutil.rmtree(path, onerror=retry)
    if os.path.lexists(root):
        remove(root)
    # A test may have locked the root itself, which rmtree cannot open; one
    # more pass after unlocking it.
    if os.path.isdir(root) and not os.path.islink(root):
        try:
            os.chmod(root, 0o700)
        except OSError:
            return
        remove(root)


GIB = 2**30
# A build whose cost is unknown, and a slot leased without one, is priced as
# the largest: a UI link, as scripts/cargo-gate measures it.
LARGEST = 9 * GIB
# Memory pressure (`some avg10` in /proc/pressure/memory, a percentage) at
# which a build waits rather than start beside others: tasks are already
# stalling on reclaim.
MEMORY_PRESSURE_LIMIT = 10
# The least any build is priced at: even a check of one crate runs rustc and
# Cargo beside the build's other processes.
LEAST = 2 * GIB
# CPU pressure (`some avg10` in /proc/pressure/cpu) at which a build waits
# rather than start beside others: runnable tasks already wait this share of
# the time, so another build would only slow the running ones.
CPU_PRESSURE_LIMIT = 40
# What a further slot's build output is expected to take on disk, beyond the
# floor the host keeps free, before one is made. The variable is for tests
# standing in for the build host; ssh does not pass it on.
SLOT_DISK = int(os.environ.get("CAGENTS_OFFLOAD_SLOT_DISK_BYTES") or 50 * GIB)
# Where memory and CPU figures are read. This too is for tests, whose results
# must not depend on how busy the host running them is.
FIGURES = os.environ.get("CAGENTS_OFFLOAD_FIGURES") or "/proc"
# How long a new slot is taken to be filling to that size.
SLOT_FILLS = 12 * 3600
# The most incremental compilation state a slot keeps, unless its lease names
# another amount. Each feature lane, profile and kind of target of the large
# `cagents` crate keeps a session of 1-6 GiB, and slots kept 40-60 GiB of
# them, beside the 20-30 GiB their compiled dependencies take. Rustc remakes
# an evicted session, at the cost of that crate's next build being a full one.
INCREMENTAL_BUDGET = 20 * GIB  # INCREMENTAL_GIB on the calling side
# Below twice the floor, a slot keeps this share of it.
PRESSED_SHARE = 4
# A compiled unit whose fingerprint no build has read for this long is
# removed, and Cargo builds it again if a build needs it: old versions and
# feature sets otherwise stay for good. Not where access times are not kept.
DEPENDENCY_IDLE = 3 * 86400
# How often a slot's compiled dependencies are looked through for those, unless
# the disk is below twice the floor.
DEPENDENCY_SWEEPS = 6 * 3600


def free_space(path):
    """The bytes free to this user on the file system holding `path`."""
    space = os.statvfs(path)
    return space.f_bavail * space.f_frsize


def pressure_floor(path, floor):
    """The free space on the file system holding `path` below which slots
    keep less: twice the larger of `floor` and the floor scripts/build-disk-guard
    keeps there by default, 5% of the file system and at most 64 GiB."""
    space = os.statvfs(path)
    return 2 * max(floor, min(64 * GIB, space.f_blocks * space.f_frsize // 20))


def target_directories(slot, pattern):
    """The directories `pattern` names in each profile of the slot's
    target, with or without a `--target` triple: `<profile>/<pattern>` and
    `<triple>/<profile>/<pattern>`."""
    target = glob.escape(os.path.join(slot, "src", "target"))
    return sorted(path for depth in ("*", "*/*")
                  for path in glob.glob(os.path.join(target, depth, pattern))
                  if os.path.isdir(path) and not os.path.islink(path))


def tree_size(path, seen):
    """The bytes the files under `path` hold on disk, counting each inode
    in `seen` once: rustc hard-links a session's files into the next."""
    size = 0
    for directory, names, files in os.walk(path):
        for name in files + names:
            try:
                status = os.lstat(os.path.join(directory, name))
            except OSError:
                continue
            if (status.st_dev, status.st_ino) not in seen:
                seen.add((status.st_dev, status.st_ino))
                size += status.st_blocks * 512
    return size


def in_use(crate):
    """Whether a rustc holds one of the sessions in the incremental
    directory `crate`: it holds an flock(2) on the session's lock file for
    as long as it compiles the crate."""
    for name in os.listdir(crate):
        if not (name.startswith("s-") and name.endswith(".lock")):
            continue
        try:
            with open(os.path.join(crate, name), "rb") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        except OSError:
            pass
    return False


def evict(slot, path):
    """Moves `path` out of the slot's target, in one rename, into the slot's
    `evicted` directory, which nothing builds in: a build never finds part
    of it. REMOVER removes it later."""
    evicted = os.path.join(slot, "evicted")
    os.makedirs(evicted, exist_ok=True)
    os.rename(path, os.path.join(evicted, f"{time.time_ns()}-{os.getpid()}-{os.path.basename(path)}"))


def trim(slot, budget, pressed):
    """Bounds the build output of `slot`, whose lease and `running` lock the
    caller holds, so no build of its own runs there: keeps the incremental
    sessions of the crates its builds compiled most recently until they
    fill `budget` bytes, or a quarter of it when `pressed`, and moves out
    the rest, and every few hours, or at once when `pressed`, compiled
    units no build has looked at for days.
    Returns the bytes moved out. A crate whose session a rustc holds stays,
    whatever started it."""
    if pressed:
        budget //= PRESSED_SHARE
    # A finalized session never changes, and rustc names each new one
    # afresh, so the size of each is measured once, when first seen.
    record = os.path.join(slot, "incremental-sizes")
    try:
        with open(record) as file:
            known = json.load(file)
        if not isinstance(known, dict):
            known = {}
    except (OSError, ValueError):
        known = {}
    measured, crates = {}, []
    for incremental in target_directories(slot, "incremental"):
        for crate in os.scandir(incremental):
            if not crate.is_dir(follow_symlinks=False):
                continue
            size, last, seen = 0, 0.0, set()
            for session in os.scandir(crate.path):
                try:
                    last = max(last, session.stat(follow_symlinks=False).st_mtime)
                except OSError:
                    continue
                if not session.is_dir(follow_symlinks=False):
                    continue
                key = os.path.relpath(session.path, slot)
                if session.name.endswith("-working"):
                    # Being written, or left by a build that was stopped.
                    size += tree_size(session.path, seen)
                    continue
                if not isinstance(known.get(key), int) or known[key] < 0:
                    known[key] = tree_size(session.path, set())
                measured[key] = known[key]
                size += known[key]
            crates.append((last, size, crate.path))
    kept = moved = 0
    # The crates compiled most recently stay until they fill the budget,
    # the one that crosses it included: the next build most likely needs
    # the large session it compiled last. The rest go.
    for last, size, crate in sorted(crates, reverse=True):
        if kept < budget:
            kept += size
            continue
        try:
            if in_use(crate):
                kept += size
                continue
            evict(slot, crate)
        except OSError:
            continue
        moved += size
    # Only a record: on a full disk the trim goes on without it.
    try:
        with open(record + ".new", "w") as file:
            json.dump({key: size for key, size in measured.items()
                       if os.path.isdir(os.path.join(slot, key))}, file)
        os.replace(record + ".new", record)
    except OSError:
        pass
    swept = os.path.join(slot, "dependencies-swept")
    try:
        due = pressed or time.time() - os.stat(swept).st_mtime >= DEPENDENCY_SWEEPS
    except OSError:
        due = True
    # Where reading a file leaves its access time alone, every dependency
    # would look unread.
    if due and not os.statvfs(slot).f_flag & os.ST_NOATIME:
        try:
            moved += sweep_dependencies(slot, time.time() - DEPENDENCY_IDLE)
            open(swept, "a").close()
            os.utime(swept)
        except OSError:
            pass
    return moved


def newest_file(path):
    """The latest time any file under `path` was read or written, and the
    bytes they hold. By its files alone: looking through a directory reads
    it."""
    newest, size = 0.0, 0
    for directory, _names, files in os.walk(path):
        for name in files:
            try:
                status = os.lstat(os.path.join(directory, name))
            except OSError:
                continue
            newest = max(newest, status.st_atime, status.st_mtime)
            size += status.st_blocks * 512
    return newest, size


def sweep_dependencies(slot, cutoff):
    """Moves out of each profile of the slot's target the compiled units
    that no build has looked at since `cutoff`, and returns the bytes moved.
    Cargo reads the fingerprint of every unit in a build's graph, whether
    or not it compiles it, so `.fingerprint/<package>-<hash>` dates a unit:
    the rlib of a build dependency or a compiled build script is read only
    when it is built again, and judged by itself would look unused in a
    lane that builds daily. A stale unit goes with its fingerprint first,
    so one moved out only in part is built again, then with the
    `deps/<crate>-<hash>` files and `build/<package>-<hash>` directory
    sharing its hash. Cargo builds again whatever a build needs of it."""
    moved = 0
    for fingerprints in target_directories(slot, ".fingerprint"):
        profile = os.path.dirname(fingerprints)
        outputs = {}
        for kind in ("deps", "build"):
            try:
                entries = list(os.scandir(os.path.join(profile, kind)))
            except OSError:
                continue
            for entry in entries:
                unit = entry.name.split(".", 1)[0].rpartition("-")[2]
                outputs.setdefault(unit, []).append(entry)
        for entry in os.scandir(fingerprints):
            if not entry.is_dir(follow_symlinks=False):
                continue
            unit = entry.name.rpartition("-")[2]
            newest, size = newest_file(entry.path)
            parts = [(entry.path, size)]
            for output in outputs.get(unit, ()):
                if output.is_dir(follow_symlinks=False):
                    used, held = newest_file(output.path)
                else:
                    try:
                        status = output.stat(follow_symlinks=False)
                    except OSError:
                        continue
                    used, held = max(status.st_atime, status.st_mtime), status.st_blocks * 512
                newest = max(newest, used)
                parts.append((output.path, held))
            if newest >= cutoff:
                continue
            for path, held in parts:
                try:
                    evict(slot, path)
                except OSError:
                    if path == entry.path:
                        break
                    continue
                moved += held
    return moved


# Removes what trim moved out of each slot named after its first argument
# until nothing is left there; nothing else uses any of it, and nothing
# writes there but trim's renames. Unless that argument is "wait", it takes
# turns per slot with the other removers that nothing waits for: the one
# holding a slot's `evicted.lock` takes what is added before it lets go,
# and looks again after. One a build waits for takes no turn: it removes
# beside an idle remover rather than after it, each passing over what the
# other has removed. One that is stopped leaves the rest to the next.
REMOVER = """
import fcntl, os, shutil, sys
def drain(evicted):
    while True:
        try:
            names = os.listdir(evicted)
        except OSError:
            return
        if not names:
            return
        for name in names:
            path = os.path.join(evicted, name)
            if os.path.isdir(path) and not os.path.islink(path):
                shutil.rmtree(path, ignore_errors=True)
                if os.path.lexists(path):
                    sys.exit(1)
            else:
                try:
                    os.unlink(path)
                except FileNotFoundError:
                    pass
                except OSError:
                    sys.exit(1)
def left(evicted):
    try:
        return bool(os.listdir(evicted))
    except OSError:
        return False
waited = sys.argv[1] == "wait"
for slot in sys.argv[2:]:
    evicted = os.path.join(slot, "evicted")
    if waited:
        drain(evicted)
        continue
    while left(evicted):
        with open(os.path.join(slot, "evicted.lock"), "a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                break
            drain(evicted)
"""


def evicted_left(slot):
    """Whether anything trim moved out of `slot` is still there."""
    try:
        return bool(os.listdir(os.path.join(slot, "evicted")))
    except OSError:
        return False


def remove_evicted(slots, wait=False):
    """Removes what trim moved out of `slots` in a session of its own,
    waiting for it only when asked: then it removes everything left there,
    beside any idle removal already under way, at low priority rather than
    idle, which the I/O of running builds could starve."""
    slots = [slot for slot in slots if evicted_left(slot)]
    if not slots:
        return
    lower = [shutil.which("nice") or "nice", "-n", "10" if wait else "19"]
    if shutil.which("ionice"):
        lower += [shutil.which("ionice"), *(("-c2", "-n7") if wait else ("-c3",))]
    remover = subprocess.Popen([*lower, sys.executable, "-c", REMOVER,
                                "wait" if wait else "idle", *slots],
                               cwd="/", stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, start_new_session=True)
    if wait:
        remover.wait()


def trim_free(base, budget, floor, mine=None):
    """Trims each of the slots under `base` but `mine` that no lease holds,
    under its lease and `running` locks, as a lease would; a slot taken
    meanwhile is passed over. Returns each slot it trimmed with the bytes
    it moved out. The lease lock is shared: a lease cannot take the slot
    meanwhile, while a `--hold` whose lease has ended, which takes it
    shared, still finds that it ended. Trims of one slot take turns on its
    `running` lock."""
    trimmed = []
    for index in slot_indices(base):
        slot = os.path.join(base, f"slot-{index}")
        if slot == mine:
            continue
        try:
            lock = open(os.path.join(slot, "lock"), "a")
        except OSError:
            continue
        with lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                continue
            with open(os.path.join(slot, "running"), "a") as running:
                try:
                    fcntl.flock(running, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    continue
                try:
                    moved = trim(slot, budget, free_space(slot) < pressure_floor(slot, floor))
                except OSError:
                    # What it moved out before failing is still to remove.
                    moved = 0
                trimmed.append((slot, moved))
    return trimmed


def available_memory():
    try:
        with open(f"{FIGURES}/meminfo") as file:
            for line in file:
                if line.startswith("MemAvailable:"):
                    return int(line.split()[1]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    return None


def memory_pressure(resource="memory"):
    try:
        with open(f"{FIGURES}/pressure/{resource}") as file:
            for line in file:
                if line.startswith("some "):
                    return float(line.split("avg10=")[1].split()[0])
    except (OSError, ValueError, IndexError):
        pass
    return None


def resident(roots):
    """The resident memory of each process tree rooted at a pid in `roots`."""
    parent, size = {}, {}
    page = os.sysconf("SC_PAGE_SIZE")
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        try:
            with open(f"/proc/{name}/stat") as file:
                fields = file.read().rsplit(")", 1)[1].split()
        except (OSError, IndexError):
            continue
        parent[int(name)] = int(fields[1])
        size[int(name)] = int(fields[21]) * page
    held = dict.fromkeys(roots, 0)
    for pid, rss in size.items():
        node = pid
        while node not in held and node in parent and node > 1:
            node = parent[node]
        if node in held:
            held[node] += rss
    return held


def read_claim(slot):
    try:
        with open(os.path.join(slot, "claim")) as file:
            claimed = json.load(file)
        return claimed if isinstance(claimed, dict) else {}
    except (OSError, ValueError):
        return {}


def claim(slot):
    """What a leased slot's build is expected to need and the process its
    command runs as, once it has started."""
    claimed = read_claim(slot)
    try:
        return int(claimed.get("cost") or LARGEST), claimed.get("pid")
    except (ValueError, TypeError):
        return LARGEST, None


def slot_indices(base):
    """The slots made so far, in order."""
    try:
        names = os.listdir(base)
    except OSError:
        return []
    return sorted(int(name[5:]) for name in names
                  if name.startswith("slot-") and name[5:].isdigit())


def leased(slot):
    """Whether a build holds `slot`."""
    return leased_lock(os.path.join(slot, "lock"))


def leased_lock(path):
    """Whether something holds the lock file at `path` exclusively, as a
    lease or build does. A trim of an idle slot, or a hold's check that its
    lease lasts, holds it shared, and is no build."""
    try:
        with open(path, "a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            fcntl.flock(lock, fcntl.LOCK_UN)
            return False
    except OSError:
        return False


def running_builds(base, mine):
    """The expected cost and holder of every build running beside `mine`."""
    others = []
    for index in slot_indices(base):
        slot = os.path.join(base, f"slot-{index}")
        if slot != mine and leased(slot):
            others.append(claim(slot))
    return others + registered(base)


def room(base, mine, cost):
    """None when a build expected to need `cost` bytes fits beside the builds
    in the other leased slots, as scripts/cargo-gate admits builds on its
    host: the memory available now, less what those builds are expected to
    take beyond what they already hold, covers it, and neither the memory nor
    the CPUs are under pressure. A lone build always fits. Otherwise why it
    waits."""
    others = running_builds(base, mine)
    if not others:
        return None
    pressure = memory_pressure()
    if pressure is not None and pressure >= MEMORY_PRESSURE_LIMIT:
        return f"pressure {pressure:.0f} {MEMORY_PRESSURE_LIMIT}"
    pressure = memory_pressure("cpu")
    if pressure is not None and pressure >= CPU_PRESSURE_LIMIT:
        return f"cpu {pressure:.0f} {CPU_PRESSURE_LIMIT}"
    available = available_memory()
    if available is None:
        return None
    held = resident([pid for _, pid in others if isinstance(pid, int)])
    outstanding = sum(max(0, need - held.get(pid, 0)) for need, pid in others)
    if available - outstanding >= cost:
        return None
    return f"memory {max(0, available - outstanding) / GIB:.1f} {cost / GIB:.1f} {len(others)}"


# The marks a running build's processes carry in their environment, into
# whatever session they move: the gate whose slot a scripts/cargo-gate
# command holds, and the slot an offloaded command runs in.
HELD_MARK = "CAGENTS_BUILD_SLOT_HELD"
SLOT_MARK = "CAGENTS_OFFLOAD_SLOT"
Process = collections.namedtuple("Process", "parent session terminal own reaped start name")


def process_table():
    """Each process's parent, session, CPU ticks of its own and of the
    children it has reaped, start in ticks since boot, and name."""
    table = {}
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        try:
            with open(f"/proc/{name}/stat") as file:
                head, rest = file.read().rsplit(")", 1)
            # proc(5)'s fields 4, 6, 7, 14 to 17 and 22, counted from field 3.
            fields = rest.split()
            table[int(name)] = Process(
                int(fields[1]), int(fields[3]), int(fields[4]), int(fields[11]) + int(fields[12]),
                int(fields[13]) + int(fields[14]), int(fields[19]), head.partition("(")[2])
        except (OSError, ValueError, IndexError):
            continue
    return table


def lock_holders(paths):
    """Which processes hold a flock(2) lock on each of the files at `paths`,
    by resolved path. The kernel lists a lock under every descriptor sharing
    it, so this finds a holder that inherited the lock from a process long
    gone, as one whose `flock` helper took it on a shared descriptor.
    /proc/locks names only the process that took a lock, and a file by an
    inode whose device on btrfs is not the one stat reports: it is consulted
    only for a lock whose holder's descriptors this user cannot read."""
    wanted = {}
    for path in paths:
        try:
            wanted[os.path.realpath(path)] = os.stat(path).st_ino
        except OSError:
            pass
    held = {}
    if not wanted:
        return held
    unreadable = set()
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        directory = f"/proc/{name}/fd"
        try:
            descriptors = os.listdir(directory)
        except PermissionError:
            unreadable.add(int(name))
            continue
        except OSError:
            continue
        for descriptor in descriptors:
            try:
                # Only once the path matches: another descriptor may be on a stuck mount.
                target = os.readlink(f"{directory}/{descriptor}")
                if target not in wanted or os.stat(f"{directory}/{descriptor}").st_ino != wanted[target]:
                    continue
                with open(f"/proc/{name}/fdinfo/{descriptor}") as file:
                    info = file.read()
            except OSError:
                continue
            if any(line.startswith("lock:") and "FLOCK" in line for line in info.splitlines()):
                held.setdefault(target, set()).add(int(name))
    if unreadable:
        try:
            with open("/proc/locks") as file:
                lines = file.read().splitlines()
        except OSError:
            lines = []
        inodes = {inode: path for path, inode in wanted.items() if path not in held}
        for line in lines:
            # "1: FLOCK ADVISORY WRITE PID MAJOR:MINOR:INODE 0 EOF"; a request
            # still waiting has "->" before FLOCK, and holds nothing.
            fields = line.split()
            try:
                pid, inode = int(fields[4]), int(fields[5].rsplit(":", 1)[1])
            except (ValueError, IndexError):
                continue
            if fields[1] == "FLOCK" and pid in unreadable and inode in inodes:
                held.setdefault(inodes[inode], set()).add(pid)
    return held


def recorded_builds():
    """The holder and lock of each build this host's registry records."""
    found = []
    try:
        names = os.listdir(REGISTRY) if REGISTRY else []
    except OSError:
        return found
    for name in names:
        if not name.startswith(("gate-", "offload-")) or name.endswith(".new"):
            continue
        try:
            with open(os.path.join(REGISTRY, name)) as file:
                first, _since, lock = (file.read().splitlines() + ["", "", ""])[:3]
            found.append((int(first.split()[0]), lock))
        except (OSError, ValueError, IndexError):
            continue
    return found


def host_cpus():
    """The CPUs the whole host's pressure is over."""
    return os.cpu_count() or 1


def cpu_count(amount):
    figure = f"{amount:.1f}"
    return f"{figure} CPU" if figure == "1.0" else f"{figure} CPUs"


def busiest(pids=(), locks=(), interval=1.0, shown=None, there=False, bounded=None):
    """What holds this host's CPUs besides its running builds, as a clause:
    how many CPUs the builds and everything else use, and which process
    sessions outside the builds use the most, over about `interval` seconds.
    A session is what one login, ssh command or terminal started, so a
    runaway loop and the children it keeps starting count together.

    A build is everything below a process in `pids`, below the holder of a
    lock in `locks`, or below one the registry records while its lock is
    held; and any process carrying a running build's mark in its
    environment, or working in a running offloaded build's slot, as its file
    copies do. The marks follow a build's processes into sessions of their
    own. What both leaves the build's process tree and clears its
    environment or leaves its slot is counted as not a build, as is anything
    a plain `flock` holder's command detaches, which carries no mark.
    `there` is for a caller on another host; `bounded` is a scripts/bounded
    to point at."""
    recorded = recorded_builds()
    # scripts/cargo-gate's slots in their default place, wherever their
    # holder came from, as a plain `flock` on the build host. A slot family
    # has a queue beside its first slot; other locks there, such as a native
    # session's, are not builds.
    gate_slots = [path for path in glob.glob("/var/tmp/cagents-*.lock*")
                  if (match := re.fullmatch(r"(.*\.lock)(?:\.[0-9]+)?", path))
                  and os.path.isfile(match[1] + ".queue")]
    held = lock_holders([*locks, *(lock for _, lock in recorded), *gate_slots])
    roots = {pid for pid in pids if pid > 0}.union(*held.values())
    roots |= {pid for pid, lock in recorded if pid > 0 and os.path.realpath(lock) in held}
    # An offloaded build's lock is `lock` in its slot, where its files are.
    # What a lease's build does in its slot starts after the lease took it:
    # an older process with the slot's mark or in its directory is left from
    # an earlier build.
    slots = {}
    for lock, holders in held.items():
        if os.path.basename(lock) == "lock" and os.path.basename(os.path.dirname(lock)).startswith("slot-"):
            starts = [start_time(pid) for pid in holders]
            slots[os.path.dirname(lock)] = min((start for start in starts if start is not None), default=0)

    # Each process is read about midway through its scan.
    began = time.monotonic()
    first = process_table()
    scanned = time.monotonic()
    time.sleep(interval)
    resumed = time.monotonic()
    second = process_table()
    elapsed = max(1e-3, (resumed + time.monotonic() - began - scanned) / 2)
    ticks = os.sysconf("SC_CLK_TCK")

    # A process's own ticks and those of the children it reaped meanwhile,
    # where a loop of short-lived commands spends its time. A process that
    # ended within the sample brought its whole life's ticks to whichever
    # ancestor outlived it, through any that ended too, so what it had used
    # before the sample comes off that ancestor again.
    def alive(pid):
        before, after = first.get(pid), second.get(pid)
        return before is not None and after is not None and before.start == after.start
    before_sample = collections.Counter()
    for pid, before in first.items():
        if alive(pid):
            continue
        ancestor, steps = before.parent, 0
        while ancestor > 1 and ancestor in first and not alive(ancestor) and steps < 128:
            ancestor, steps = first[ancestor].parent, steps + 1
        before_sample[ancestor] += before.own + before.reaped
    # Whatever is misattributed, as to a subreaper that took a child over
    # meanwhile, no process uses more than every CPU.
    cpus = host_cpus()
    used = {}
    for pid, after in second.items():
        spent = after.own + after.reaped
        before = first.get(pid)
        # One that started within the sample used nothing before it.
        if before is not None and before.start == after.start:
            spent -= before.own + before.reaped + before_sample[pid]
        used[pid] = min(cpus, max(0, spent) / ticks / elapsed)

    def marks(pid, names=(HELD_MARK, SLOT_MARK)):
        try:
            with open(f"/proc/{pid}/environ", "rb") as file:
                entries = file.read().split(b"\0")
        except OSError:
            return {}
        found = {}
        for entry in entries:
            key, _, value = entry.decode(errors="replace").partition("=")
            if key in names:
                found[key] = value
        return found

    def builds_itself(pid):
        if pid in roots:
            return True
        found = marks(pid)
        holder = found.get(HELD_MARK, "")
        if holder.isdigit() and int(holder) in roots:
            return True
        entry = second.get(pid) or first.get(pid)
        def current(slot):
            return entry is not None and entry.start >= slots[slot]
        if found.get(SLOT_MARK) in slots and current(found[SLOT_MARK]):
            return True
        try:
            directory = os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            return False
        return any((directory == slot or directory.startswith(slot + "/")) and current(slot)
                   for slot in slots)

    verdicts = {}
    def in_build(pid):
        chain, verdict = [], False
        while pid > 1 and len(chain) < 128:
            if pid in verdicts:
                verdict = verdicts[pid]
                break
            chain.append(pid)
            if builds_itself(pid):
                verdict = True
                break
            entry = second.get(pid) or first.get(pid)
            if entry is None:
                break
            pid = entry.parent
        for link in chain:
            verdicts[link] = verdict
        return verdict

    builds = others = 0.0
    sessions = {}
    for pid, share in used.items():
        if share <= 0 or pid == os.getpid():
            continue
        if in_build(pid):
            builds += share
            continue
        others += share
        # Session 0 is the kernel's own threads.
        session = second[pid].session
        total, top = sessions.get(session, (0.0, (0.0, pid)))
        sessions[session] = (total + share, max(top, (share, pid)))

    def command_of(pid):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as file:
                words = file.read().split(b"\0")
            words = [word.decode(errors="replace") for word in words if word]
            # The program by its name, which a long path would push out.
            if words and "/" in words[0]:
                words[0] = os.path.basename(words[0]) or words[0]
            text = " ".join(words)
        except OSError:
            text = ""
        if not text.strip():
            # Ended since, or a kernel thread: the name it was sampled with.
            entry = first.get(pid) or second.get(pid)
            text = entry.name if entry else "?"
        # On one line, and printable, whatever a command or name holds: an
        # escape sequence in one must not reach the terminal showing it.
        text = "".join(char if char.isprintable() else " " for char in text)
        text = " ".join(text.split()) or "?"
        return (text[:60] + "...") if len(text) > 63 else text

    def age_of(pid):
        try:
            with open("/proc/uptime") as file:
                up = float(file.read().split()[0])
        except (OSError, ValueError, IndexError):
            return "?"
        entry = second.get(pid) or first.get(pid)
        if entry is None:
            return "?"
        seconds = max(0, int(up - entry.start / ticks))
        if seconds >= 86400:
            return f"{seconds // 86400}d{seconds % 86400 // 3600}h"
        if seconds >= 3600:
            return f"{seconds // 3600}h{seconds % 3600 // 60}m"
        if seconds >= 60:
            return f"{seconds // 60}m"
        return f"{seconds}s"

    # The sessions of this process and of everything that started it, such
    # as the agent whose command waits: none of them is a workload to end.
    callers, pid = {os.getsid(0)}, os.getpid()
    while pid > 1 and pid in second and len(callers) < 128:
        callers.add(second[pid].session)
        pid = second[pid].parent
    install = os.path.realpath(os.path.expanduser("~/.local/share/cagents-install"))
    def cagents_own(pid):
        """Whether `pid` is cagents itself, such as the daemon hosting every
        terminal and agent: installed, or by its executable's name."""
        try:
            executable = os.readlink(f"/proc/{pid}/exe").removesuffix(" (deleted)")
        except OSError:
            entry = second.get(pid)
            return entry is not None and entry.name in ("cagentsd", "cagents-ui", "cagents")
        return (executable.startswith(install + "/")
                or os.path.basename(executable) in ("cagentsd", "cagents-ui", "cagents"))

    def risky(session, top):
        """Why ending `session` whole may end more than a workload, or None.
        No hint offers to end the session of cagents itself, of this wait or
        of what started it, such as the agent waiting, nor the system's, a
        desktop's or a terminal's."""
        if session in callers:
            return "the one this wait runs in"
        if session == 1:
            return "the system's own"
        if any(entry.session == session and cagents_own(pid) for pid, entry in second.items()):
            return "cagents' own"
        leader = second.get(session)
        alive = leader is not None and leader.session == session
        # A daemon's leader has exited; what it runs still says where it came from.
        found = marks(session if alive else top, ("XDG_SESSION_TYPE",))
        if found.get("XDG_SESSION_TYPE") in ("wayland", "x11", "mir"):
            return "one started from the desktop"
        if alive and leader.terminal:
            return "a terminal's"
        return None

    def members(session):
        # Builds in it too: ending the session ends them as well.
        return sum(1 for pid, entry in second.items() if entry.session == session and pid != os.getpid())

    # More, and less busy, for tests whose own load must show however busy
    # their host is.
    try:
        shown = shown or max(1, int(os.environ.get("CAGENTS_OFFLOAD_BUSIEST_SHOWN") or 3))
    except ValueError:
        shown = 3
    try:
        least = float(os.environ.get("CAGENTS_OFFLOAD_BUSIEST_LEAST") or 0.5)
    except ValueError:
        least = 0.5
    if not 0 <= least < float("inf"):
        least = 0.5
    ranked = sorted(sessions.items(), key=lambda item: -item[1][0])
    named = [item for item in ranked[:shown] if item[1][0] >= least]
    rest = ranked[len(named):]
    totals = f"builds use {cpu_count(builds)} and everything else {cpu_count(others)}"
    if not named:
        if others < max(1.0, builds / 4):
            # Pressure is a ten-second average, so a wait can follow a burst
            # that has since ended: builds hold the CPUs only when, with the
            # rest, they keep at least half of them busy.
            if builds >= max(0.5, others) and builds + others >= cpus / 2:
                return f"nothing else uses much; the running builds hold them: {totals}"
            return f"nothing uses much at the moment: {totals}, of {cpus} in all"
        least_text = "half a CPU" if least == 0.5 else cpu_count(least)
        return f"{totals}, though no session outside them uses {least_text}"
    parts = []
    for session, (total, (_, top)) in named:
        if session == 0:
            parts.append(f"the kernel's own threads: {cpu_count(total)}")
            continue
        count = members(session)
        processes = f"{count} process{'es' if count != 1 else ''}"
        leader = second.get(session)
        if leader is not None and leader.session == session:
            part = (f"session {session} ({command_of(session)}, started {age_of(session)} ago): "
                    f"{cpu_count(total)} in {processes}")
            if top != session:
                part += f", most in pid {top} ({command_of(top)})"
        else:
            part = (f"session {session}, whose leader has exited: {cpu_count(total)} in "
                    f"{processes}, most in pid {top} ({command_of(top)}, started {age_of(top)} ago)")
        parts.append(part)
    text = f"{totals}; besides builds, the CPUs go to " + "; ".join(parts)
    if rest:
        more = sum(total for _, (total, _) in rest)
        text += f"; and {len(rest)} more session{'s' if len(rest) != 1 else ''} using {cpu_count(more)}"
    where = " there" if there else ""
    first_session, first_top = next(((session, top) for session, (_, (_, top)) in named if session != 0),
                                    (None, None))
    if first_session is not None:
        why = risky(first_session, first_top)
        if why is None:
            text += (f". `ps -s {first_session}`{where} lists session {first_session}'s processes, "
                     f"and `pkill -s {first_session}` ends them")
        else:
            text += (f". Session {first_session} is {why}: `ps -s {first_session}`{where} "
                     f"lists its processes, to end only what you recognise")
    if bounded:
        text += f"; `{bounded} --list` shows the workloads bounded to their session"
    return text


# Where this host's builds record themselves, whichever slot family runs
# them: scripts/cargo-gate's shared families here and these offloaded slots
# each price the others' running builds beside their own. Empty disables it;
# tests standing in for the build host name a private one.
REGISTRY = os.environ.get("CAGENTS_BUILD_REGISTRY", f"/var/tmp/cagents-builds-{os.getuid()}")


class deciding:
    """Holds the host's admission decision, which scripts/cargo-gate's
    families take too, while this build is priced and recorded."""

    def __enter__(self):
        self.lock = None
        if REGISTRY:
            try:
                os.makedirs(REGISTRY, mode=0o700, exist_ok=True)
                self.lock = open(os.path.join(REGISTRY, ".decision"), "a")
                fcntl.flock(self.lock, fcntl.LOCK_EX)
            except OSError:
                self.lock = None
        return self

    def __exit__(self, *_exception):
        if self.lock is not None:
            self.lock.close()


# Once refused room this long, the build refused longest on the host starts
# beside the running builds whatever their memory, as scripts/cargo-gate
# admits its own: while a build admitted that way may still be ramping up,
# none other is. This host's setting, as the gate reads its own.
try:
    WAIT_PRIORITY = max(0, int(os.environ.get("CAGENTS_BUILD_WAIT_PRIORITY_SECS") or 120))
except ValueError:
    WAIT_PRIORITY = 120
# How recently a waiting build must have been refused room to keep its place,
# and how long a build admitted as overdue keeps the next one waiting.
WAIT_FRESH = 10
OVERDUE_RAMP = 600


def registry_entry(slot, kind="offload-"):
    # One spelling of the slot, however the path that leased or ran it read.
    slot = os.path.realpath(slot)
    return os.path.join(REGISTRY, kind + hashlib.sha256(os.fsencode(slot)).hexdigest()[:16])


def write_record(entry, text):
    with open(entry + ".new", "w") as file:
        file.write(text)
    os.replace(entry + ".new", entry)


def register(slot, cost, pid, overdue=None):
    """Records the build in `slot` as the gate records its own: its holder,
    expected cost in KiB, start in seconds since boot, the lock it holds and
    whether it was admitted as overdue. `overdue` None keeps the record's."""
    if not REGISTRY:
        return
    entry = registry_entry(slot)
    if overdue is None:
        try:
            with open(entry) as file:
                overdue = (file.read().splitlines() + [""] * 4)[3] == "overdue"
        except OSError:
            overdue = False
    try:
        os.makedirs(REGISTRY, mode=0o700, exist_ok=True)
        since = uptime()
        lock = os.path.join(os.path.realpath(slot), "lock")
        write_record(entry, f"{pid or 0} {cost // 1024}\n{since}\n{lock}\n"
                            f"{'overdue' if overdue else ''}\n")
    except OSError:
        pass


def reprice(slot, cost):
    """Prices the command running in `slot` at `cost` for builds deciding
    from now on, in its claim and its host record, keeping the record's
    start and overdue mark."""
    claimed = read_claim(slot)
    claimed["cost"] = cost
    with open(os.path.join(slot, "claim.new"), "w") as file:
        json.dump(claimed, file)
    os.replace(os.path.join(slot, "claim.new"), os.path.join(slot, "claim"))
    if not REGISTRY:
        return
    entry = registry_entry(slot)
    try:
        with open(entry) as file:
            lines = file.read().splitlines()
        pid = lines[0].split()[0]
        lines[0] = f"{pid} {cost // 1024}"
        write_record(entry, "\n".join(lines) + "\n")
    except (OSError, IndexError):
        pass


# Programs that compile, link or drive a native build. While one runs in a
# command's session, the command is building.
COMPILER = re.compile(r"(?:.+-)?(?:rustc|rustdoc|cc|c\+\+|gcc|g\+\+|clang|clang\+\+|cc1|cc1plus"
                      r"|cc1obj|collect2|ld|ld\.[a-z]+|lld|mold|as|ar|zig|cmake|make|gmake|ninja)"
                      r"(?:-[0-9][0-9.]*)?")
# How often a running command's phase is looked at, and the least a test run
# is priced at. The variables are for tests standing in for the build host;
# ssh does not pass them on.
PHASE_INTERVAL = float(os.environ.get("CAGENTS_OFFLOAD_PHASE_INTERVAL") or 2)
TEST_LEAST = int(os.environ.get("CAGENTS_OFFLOAD_TEST_LEAST_BYTES") or LEAST)


def session_phase(session):
    """"build" while a process in `session` compiles or runs a build script,
    "test" while one instead runs an executable Cargo built into a `deps`
    directory (a test harness, benchmark, or what they start beside it), and
    None while neither does: Cargo between steps, or the command ending."""
    testing = False
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        try:
            with open(f"/proc/{name}/stat") as file:
                fields = file.read().rsplit(")", 1)[1].split()
            if int(fields[3]) != session:
                continue
            executable = os.readlink(f"/proc/{name}/exe")
        except (OSError, ValueError, IndexError):
            continue
        executable = executable.removesuffix(" (deleted)")
        directory, program = os.path.split(executable)
        if COMPILER.fullmatch(program) or program.startswith(("build-script-", "build_script_")):
            return "build"
        if os.path.basename(directory) == "deps":
            testing = True
    return "test" if testing else None


def price_by_phase(slot, cost, session, ended):
    """Prices the command in `slot`, whose processes form `session`, by its
    phase. Cargo runs tests only once it has built everything they need, and
    a test run needs what its tests hold, not what compiling them did: while
    it tests, the command is priced at the most its processes have held
    since its tests began, as sampled each pass, and never below the least
    any build is priced at. Builds the host admits meanwhile then take memory
    the compile no longer reserves, while what the tests do hold stays
    counted, however much that is; growth beyond that peak is not reserved,
    as tests run by the gate here are not, and the host's memory pressure
    holds further builds back. When it compiles again, as doctests do, it is
    priced as a build. Once `ended` is set, the slot is priced as a build
    again, for whatever builds in it next under the same lease, and pricing
    stops."""
    priced, peak, repriced = cost, 0, False
    while not ended.wait(PHASE_INTERVAL):
        try:
            phase = session_phase(session)
            if phase == "test":
                peak = max(peak, resident([os.getpid()]).get(os.getpid(), 0))
                price = max(TEST_LEAST, peak)
            elif phase == "build":
                price = cost
            else:
                continue
            # Small changes in what the tests hold are not worth rewriting for.
            if price != priced and (price == cost or priced == cost
                                    or abs(price - priced) >= 64 * 2**20):
                repriced = True
                reprice(slot, price)
                priced = price
        except Exception:
            # Repricing never ends a command. A failed pass, such as a claim
            # the full disk could not take, is tried again at the next.
            continue
    # Even a pass that failed partway may have changed the claim.
    if repriced:
        try:
            reprice(slot, cost)
        except Exception:
            pass


def start_time(pid):
    """When process `pid` started, in clock ticks since boot, or None."""
    try:
        with open(f"/proc/{pid}/stat") as file:
            return int(file.read().rsplit(")", 1)[1].split()[19])
    except (OSError, ValueError, IndexError):
        return None


def uptime():
    """Seconds since boot, which the wall clock's steps cannot reorder."""
    with open("/proc/uptime") as file:
        return int(float(file.read().split()[0]))


def record_refusal(slot, since, now, priority="normal"):
    """Records the build in `slot` as refused room since `since` and again at
    `now`, so that another family's build can tell which of them has been
    refused longest."""
    if REGISTRY:
        try:
            pid = os.getpid()
            write_record(registry_entry(slot, "wait-offload-"),
                         f"{pid} {start_time(pid)} {since} {now}\n{priority}\n")
        except OSError:
            pass


def forget_wait(slot):
    if REGISTRY:
        try:
            os.unlink(registry_entry(slot, "wait-offload-"))
        except OSError:
            pass


def overdue(slot, since, priority="normal"):
    """Whether the build in `slot`, refused room since `since`, has been
    refused for the priority time, longer than every other build refused on
    the host now, and no build admitted that way may still be ramping up."""
    if not REGISTRY or WAIT_PRIORITY <= 0:
        return False
    now = uptime()
    if now - since < WAIT_PRIORITY:
        return False
    mine, pid = registry_entry(slot, "wait-offload-"), os.getpid()
    try:
        names = os.listdir(REGISTRY)
    except OSError:
        return False
    for name in names:
        path = os.path.join(REGISTRY, name)
        if name.endswith(".new"):
            continue
        try:
            with open(path) as file:
                text = file.read().splitlines() + [""] * 4
        except OSError:
            continue
        if name.startswith("wait-") and path != mine:
            try:
                other, started, other_since, last = (int(field) for field in text[0].split())
            except ValueError:
                continue
            rank = lambda value: 0 if value == "urgent" else 1
            if (now - last <= WAIT_FRESH and now - other_since >= WAIT_PRIORITY
                    and (rank(text[1]), other_since, other) < (rank(priority), since, pid)
                    and start_time(other) == started):
                return False
        elif name.startswith(("gate-", "offload-")) and text[3] == "overdue":
            try:
                holder = int(text[0].split()[0])
                started = int(text[1])
            except (ValueError, IndexError):
                continue
            if (now - started < OVERDUE_RAMP
                    and (holder == 0 or os.path.exists(f"/proc/{holder}"))
                    and os.path.isfile(text[2]) and leased_lock(text[2])):
                return False
    return True


def registered(base):
    """The expected cost and holder of each running build that another slot
    family on this host recorded: one whose record's lock is held."""
    found = []
    try:
        names = os.listdir(REGISTRY) if REGISTRY else []
    except OSError:
        return found
    for name in names:
        if name.startswith(".") or name.endswith(".new"):
            continue
        try:
            with open(os.path.join(REGISTRY, name)) as file:
                first, _since, lock = (file.read().splitlines() + ["", "", ""])[:3]
            pid, kib = (int(field) for field in first.split())
        except (OSError, ValueError):
            continue
        if not name.startswith(("gate-", "offload-")):
            continue
        if not lock or os.path.commonpath([os.path.realpath(base), os.path.realpath(lock)]) == os.path.realpath(base):
            continue
        # Opening anything but a regular file could fail or block.
        if not os.path.isfile(lock) or not leased_lock(lock):
            continue
        if pid == 0:
            # An offloaded build whose command has not started: its cost.
            found.append((kib * 1024, None))
        elif os.path.exists(f"/proc/{pid}"):
            found.append((kib * 1024, pid))
        else:
            # Its holder has exited: priced as unknown, the largest cost.
            found.append((LARGEST, None))
    return found


def enclosing_checkout(path):
    """A Git marker above `path`, under which tests that check Git ancestry
    fail, or None."""
    while path != os.path.dirname(path):
        path = os.path.dirname(path)
        if os.path.lexists(os.path.join(path, ".git")):
            return os.path.join(path, ".git")
    return None

if command == "lease":
    slots, key, floor = int(sys.argv[3]), sys.argv[4], int(sys.argv[5]) * 2**30
    profiles = sys.argv[6]
    cost = max(LEAST, int(sys.argv[7]) if len(sys.argv) > 7 and sys.argv[7] else LARGEST)
    # The checkout and Cargo command this build is: another request for the
    # same one waits for its slot rather than build it again elsewhere.
    build = sys.argv[8] if len(sys.argv) > 8 else ""
    priority = sys.argv[10] if len(sys.argv) > 10 else "normal"
    if priority not in ("normal", "urgent"):
        sys.exit("CAGENTS_BUILD_PRIORITY must be normal or urgent")
    # The most incremental compilation state the slot keeps, in GiB.
    budget = int(sys.argv[9]) * GIB if len(sys.argv) > 9 and sys.argv[9] else INCREMENTAL_BUDGET
    os.makedirs(base, exist_ok=True)
    leases = []
    waiting_for = None
    def release():
        # The next build in this slot starts only once this one's command
        # has ended, however this host's side of it was stopped.
        if leases:
            with open(os.path.join(leases[0], "running"), "a") as running:
                fcntl.flock(running, fcntl.LOCK_EX)
            try:
                os.unlink(registry_entry(leases[0]))
            except OSError:
                pass
            forget_wait(leases[0])
        os._exit(0)
    until_closed(release)
    # Waiters line up on a queue lock, and the one at its head takes the
    # first slot that frees.
    # Tests cannot run faithfully under a stray Git marker; the caller learns
    # of one before waiting for a slot.
    marker = enclosing_checkout(temporary_directory(os.path.join(base, "slot-0")))
    if marker:
        say("marker", json.dumps(marker))
    announced = False
    def join_queue():
        global announced
        queue = open(os.path.join(base, "queue"), "a")
        try:
            fcntl.flock(queue, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            say("wait")
            announced = True
            fcntl.flock(queue, fcntl.LOCK_EX)
        return queue
    queue = join_queue()
    def owner(index):
        try:
            with open(os.path.join(base, f"slot-{index}", "owner")) as file:
                return file.read().strip()
        except OSError:
            return ""
    # This checkout's last slot, then one another checkout built in, whose
    # compiled dependencies it shares, then an empty one. Up to `slots` are
    # made, each only while the disk holds another build's output beside the
    # floor; how many build at once is then down to memory and CPU, below.
    def built(index):
        return os.path.isdir(os.path.join(base, f"slot-{index}", "src", "target"))
    def free():
        stat = os.statvfs(base)
        return stat.f_bavail * stat.f_frsize
    def candidates():
        existing = slot_indices(base)
        # The same build, running: once it ends, this one has nothing left
        # to compile in its slot.
        def claimed(index):
            return read_claim(os.path.join(base, f"slot-{index}"))
        same = [index for index in existing
                if build and claimed(index).get("build") == build
                and claimed(index).get("key") == key and leased(os.path.join(base, f"slot-{index}"))]
        if same:
            return same, "same"
        indices = existing[:]
        # The first slot is always made; the disk floor below governs it. A
        # further one needs room for its build output beyond what the slots
        # made lately have yet to take as they fill.
        def growing(index):
            try:
                made = os.stat(os.path.join(base, f"slot-{index}", "made")).st_mtime
            except OSError:
                return False
            return time.time() - made < SLOT_FILLS
        pending = SLOT_DISK * sum(1 for index in existing if growing(index))
        if not existing or len(existing) < slots and free() - floor - pending >= SLOT_DISK:
            indices.append(max(existing, default=-1) + 1)
        return sorted(indices, key=lambda index: (owner(index) != key, not built(index), index)), None
    while True:
        order, why = candidates()
        if why != "same" and queue.closed:
            # The build it waited for has ended: back in line, behind the
            # builds that went on meanwhile.
            queue = join_queue()
            order, why = candidates()
        # A slot is taken only from the head of the queue: one that waited
        # for the same build, once it ends, gets back in line first.
        for index in order if why != "same" else ():
            slot = os.path.join(base, f"slot-{index}")
            if not os.path.isdir(slot):
                os.makedirs(os.path.join(slot, "src"), exist_ok=True)
                open(os.path.join(slot, "made"), "a").close()
            os.makedirs(os.path.join(slot, "src"), exist_ok=True)
            lock = open(os.path.join(slot, "lock"), "a")
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                lock.close()
                continue
            break
        else:
            if why == "same":
                # Out of the queue meanwhile, which other builds go on through.
                queue.close()
                if waiting_for != why:
                    say("wait same")
                    announced = True
                    waiting_for = why
            elif not announced:
                say("wait")
                announced = True
            time.sleep(0.5)
            continue
        break
    leases.append(slot)
    # What this build is, at once, so that builds deciding meanwhile price it
    # and do not take it for a build it is not.
    with open(os.path.join(slot, "claim.new"), "w") as file:
        json.dump({"cost": cost, "pid": None, "build": build, "key": key}, file)
    os.replace(os.path.join(slot, "claim.new"), os.path.join(slot, "claim"))
    # At the head of the queue: the build starts once the memory it is
    # expected to need is free beside the builds already running here.
    waiting = None
    refused_since = refused_last = None
    while True:
        # Recorded only once admitted, and in the same decision, so that the
        # host's other slot families neither miss it nor count it waiting.
        with deciding():
            why = room(base, slot, cost)
            late = (why is not None and refused_since is not None
                    and uptime() - refused_last <= WAIT_FRESH and overdue(slot, refused_since, priority))
            if why is None or late:
                register(slot, cost, None, overdue=late)
                forget_wait(slot)
                break
            now = uptime()
            if refused_since is None or now - refused_last > WAIT_FRESH:
                refused_since = now
            refused_last = now
            record_refusal(slot, refused_since, now, priority)
        if why.split()[0] != waiting:
            if why.startswith("cpu "):
                # Named once, as the wait starts, outside the decision:
                # sampling takes a second.
                holders = [pid for _, pid in running_builds(base, slot) if isinstance(pid, int)]
                locks = [os.path.join(base, f"slot-{index}", "lock") for index in slot_indices(base)
                         if os.path.join(base, f"slot-{index}") != slot]
                # Naming them never ends a lease, nor holds it up for long:
                # reading a process stuck on a hung mount can block.
                culprits = []
                def sample():
                    try:
                        culprits.append(busiest(holders, locks, there=True))
                    except Exception:
                        pass
                sampler = threading.Thread(target=sample, daemon=True)
                sampler.start()
                sampler.join(10)
                if culprits:
                    why = f"{why} -- {culprits[0]}"
            say("wait", why)
            announced = True
            waiting = why.split()[0]
        time.sleep(1)
    queue.close()
    # A previous build's command or prune may outlive its lease's
    # connection; nothing in the slot changes until it has ended.
    with open(os.path.join(slot, "running"), "a") as running:
        try:
            fcntl.flock(running, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if not announced:
                say("wait")
                announced = True
            fcntl.flock(running, fcntl.LOCK_EX)
    # Before this build adds to it, the slot keeps only the build output its
    # builds used last within its budget; below twice the floor, so does
    # every slot no lease holds. The removal itself goes on after.
    pressed = free() < pressure_floor(base, floor)
    if not announced:
        # Measuring sessions it has not seen before may take a while.
        slow = threading.Timer(5, say, ("wait", "trim"))
        slow.daemon = True
        slow.start()
    trimmed = [slot]
    try:
        trim(slot, budget, pressed)
        if pressed:
            trimmed += [other for other, _ in trim_free(base, budget, floor, mine=slot)]
    except OSError:
        pass
    if not announced:
        slow.cancel()
        slow.join()
    if free() < floor:
        # What it moved out may be enough.
        say("wait")
        announced = True
        remove_evicted(trimmed, wait=True)
    else:
        remove_evicted(trimmed)
    if free() < floor:
        # This slot's build output is the one this build may discard.
        say("wait")
        shutil.rmtree(os.path.join(slot, "src", "target"), ignore_errors=True)
        if free() < floor:
            say("refuse", free() // 2**30, sys.argv[5])
            sys.exit(0)
    # Gates from before copies were compared by content keep each file's
    # time from the calling host, under which the slot can hold a build of
    # other sources than its copy has. They lease the slot without this
    # marker, which records when this kind of gate last wrote the owner: when
    # it is missing or another lease wrote the owner since, every source file
    # is new to Cargo once.
    owner = os.path.join(slot, "owner")
    marker = os.path.join(slot, "synced-by-content")
    def stamp():
        try:
            return str(os.stat(owner).st_mtime_ns)
        except OSError:
            return ""
    try:
        with open(marker) as file:
            current = file.read().strip() == stamp() != ""
    except OSError:
        current = False
    if not current:
        now = time.time()
        for directory, names, files in os.walk(os.path.join(slot, "src")):
            names[:] = [name for name in names if name != "target"]
            for name in files:
                try:
                    os.utime(os.path.join(directory, name), (now, now), follow_symlinks=False)
                except OSError:
                    pass
    with open(owner, "w") as file:
        file.write(key + "\n")
    with open(marker, "w") as file:
        file.write(stamp() + "\n")
    # Files a command's settings name on the calling host, copied in beside
    # the checkout: from the checkout's ignored files, or its target.
    for kind in ("checkout", "target"):
        os.makedirs(os.path.join(slot, "inputs", kind), exist_ok=True)
    config = os.path.join(slot, ".cargo", "config.toml")
    os.makedirs(os.path.dirname(config), exist_ok=True)
    try:
        current = open(config).read()
    except OSError:
        current = None
    if current != profiles:
        with open(config + ".new", "w") as file:
            file.write(profiles)
        os.replace(config + ".new", config)
    say("slot", json.dumps({"index": index, "path": os.path.realpath(slot)}))
    while True:
        time.sleep(3600)

elif command == "prune":
    # Removes the slot checkout's files that are not in the list on standard
    # input, keeping Cargo's target directory.
    source = os.path.join(base, "src")
    keep = set(filter(None, sys.stdin.buffer.read().split(b"\0")))
    # A cancelled build's lease is released only after this ends, as after a
    # command, so the next build's copy cannot lose files to this walk.
    running = open(os.path.join(base, "running"), "a")
    fcntl.flock(running, fcntl.LOCK_EX)
    keep_dirs = {b"."}
    for path in keep:
        parts = path.split(b"/")
        for depth in range(1, len(parts)):
            keep_dirs.add(b"/".join(parts[:depth]))
    root = os.fsencode(source)
    directories = []
    for directory, names, files in os.walk(root, topdown=True):
        relative = os.path.relpath(directory, root)
        if relative == b".":
            names[:] = [name for name in names if name != b"target"]
        else:
            directories.append((directory, os.path.normpath(relative)))
        links = [name for name in names if os.path.islink(os.path.join(directory, name))]
        for name in files + links:
            if os.path.normpath(os.path.join(relative, name)) not in keep:
                os.unlink(os.path.join(directory, name))
        names[:] = [name for name in names if name not in links]
    for directory, relative in reversed(directories):
        if relative not in keep_dirs and not os.listdir(directory):
            os.rmdir(directory)

elif command == "written":
    # The files the last command wrote in the slot's checkout, as JSON: the
    # listed ones on standard input it may have changed, and those it added.
    # Prune left only the listed files beside the target directories, so a
    # file not listed is new; a listed one is a candidate when it is no older
    # than the command's start, which the caller compares by content.
    source = os.path.join(base, "src")
    keep = set(filter(None, sys.stdin.buffer.read().split(b"\0")))
    skip = {os.path.realpath(os.path.join(source, "target"))}
    skip.update(os.path.realpath(path) for path in sys.argv[3:])
    # Once the command and whatever it left running have ended.
    running = open(os.path.join(base, "running"), "a")
    fcntl.flock(running, fcntl.LOCK_EX)
    try:
        since = os.stat(os.path.join(base, "started")).st_mtime_ns
    except OSError:
        since = None
    root = os.fsencode(source)
    changed, added = [], []
    for directory, names, files in os.walk(root):
        names[:] = [name for name in names
                    if os.path.realpath(os.path.join(directory, name)) not in skip]
        links = [name for name in names if os.path.islink(os.path.join(directory, name))]
        names[:] = [name for name in names if name not in links]
        for name in files + links:
            path = os.path.join(directory, name)
            relative = os.path.normpath(os.path.relpath(path, root))
            if relative not in keep:
                added.append(os.fsdecode(relative))
            elif since is not None and os.lstat(path).st_mtime_ns >= since:
                changed.append(os.fsdecode(relative))
    print(json.dumps({"changed": changed, "added": added}))

elif command == "busiest":
    # For scripts/cargo-gate's own wait on this host; `base` is unused. After
    # an optional `--bounded PATH`, each argument is a running build's holder
    # or one of the gate's slot locks.
    arguments, bounded = sys.argv[3:], None
    if arguments[:1] == ["--bounded"] and len(arguments) > 1:
        bounded, arguments = arguments[1], arguments[2:]
        # As the caller would type it here.
        relative = os.path.relpath(bounded)
        if not relative.startswith(".."):
            bounded = relative if "/" in relative else f"./{relative}"
    print(busiest([int(word) for word in arguments if word.isdigit()],
                  [word for word in arguments if not word.isdigit()], bounded=bounded))

elif command == "trim":
    # Trims the slots no lease holds, of every repository under `base`, the
    # offload root, for scripts/build-disk-guard: the most incremental state
    # each keeps in GiB, the floor in GiB, and whether to wait for the
    # removal.
    budget, floor = int(sys.argv[3]) * GIB, int(sys.argv[4]) * GIB
    wait = sys.argv[5:6] == ["--wait"]
    trimmed = []
    for repository in sorted(glob.glob(os.path.join(glob.escape(base), "*", ""))):
        trimmed += trim_free(repository.rstrip(os.sep), budget, floor)
    # Waiting, for every slot's removal, including those of a trim that
    # held a slot this one passed over.
    remove_evicted(sorted(glob.glob(os.path.join(glob.escape(base), "*", "slot-*"))) if wait
                   else [slot for slot, _ in trimmed], wait=wait)
    moved = sum(size for _, size in trimmed)
    if moved:
        say(f"moved {moved / GIB:.1f} GiB of build output out of {len(trimmed)} idle build slots")

elif command == "exists":
    # Whether a result the caller may copy back is there.
    sys.exit(0 if os.path.exists(base) else 1)

elif command == "run":
    # The environment and limits come first on standard input, never on the command
    # line, which every user of the host can read.
    directory, arguments = sys.argv[3], sys.argv[4:]
    request = json.loads(sys.stdin.buffer.readline())
    environment = request["environment"]
    # The command may open as many files as the host allows. An ssh
    # session's soft limit is the conventional 1024, which fails
    # descriptor-heavy suites, and nothing gains from a low one.
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    if soft != hard:
        try:
            resource.setrlimit(resource.RLIMIT_NOFILE, (hard, hard))
        except (OSError, ValueError):
            pass  # Beyond what the kernel allows; the session's own limit stands.
    if not request.get("core_dumps"):
        # A crashing test or compiler leaves no core: the host's
        # systemd-coredump stores and compresses every one it is given, which
        # filled its disk. Only the soft limit drops, so a test that wants a
        # core can raise it again.
        resource.setrlimit(resource.RLIMIT_CORE, (0, resource.getrlimit(resource.RLIMIT_CORE)[1]))
    running = open(os.path.join(base, "running"), "a")
    fcntl.flock(running, fcntl.LOCK_EX)
    # What the command writes in the checkout is newer than this: see `written`.
    started = os.path.join(base, "started")
    open(started, "a").close()
    os.utime(started)
    # Builds admitted later price this one by what its processes hold. Under
    # a hold, a command before this one may have repriced the claim for its
    # tests and been killed before restoring it, so each starts from what the
    # lease was priced at, which the first records.
    cost, _ = claim(base)
    with open(os.path.join(base, "claim.new"), "w") as file:
        claimed = read_claim(base)
        try:
            cost = int(claimed.get("leased") or cost)
        except (ValueError, TypeError):
            pass
        json.dump({"cost": cost, "leased": cost, "pid": os.getpid(),
                   "build": claimed.get("build", ""), "key": claimed.get("key", "")}, file)
    os.replace(os.path.join(base, "claim.new"), os.path.join(base, "claim"))
    register(base, cost, os.getpid())
    os.chdir(os.path.join(base, "src", directory))
    environment = dict(os.environ, **environment)
    if "CARGO_BUILD_JOBS" not in environment:
        # The CPUs shared by the builds running now, this one included, but
        # never so few that one build's slow crates stall it.
        builds = sum(leased(os.path.join(os.path.dirname(base), f"slot-{index}"))
                     for index in slot_indices(os.path.dirname(base)))
        # At most 8 and half the CPUs, as scripts/cargo-gate gives builds on
        # its host: the memory builds are expected to need was measured so.
        cpus = len(os.sched_getaffinity(0))
        environment["CARGO_BUILD_JOBS"] = str(
            min(max(4, cpus // max(1, builds)), max(4, min(8, cpus // 2))))
    # Temporary files go in a directory of this slot's own, rather than in
    # the host's /tmp, which others use: temporary_directory puts it in the
    # runtime directory, which is memory on a systemd host such as fw16, or
    # in the slot when that is unsafe or unavailable. The path stays short:
    # tests bind Unix sockets under it, whose paths are limited to 108 bytes.
    # The slot runs one command at a time, so whatever the last one left
    # there is stale.
    environment["TMPDIR"] = temporary = temporary_directory(base)
    # What the command starts is this build's, whichever session it moves to.
    environment[SLOT_MARK] = os.path.realpath(base)
    clear(temporary)
    os.makedirs(temporary, mode=0o700, exist_ok=True)

    # build.rs asks Git for the version stamp only when it is not given; the
    # slot is not a repository, and whatever encloses it is not this one.
    environment["GIT_CEILING_DIRECTORIES"] = os.path.dirname(base)
    # Tools the checkout pins with mise, such as Zig for Ghostty, resolve
    # through its shims, which a login shell's prompt hook would otherwise add.
    environment["MISE_TRUSTED_CONFIG_PATHS"] = os.path.join(base, "src")
    shims = os.path.expanduser("~/.local/share/mise/shims")
    if os.path.isdir(shims):
        environment["PATH"] = shims + os.pathsep + environment.get("PATH", "")
        # See the note at the top of scripts/cargo-gate: a test's fixture may move HOME.
        environment.setdefault("MISE_DATA_DIR", os.path.dirname(shims))
    if request.get("directories") is not None:
        # Where this host's Cargo puts the build's results and intermediates,
        # which its own configuration may move out of the slot: the caller
        # maps the paths Cargo reports there onto its own.
        found = subprocess.run(
            [arguments[0], "metadata", "--format-version", "1", "--no-deps", "--offline",
             *request["directories"]],
            env=environment, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL)
        try:
            described = json.loads(found.stdout)
            directories = {"target": described["target_directory"],
                           "build": described.get("build_directory") or described["target_directory"]}
        except (ValueError, KeyError, TypeError):
            directories = {}
        sys.stdout.write(DIRECTORIES_MARKER + json.dumps(directories) + "\n")
        sys.stdout.flush()
    if request.get("host_test_helper") is not None:
        # The helper build and test run share this lease, source copy and Cargo
        # environment. Keep it beneath the supervised child, so cancellation
        # and the phase-based memory pricing cover the preparation too.
        helper = os.path.join(base, "cargo-host-test-helper.py")
        with open(helper, "w") as file:
            file.write(request["host_test_helper"])
        arguments = [sys.executable, "-I", helper, "--run", *arguments]
    if request.get("memory_cap") is not None:
        # The gate's helper travels with this invocation, including installed
        # gates and arbitrary Cargo workspaces that have no repository scripts.
        # Write outside src: a checkout copy/prune must not replace its wrapper.
        cap = os.path.join(base, "memory-capped")
        with open(cap, "w") as file:
            file.write(request["memory_cap"])
        arguments = [sys.executable, "-I", cap, *arguments]
    child = subprocess.Popen(arguments, env=environment, stdin=subprocess.DEVNULL,
                             start_new_session=True)
    ended = threading.Event()
    pricing = threading.Thread(target=price_by_phase, args=(base, cost, child.pid, ended),
                               daemon=True)
    pricing.start()
    def priced_as_built():
        # A hold builds again in this slot under the same lease and claim.
        ended.set()
        pricing.join(10)
    def end(sent_first):
        """Signals the command's process group until it is gone: children
        that ignore an interrupt, as a shell's background jobs do, get a
        termination and then a kill."""
        for sent in (sent_first, signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(child.pid, sent)
            except ProcessLookupError:
                return
            for _ in range(50):
                try:
                    os.killpg(child.pid, 0)
                except ProcessLookupError:
                    return
                time.sleep(0.1)
    cancelling = threading.Event()
    def cancel():
        cancelling.set()
        end(signal.SIGINT)
        priced_as_built()
        os._exit(130)
    until_closed(cancel)
    status = child.wait()
    if cancelling.is_set():
        # Ending the group exits.
        while True:
            time.sleep(3600)
    # What the command left running would keep the connection open.
    end(signal.SIGTERM)
    priced_as_built()
    os._exit(status if status >= 0 else 128 - status)
'''


def remote_command(arguments):
    """The build host's command line for the agent with `arguments`. The
    host's login shell parses it, and may not be a POSIX shell (fish treats
    backslashes in quotes differently), so the agent and its arguments travel
    as base64, which every shell leaves alone."""
    payload = json.dumps([REMOTE_AGENT, [str(argument) for argument in arguments]])
    encoded = base64.b64encode(payload.encode()).decode()
    return ["python3", "-c", BOOTSTRAP, encoded]


BOOTSTRAP = ("'import base64, json, sys; code, sys.argv[1:] = "
             "json.loads(base64.b64decode(sys.argv[1])); exec(compile(code, \"cargo-offload\", \"exec\"))'")


# ssh binds a build's connection at ControlPath plus a 17-byte suffix while
# it creates it, and a socket's path holds at most 107 bytes.
CONTROL_PATH_LIMIT = 107 - len("/m") - 17


def owner_alive(name):
    """Whether the build that made the connection directory `name`, which
    carries its process ID, is still running. A name without one is from an
    older gate: then it is judged by age."""
    pid = name[len("cof-ssh-"):].split("-", 1)[0]
    if not pid.isdigit() or "-" not in name[len("cof-ssh-"):]:
        return None
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except OSError:
        pass  # Someone else's process: running.
    return True


def sweep_connections(directory, age=120):
    """Removes the connection directories of builds that were killed before
    they could, with no connection listening there. A build still waiting
    for the host has never connected, so its directory goes only once that
    build has ended and has not used it for a while: a build in another PID
    namespace looks ended from here, but it renews the directory's time
    whenever it connects."""
    try:
        names = [name for name in os.listdir(directory) if name.startswith("cof-ssh-")]
    except OSError:
        return
    for name in names:
        path = os.path.join(directory, name)
        try:
            status = os.lstat(path)
        except OSError:
            continue
        if not os.path.isdir(path) or os.path.islink(path) or status.st_uid != os.getuid():
            continue
        alive = owner_alive(name)
        if alive or time.time() - status.st_mtime < age:
            continue
        probe = socket.socket(socket.AF_UNIX)
        try:
            probe.connect(os.path.join(path, "m"))
            continue  # A connection is still open; it ends when it persists no longer.
        except OSError:
            pass
        finally:
            probe.close()
        shutil.rmtree(path, ignore_errors=True)


class Offload:
    def __init__(self, host, plan, environment, loopback=False):
        self.host = host
        self.loopback = loopback
        self.memory_cap = None
        if plan is not None and plan.runs_tests:
            try:
                self.memory_cap = Path(__file__).with_name("memory-capped").read_text()
            except OSError as error:
                raise Refusal(f"offloaded tests require memory-capped beside cargo-offload: {error}") from error
        self.plan = plan
        self.environment = environment
        self.priority = environment.get("CAGENTS_BUILD_PRIORITY", "normal")
        if self.priority not in ("normal", "urgent"):
            say("CAGENTS_BUILD_PRIORITY must be normal or urgent")
            sys.exit(2)
        self.slots = positive(environment, "CAGENTS_BUILD_REMOTE_SLOTS", 8)
        # Unset: the host shares its CPUs among the builds running there.
        self.jobs = positive(environment, "CAGENTS_BUILD_REMOTE_JOBS", 0) or None
        self.floor = positive(environment, "CAGENTS_BUILD_REMOTE_FREE_FLOOR_GIB", 40)
        self.incremental = positive(environment, "CAGENTS_BUILD_REMOTE_INCREMENTAL_GIB",
                                    INCREMENTAL_GIB, least=0)
        self.answer = positive(environment, "CAGENTS_BUILD_REMOTE_ANSWER_SECONDS", 30)
        self.retry = positive(environment, "CAGENTS_BUILD_REMOTE_RETRY_SECONDS", 15)
        # What the build is expected to need at its peak, as scripts/cargo-gate
        # prices it for its own admission; the build host admits by it too.
        self.cost = positive(environment, "CAGENTS_BUILD_EXPECTED_KIB", 0) * 1024 or ""
        self.ssh = [
            "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
            "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=4",
        ]
        if loopback:
            # The same commands and copies, run here as ssh would run them there.
            self.ssh = [sys.executable, os.path.abspath(__file__), "--loopback-shell"]
        self.control = None
        self.children = []
        self.command = None
        self.lease = None
        self.cancelled = 0
        # A Git marker above the slot's checkout, as its lease reported.
        self.marker = None

    def remote(self, *arguments):
        if self.control is not None:
            try:
                os.utime(self.control)  # In use: see sweep_connections.
            except OSError:
                pass
        return self.ssh + [self.host] + remote_command(arguments)

    def spawn(self, command, **options):
        child = subprocess.Popen(command, start_new_session=True, **options)
        self.children.append(child)
        return child

    def cancel(self, number, _frame):
        """Ends what this build started. The remote command ends through its
        connection, so this waits for it to end there; the lease outlives it
        and ends after it. A second signal stops waiting for a connection
        that may be dead; the host still ends the command when it notices."""
        again = bool(self.cancelled)
        if not self.cancelled:
            self.cancelled = number
        for child in self.children:
            if child.poll() is not None or (child is self.lease and self.command is not None):
                continue
            if child is self.command and not again:
                try:
                    child.stdin.close()
                except (OSError, ValueError):
                    pass
                continue
            try:
                child.terminate()
            except ProcessLookupError:
                pass

    def locate(self):
        """(top, workspace, cwd, metadata, base): the Git checkout, its Cargo
        workspace, the directory the command runs from, Cargo's description
        of the workspace, and where the build host keeps its slots."""
        cargo = real_cargo(self.environment)
        metadata = subprocess.run(
            [cargo, "metadata", "--format-version", "1", "--no-deps"],
            capture_output=True, text=True, env=self.environment,
        )
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True)
        if metadata.returncode or top.returncode:
            raise Refusal("this is not a Cargo workspace in a Git checkout, which is "
                          f"what {self.host} builds")
        try:
            metadata = json.loads(metadata.stdout)
            workspace = os.path.realpath(metadata["workspace_root"])
            metadata["target_directory"]
        except (ValueError, KeyError, TypeError):
            raise Refusal(f"{cargo} metadata did not describe this workspace") from None
        top = os.path.realpath(top.stdout.strip())
        cwd = os.path.realpath(os.getcwd())
        if os.path.commonpath([top, workspace, cwd]) != top:
            raise Refusal("the workspace is outside its Git checkout, which is what "
                          f"{self.host} builds")
        common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                capture_output=True, text=True).stdout.strip()
        repository = Path(common).parent.name or Path(top).name
        return top, workspace, cwd, metadata, f"~/.cache/cagents-offload/{repository}"

    def run(self):
        for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(number, self.cancel)
        try:
            top, workspace, cwd, metadata, base = self.locate()
        except Refusal as refusal:
            return self.refuse(str(refusal))
        if self.plan.fixes and not self.plan.flag("--allow-no-vcs"):
            dirty, staged = uncommitted(top, workspace, self.environment)
            allowed_dirty = self.plan.flag("--allow-dirty")
            if dirty and not allowed_dirty:
                return self.refuse("the working directory has uncommitted changes, which "
                                   "fixes could mix with; commit them or pass --allow-dirty: "
                                   + ", ".join(dirty[:10]))
            if staged and not (allowed_dirty or self.plan.flag("--allow-staged")):
                return self.refuse("the working directory has staged changes, which fixes "
                                   "could mix with; commit them or pass --allow-staged: "
                                   + ", ".join(staged[:10]))

        if self.cancelled:
            return 128 + self.cancelled
        if self.held(base, top) is not None:
            status = self.build_held(base, top, workspace, cwd, metadata)
            if status is not None:
                return status
        self.share_connection()
        try:
            status, slot = self.lease_slot(base, top)
            if slot is None:
                return status
            try:
                return self.build(slot, top, workspace, cwd, metadata)
            except Refusal as refusal:
                if self.cancelled:
                    return 128 + self.cancelled
                return self.refuse(str(refusal))
            finally:
                self.end_lease()
        finally:
            self.close_connection()

    def end_lease(self):
        self.lease.stdin.close()
        try:
            self.lease.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self.lease.kill()

    def held(self, base, top):
        """The slot an enclosing `--hold` holds for this checkout on this
        build host, as (slot, marker, lock), or None. A holder keeps its lock
        while its lease lasts, so a lock anyone can take is a hold that has
        ended, and the build leases a slot of its own."""
        try:
            held = json.loads(self.environment.get(HELD) or "null")
            if not isinstance(held, dict) or (held.get("host"), held.get("base"), held.get("top")) \
                    != (self.host, base, top):
                return None
            descriptor = os.open(held["lock"], os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        except (ValueError, KeyError, TypeError, OSError):
            return None
        try:
            if os.fstat(descriptor).st_uid != os.getuid():
                return None
            # The build host's own path to one of its slots: nothing else is
            # a slot to build in.
            slot = str(held["slot"])
            if not (os.path.isabs(slot) and os.path.normpath(slot) == slot
                    and re.fullmatch(r"slot-[0-9]+", os.path.basename(slot))):
                return None
            fcntl.flock(descriptor, fcntl.LOCK_SH | fcntl.LOCK_NB)
            return None
        except BlockingIOError:
            return slot, held.get("marker"), held["lock"]
        finally:
            os.close(descriptor)

    def build_held(self, base, top, workspace, cwd, metadata):
        """Builds in the slot an enclosing `--hold` holds, or returns None
        when that hold ended while this waited its turn."""
        held = self.held(base, top)
        try:
            builds = open(held[2] + ".builds", "a")
        except OSError:
            return None
        with builds:
            # One build at a time in the slot, as a lease of its own would be.
            fcntl.flock(builds, fcntl.LOCK_EX)
            held = self.held(base, top)
            if held is None:
                return None
            slot, marker, _ = held
            if marker and self.tests_there():
                return self.refuse_marker(marker)
            self.share_connection()
            try:
                return self.build(slot, top, workspace, cwd, metadata)
            except Refusal as refusal:
                if self.cancelled:
                    return 128 + self.cancelled
                return self.refuse(str(refusal))
            finally:
                self.close_connection()

    def tests_there(self):
        """Whether the command runs tests on the build host."""
        return self.plan.subcommand in ("test", "bench")

    def refuse_marker(self, marker):
        # Tests that check Git ancestry would fail there for a reason
        # that is not theirs, so this stops and names it.
        say(f"{marker} on {self.host} puts the tests inside a Git checkout; something "
            f"left it there. Remove it, or {OPT_OUT}.")
        return REFUSED

    def share_connection(self):
        """Makes this build's steps (its lease, copies, command and the
        results it takes back) one ssh session to the host rather than one
        each: every session costs a login there, which its sshd audits. The
        session is this build's alone, so cancelling it, which ends what it
        started, cuts no other build's. A loopback has no connection."""
        if self.loopback:
            return
        candidates = [self.environment.get("XDG_RUNTIME_DIR") or "", tempfile.gettempdir(), "/tmp"]
        for directory in dict.fromkeys(candidates):
            if not os.path.isdir(directory):
                continue
            sweep_connections(directory)
            try:
                control = tempfile.mkdtemp(prefix=f"cof-ssh-{os.getpid()}-", dir=directory)
            except OSError:
                continue
            if len(control) <= CONTROL_PATH_LIMIT:
                break
            os.rmdir(control)
        else:
            return  # No directory has a short enough path: each step connects on its own.
        self.control = control
        self.ssh += ["-o", "ControlMaster=auto", "-o", f"ControlPath={control}/m",
                     "-o", "ControlPersist=60"]

    def close_connection(self):
        if self.control is None:
            return
        try:
            subprocess.run([*self.ssh, "-O", "exit", self.host], stdin=subprocess.DEVNULL,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        except subprocess.TimeoutExpired:
            pass
        shutil.rmtree(self.control, ignore_errors=True)
        self.control = None

    def refuse(self, reason):
        say(reason)
        return REFUSED

    def lease_slot(self, base, top):
        """(status, None) when no slot was leased, or (None, slot path).
        While the host cannot take the build, waits for it and says so once a
        minute, within the gate's admission budget."""
        deadline = admission_deadline(self.environment)
        since = said = reason = None
        while True:
            outcome, detail = self.try_lease(base, top, deadline)
            if outcome == "slot":
                return None, detail
            if outcome in ("status", "cancelled"):
                return detail, None
            if outcome == "expired":
                say(f"build admission timed out{': ' + reason if reason else ''}; {OPT_OUT}")
                return EXPIRED, None
            reason = detail
            now = time.monotonic()
            if since is None:
                since = said = now
                say(f"{detail}; waiting for it ({OPT_OUT})")
            elif now - said >= 60:
                said = now
                say(f"{detail}; still waiting after {format_duration(now - since)}")
            left = remaining(deadline)
            if left is not None and left <= 0:
                say(f"build admission timed out: {detail}; {OPT_OUT}")
                return EXPIRED, None
            pause = self.retry if left is None else min(self.retry, left)
            end = time.monotonic() + pause
            while time.monotonic() < end:
                if self.cancelled:
                    return 128 + self.cancelled, None
                time.sleep(0.1)

    def build_identity(self, directory):
        """The Cargo command this is, run from `directory` of the checkout, for
        a command that only builds there, without what only its tests take or
        what only changes how Cargo reports; empty for one that also runs
        tests there, which a request for the same build should not wait out."""
        if self.plan.subcommand in ("test", "bench") and not self.plan.no_run:
            return ""
        options = [option for option in self.plan.options
                   if option[0] is not None or self.plan.subcommand not in ("test", "bench")]
        identity = json.dumps([self.plan.toolchain, self.plan.subcommand, directory, options,
                               sorted((name, value) for name, value
                                      in forwarded_environment(self.environment).items()
                                      if not name.startswith(("CAGENTS_", "CARGO_TERM_"))
                                      and name not in ("RUST_BACKTRACE", "RUST_LIB_BACKTRACE",
                                                       "RUST_LOG"))])
        return hashlib.sha256(identity.encode()).hexdigest()[:24]

    def try_lease(self, base, top, deadline):
        """("slot", path); ("waiting", why) when the host cannot take the build
        now; ("expired", None) when the admission budget ran out; or
        ("status"/"cancelled", exit status) when the command ends."""
        lease = self.lease = self.spawn(
            self.remote("lease", base, self.slots, f"{os.uname().nodename}:{top}", self.floor,
                        profile_config(os.path.expanduser("~/.cargo/config.toml")), self.cost,
                        self.build_identity(os.path.relpath(os.path.realpath(os.getcwd()), top)),
                        self.incremental, self.priority),
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
        )
        lines = Lines(lease.stdout)

        def next_line(limit):
            # The gate's admission budget covers the wait for a slot on the
            # build host, as it does one here, but not the build.
            left = remaining(deadline)
            if left is not None and (limit is None or left <= limit):
                try:
                    return lines.next(max(0.0, left))
                except TimeoutError:
                    raise AdmissionExpired from None
            return lines.next(limit)

        try:
            line = next_line(self.answer)
            if line and line.startswith("marker "):
                self.marker = json.loads(line.removeprefix("marker "))
                if self.tests_there():
                    lease.kill()
                    return "status", self.refuse_marker(self.marker)
                line = next_line(self.answer)
            told = set()
            while line is not None and (line == "wait" or line.startswith("wait ")):
                words = line.split()
                reason = words[1] if len(words) > 1 else "slot"
                if reason not in told:
                    told.add(reason)
                    if reason == "memory":
                        say(f"waiting for memory on {self.host}: {words[2]} GiB is free beside its "
                            f"{words[4]} running builds, and this one is expected to need {words[3]} GiB")
                    elif reason == "pressure":
                        say(f"waiting for memory on {self.host}: its memory pressure is "
                            f"{words[2]}%, at or above the {words[3]}% limit")
                    elif reason == "cpu":
                        # What holds them there, after a host that names it.
                        culprits = line.split(" -- ", 1)[1] if " -- " in line else ""
                        say(f"waiting for CPU on {self.host}: its CPU pressure is "
                            f"{words[2]}%, at or above the {words[3]}% limit"
                            + (f"; {culprits}" if culprits else ""))
                    elif reason == "trim":
                        say(f"waiting while {self.host} trims old build output from this build's slot")
                    elif reason == "same":
                        say(f"waiting for the same build of this checkout on {self.host} to "
                            f"finish, which leaves this one little to compile")
                    else:
                        say(f"waiting for a build slot on {self.host}")
                line = next_line(None)
        except AdmissionExpired:
            lease.kill()
            return "expired", None
        except TimeoutError:
            lease.kill()
            lease.wait()
            return "waiting", f"{self.host} did not answer within {self.answer}s"
        if self.cancelled:
            return "cancelled", 128 + self.cancelled
        words = (line or "").split()
        if words[:1] == ["slot"]:
            return "slot", json.loads(line.removeprefix("slot "))["path"]
        if words[:1] == ["refuse"]:
            lease.kill()
            lease.wait()
            return "waiting", f"{self.host} has {words[1]} GiB free, below its {words[2]} GiB floor"
        try:
            status = lease.wait(timeout=10)
        except subprocess.TimeoutExpired:
            lease.kill()
            status = lease.wait()
        if self.cancelled:
            return "cancelled", 128 + self.cancelled
        if status == 255:
            # ssh's own failure: no connection.
            return "waiting", f"{self.host} is unreachable"
        say(f"{self.host} could not lease a build slot (status {status}); {OPT_OUT}")
        return "status", UNAVAILABLE

    def build(self, slot, top, workspace, cwd, metadata):
        plan = self.plan
        source = f"{slot}/src"
        local_target = os.path.realpath(metadata["target_directory"])
        local_build = os.path.realpath(metadata.get("build_directory") or local_target)
        remote_target = os.path.normpath(os.path.join(source, os.path.relpath(workspace, top), "target"))
        directories = {}

        def translate(option, value):
            """A path option's value as the build host has the path."""
            if option == "--config" and "=" in value:
                return value
            if option == "--target" and not value.endswith(".json"):
                return value
            if option not in PATHS and option not in ("--config", "--target"):
                return value
            local = os.path.realpath(os.path.join(cwd, os.path.expanduser(value)))
            if not inside(local, top):
                raise Refusal(f"{option} {value} is outside this checkout, which is all "
                              f"{self.host} has; {OPT_OUT}")
            remote = os.path.join(source, os.path.relpath(local, top))
            directories[option] = (remote, local)
            return remote

        extra = []
        if plan.fixes:
            # The slot is not a Git checkout; this side checked the checkout.
            extra.append("--allow-no-vcs")
        if plan.subcommand == "run":
            extra += ["--config", f"target.{self.triple(plan)}.runner={json.dumps(RUNNER)}"]
        arguments = plan.arguments(translate, extra)
        if "--target-dir" in directories:
            if local_build == local_target:
                # Without a build directory of its own, Cargo builds in the
                # target directory it was given.
                local_build = directories["--target-dir"][1]
            remote_target, local_target = directories["--target-dir"]
        remote_build = remote_target
        # The settings that may move the build host's directories, for it to
        # describe them.
        configs = [value for option, value in zip(arguments, arguments[1:]) if option == "--config"]
        configs += [word.partition("=")[2] for word in arguments if word.startswith("--config=")]

        listing = subprocess.run(
            ["git", "-C", top, "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
            capture_output=True, check=True,
        ).stdout
        files = [name for name in dict.fromkeys(listing.split(b"\0")) if name and (
            os.path.islink(os.path.join(os.fsencode(top), name))
            or os.path.isfile(os.path.join(os.fsencode(top), name)))]
        listing = b"\0".join(files) + b"\0"
        environment = forwarded_environment(self.environment)
        environment.update(self.inputs(slot, top, local_target, remote_target,
                                       {os.fsdecode(name) for name in files}))
        shell = " ".join(shlex.quote(word) for word in self.ssh)
        # What each file was as sent, so that one edited here meanwhile keeps
        # that edit over what the command writes there.
        sent = {}
        for name in files:
            status = os.lstat(os.path.join(os.fsencode(top), name))
            sent[os.fsdecode(name)] = (status.st_size, status.st_mtime_ns)
        # Files are compared by content and a changed one is written with
        # the time it arrives, not the time it has here. Cargo judges path
        # crates, such as the vendored patches, by modification time: a
        # worktree whose copy of a file is older than another worktree's
        # build in the slot would otherwise build against that build.
        sync = self.spawn(
            ["rsync", "-rlpgoD", "--checksum", "-z", "--from0", "--files-from=-", "-e", shell,
             "./", f"{self.host}:{source}/"],
            cwd=top, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
        )
        sync.communicate(listing)
        if self.cancelled:
            return 128 + self.cancelled
        # 24: a file was removed while being copied; the next build copies
        # the checkout as it is then.
        if sync.returncode not in (0, 24):
            say(f"could not copy the sources to {self.host} (rsync exited {sync.returncode})")
            return sync.returncode
        prune = self.spawn(self.remote("prune", slot), stdin=subprocess.PIPE)
        prune.communicate(listing)
        if self.cancelled:
            return 128 + self.cancelled

        root = next((package for package in metadata.get("packages", [])
                     if os.path.dirname(os.path.realpath(package["manifest_path"])) == workspace),
                    None)
        if self.jobs:
            environment["CARGO_BUILD_JOBS"] = str(self.jobs)
        environment.setdefault("CARGO_TERM_PROGRESS_WHEN", "never")
        if sys.stderr.isatty():
            environment.setdefault("CARGO_TERM_COLOR", "always")
        stamp = build_metadata(top, root["version"] if root else "", self.environment)
        if stamp:
            environment["CAGENTS_BUILD_METADATA"] = stamp
        environment[SUPPLIED] = "1"

        def mapped():
            # Longest first, so the target directory wins over the checkout
            # that holds it.
            return sorted({remote: local for remote, local in [
                (remote_build, local_build), (remote_target, local_target), (source, top),
                *directories.values()]}.items(), key=lambda pair: -len(pair[0]))
        mappings = mapped()
        command = self.command = self.spawn(
            self.remote("run", slot, os.path.relpath(cwd, top), "cargo", *arguments),
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE if plan.captures else None,
        )
        try:
            request = {"environment": environment,
                       "core_dumps": self.environment.get("CAGENTS_BUILD_REMOTE_CORE_DUMPS") == "1"}
            if plan.runs_tests:
                request["memory_cap"] = self.memory_cap
            if plan.subcommand == "test":
                helper = Path(__file__).resolve().with_name("cargo-host-test-helper.py")
                if helper.is_file():
                    request["host_test_helper"] = helper.read_text()
            if plan.captures:
                request["directories"] = [arg for value in configs for arg in ("--config", value)]
            command.stdin.write((json.dumps(request) + "\n").encode())
            command.stdin.flush()
        except (BrokenPipeError, ValueError):
            pass  # The connection failed or was cancelled; its status says which.
        messages = []
        launch = None
        if plan.captures:
            for line in command.stdout:
                if line.startswith(DIRECTORIES_MARKER.encode()):
                    there = json.loads(line[len(DIRECTORIES_MARKER):])
                    if "target" in there:
                        if "--target-dir" not in directories:
                            remote_target = there["target"]
                        remote_build = there["build"]
                        if "--target-dir" in directories and there["build"] == there["target"]:
                            remote_build = remote_target
                        mappings = mapped()
                    continue
                if plan.subcommand == "run" and line.startswith(RUN_MARKER.encode()):
                    launch = json.loads(line[len(RUN_MARKER):])
                    continue
                if line.startswith(b"{"):
                    try:
                        message = json.loads(line)
                    except ValueError:
                        message = None
                    if message is not None:
                        messages.append(message)
                        if plan.caller_wants_json or not plan.executables and not plan.flag("--open"):
                            line = (json.dumps(rewrite(message, mappings)) + "\n").encode()
                        else:
                            continue
                sys.stdout.buffer.write(line)
                sys.stdout.buffer.flush()
        status = command.wait()
        if self.cancelled:
            return 128 + self.cancelled
        if status == 255:
            say(f"lost the connection to {self.host}")
            return status

        # What the command left for this host, whether or not it succeeded:
        # what it wrote in the checkout, such as fixes it applied before
        # failing or a test's recording, and a failed build's timings.
        back = self.take_written(slot, source, top, listing, sent, shell,
                                 {remote_target, remote_build, *(remote for remote, _ in directories.values())})
        if plan.timings:
            back = back or self.fetch(f"{remote_target}/cargo-timings/",
                                      os.path.join(local_target, "cargo-timings") + "/", shell,
                                      missing_ok=True)
            say(f"timing reports are in {os.path.join(local_target, 'cargo-timings')}")
        if status:
            return status
        if plan.subcommand in ("doc", "rustdoc"):
            # A target given by its specification file builds into a
            # directory named for the file.
            for triple in [""] + [
                    os.path.splitext(os.path.basename(value))[0] if value.endswith(".json") else value
                    for value in plan.values("--target")]:
                back = back or self.fetch(
                    os.path.join(remote_target, triple, "doc") + "/",
                    os.path.join(local_target, triple, "doc") + "/", shell, delete=True,
                    missing_ok=bool(triple) or plan.subcommand == "rustdoc")
        if plan.executables:
            here = dict(mappings)
            for root, made in artifacts(messages, [remote_target, remote_build]).items():
                os.makedirs(here[root], exist_ok=True)
                back = back or self.fetch(f"{root}/", here[root] + "/", shell, files=made)
        for option in ("--artifact-dir", "--out-dir"):
            if option in directories:
                remote, local = directories[option]
                back = back or self.fetch(remote + "/", local + "/", shell)
        if back:
            say(f"could not copy the results back from {self.host} (rsync exited {back})")
            return back
        if plan.flag("--open"):
            return self.open_documentation(messages, mappings)
        if plan.subcommand == "run":
            return self.launch(launch, mappings)
        return 0

    def inputs(self, slot, top, local_target, remote_target, synced):
        """The settings naming files on this host, as the build host has
        them: a checkout file it was sent, or a copy of a file in the
        checkout or its target, such as the retained-actor helper. A copy of
        an unchanged file is not sent again, and one the slot built itself
        is linked rather than sent."""
        mapped = {}
        for name in path_settings(self.environment):
            value = self.environment[name]
            local = os.path.realpath(os.path.expanduser(value))
            if inside(local, top) and os.path.relpath(local, top) in synced:
                mapped[name] = os.path.join(slot, "src", os.path.relpath(local, top))
                continue
            if inside(local, local_target):
                kind, base, link = "target", local_target, remote_target
            elif inside(local, top):
                kind, base, link = "checkout", top, os.path.join(slot, "src")
            else:
                raise Refusal(f"{name} names {value}, outside this checkout and its target, "
                              f"which {self.host} cannot have; unset it or {OPT_OUT}")
            if not os.path.isfile(local):
                raise Refusal(f"{name} names {value}, which is not a file {self.host} can be "
                              f"sent; {OPT_OUT}")
            relative = os.path.relpath(local, base)
            destination = os.path.join(slot, "inputs", kind)
            shell = " ".join(shlex.quote(word) for word in self.ssh)
            status = self.spawn(
                ["rsync", "-a", "--modify-window=-1", "-z", "-R", f"--link-dest={link}", "-e", shell,
                 f"{base}/./{relative}", f"{self.host}:{destination}/"]).wait()
            if self.cancelled:
                raise Refusal("cancelled")
            if status:
                raise Refusal(f"could not send {name} ({value}) to {self.host} "
                              f"(rsync exited {status})")
            mapped[name] = os.path.join(destination, relative)
        return mapped

    def fetch(self, remote, local, shell, *, files=None, delete=False, missing_ok=False):
        """Copies `remote` from the build host into `local`: the listed
        files, or the whole directory. Returns rsync's status. Times are
        compared to the nanosecond: an executable rebuilt within the second
        is often the same size."""
        command = ["rsync", "-a", "--modify-window=-1", "-z", "-e", shell]
        if delete:
            command.append("--delete")
        if files is not None:
            command += ["--from0", "--files-from=-"]
        if missing_ok:
            # Only when the directory is there: a failed build may leave none.
            probe = self.spawn(self.remote("exists", remote)).wait()
            if probe:
                return 0
        os.makedirs(local, exist_ok=True)
        back = self.spawn(command + [f"{self.host}:{remote}", local],
                          stdin=subprocess.PIPE if files is not None else subprocess.DEVNULL)
        if files is not None:
            back.communicate(("\0".join(files) + "\0").encode())
        else:
            back.wait()
        return 0 if self.cancelled else back.returncode

    def take_written(self, slot, source, top, listing, sent, shell, outputs):
        """Brings back what the command wrote in the slot's checkout, as it
        would have written it here: Cargo's fixes, a test's recording, an
        updated lockfile. A file here that changed after it was sent, or a new
        one that appeared meanwhile, is newer and is kept; a new file this
        checkout ignores is left there. `outputs` are the build's directories,
        which are not looked at."""
        found = subprocess.run(self.remote("written", slot, *sorted(outputs)),
                               input=listing, capture_output=True)
        if found.returncode:
            return found.returncode
        written = json.loads(found.stdout)
        changed = written["changed"]
        if changed:
            # Candidates by time, which a copy arriving as the command started
            # shares; only a difference in content is a change.
            differing = subprocess.run(
                ["rsync", "-a", "-c", "-n", "--from0", "--files-from=-", "--out-format=%n",
                 "-e", shell, f"{self.host}:{source}/", top + "/"],
                input=("\0".join(changed) + "\0").encode(), capture_output=True)
            if differing.returncode:
                return differing.returncode
            changed = [name for name in os.fsdecode(differing.stdout).splitlines()
                       if name and not name.endswith("/")]
        added = written["added"]
        if added:
            ignored = subprocess.run(["git", "-C", top, "check-ignore", "-z", "--stdin"],
                                     input=("\0".join(added) + "\0").encode(), capture_output=True)
            if ignored.returncode not in (0, 1):
                say(f"cannot tell which of the files the command added are ignored here; "
                    f"left on {self.host}: {', '.join(added)}")
                added = []
            else:
                skipped = set(os.fsdecode(ignored.stdout).split("\0"))
                added = [name for name in added if name not in skipped]
        taken = []
        for name in changed:
            try:
                status = os.lstat(os.path.join(top, name))
                now = (status.st_size, status.st_mtime_ns)
            except OSError:
                now = None
            if now == sent.get(name):
                taken.append(name)
            else:
                say(f"not taking {name} from {self.host}: it changed here while the command ran")
        for name in added:
            if os.path.lexists(os.path.join(top, name)):
                say(f"not taking {name} from {self.host}: it appeared here while the command ran")
            else:
                taken.append(name)
        if not taken:
            return 0
        status = self.fetch(f"{source}/", top + "/", shell, files=taken)
        if not status:
            if self.plan.fixes:
                say(f"applied fixes to {len(taken)} file{'s' if len(taken) != 1 else ''}")
            else:
                say(f"took back what the command wrote here: {', '.join(taken)}")
        return status

    def triple(self, plan):
        """The target `cargo run` builds for: the one given, or this host's."""
        given = plan.values("--target")
        if given:
            return given[-1]
        version = subprocess.run(["rustc", "-vV"], capture_output=True, text=True,
                                 env=self.environment)
        host = next((line.split(None, 1)[1] for line in version.stdout.splitlines()
                     if line.startswith("host: ")), None)
        if version.returncode or not host:
            raise Refusal(f"cannot tell this host's target triple for `cargo run`; {OPT_OUT}")
        return host

    def launch(self, launch, mappings):
        """Runs the program `cargo run` chose, here, as Cargo would have."""
        if launch is None:
            say("Cargo built the program but did not say which one it would run")
            return 101
        executable = rewrite(launch["program"], mappings)
        environment = dict(self.environment)
        for name, value in launch["environment"].items():
            environment[name] = rewrite(value, mappings)
        environment["CARGO"] = shutil.which(real_cargo(self.environment)) or environment.get("CARGO", "")
        if shims := environment.get("CAGENTS_BUILD_EXEC_SHIMS"):
            # Back in the outer exec's scope: restore the Cargo shim and
            # compiler guard that the gate removed for this build.
            environment["PATH"] = shims + os.pathsep + environment.get("PATH", os.defpath)
            environment["RUSTC_WRAPPER"] = str(Path(__file__).resolve().with_name(
                "cargo-gate-rustc-guard"))
        sys.stdout.flush()
        sys.stderr.flush()
        # The program replaces this process, and with it the cleanup at the
        # end of the build. Closing the lease frees the slot; what this
        # started ends and is reaped first, rather than becoming the
        # program's children, which it would never wait for.
        self.lease.stdin.close()
        self.close_connection()
        deadline = time.monotonic() + 10
        for child in self.children:
            try:
                child.wait(timeout=max(0, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()
        try:
            os.execve(executable, [executable, *self.plan.program], environment)
        except OSError as error:
            say(f"could not run {executable}: {error}")
            return 127

    def open_documentation(self, messages, mappings):
        """Opens the documentation Cargo made last, as `cargo doc --open` does."""
        pages = [name for message in messages if message.get("reason") == "compiler-artifact"
                 for name in message.get("filenames") or [] if name.endswith("/index.html")]
        if not pages:
            say("Cargo reported no documentation to open")
            return 0
        page = rewrite(pages[-1], mappings)
        opener = self.environment.get("BROWSER") or "xdg-open"
        say(f"opening {page}")
        try:
            subprocess.Popen([opener, page], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, start_new_session=True)
        except OSError as error:
            say(f"could not open {page} with {opener}: {error}")
        return 0


class Hold(Offload):
    """Leases one slot on the build host and holds it while `command` runs
    here, for a script of builds such as the development runner's: each
    gated Cargo command in it builds in that slot, one at a time, with no
    admission of its own. Tests run there too, priced by what they hold while
    they run and at the hold's cost again once they end. The slot stays
    leased until the command ends, so hold only for builds."""

    def __init__(self, host, command, environment, loopback=False):
        super().__init__(host, None, environment, loopback)
        self.program = command

    def build_identity(self, directory):
        return ""

    def tests_there(self):
        # The builds in it learn of the marker when they run tests.
        return False

    def cancel(self, number, frame):
        if self.command is not None and self.command.poll() is None:
            # The command ends its builds, which end before the lease does.
            self.cancelled = self.cancelled or number
            try:
                self.command.send_signal(number)
            except ProcessLookupError:
                pass
            return
        super().cancel(number, frame)

    def run(self):
        for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(number, self.cancel)
        try:
            top, _, _, _, base = self.locate()
        except Refusal as refusal:
            return self.refuse(str(refusal))
        if self.held(base, top) is not None:
            # Already inside a hold of this checkout's: its slot serves.
            return self.execute(dict(self.environment))
        if self.cancelled:
            return 128 + self.cancelled
        self.share_connection()
        try:
            status, slot = self.lease_slot(base, top)
            if slot is None:
                return status
            runtime = self.environment.get("XDG_RUNTIME_DIR") or ""
            directory = tempfile.mkdtemp(prefix="cagents-hold-",
                                         dir=runtime if os.path.isdir(runtime) else None)
            try:
                lock = os.path.join(directory, "lock")
                descriptor = os.open(lock, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
                fcntl.flock(descriptor, fcntl.LOCK_EX)

                def watch(lease=self.lease):
                    # A lease that ends early, with its connection, frees the
                    # slot there; the builds still to come lease their own.
                    lease.wait()
                    try:
                        fcntl.flock(descriptor, fcntl.LOCK_UN)
                    except OSError:
                        pass
                threading.Thread(target=watch, daemon=True).start()
                environment = dict(self.environment)
                environment[HELD] = json.dumps({"host": self.host, "base": base, "top": top,
                                                "slot": slot, "marker": self.marker,
                                                "lock": lock})
                return self.execute(environment)
            finally:
                self.end_lease()
                shutil.rmtree(directory, ignore_errors=True)
        finally:
            self.close_connection()

    def execute(self, environment):
        try:
            self.command = subprocess.Popen(self.program, env=environment)
        except OSError as error:
            say(f"could not run {self.program[0]}: {error}")
            return 127
        status = self.command.wait()
        return 128 - status if status < 0 else status


# The runner `cargo run` gets on the build host: it reports the program and
# the environment Cargo gives it, and runs nothing there.
RUNNER = ["python3", "-c",
          "import json, os, sys; print(" + repr(RUN_MARKER) + " + json.dumps({'program': "
          "sys.argv[1], 'environment': {name: value for name, value in os.environ.items() "
          "if name.startswith('CARGO_PKG_') or name in ('CARGO_MANIFEST_DIR', "
          "'CARGO_MANIFEST_PATH', 'CARGO_CRATE_NAME', 'CARGO_BIN_NAME', "
          "'CARGO_PRIMARY_PACKAGE')}}), flush=True)"]


def positive(environment, name, default, least=1):
    value = environment.get(name, "")
    if not value:
        return default
    if not value.isdigit() or value.startswith("0") and value != "0" or int(value) < least:
        say(f"{name} must be a {'positive' if least else 'nonnegative'} integer")
        sys.exit(2)
    return int(value)


def format_duration(seconds):
    minutes = int(seconds // 60)
    return f"{minutes} minute{'s' if minutes != 1 else ''}" if minutes else f"{int(seconds)}s"


class AdmissionExpired(Exception):
    """The gate's admission budget ran out before a slot was leased."""


class Lines:
    """A child's output lines, read on one thread, so a wait that gives up
    does not lose the line that arrives after it."""

    def __init__(self, stream):
        self.queue = queue.Queue()
        threading.Thread(target=self.read, args=(stream,), daemon=True).start()

    def read(self, stream):
        for line in stream:
            self.queue.put(line.strip())
        self.queue.put(None)

    def next(self, timeout):
        """The next line, or None once the output ends; TimeoutError if none
        arrives within `timeout` seconds."""
        try:
            return self.queue.get(timeout=timeout)
        except queue.Empty:
            raise TimeoutError from None


def admission_deadline(environment):
    """The gate's admission deadline on this host's monotonic clock, if the
    caller gave the gate an admission budget."""
    value = environment.get("CAGENTS_BUILD_ADMISSION_DEADLINE", "")
    return int(value) if value.isascii() and value.isdecimal() else None


def remaining(deadline):
    """Seconds left before `deadline`, or None without one."""
    return None if deadline is None else (deadline - time.monotonic_ns()) / 1e9


def say(message):
    print(f"{program}: {message}", file=sys.stderr, flush=True)


def main(arguments):
    if arguments[:1] == ["--loopback-shell"]:
        return loopback_shell(arguments[1:])
    if arguments[:1] == ["--trim-slots"]:
        # Bounds this host's own idle offload slots, as their leases do,
        # for scripts/build-disk-guard: FLOOR in GiB, then --wait to wait
        # for what they free.
        if len(arguments) < 2 or not arguments[1].isdigit() or arguments[2:] not in ([], ["--wait"]):
            say("usage: cargo-offload --trim-slots FLOOR_GIB [--wait]")
            return 2
        # The slots sshd's sessions make, under the account's home, whatever
        # HOME a fixture or native-evidence build gives this process.
        root = os.environ.get("CAGENTS_BUILD_OFFLOAD_SLOTS",
                              os.path.join(pwd.getpwuid(os.getuid()).pw_dir, ".cache", "cagents-offload"))
        if not root or not os.path.isdir(root):
            return 0
        # It may outlive the build that started it, which must not stay
        # holding the build's locks through it.
        os.closerange(3, resource.getrlimit(resource.RLIMIT_NOFILE)[0])
        budget = positive(os.environ, "CAGENTS_BUILD_REMOTE_INCREMENTAL_GIB", INCREMENTAL_GIB, least=0)
        sys.argv = ["cargo-offload", "trim", root, str(budget), *arguments[1:]]
        exec(compile(REMOTE_AGENT, "cargo-offload", "exec"), {"__name__": "cargo-offload-agent"})
        return 0
    if arguments[:1] == ["--busiest"]:
        # What holds this host's CPUs besides the builds that the PIDs and
        # slot locks which follow are of.
        sys.argv = ["cargo-offload", "busiest", "~", *arguments[1:]]
        exec(compile(REMOTE_AGENT, "cargo-offload", "exec"), {"__name__": "cargo-offload-agent"})
        return 0
    # The gate passes on where it found builds go, so this cannot decide
    # otherwise, such as when a slow name lookup ends differently, and exit
    # FALL_BACK having built nothing. Nothing this starts inherits it.
    decided = os.environ.pop("CAGENTS_BUILD_OFFLOAD_HOST", "")
    decided, loopback = decided.removesuffix(LOOPBACK_MARK), decided.endswith(LOOPBACK_MARK)
    environment = dict(os.environ)
    if arguments[:1] == ["--stamp"]:
        # The version stamp for a build here of the workspace the Cargo
        # arguments that follow name, which the gate passes to Cargo as a
        # build host's offload would: a line, empty for none. Status 1
        # outside a Cargo workspace in a Git checkout.
        stamp = checkout_stamp(arguments[1:], environment)
        if stamp is None:
            return 1
        print(stamp)
        return 0
    # Only `local` builds here; an empty setting is no setting.
    host = decided or environment.get("CAGENTS_BUILD_REMOTE") or "fw16"
    here = False
    if not decided and host == "local":
        here = True
    elif not decided and is_this_host(host):
        # The build host itself builds in place, unless asked to use its slots.
        loopback = environment.get(LOOPBACK) == "1"
        here = not loopback
    if arguments[:1] == ["--host"]:
        # Where builds go: 0, printing the build host, marked when that is
        # this host reached by loopback, or FALL_BACK when this host builds
        # in place. Any other status is a failure.
        if here:
            return FALL_BACK
        print(host + (LOOPBACK_MARK if loopback else ""))
        return 0
    if here:
        return FALL_BACK
    if arguments[:1] == ["--hold"]:
        if len(arguments) < 2:
            say("missing command for --hold")
            return 2
        return Hold(host, arguments[1:], environment, loopback).run()
    try:
        plan = parse(arguments)
    except Refusal as refusal:
        say(str(refusal))
        return REFUSED
    if plan is None:
        cargo = real_cargo(environment)
        os.execvp(cargo, [cargo, *arguments])
    try:
        return Offload(host, plan, environment, loopback).run()
    except Refusal as refusal:
        say(str(refusal))
        return REFUSED


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
